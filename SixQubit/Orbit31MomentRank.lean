theorem momentMatrix_scaled_right_inverse_Z :
    momentMatrixZ * momentRightInverseZ = 8 • (1 : Matrix (Fin 23) (Fin 23) Int) := by
  ext i j
  have h : forall i j, (momentMatrixZ * momentRightInverseZ) i j =
      (if i = j then (8 : Int) else 0) := by decide
  simpa [Matrix.one_apply] using h i j

def momentMatrix : Matrix (Fin 23) (Fin 32) Real :=
  momentMatrixZ.map (Int.castRingHom Real)

theorem momentMatrix_rank : momentMatrix.rank = 23 := by
  have hmap : momentMatrix * momentRightInverseZ.map (Int.castRingHom Real) =
      8 • (1 : Matrix (Fin 23) (Fin 23) Real) := by
    rw [momentMatrix, <- Matrix.map_mul, momentMatrix_scaled_right_inverse_Z]
    ext i j
    by_cases hij : i = j <;>
      norm_num [Matrix.map_apply, Matrix.smul_apply, Matrix.one_apply, Matrix.ofNat_apply, hij]
  have hmul : momentMatrix * ((1/8 : Real) •
      momentRightInverseZ.map (Int.castRingHom Real)) = 1 := by
    rw [Matrix.mul_smul, hmap]
    ext i j
    by_cases hij : i = j <;>
      norm_num [Matrix.smul_apply, Matrix.one_apply, Matrix.ofNat_apply, hij]
  have hlo := Matrix.rank_mul_le_left momentMatrix
    ((1/8 : Real) • momentRightInverseZ.map (Int.castRingHom Real))
  rw [hmul, Matrix.rank_one] at hlo
  have hhi := Matrix.rank_le_height momentMatrix
  norm_num at hlo
  omega

