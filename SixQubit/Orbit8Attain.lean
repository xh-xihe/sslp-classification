import Mathlib
import SS.HilbertKL
import SixQubit.Pin
import SixQubit.Orbit8Real

/-!
# Orbit 8: the enumerator of the exhibited code

The code of `SixQubit/Orbit8Real.lean` carries the `Z`-string on qubits
`000010`, whose overlap with every word of both supports is odd, so it
negates both logical words.  Its Pauli weight is 1, so `SixQubit/Pin.lean`
pins the enumerator to

    (1, 1, 0, 0, 15, 15, 0)

**Scope.**  This module supplies one early attainment point, not the universal
classification.  No mask has uniform parity on the complete orbit-8 fibres, so
the mask argument cannot prove uniqueness.  The required support and Hafnian
reduction, exact interval, and pointwise attainment are now kernel-proved in
`Orbit8UniversalFinal` and its dependencies.

Generated by `tools/generators/genattain.py`.
-/

namespace SixQubit.Orbit8Attain

open SS.MacWilliams SixQubit.Pin SixQubit.Orbit8Real

/-- The `Z`-string on qubits `000010`. -/
def zmask : SS.BitString 6 := ![false, false, false, false, true, false]

/-- Its overlap with every bottom word is odd. -/
theorem zmask_L0 : ∀ s ∈ L0, SS.bdot zmask s = true := by decide

/-- Its overlap with every top word is odd. -/
theorem zmask_L1 : ∀ s ∈ L1, SS.bdot zmask s = true := by decide

/-- Its Pauli weight. -/
theorem zmask_wt :
    (⟨fun _ => false, zmask⟩ : SS.PauliString 6).wt = 1 := by decide

/-- **The exhibited orbit-8 code has enumerator `(1, 1, 0, 0, 15, 15, 0)`.** -/
theorem enumerator :
    Aco ![w0, w1] 1 = 4 ∧ Aco ![w0, w1] 2 = 0 ∧ Aco ![w0, w1] 3 = 0
      ∧ Aco ![w0, w1] 4 = 60 ∧ Aco ![w0, w1] 5 = 60
      ∧ Aco ![w0, w1] 6 = 0 := by
  have hnorm : ∀ k, SS.innerC ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) = 1 := by
    intro k
    fin_cases k
    · exact w0_normalized
    · exact w1_normalized
  have hG : ∀ k, SS.pauliAct (⟨fun _ => false, zmask⟩ : SS.PauliString 6)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
        = -((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) := by
    intro k
    fin_cases k
    · exact zstring_negates w0 L0 w0_vanishes zmask zmask_L0
    · exact zstring_negates w1 L1 w1_vanishes zmask zmask_L1
  exact (enumerator_of_forced_neg ![w0, w1] is_code (Aco_zero _ hnorm) hnorm _ hG).1 zmask_wt

end SixQubit.Orbit8Attain
