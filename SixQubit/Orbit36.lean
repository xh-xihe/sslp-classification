/-! ## The diagonal layer -/

/-- The only weight-at-most-two flip that maps `S0` into itself is `X_5 X_6`,
which pairs `u` with `v` and `u'` with `v'`.  The diagonal
information the argument uses is exactly the `MomentSystem` below, so these
rows are not headline hypotheses; the layer is recorded for completeness. -/
def diagBot (c : SS.BitString 6 -> ℂ) (e z : SS.BitString 6) : ℂ :=
  ∑ x ∈ S0.filter (fun x => SS.bxor x e ∈ S0),
      SixQubit.signMul (SS.bdot z x) (star (c (SS.bxor x e)) * c x)

def diagTop (dd : SS.BitString 6 -> ℂ) (e z : SS.BitString 6) : ℂ :=
  ∑ y ∈ S1.filter (fun y => SS.bxor y e ∈ S1),
      SixQubit.signMul (SS.bdot z y) (star (dd (SS.bxor y e)) * dd y)

