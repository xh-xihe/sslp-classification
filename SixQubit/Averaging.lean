import Mathlib

/-!
# Averaging a coefficient over a symmetry group

A linear identity among Pauli coefficients can fail label by label and still
hold, because the symmetries of a code relate different labels rather than
killing them.  Orbit 21 is the case at hand: its Farkas certificate has 476
labels outside the forced set carrying a nonzero coefficient, yet every one of
the 320 symmetry classes has coefficient sum zero.

Reindexing turns that into a per-label statement.  If the weights `N` are
invariant under a symmetry `sigma`, then `sum c a * N a` is unchanged by
replacing `c` with `c . sigma`, so it equals the average of `c` over the group
-- and that average is the class sum over the class size, which vanishes off the
forced set.  What is left is one finite check.

Nothing here is specific to Paulis or to orbit 21.
-/

namespace SixQubit.Averaging

variable {α : Type*} [Fintype α]

/-- Reindexing by a symmetry of the weights moves it onto the coefficient. -/
theorem sum_shift (σ : α ≃ α) (c N : α → ℝ) (hN : ∀ a, N (σ a) = N a) :
    ∑ a, c a * N a = ∑ a, c (σ a) * N a := by
  have h := Fintype.sum_equiv σ (fun a => c (σ a) * N (σ a)) (fun b => c b * N b)
    (fun a => rfl)
  rw [← h]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  show c (σ a) * N (σ a) = c (σ a) * N a
  rw [hN a]

/-- The averaged form, for a group generated by two commuting involutions.

This is the shape orbit 21 needs: multiplication by the forced stabilizer and
conjugation by the diagonal gate are both involutions on labels and they
commute, so the group they generate has order four. -/
theorem sum_average_four (σ τ : α ≃ α) (c N : α → ℝ)
    (hσ : ∀ a, N (σ a) = N a) (hτ : ∀ a, N (τ a) = N a) :
    4 * ∑ a, c a * N a
      = ∑ a, (c a + c (σ a) + c (τ a) + c (σ (τ a))) * N a := by
  have h1 : ∑ a, c a * N a = ∑ a, c (σ a) * N a := sum_shift σ c N hσ
  have h2 : ∑ a, c a * N a = ∑ a, c (τ a) * N a := sum_shift τ c N hτ
  have hστ : ∀ a, N (σ (τ a)) = N a := by
    intro a; rw [hσ, hτ]
  have h3 : ∑ a, c a * N a = ∑ a, c (σ (τ a)) * N a :=
    sum_shift (τ.trans σ) c N hστ
  have hsplit : ∑ a, (c a + c (σ a) + c (τ a) + c (σ (τ a))) * N a
      = (∑ a, c a * N a) + (∑ a, c (σ a) * N a)
        + (∑ a, c (τ a) * N a) + (∑ a, c (σ (τ a)) * N a) := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun a _ => by ring)
  rw [hsplit, ← h1, ← h2, ← h3]
  ring

/-- **The payoff.**  When the averaged coefficient vanishes wherever the weight
does not, the whole sum is zero.

The hypothesis is a finite disjunction, one per label, and for a concrete orbit
the kernel decides the first disjunct and the code's structure supplies the
second. -/
theorem sum_eq_zero_of_average (σ τ : α ≃ α) (c N : α → ℝ)
    (hσ : ∀ a, N (σ a) = N a) (hτ : ∀ a, N (τ a) = N a)
    (hzero : ∀ a, c a + c (σ a) + c (τ a) + c (σ (τ a)) = 0 ∨ N a = 0) :
    ∑ a, c a * N a = 0 := by
  have h := sum_average_four σ τ c N hσ hτ
  have hr : ∑ a, (c a + c (σ a) + c (τ a) + c (σ (τ a))) * N a = 0 := by
    refine Finset.sum_eq_zero (fun a _ => ?_)
    rcases hzero a with h0 | h0
    · rw [h0, zero_mul]
    · rw [h0, mul_zero]
  rw [hr] at h
  linarith

end SixQubit.Averaging
