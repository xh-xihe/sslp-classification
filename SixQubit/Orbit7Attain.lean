import Mathlib
import SS.HilbertKL
import SixQubit.Pin
import SixQubit.Orbit7Real

/-!
# Orbit 7: the enumerator of the exhibited code

The code of `SixQubit/Orbit7Real.lean` carries the `Z`-string on qubits
`101000`, whose overlap with every word of both supports is odd, so it
negates both logical words.  Its Pauli weight is 2, so `SixQubit/Pin.lean`
pins the enumerator to

    (1, 0, 1, 0, 11, 16, 3)

**Scope.**  This module supplies one early attainment point, not the universal
classification.  No mask has uniform parity on the complete orbit-7 fibres, so
the mask argument cannot prove uniqueness.  The required support, tangent and
projector reduction, the exact interval, and pointwise attainment are now
kernel-proved in `Orbit7UniversalFinal` and its dependencies.

Generated by `tools/generators/genattain.py`.
-/

namespace SixQubit.Orbit7Attain

open SS.MacWilliams SixQubit.Pin SixQubit.Orbit7Real

/-- The `Z`-string on qubits `101000`. -/
def zmask : SS.BitString 6 := ![true, false, true, false, false, false]

/-- Its overlap with every bottom word is odd. -/
theorem zmask_L0 : ∀ s ∈ L0, SS.bdot zmask s = true := by decide

/-- Its overlap with every top word is odd. -/
theorem zmask_L1 : ∀ s ∈ L1, SS.bdot zmask s = true := by decide

/-- Its Pauli weight. -/
theorem zmask_wt :
    (⟨fun _ => false, zmask⟩ : SS.PauliString 6).wt = 2 := by decide

/-- **The exhibited orbit-7 code has enumerator `(1, 0, 1, 0, 11, 16, 3)`.** -/
theorem enumerator :
    Aco ![w0, w1] 1 = 0 ∧ Aco ![w0, w1] 2 = 4 ∧ Aco ![w0, w1] 3 = 0
      ∧ Aco ![w0, w1] 4 = 44 ∧ Aco ![w0, w1] 5 = 64
      ∧ Aco ![w0, w1] 6 = 12 := by
  have hnorm : ∀ k, SS.innerC ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) = 1 := by
    intro k
    fin_cases k
    · exact w0_normalized
    · exact w1_normalized
  have hG : ∀ k, SS.pauliAct (⟨fun _ => false, zmask⟩ : SS.PauliString 6)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
        = -((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) := by
    intro k
    fin_cases k
    · exact zstring_negates w0 L0 w0_vanishes zmask zmask_L0
    · exact zstring_negates w1 L1 w1_vanishes zmask zmask_L1
  exact (enumerator_of_forced_neg ![w0, w1] is_code (Aco_zero _ hnorm) hnorm _ hG).2 zmask_wt

end SixQubit.Orbit7Attain
