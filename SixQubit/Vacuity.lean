/-!
# No wrapper is vacuously true

Each `no_code` theorem assumes support, normalization and
`SS.HasDistance ![c, d] 3`, and concludes `False`. A theorem whose hypotheses
cannot all hold is true and says nothing, so before reading any of them as a
no-go one must know that the hypotheses OTHER than `HasDistance` are jointly
satisfiable. Otherwise `HasDistance` would be carrying no weight.

For every one of the fifty-one orbits this module exhibits such a pair: the
point masses `c = indicator {y0}` on the bottom fiber and `d = indicator {z}`
on the top. They are supported correctly and normalized, and they are
emphatically not codes -- which is the point. What each wrapper therefore
says is that no such pair can additionally have distance three.

Generated by `tools/generators/genvacuity.py`; no `sorry`, no `native_decide`.
-/

namespace SixQubit.Vacuity

open scoped BigOperators

noncomputable section

/-- The point mass at a single bit string. -/
def pt (s : SS.BitString 6) : SS.BitString 6 -> ℂ := fun t => if t = s then 1 else 0

theorem pt_support (s : SS.BitString 6) (S : Finset (SS.BitString 6)) (hs : s ∈ S) :
    ∀ t, t ∉ S → pt s t = 0 := by
  intro t ht
  have : t ≠ s := by rintro rfl; exact ht hs
  simp [pt, this]

theorem pt_norm (s : SS.BitString 6) : SS.innerC (pt s) (pt s) = 1 := by
  unfold SS.innerC pt
  rw [Finset.sum_eq_single s]
  · simp
  · intro b _ hb; simp [hb]
  · intro h; exact absurd (Finset.mem_univ s) h

/-- The non-distance hypotheses of `SixQubit.Orbit5.no_code` are jointly
satisfiable, so that theorem is not vacuously true. -/
theorem live_Orbit5 :
    (∀ x, x ∉ SixQubit.Orbit5.S0 → pt SixQubit.Orbit5.y0 x = 0) ∧
    (∀ y, y ∉ SixQubit.Orbit5.S1 → pt (SixQubit.Orbit5.z0) y = 0) ∧
    SS.innerC (pt SixQubit.Orbit5.y0) (pt SixQubit.Orbit5.y0) = 1 ∧
    SS.innerC (pt (SixQubit.Orbit5.z0)) (pt (SixQubit.Orbit5.z0)) = 1 :=
  ⟨pt_support _ _ (by decide), pt_support _ _ (by decide),
   pt_norm _, pt_norm _⟩

