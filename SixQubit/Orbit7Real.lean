import Mathlib
import SS.HilbertKL
import SixQubit.Realize

/-!
# Orbit 7: an exact realization

Orbit 7 of the six-qubit SSLP classification is `q = 3`, angle vector
`a = (0, 1, 1, 1, 2, 2)`, with the two words supported in the residue-`0` and residue-`1`
fibers.  This module exhibits an explicit pair and proves it is an exact
`((6,2,3))` code, so the orbit is nonempty.

The amplitudes are `1/12` times entries of `Z[sqrt 2, sqrt 3, i]`, 11 per
word.  All the Knill--Laflamme constraints of Pauli weight at most two are
decided by the kernel in that ring; `SixQubit/Realize.lean` transports the
decision to genuine complex matrix elements.

Generated by `tools/generators/genreal.py`, which re-checks the same
certificate in the same eight-integer arithmetic before writing.
-/

namespace SixQubit.Orbit7Real

open SixQubit.Realize

/-! ## The angle record and the two supports -/

def av : Fin 6 → ZMod 3 := ![0, 1, 1, 1, 2, 2]

def L0 : List (SS.BitString 6) :=
  [bs true  false false false false false,
   bs false true  true  true  false false,
   bs true  true  false false true  false,
   bs false false true  false true  false,
   bs true  false false true  true  false,
   bs true  true  false false false true,
   bs false false true  false false true,
   bs true  false false true  false true,
   bs false true  true  false true  true,
   bs true  true  false true  true  true,
   bs false false true  true  true  true]

def L1 : List (SS.BitString 6) :=
  [bs true  true  false false false false,
   bs false false true  false false false,
   bs true  false false true  false false,
   bs false true  true  false true  false,
   bs true  true  false true  true  false,
   bs false false true  true  true  false,
   bs false true  true  false false true,
   bs true  true  false true  false true,
   bs false false true  true  false true,
   bs true  false false false true  true,
   bs false true  true  true  true  true]

theorem L0_nodup : L0.Nodup := by decide
theorem L1_nodup : L1.Nodup := by decide

/-- Every bottom word lies in the residue-`0` fiber. -/
theorem L0_in_fiber : ∀ x ∈ L0, SS.weight av x = 0 := by decide

/-- Every top word lies in the residue-`1` fiber. -/
theorem L1_in_fiber : ∀ x ∈ L1, SS.weight av x = 1 := by decide

/-! ## The exact amplitude tables -/

/-- The bottom word, scaled by 12. -/
def c0z (x : SS.BitString 6) : ZQ :=
  if num x = 1 then z8 0 0 (-2) 0 0 0 0 0
  else if num x = 14 then z8 0 0 0 (-1) 0 3 0 0
  else if num x = 19 then z8 0 0 (-1) 0 3 0 0 0
  else if num x = 20 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 25 then z8 0 0 (-2) 0 0 0 0 0
  else if num x = 35 then z8 0 0 2 0 0 0 0 0
  else if num x = 36 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 41 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 54 then z8 0 0 2 0 0 0 0 0
  else if num x = 59 then z8 0 0 (-1) 0 3 0 0 0
  else if num x = 60 then z8 0 0 (-2) 0 0 0 0 0
  else ZQ.zero

/-- The top word, scaled by 12. -/
def c1z (x : SS.BitString 6) : ZQ :=
  if num x = 3 then z8 0 0 1 0 3 0 0 0
  else if num x = 4 then z8 0 0 (-1) 0 3 0 0 0
  else if num x = 9 then z8 0 0 (-1) 0 (-3) 0 0 0
  else if num x = 22 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 27 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 28 then z8 0 0 (-1) 0 (-3) 0 0 0
  else if num x = 38 then z8 0 0 1 0 3 0 0 0
  else if num x = 43 then z8 0 0 1 0 (-3) 0 0 0
  else if num x = 44 then z8 0 0 (-1) 0 3 0 0 0
  else if num x = 49 then z8 0 0 0 1 0 (-3) 0 0
  else if num x = 62 then z8 0 0 1 0 3 0 0 0
  else ZQ.zero

theorem c0z_vanishes : ∀ x : SS.BitString 6, x ∉ L0 → c0z x = ZQ.zero := by decide
theorem c1z_vanishes : ∀ x : SS.BitString 6, x ∉ L1 → c1z x = ZQ.zero := by decide

/-! ## The finite certificate -/

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 40000 in
/-- The Knill--Laflamme constraints of Pauli weight at most two, decided by the
kernel over all mask pairs.  The weight guard rejects the 3942 pairs of weight
three or more before any ring arithmetic is reached. -/
theorem check_all : ∀ m < 64, ∀ k < 64,
    (⟨nbit m, nbit k⟩ : SS.PauliString 6).wt ≤ 2 →
    checkKL c0z c1z L0 L1 (nbit m) (nbit k) = true := by decide

/-! ## The code -/

noncomputable section

/-- The normalizing scalar `1/12`. -/
def sc : ℂ := (1/12 : ℂ)

/-- `|0_L>`. -/
def w0 : SS.State 6 ℂ := stC sc c0z

/-- `|1_L>`. -/
def w1 : SS.State 6 ℂ := stC sc c1z

/-- **Orbit 7 is realized: this pair is an exact `((6,2,3))` code.** -/
theorem is_code : SS.HasDistance ![w0, w1] 3 :=
  is_code_of_check sc c0z c1z L0 L1 L0_nodup L1_nodup c0z_vanishes c1z_vanishes
    check_all

theorem norm0 : zmat c0z c0z L0 (fun _ => false) (fun _ => false)
    = z8 144 0 0 0 0 0 0 0 := by decide

theorem norm1 : zmat c1z c1z L1 (fun _ => false) (fun _ => false)
    = z8 144 0 0 0 0 0 0 0 := by decide

theorem sc_norm : star sc * sc * (144 : ℂ) = 1 := by
  rw [sc]
  norm_num [Complex.star_def, Complex.conj_ofNat]

theorem w0_normalized : SS.innerC w0 w0 = 1 :=
  normalized_of sc c0z L0 L0_nodup c0z_vanishes 144 norm0 sc_norm

theorem w1_normalized : SS.innerC w1 w1 = 1 :=
  normalized_of sc c1z L1 L1_nodup c1z_vanishes 144 norm1 sc_norm

theorem w0_vanishes (s : SS.BitString 6) (hs : s ∉ L0) : w0 s = 0 :=
  stC_vanishes sc c0z L0 c0z_vanishes s hs

theorem w1_vanishes (s : SS.BitString 6) (hs : s ∉ L1) : w1 s = 0 :=
  stC_vanishes sc c1z L1 c1z_vanishes s hs

end

end SixQubit.Orbit7Real
