import Mathlib

import SS.HilbertKL

/-!
# Local monomial equivalence of two-dimensional codes

This module supplies the *equivalence layer* that the orbit-36 classification
needs, and that every other orbit can reuse.  Over the Hilbert-space semantics
of `SS.HilbertKL` (states are amplitude vectors `SS.State n C = BitString n -> C`,
Paulis act by `SS.pauliAct`, and `SS.HasDistance` is the genuine
Knill--Laflamme condition) it defines

  * `permAct`  -- the action of a permutation of the physical qubits;
  * `monAct`   -- the action of a local monomial unitary, i.e. a tensor product
                  of one-qubit matrices each of which is a diagonal or an
                  antidiagonal with entries of modulus one;
  * `scal`     -- a phase on a single logical basis vector;
  * `swapIdx`  -- the interchange of the two logical basis vectors;
  * `Equivalent p q` -- `q` is obtained from `p` by one element of the group
    generated by all of these.

and proves that **every generator preserves `SS.HasDistance _ 3`**; in fact each
generator is invertible inside the same family, so the invariance is an
equivalence:

    `hasDistance_iff_of_equivalent : Equivalent p q -> (HasDistance p 3 <-> HasDistance q 3)`.

Without that invariance a classification statement would be empty, so it is
proved here for arbitrary `n` and for the honest Knill--Laflamme predicate, not
for a combinatorial surrogate.

## How the invariance is proved

`SS.innerC psi (SS.pauliAct P phi)` is `i^{#Y}` times the bridge sum

    corr psi phi x z = sum_s (-1)^{z.s} conj (psi (s + x)) phi s,

and the prefactor is invertible, so the Knill--Laflamme condition for a pair of
logical words is equivalent to the three equations `KLraw`:  both off-diagonal
bridge sums vanish and the two diagonal ones agree.  For each generator `G` the
bridge sum of the transformed pair is an explicit *linear combination, with
coefficients independent of the pair,* of bridge sums of the original pair at
Pauli labels of no larger weight:

  * permutation:  `corr` at `(x, z)` becomes `corr` at `(x o sigma, z o sigma)`;
  * `X`-flip:     `corr` is multiplied by the sign `(-1)^{z.f}`;
  * a one-qubit diagonal phase `t` on qubit `i` with `x i = true`:

        corr' (x,z) = ((t + conj t)/2) corr (x,z) - ((t - conj t)/2) corr (x, z + e_i),

    and `(x, z + e_i)` has weight at most that of `(x,z)` precisely because
    `x i = true`;  when `x i = false` the two agree;
  * a phase on one logical word: `corr` picks up `conj(lambda_j) lambda_k`.

Because `KLraw` is stated by linear equations in `corr`, each of these transports
the condition.  A general local monomial unitary is `permAct` after a global
scalar, a diagonal `diagOn` over all qubits, and an `X`-flip, so the four
generator lemmas suffice.

No `sorry`, no `native_decide`.
-/

namespace SixQubit.CodeEquiv

open scoped BigOperators

noncomputable section

variable {n : ℕ}

/-! ## 0.  Small complex helpers -/

theorem star_mul_self (t : ℂ) : star t * t = (Complex.normSq t : ℂ) := by
  simpa [Complex.star_def] using (Complex.normSq_eq_conj_mul_self (z := t)).symm

theorem unit_of_normSq {t : ℂ} (h : Complex.normSq t = 1) : star t * t = 1 := by
  rw [star_mul_self, h]
  norm_num

theorem ne_zero_of_normSq {t : ℂ} (h : Complex.normSq t = 1) : t ≠ 0 := by
  intro h0
  rw [h0, map_zero] at h
  exact zero_ne_one h

theorem star_unit_unit {t : ℂ} (h : star t * t = 1) : star (star t) * star t = 1 := by
  rw [star_star]
  rw [mul_comm] at h
  exact h

/-! ## 1.  Parity arithmetic for `SS.bdot`

`SS.bdot z s` is the parity of the overlap of the two masks.  The three facts
used below are additivity in each argument, the value on a standard basis mask,
and invariance under a simultaneous permutation of both arguments. -/

/-- The overlap count whose parity is `SS.bdot`. -/
def bcount (z s : SS.BitString n) : ℕ := ∑ i, if (z i && s i) = true then 1 else 0

theorem bdot_eq_bcount (z s : SS.BitString n) : SS.bdot z s = (bcount z s % 2 == 1) := by
  simp only [SS.bdot, bcount, Finset.card_filter]

theorem bcount_comm (z s : SS.BitString n) : bcount z s = bcount s z := by
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [Bool.and_comm]

theorem bdot_comm (z s : SS.BitString n) : SS.bdot z s = SS.bdot s z := by
  rw [bdot_eq_bcount, bdot_eq_bcount, bcount_comm]

theorem triple_even : ∀ u v w : Bool,
    (if (u && (xor v w)) = true then 1 else 0) + (if (u && v) = true then 1 else 0)
      + (if (u && w) = true then 1 else 0) = 2 * (if (u && (v || w)) = true then 1 else 0) := by
  decide

theorem bcount_bxor_sum (z s f : SS.BitString n) :
    bcount z (SS.bxor s f) + bcount z s + bcount z f
      = 2 * bcount z (fun i => s i || f i) := by
  have h : ∀ i : Fin n,
      (if (z i && SS.bxor s f i) = true then 1 else 0)
        + (if (z i && s i) = true then 1 else 0)
        + (if (z i && f i) = true then 1 else 0)
      = 2 * (if (z i && (s i || f i)) = true then 1 else 0) := by
    intro i
    simp only [SS.bxor_apply]
    exact triple_even (z i) (s i) (f i)
  calc bcount z (SS.bxor s f) + bcount z s + bcount z f
      = ∑ i, ((if (z i && SS.bxor s f i) = true then 1 else 0)
          + (if (z i && s i) = true then 1 else 0)
          + (if (z i && f i) = true then 1 else 0)) := by
        simp only [bcount, Finset.sum_add_distrib]
    _ = ∑ i, 2 * (if (z i && (s i || f i)) = true then 1 else 0) :=
        Finset.sum_congr rfl (fun i _ => h i)
    _ = 2 * bcount z (fun i => s i || f i) := by
        simp only [bcount, Finset.mul_sum]

theorem bdot_bxor_right (z s f : SS.BitString n) :
    SS.bdot z (SS.bxor s f) = xor (SS.bdot z s) (SS.bdot z f) := by
  have h := bcount_bxor_sum z s f
  rw [bdot_eq_bcount, bdot_eq_bcount, bdot_eq_bcount]
  have hb : bcount z s % 2 = 0 ∨ bcount z s % 2 = 1 := by omega
  have hc : bcount z f % 2 = 0 ∨ bcount z f % 2 = 1 := by omega
  rcases hb with hb | hb <;> rcases hc with hc | hc
  · have ha : bcount z (SS.bxor s f) % 2 = 0 := by omega
    rw [ha, hb, hc]
    decide
  · have ha : bcount z (SS.bxor s f) % 2 = 1 := by omega
    rw [ha, hb, hc]
    decide
  · have ha : bcount z (SS.bxor s f) % 2 = 1 := by omega
    rw [ha, hb, hc]
    decide
  · have ha : bcount z (SS.bxor s f) % 2 = 0 := by omega
    rw [ha, hb, hc]
    decide

theorem bdot_bxor_left (z e s : SS.BitString n) :
    SS.bdot (SS.bxor z e) s = xor (SS.bdot z s) (SS.bdot e s) := by
  rw [bdot_comm, bdot_bxor_right, bdot_comm, bdot_comm e s]

theorem bcount_stdBasis (i : Fin n) (s : SS.BitString n) :
    bcount (SS.stdBasis i) s = if s i = true then 1 else 0 := by
  rw [bcount, Finset.sum_eq_single i]
  · simp [SS.stdBasis]
  · intro j _ hj
    rw [SS.stdBasis_apply_ne hj]
    simp
  · intro h
    exact absurd (Finset.mem_univ i) h

theorem bdot_stdBasis (i : Fin n) (s : SS.BitString n) :
    SS.bdot (SS.stdBasis i) s = s i := by
  rw [bdot_eq_bcount, bcount_stdBasis]
  cases h : s i <;> simp

/-! ## 2.  Permuting the physical qubits -/

/-- Relabel the coordinates of a bitstring by a permutation. -/
def permStr (σ : Equiv.Perm (Fin n)) (s : SS.BitString n) : SS.BitString n := fun i => s (σ i)

@[simp] theorem permStr_apply (σ : Equiv.Perm (Fin n)) (s : SS.BitString n) (i : Fin n) :
    permStr σ s i = s (σ i) := rfl

theorem permStr_bxor (σ : Equiv.Perm (Fin n)) (s t : SS.BitString n) :
    permStr σ (SS.bxor s t) = SS.bxor (permStr σ s) (permStr σ t) := rfl

/-- Relabelling by a permutation is a bijection of bitstrings. -/
def permStrEquiv (σ : Equiv.Perm (Fin n)) : SS.BitString n ≃ SS.BitString n where
  toFun := permStr σ
  invFun := permStr σ.symm
  left_inv := by
    intro s
    funext i
    simp [permStr]
  right_inv := by
    intro s
    funext i
    simp [permStr]

theorem bcount_permStr (σ : Equiv.Perm (Fin n)) (z s : SS.BitString n) :
    bcount (permStr σ z) (permStr σ s) = bcount z s :=
  Equiv.sum_comp σ (fun j => if (z j && s j) = true then 1 else 0)

theorem bdot_permStr (σ : Equiv.Perm (Fin n)) (z s : SS.BitString n) :
    SS.bdot (permStr σ z) (permStr σ s) = SS.bdot z s := by
  rw [bdot_eq_bcount, bdot_eq_bcount, bcount_permStr]

theorem wt_permStr (σ : Equiv.Perm (Fin n)) (x z : SS.BitString n) :
    (⟨permStr σ x, permStr σ z⟩ : SS.PauliString n).wt
      = (⟨x, z⟩ : SS.PauliString n).wt := by
  simp only [SS.PauliString.wt, Finset.card_filter, permStr_apply]
  exact Equiv.sum_comp σ (fun j => if (x j || z j) = true then 1 else 0)

theorem wt_bxor_std_le {x z : SS.BitString n} {i : Fin n} (hx : x i = true) :
    (⟨x, SS.bxor z (SS.stdBasis i)⟩ : SS.PauliString n).wt
      ≤ (⟨x, z⟩ : SS.PauliString n).wt := by
  apply Finset.card_le_card
  intro j hj
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
  by_cases hji : j = i
  · subst hji
    simp [hx]
  · rw [SS.bxor_apply, SS.stdBasis_apply_ne hji, Bool.xor_false] at hj
    exact hj

/-! ## 3.  The bridge sum -/

/-- The Knill--Laflamme matrix element of the Pauli `P(x,z)`, with the invertible
prefactor `i^{#Y}` removed.  This is exactly `SS.innerC_pauliAct`. -/
def corr (psi phi : SS.State n ℂ) (x z : SS.BitString n) : ℂ :=
  ∑ s, SS.signC (SS.bdot z s) (star (psi (SS.bxor s x)) * phi s)

theorem innerC_eq_corr (psi phi : SS.State n ℂ) (P : SS.PauliString n) :
    SS.innerC psi (SS.pauliAct P phi) = (Complex.I ^ P.numY) * corr psi phi P.x P.z :=
  SS.innerC_pauliAct psi phi P

theorem signC_not (b : Bool) (t : ℂ) : SS.signC (!b) t = -SS.signC b t := by
  cases b <;> simp [SS.signC]

theorem signC_mul (b : Bool) (u t : ℂ) : SS.signC b (u * t) = u * SS.signC b t := by
  cases b <;> simp [SS.signC]

/-! ## 4.  The Knill--Laflamme condition in bridge form -/

/-- The Knill--Laflamme condition for a pair of logical words at the Pauli
`P(x,z)`: the two off-diagonal bridge sums vanish and the diagonal ones agree. -/
def KLraw (p : Fin 2 → SS.State n ℂ) (x z : SS.BitString n) : Prop :=
  corr (p 0) (p 1) x z = 0 ∧ corr (p 1) (p 0) x z = 0
    ∧ corr (p 0) (p 0) x z = corr (p 1) (p 1) x z

/-- Error detection up to weight `w`, in bridge form. -/
def DetectsRaw (p : Fin 2 → SS.State n ℂ) (w : ℕ) : Prop :=
  ∀ x z : SS.BitString n, (⟨x, z⟩ : SS.PauliString n).wt ≤ w → KLraw p x z

theorem klCondition_iff (p : Fin 2 → SS.State n ℂ) (P : SS.PauliString n) :
    SS.KLCondition p P ↔ KLraw p P.x P.z := by
  have hI : (Complex.I ^ P.numY) ≠ 0 := SS.pauliPrefactor_ne_zero P
  constructor
  · rintro ⟨cst, h⟩
    have h01 := h 0 1
    have h10 := h 1 0
    have h00 := h 0 0
    have h11 := h 1 1
    rw [innerC_eq_corr] at h01 h10 h00 h11
    simp only [show ((0 : Fin 2) = 1) = False by simp, show ((1 : Fin 2) = 0) = False by simp,
      if_false, if_true] at h01 h10 h00 h11
    refine ⟨?_, ?_, ?_⟩
    · exact (mul_eq_zero.mp h01).resolve_left hI
    · exact (mul_eq_zero.mp h10).resolve_left hI
    · exact mul_left_cancel₀ hI (h00.trans h11.symm)
  · rintro ⟨h01, h10, h00⟩
    refine ⟨(Complex.I ^ P.numY) * corr (p 0) (p 0) P.x P.z, ?_⟩
    intro j k
    fin_cases j <;> fin_cases k <;> rw [innerC_eq_corr] <;> simp [h01, h10, h00]

theorem hasDistance_iff (p : Fin 2 → SS.State n ℂ) :
    SS.HasDistance p 3 ↔ DetectsRaw p 2 := by
  constructor
  · intro h x z hw
    exact (klCondition_iff p ⟨x, z⟩).mp (h ⟨x, z⟩ hw)
  · intro h P hw
    exact (klCondition_iff p P).mpr (h P.x P.z hw)

/-! ## 5.  The generators -/

/-- Permutation of the physical qubits. -/
def permAct (σ : Equiv.Perm (Fin n)) (psi : SS.State n ℂ) : SS.State n ℂ :=
  fun s => psi (permStr σ s)

/-- The local `X`-flip `X^f`. -/
def flipAct (f : SS.BitString n) (psi : SS.State n ℂ) : SS.State n ℂ :=
  fun s => psi (SS.bxor s f)

/-- A one-qubit diagonal phase `diag (1, t)` on qubit `i`. -/
def dAct (i : Fin n) (t : ℂ) (psi : SS.State n ℂ) : SS.State n ℂ :=
  fun s => (if s i then t else 1) * psi s

/-- A phase on one logical basis vector. -/
def scal (l : ℂ) (psi : SS.State n ℂ) : SS.State n ℂ := fun s => l * psi s

/-- The diagonal unitary `otimes_{i in T} diag (1, t i)`. -/
def diagOn (T : Finset (Fin n)) (t : Fin n → ℂ) (psi : SS.State n ℂ) : SS.State n ℂ :=
  fun s => (∏ i ∈ T, (if s i then t i else 1)) * psi s

/-- A local monomial unitary: on qubit `i` the two nonzero entries are `al i`
and `be i`, and the flip mask `f` says which qubits carry an antidiagonal. -/
def monAct (f : SS.BitString n) (al be : Fin n → ℂ) (psi : SS.State n ℂ) : SS.State n ℂ :=
  fun s => (∏ i, (if s i then be i else al i)) * psi (SS.bxor s f)

/-- Interchange of the two logical basis vectors. -/
def swapIdx : Bool -> Fin 2 -> Fin 2
  | false, k => k
  | true, k => if k = 0 then 1 else 0

theorem swapIdx_involutive (b : Bool) (k : Fin 2) : swapIdx b (swapIdx b k) = k := by
  cases b <;> fin_cases k <;> rfl

/-! ## 6.  The bridge sum under each generator -/

theorem corr_permAct (σ : Equiv.Perm (Fin n)) (psi phi : SS.State n ℂ) (x z : SS.BitString n) :
    corr (permAct σ psi) (permAct σ phi) x z = corr psi phi (permStr σ x) (permStr σ z) := by
  unfold corr
  rw [← Equiv.sum_comp (permStrEquiv σ)
    (fun u => SS.signC (SS.bdot (permStr σ z) u) (star (psi (SS.bxor u (permStr σ x))) * phi u))]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  show SS.signC (SS.bdot z s) (star (permAct σ psi (SS.bxor s x)) * permAct σ phi s)
      = SS.signC (SS.bdot (permStr σ z) (permStr σ s))
          (star (psi (SS.bxor (permStr σ s) (permStr σ x))) * phi (permStr σ s))
  rw [bdot_permStr]
  rfl

theorem bxor_shuffle (s f x : SS.BitString n) :
    SS.bxor (SS.bxor (SS.bxor s f) x) f = SS.bxor s x := by
  funext i
  simp only [SS.bxor_apply]
  cases s i <;> cases f i <;> cases x i <;> rfl

theorem corr_flipAct (f : SS.BitString n) (psi phi : SS.State n ℂ) (x z : SS.BitString n) :
    corr (flipAct f psi) (flipAct f phi) x z = SS.signC (SS.bdot z f) (corr psi phi x z) := by
  have hre : corr (flipAct f psi) (flipAct f phi) x z
      = ∑ s, SS.signC (xor (SS.bdot z s) (SS.bdot z f))
          (star (psi (SS.bxor s x)) * phi s) := by
    unfold corr
    rw [← Equiv.sum_comp (SS.bxorEquiv f)
      (fun u => SS.signC (SS.bdot z u) (star (flipAct f psi (SS.bxor u x)) * flipAct f phi u))]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    show SS.signC (SS.bdot z (SS.bxor s f))
        (star (flipAct f psi (SS.bxor (SS.bxor s f) x)) * flipAct f phi (SS.bxor s f))
      = SS.signC (xor (SS.bdot z s) (SS.bdot z f)) (star (psi (SS.bxor s x)) * phi s)
    rw [bdot_bxor_right]
    unfold flipAct
    rw [bxor_shuffle, SS.bxor_bxor_cancel]
  rw [hre]
  cases hf : SS.bdot z f
  · simp only [Bool.xor_false, SS.signC_false]
    rfl
  · simp only [Bool.xor_true, SS.signC_true]
    rw [corr, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun s _ => signC_not _ _)

theorem corr_scal (l m : ℂ) (psi phi : SS.State n ℂ) (x z : SS.BitString n) :
    corr (scal l psi) (scal m phi) x z = star l * m * corr psi phi x z := by
  unfold corr scal
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  rw [star_mul, ← signC_mul]
  congr 1
  ring

theorem dstep0 (t X : ℂ) (b c : Bool) (ht : star t * t = 1) :
    SS.signC b (star (if c then t else 1) * ((if c then t else 1) * X)) = SS.signC b X := by
  have key : star (if c then t else 1) * ((if c then t else 1) * X) = X := by
    cases c
    · show star (1 : ℂ) * ((1 : ℂ) * X) = X
      rw [star_one]
      ring
    · show star t * (t * X) = X
      linear_combination X * ht
  rw [key]

theorem dstep (t X : ℂ) (b c : Bool) :
    SS.signC b (star (if !c then t else 1) * ((if c then t else 1) * X))
      = ((t + star t) / 2) * SS.signC b X - ((t - star t) / 2) * SS.signC (xor b c) X := by
  have h1 : star (1 : ℂ) = 1 := star_one ℂ
  cases c
  · cases b
    · show star t * ((1 : ℂ) * X) = ((t + star t) / 2) * X - ((t - star t) / 2) * X
      ring
    · show -(star t * ((1 : ℂ) * X)) = ((t + star t) / 2) * (-X) - ((t - star t) / 2) * (-X)
      ring
  · cases b
    · show star (1 : ℂ) * (t * X) = ((t + star t) / 2) * X - ((t - star t) / 2) * (-X)
      rw [h1]
      ring
    · show -(star (1 : ℂ) * (t * X)) = ((t + star t) / 2) * (-X) - ((t - star t) / 2) * X
      rw [h1]
      ring

theorem corr_dAct_false (i : Fin n) (t : ℂ) (psi phi : SS.State n ℂ) (x z : SS.BitString n)
    (hx : x i = false) (ht : star t * t = 1) :
    corr (dAct i t psi) (dAct i t phi) x z = corr psi phi x z := by
  unfold corr
  refine Finset.sum_congr rfl (fun s _ => ?_)
  have hxi : SS.bxor s x i = s i := by
    rw [SS.bxor_apply, hx, Bool.xor_false]
  have key : star (dAct i t psi (SS.bxor s x)) * dAct i t phi s
      = star (if s i then t else 1) * ((if s i then t else 1) * (star (psi (SS.bxor s x)) * phi s)) := by
    unfold dAct
    rw [hxi, star_mul]
    ring
  rw [key, dstep0 t _ _ _ ht]

theorem corr_dAct_true (i : Fin n) (t : ℂ) (psi phi : SS.State n ℂ) (x z : SS.BitString n)
    (hx : x i = true) :
    corr (dAct i t psi) (dAct i t phi) x z
      = ((t + star t) / 2) * corr psi phi x z
        - ((t - star t) / 2) * corr psi phi x (SS.bxor z (SS.stdBasis i)) := by
  unfold corr
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  have hxi : SS.bxor s x i = !(s i) := by
    rw [SS.bxor_apply, hx, Bool.xor_true]
  have hb : SS.bdot (SS.bxor z (SS.stdBasis i)) s = xor (SS.bdot z s) (s i) := by
    rw [bdot_bxor_left, bdot_stdBasis]
  have key : star (dAct i t psi (SS.bxor s x)) * dAct i t phi s
      = star (if !(s i) then t else 1)
          * ((if s i then t else 1) * (star (psi (SS.bxor s x)) * phi s)) := by
    unfold dAct
    rw [hxi, star_mul]
    ring
  rw [key, hb, dstep]

/-! ## 7.  Transport of the Knill--Laflamme condition -/

theorem detectsRaw_permAct {p : Fin 2 → SS.State n ℂ} {w : ℕ} (σ : Equiv.Perm (Fin n))
    (h : DetectsRaw p w) : DetectsRaw (fun k => permAct σ (p k)) w := by
  intro x z hw
  obtain ⟨h1, h2, h3⟩ := h (permStr σ x) (permStr σ z) (by rw [wt_permStr]; exact hw)
  exact ⟨by simpa [corr_permAct] using h1, by simpa [corr_permAct] using h2,
    by simpa [corr_permAct] using h3⟩

theorem detectsRaw_flipAct {p : Fin 2 → SS.State n ℂ} {w : ℕ} (f : SS.BitString n)
    (h : DetectsRaw p w) : DetectsRaw (fun k => flipAct f (p k)) w := by
  intro x z hw
  obtain ⟨h1, h2, h3⟩ := h x z hw
  refine ⟨?_, ?_, ?_⟩ <;> simp only [corr_flipAct]
  · rw [h1]
    cases SS.bdot z f <;> simp
  · rw [h2]
    cases SS.bdot z f <;> simp
  · rw [h3]

theorem detectsRaw_dAct {p : Fin 2 → SS.State n ℂ} {w : ℕ} (i : Fin n) (t : ℂ)
    (ht : star t * t = 1) (h : DetectsRaw p w) : DetectsRaw (fun k => dAct i t (p k)) w := by
  intro x z hw
  by_cases hx : x i = true
  · obtain ⟨a1, a2, a3⟩ := h x z hw
    obtain ⟨b1, b2, b3⟩ := h x (SS.bxor z (SS.stdBasis i)) (le_trans (wt_bxor_std_le hx) hw)
    refine ⟨?_, ?_, ?_⟩ <;> simp only [corr_dAct_true i t _ _ x z hx]
    · rw [a1, b1]
      ring
    · rw [a2, b2]
      ring
    · rw [a3, b3]
  · have hx' : x i = false := by
      cases hxi : x i
      · rfl
      · exact absurd hxi hx
    obtain ⟨a1, a2, a3⟩ := h x z hw
    refine ⟨?_, ?_, ?_⟩ <;> simp only [corr_dAct_false i t _ _ x z hx' ht]
    · exact a1
    · exact a2
    · exact a3

theorem detectsRaw_scalPair {p : Fin 2 → SS.State n ℂ} {w : ℕ} (lam : Fin 2 → ℂ)
    (hl : ∀ k, star (lam k) * lam k = 1) (h : DetectsRaw p w) :
    DetectsRaw (fun k => scal (lam k) (p k)) w := by
  intro x z hw
  obtain ⟨a1, a2, a3⟩ := h x z hw
  refine ⟨?_, ?_, ?_⟩ <;> simp only [corr_scal]
  · rw [a1, mul_zero]
  · rw [a2, mul_zero]
  · rw [a3, hl 0, hl 1]

theorem detectsRaw_swap {p : Fin 2 → SS.State n ℂ} {w : ℕ} (b : Bool) (h : DetectsRaw p w) :
    DetectsRaw (fun k => p (swapIdx b k)) w := by
  intro x z hw
  obtain ⟨a1, a2, a3⟩ := h x z hw
  cases b
  · exact ⟨a1, a2, a3⟩
  · exact ⟨a2, a1, a3.symm⟩

/-! ## 8.  The diagonal layer, one qubit at a time -/

theorem diagOn_empty (t : Fin n → ℂ) (psi : SS.State n ℂ) : diagOn ∅ t psi = psi := by
  funext s
  simp [diagOn]

theorem diagOn_insert {i : Fin n} {T : Finset (Fin n)} (hi : i ∉ T) (t : Fin n → ℂ)
    (psi : SS.State n ℂ) : diagOn (insert i T) t psi = dAct i (t i) (diagOn T t psi) := by
  funext s
  simp only [diagOn, dAct, Finset.prod_insert hi]
  ring

theorem detectsRaw_diagOn {p : Fin 2 → SS.State n ℂ} {w : ℕ} (T : Finset (Fin n))
    (t : Fin n → ℂ) (ht : ∀ i, star (t i) * t i = 1) (h : DetectsRaw p w) :
    DetectsRaw (fun k => diagOn T t (p k)) w := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa only [diagOn_empty] using h
  | insert i T hi ih =>
      have h2 := detectsRaw_dAct i (t i) (ht i) ih
      simpa only [diagOn_insert hi] using h2

/-! ## 9.  Local monomial unitaries -/

theorem monAct_eq (f : SS.BitString n) (al be : Fin n → ℂ) (hal : ∀ i, al i ≠ 0)
    (psi : SS.State n ℂ) :
    monAct f al be psi
      = scal (∏ i, al i) (diagOn Finset.univ (fun i => be i / al i) (flipAct f psi)) := by
  funext s
  simp only [monAct, scal, diagOn, flipAct]
  rw [← mul_assoc, ← Finset.prod_mul_distrib]
  refine congrArg (fun u => u * psi (SS.bxor s f)) ?_
  refine Finset.prod_congr rfl (fun i _ => ?_)
  by_cases hs : s i = true
  · rw [if_pos hs, if_pos hs, mul_div_assoc']
    rw [mul_comm, mul_div_assoc, div_self (hal i), mul_one]
  · rw [if_neg hs, if_neg hs, mul_one]

/-- A local monomial unitary together with a relabelling of the physical qubits:
on qubit `i` the one-qubit factor is `diag (al i, be i)` when `flip i = false`
and the antidiagonal with the same two entries when `flip i = true`; both entries
have modulus one, so each factor is unitary. -/
structure LocalMonomial (n : ℕ) where
  perm : Equiv.Perm (Fin n)
  flip : SS.BitString n
  al : Fin n → ℂ
  be : Fin n → ℂ
  al_unit : ∀ i, Complex.normSq (al i) = 1
  be_unit : ∀ i, Complex.normSq (be i) = 1

/-- The action of a local monomial unitary preceded by the qubit relabelling. -/
def LocalMonomial.act (U : LocalMonomial n) (psi : SS.State n ℂ) : SS.State n ℂ :=
  monAct U.flip U.al U.be (permAct U.perm psi)

theorem LocalMonomial.act_apply (U : LocalMonomial n) (psi : SS.State n ℂ) (s : SS.BitString n) :
    U.act psi s = (∏ i, (if s i then U.be i else U.al i)) * psi (permStr U.perm (SS.bxor s U.flip)) :=
  rfl

theorem detectsRaw_act {p : Fin 2 → SS.State n ℂ} {w : ℕ} (U : LocalMonomial n)
    (h : DetectsRaw p w) : DetectsRaw (fun k => U.act (p k)) w := by
  have hal : ∀ i, U.al i ≠ 0 := fun i => ne_zero_of_normSq (U.al_unit i)
  have hq : ∀ i, star (U.be i / U.al i) * (U.be i / U.al i) = 1 := by
    intro i
    refine unit_of_normSq ?_
    rw [map_div₀, U.al_unit i, U.be_unit i]
    norm_num
  have hc : star (∏ i, U.al i) * (∏ i, U.al i) = 1 := by
    refine unit_of_normSq ?_
    rw [map_prod]
    simp [U.al_unit]
  have h1 := detectsRaw_permAct U.perm h
  have h2 := detectsRaw_flipAct U.flip h1
  have h3 := detectsRaw_diagOn Finset.univ (fun i => U.be i / U.al i) hq h2
  have h4 := detectsRaw_scalPair (fun _ => ∏ i, U.al i) (fun _ => hc) h3
  simpa only [LocalMonomial.act, monAct_eq U.flip U.al U.be hal] using h4

/-! ## 10.  Equivalence of pairs of logical words -/

/-- `q` is obtained from `p` by a physical-qubit permutation, a local monomial
unitary, logical basis phases, and a possible interchange of the two logical
basis vectors. -/
def Equivalent (p q : Fin 2 → SS.State n ℂ) : Prop :=
  ∃ (U : LocalMonomial n) (lam : Fin 2 → ℂ) (sw : Bool),
    (∀ k, Complex.normSq (lam k) = 1) ∧
      ∀ k, q k = scal (lam k) (U.act (p (swapIdx sw k)))

theorem Equivalent.refl (p : Fin 2 → SS.State n ℂ) : Equivalent p p := by
  refine ⟨⟨Equiv.refl _, fun _ => false, fun _ => 1, fun _ => 1, fun _ => by simp,
    fun _ => by simp⟩, fun _ => 1, false, fun _ => by simp, ?_⟩
  intro k
  funext s
  have hp : permStr (Equiv.refl (Fin n)) (SS.bxor s (fun _ => false)) = s := by
    funext i
    simp [permStr, SS.bxor]
  have hprod : (∏ i : Fin n, (if s i then (1 : ℂ) else 1)) = 1 :=
    Finset.prod_eq_one (fun i _ => by by_cases h : s i = true <;> simp [h])
  show p k s = 1 * ((∏ i : Fin n, (if s i then (1 : ℂ) else 1))
      * p k (permStr (Equiv.refl (Fin n)) (SS.bxor s (fun _ => false))))
  rw [hp, hprod, one_mul, one_mul]

theorem detectsRaw_of_equivalent {p q : Fin 2 → SS.State n ℂ} {w : ℕ}
    (hE : Equivalent p q) (h : DetectsRaw p w) : DetectsRaw q w := by
  obtain ⟨U, lam, sw, hlam, hq⟩ := hE
  have h0 := detectsRaw_swap sw h
  have h1 := detectsRaw_act U h0
  have h2 := detectsRaw_scalPair lam (fun k => unit_of_normSq (hlam k)) h1
  have hqf : q = fun k => scal (lam k) (U.act ((fun j => p (swapIdx sw j)) k)) := funext hq
  rw [hqf]
  exact h2

/-! ## 11.  Every generator is invertible, so the invariance is an equivalence -/

theorem permAct_inv (σ : Equiv.Perm (Fin n)) (psi : SS.State n ℂ) :
    permAct σ.symm (permAct σ psi) = psi := by
  funext s
  have h : permStr σ (permStr σ.symm s) = s := by
    funext i
    simp [permStr]
  show psi (permStr σ (permStr σ.symm s)) = psi s
  rw [h]

theorem flipAct_inv (f : SS.BitString n) (psi : SS.State n ℂ) :
    flipAct f (flipAct f psi) = psi := by
  funext s
  show psi (SS.bxor (SS.bxor s f) f) = psi s
  rw [SS.bxor_bxor_cancel]

theorem scal_inv {l : ℂ} (hl : star l * l = 1) (psi : SS.State n ℂ) :
    scal (star l) (scal l psi) = psi := by
  funext s
  simp only [scal, ← mul_assoc, hl, one_mul]

theorem diagOn_inv {t : Fin n → ℂ} (ht : ∀ i, star (t i) * t i = 1) (T : Finset (Fin n))
    (psi : SS.State n ℂ) : diagOn T (fun i => star (t i)) (diagOn T t psi) = psi := by
  funext s
  simp only [diagOn, ← mul_assoc]
  rw [← Finset.prod_mul_distrib]
  have : ∀ i ∈ T, (if s i then star (t i) else 1) * (if s i then t i else 1) = 1 := by
    intro i _
    cases hs : s i
    · simp
    · simpa using ht i
  rw [Finset.prod_congr rfl this, Finset.prod_const_one, one_mul]

theorem detectsRaw_of_act {p : Fin 2 → SS.State n ℂ} {w : ℕ} (U : LocalMonomial n)
    (h : DetectsRaw (fun k => U.act (p k)) w) : DetectsRaw p w := by
  have hal : ∀ i, U.al i ≠ 0 := fun i => ne_zero_of_normSq (U.al_unit i)
  have hq : ∀ i, star (U.be i / U.al i) * (U.be i / U.al i) = 1 := by
    intro i
    refine unit_of_normSq ?_
    rw [map_div₀, U.al_unit i, U.be_unit i]
    norm_num
  have hc : star (∏ i, U.al i) * (∏ i, U.al i) = 1 := by
    refine unit_of_normSq ?_
    rw [map_prod]
    simp [U.al_unit]
  have h0 : DetectsRaw
      (fun k => scal (∏ i, U.al i)
        (diagOn Finset.univ (fun i => U.be i / U.al i)
          (flipAct U.flip (permAct U.perm (p k))))) w := by
    simpa only [LocalMonomial.act, monAct_eq U.flip U.al U.be hal] using h
  have h1 := detectsRaw_scalPair (fun _ => star (∏ i, U.al i)) (fun _ => star_unit_unit hc) h0
  simp only [scal_inv hc] at h1
  have h2 := detectsRaw_diagOn Finset.univ (fun i => star (U.be i / U.al i))
    (fun i => star_unit_unit (hq i)) h1
  simp only [diagOn_inv hq] at h2
  have h3 := detectsRaw_flipAct U.flip h2
  simp only [flipAct_inv] at h3
  have h4 := detectsRaw_permAct U.perm.symm h3
  simp only [permAct_inv] at h4
  exact h4

theorem detectsRaw_of_equivalent' {p q : Fin 2 → SS.State n ℂ} {w : ℕ}
    (hE : Equivalent p q) (h : DetectsRaw q w) : DetectsRaw p w := by
  obtain ⟨U, lam, sw, hlam, hq⟩ := hE
  have hqf : q = fun k => scal (lam k) (U.act ((fun j => p (swapIdx sw j)) k)) := funext hq
  rw [hqf] at h
  have h1 := detectsRaw_scalPair (fun k => star (lam k))
    (fun k => star_unit_unit (unit_of_normSq (hlam k))) h
  simp only [scal_inv (unit_of_normSq (hlam _))] at h1
  have h2 := detectsRaw_of_act U h1
  have h3 := detectsRaw_swap sw h2
  simpa only [swapIdx_involutive] using h3

/-! ## 12.  The headline invariance -/

/-- **Each generator preserves the genuine distance-three condition.**  A pair of
logical words obtained from a distance-three pair by a physical-qubit
permutation, a local monomial unitary, logical basis phases and a possible
interchange of the two logical basis vectors is again a distance-three pair, and
conversely.  This is what makes a classification up to `Equivalent`
meaningful. -/
theorem hasDistance_iff_of_equivalent {p q : Fin 2 → SS.State n ℂ} (hE : Equivalent p q) :
    SS.HasDistance p 3 ↔ SS.HasDistance q 3 := by
  constructor
  · intro h
    exact (hasDistance_iff q).mpr (detectsRaw_of_equivalent hE ((hasDistance_iff p).mp h))
  · intro h
    exact (hasDistance_iff p).mpr (detectsRaw_of_equivalent' hE ((hasDistance_iff q).mp h))

theorem hasDistance_of_equivalent {p q : Fin 2 → SS.State n ℂ} (hE : Equivalent p q)
    (h : SS.HasDistance p 3) : SS.HasDistance q 3 :=
  (hasDistance_iff_of_equivalent hE).mp h

end

end SixQubit.CodeEquiv
