              alpha ≠ beta → Disjoint (PhaseSectorFull.sectorSupport D alpha) (PhaseSectorFull.sectorSupport D beta)) ∧
            (∀ (alpha : Fin t),
                ∀ x ∈ PhaseSectorFull.sectorSupport D alpha, ∃ k, RealGate.angle theta x - D.phase alpha = ↑k) ∧
              ∃ mu, ∀ (alpha : Fin t) (j : Fin n), PhaseSectorFull.sectorMean D alpha j = mu j
