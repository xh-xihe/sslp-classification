@ColoredBound.quantitative_colored_finite_lift : ∀ {n t : ℕ} {theta : Fin n → ℝ} {B : ℕ},
  BinaryBeta.BetaBound (n + t - 1) B →
    ∀ (D : PhaseSectorFull.SectorDecomposition n t theta),
      PhaseSectorFull.ZDetects D →
        2 ≤ t →
          ∃ L,
            2 ≤ L.order ∧
              (FiniteLift.SameProjectiveSectorAction D fun j => ↑(L.physical j)) ∧
                (∀ (j : Fin n), ↑L.order * L.physical j = ↑(L.numerator j)) ∧
                  (∀ (e : ℕ), e ∣ L.order → (∀ (j : Fin n), ↑e ∣ L.numerator j) → e = 1) ∧
                    (∀ (alpha : Fin t), ∃ b, ↑L.order * (D.phase alpha - D.phase (FiniteLift.baseSector D)) = ↑b) ∧
                      L.order ≤ B
@ConnectedOrthogonality.exists_line : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E]
  {V : Type u_2} {W : Type u_3} [FiniteDimensional ℂ E],
  Module.finrank ℂ E = 2 →
    ∀ (c : V → E) (d : W → E) (adj : V → W → Prop),
      (∀ (x : V), c x ≠ 0) →
        (∀ (y : W), d y ≠ 0) →
          (∀ (x : V) (y : W), adj x y → inner ℂ (c x) (d y) = 0) →
            ∀ (x0 : V),
              (∀ (x : V), Relation.ReflTransGen (fun a b => ∃ y, adj a y ∧ adj b y) x0 x) →
                (∀ (y : W), ∃ x, adj x y) → ∃ L, Module.finrank ℂ ↥L = 1 ∧ (∀ (x : V), c x ∈ L) ∧ ∀ (y : W), d y ∈ Lᗮ
@FiniteLift.quantitative_colored_finite_lift : ∀ {n t : ℕ} {theta : Fin n → ℝ} {s : Type u_1} [inst : Fintype s]
  [inst_1 : DecidableEq s] (D : PhaseSectorFull.SectorDecomposition n t theta) (hZ : PhaseSectorFull.ZDetects D),
  2 ≤ t →
    ∀ (P : FiniteLift.PivotData D s) (hdet : P.matrix.det ≠ 0),
      have L := P.rationalLift hdet hZ;
      2 ≤ L.order ∧
        (FiniteLift.SameProjectiveSectorAction D fun j => ↑(L.physical j)) ∧
          (∀ (j : Fin n), ↑L.order * L.physical j = ↑(L.numerator j)) ∧
            (∀ (d : ℕ), d ∣ L.order → (∀ (j : Fin n), ↑d ∣ L.numerator j) → d = 1) ∧
              (∀ (alpha : Fin t) (x : FiniteLift.SupportIndex D alpha),
                  ∃ k,
                    RealGate.angle (fun j => ↑(L.physical j)) ↑x -
                          RealGate.angle (fun j => ↑(L.physical j)) (FiniteLift.basePoint D) -
                        (D.phase alpha - D.phase (FiniteLift.baseSector D)) =
                      ↑k) ∧
                (∀ (alpha : Fin t), ∃ b, ↑L.order * (D.phase alpha - D.phase (FiniteLift.baseSector D)) = ↑b) ∧
                  L.order ∣ SharpClearing.inverseDenominator P.matrix
