@SharpSectorZDetection.exists_minimal_primitiveLift_le_betaOf_sectorCount : ∀ {n K d : ℕ}
  (C : CodeSpec.ExactCode n K d),
  ZDetection.ZDetectsFrame C.frame →
    ∀ (v : ↥(ClassificationLevels.diagonalSymmetryGroup (GlobalClassificationBridge.exactCodeProjector C)))
      (theta : Fin n → ℝ),
      (∀ (j : Fin n), Complex.exp (2 * ↑Real.pi * Complex.I * ↑(theta j)) = ↑(↑v j)) →
        ∀ (hpres : CodeSpec.CodePreserving C.frame (PhaseSectorBridge.realGateEnd theta)),
          ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v ≠ 1 →
            ∃ qmin,
              GeneralLiftOrder.HasPrimitiveLift C
                  (ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v) qmin ∧
                (∀ (q : ℕ),
                    GeneralLiftOrder.HasPrimitiveLift C
                        (ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v) q →
                      qmin ≤ q) ∧
                  orderOf (ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v) ∣
                      qmin ∧
                    2 ≤
                        orderOf
                          (ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v) ∧
                      orderOf
                            (ClassificationLevels.intrinsicClass (GlobalClassificationBridge.exactCodeProjector C) v) ≤
                          qmin ∧
                        2 ≤ qmin ∧ qmin ≤ BetaExists.betaOf (n + GeneralSpectral.sectorCount hpres - 1)
