    (∀ (alpha : Fin t) (x : SS.BitString n), 0 ≤ PhaseSectorFull.sectorProbability D alpha x) ∧
      (∀ (alpha : Fin t), ∑ x, PhaseSectorFull.sectorProbability D alpha x = 1) ∧
        (∀ (alpha : Fin t), (PhaseSectorFull.sectorSupport D alpha).Nonempty) ∧
