@Orbit26.anchor_singular : ∀ {C D : Fin 3 → Orbit26.M2} {C3 D3 : Orbit26.M2},
  (∀ (g : Fin 3), Matrix.conjTranspose C3 * D g + (Matrix.conjTranspose (C g) * D3).transpose = 0) →
    (∀ (g h : Fin 3),
        g ≠ h →
          Orbit26.cj (C g) * Orbit26.Jmat * Matrix.transpose (D h) +
              Orbit26.cj (C h) * Orbit26.Jmat * Matrix.transpose (D g) =
            0) →
      ∑ g, C g * Matrix.conjTranspose (C g) = C3 * Matrix.conjTranspose C3 + 2 • (D3 * Matrix.conjTranspose D3) →
        ∑ g, D g * Matrix.conjTranspose (D g) = D3 * Matrix.conjTranspose D3 + 2 • (C3 * Matrix.conjTranspose C3) →
          (∀ (g : Fin 3), C g ≠ 0) →
            (∀ (g : Fin 3), D g ≠ 0) →
              (∃ g, ¬(C g 0 0 = 0 ∧ C g 1 0 = 0) ∧ ¬(C g 0 1 = 0 ∧ C g 1 1 = 0)) →
                (∃ g, ¬(D g 0 0 = 0 ∧ D g 1 0 = 0) ∧ ¬(D g 0 1 = 0 ∧ D g 1 1 = 0)) →
                  (¬IsUnit (Matrix.det D3) →
                      ∃ d,
                        ∑ i, Complex.normSq (d i) = 1 ∧
                          D3 * Matrix.conjTranspose D3 = (1 / 4) • Matrix.vecMulVec d (star d)) →
                    (¬IsUnit (Matrix.det C3) →
                        ∃ d,
                          ∑ i, Complex.normSq (d i) = 1 ∧
                            C3 * Matrix.conjTranspose C3 = (1 / 4) • Matrix.vecMulVec d (star d)) →
                      (∀ (w : Fin 2 → ℂ),
                          ∑ i, Complex.normSq (w i) = 1 →
                            ∀ (g : Fin 3),
                              Complex.normSq (Matrix.vecMul w (Orbit26.cj (C g)) 0) +
                                  Complex.normSq (Matrix.vecMul w (Orbit26.cj (C g)) 1) ≤
                                1 / 4) →
                        (∀ (w : Fin 2 → ℂ),
                            ∑ i, Complex.normSq (w i) = 1 →
                              ∀ (g : Fin 3),
                                Complex.normSq (Matrix.vecMul w (Orbit26.cj (D g)) 0) +
                                    Complex.normSq (Matrix.vecMul w (Orbit26.cj (D g)) 1) ≤
                                  1 / 4) →
                          (∀ (w : Fin 2 → ℂ),
                              ∑ i, Complex.normSq (w i) = 1 →
                                ∀ (j : Fin 2),
                                  Complex.normSq (Matrix.vecMul w (Orbit26.cj (C 0)) j) +
                                        Complex.normSq (Matrix.vecMul w (Orbit26.cj (C 1)) j) +
                                      Complex.normSq (Matrix.vecMul w (Orbit26.cj (C 2)) j) ≤
                                    3 / 8) →
                            (∀ (w : Fin 2 → ℂ),
                                ∑ i, Complex.normSq (w i) = 1 →
                                  ∀ (j : Fin 2),
                                    Complex.normSq (Matrix.vecMul w (Orbit26.cj (D 0)) j) +
                                          Complex.normSq (Matrix.vecMul w (Orbit26.cj (D 1)) j) +
                                        Complex.normSq (Matrix.vecMul w (Orbit26.cj (D 2)) j) ≤
                                      3 / 8) →
                              ¬IsUnit (Matrix.det C3) ∧ ¬IsUnit (Matrix.det D3)
