@PaperGeneralSSLP.general_sslp_normal_form : ∀ {n K d : ℕ} (C : CodeSpec.ExactCode n K d),
  2 ≤ d →
    ∀ (g : GlobalClassificationBridge.IntrinsicGroup C),
      g ≠ 1 →
        ∃ q m t,
          ∃ (hq : NeZero q) (hm : NeZero m),
            ∃ T S x0 sigma,
              T.intrinsic = g ∧
                m = orderOf g ∧
                  2 ≤ m ∧
                    2 ≤ q ∧
                      m ∣ q ∧
                        (∀ (j : Fin K) (s : SS.BitString n),
                            S.frame.vec j s = T.frame.vec j (SS.bxor (CodeEquiv.permStr sigma s) x0)) ∧
                          S.angle = PermutationSemanticTransport.permAngle sigma (Normalize.flip T.angle x0) ∧
                            (Monotone fun j => (S.angle j).val) ∧
                              Gate.Primitive q S.angle ∧
                                S.color S.base = 0 ∧
                                  Function.Injective S.color ∧
                                    Gate.Primitive m S.color ∧
                                      ∑ alpha, S.rank alpha = K ∧
                                        (∀ (alpha : Fin t),
                                            Module.finrank ℂ
                                                ↥(GeneralColoredSubspaces.ColoredFrame.sectorSpace S alpha) =
                                              S.rank alpha) ∧
                                          (∀ (alpha : Fin t),
                                              GeneralColoredSubspaces.ColoredFrame.sectorSpace S alpha ≤
                                                GeneralColoredSubspaces.fiberSubspace S.angle
                                                  (ColoredResidueArithmetic.scaledColor q (S.color alpha))) ∧
                                            ⨆ alpha, GeneralColoredSubspaces.ColoredFrame.sectorSpace S alpha =
                                                CodeSpec.codeSpan S.frame ∧
                                              SS.HasDistance S.frame.vec d
@PaperGeneralSSLP.rank_two_sslp : ∀ {n d : ℕ} (C : CodeSpec.ExactCode n 2 d),
  2 ≤ d →
    (∃ g, g ≠ 1) →
      IsCyclic
          (ClassificationLevels.IntrinsicProjectiveDiagonalLogicalGroup
            (ClassificationLevels.CodeProjector.ofFrame C.frame)) ∧
        Finite (GlobalClassificationBridge.IntrinsicGroup C) ∧
          ∃ S,
            S.m = Nat.card (GlobalClassificationBridge.IntrinsicGroup C) ∧
              2 ≤ S.q ∧
                2 ≤ S.m ∧
                  S.m ∣ S.q ∧
                    (Monotone fun j => (S.angle j).val) ∧
                      (∀ (j : Fin n), (S.angle j).val < S.q) ∧
                        Gate.Primitive S.q S.angle ∧
                          SS.SSConditionState S.angle 0 (S.frame.vec 0) ∧
                            SS.SSConditionState S.angle (↑(S.q / S.m)) (S.frame.vec 1) ∧
                              SS.HasDistance S.frame.vec d ∧
                                CodeSpec.codeSpan C.frame = CodeSpec.codeSpan S.source ∧
                                  ∀ (k : Fin 2) (s : SS.BitString n),
                                    S.frame.vec k s = S.source.vec k (SS.bxor (CodeEquiv.permStr S.perm s) S.x0)
@PaperGeneralSSLP.rank_two_sslp_converse : ∀ {n d q m : ℕ} [NeZero q] {zeta : ℂ},
  IsPrimitiveRoot zeta q →
    ∀ {a : Fin n → ZMod q},
      Gate.Primitive q a →
        m ∣ q →
          2 ≤ m →
            ∀ (F : CodeSpec.OrthonormalFrame n 2),
              SS.HasDistance F.vec d →
                SS.SSConditionState a 0 (F.vec 0) →
                  SS.SSConditionState a (↑(q / m)) (F.vec 1) → ∃ C g, C.frame = F ∧ orderOf g = m ∧ g ≠ 1
