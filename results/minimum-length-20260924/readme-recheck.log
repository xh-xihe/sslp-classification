@SectionTwoGeneral.phaseSectors : ∀ {n K d : ℕ} (C : CodeSpec.ExactCode n K d),
  2 ≤ d →
    ∀ (theta : Fin n → ℝ) (hpres : CodeSpec.CodePreserving C.frame (PhaseSectorBridge.realGateEnd theta)),
      (∀ (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount) (x : SS.BitString n),
          0 ≤ PhaseSectorFull.sectorProbability (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha x) ∧
        (∀ (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount),
            ∑ x, PhaseSectorFull.sectorProbability (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha x = 1) ∧
          (∀ (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount),
              (PhaseSectorFull.sectorSupport (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha).Nonempty) ∧
            (∀ (alpha beta : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount),
                alpha ≠ beta →
                  Disjoint (PhaseSectorFull.sectorSupport (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha)
                    (PhaseSectorFull.sectorSupport (SectionTwoGeneral.resolutionOf C theta hpres).sectors beta)) ∧
              (∀ (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount),
                  ∀ x ∈ PhaseSectorFull.sectorSupport (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha,
                    ∃ k,
                      RealGate.angle theta x - (SectionTwoGeneral.resolutionOf C theta hpres).sectors.phase alpha =
                        ↑k) ∧
                ∃ mu,
                  ∀ (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount) (j : Fin n),
                    PhaseSectorFull.sectorMean (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha j = mu j
@SectionTwoGeneral.phaseSectors_mean : ∀ {n K d : ℕ} (C : CodeSpec.ExactCode n K d) (hd : 2 ≤ d) (theta : Fin n → ℝ)
  (hpres : CodeSpec.CodePreserving C.frame (PhaseSectorBridge.realGateEnd theta))
  (alpha : Fin (SectionTwoGeneral.resolutionOf C theta hpres).sectorCount) (j : Fin n),
  ↑(PhaseSectorFull.sectorMean (SectionTwoGeneral.resolutionOf C theta hpres).sectors alpha j) =
    (1 - SectorMeanValue.klScalar (SectionTwoGeneral.resolutionOf C theta hpres).sectors ⋯ j) / 2
