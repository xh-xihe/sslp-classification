import MainTheory.D3LogicalCoordinateUnitary

/-!
# The orthogonal complement in complex dimension two

This file proves the elementary two-coordinate fact needed for the second
logical eigenvector: if `v` is nonzero, every vector Hermitian-orthogonal to
`v` is a scalar multiple of the explicit vector
`![-star (v 1), star (v 0)]`.
-/

namespace MainTheory.D3LogicalPerpSpan

open MainTheory
open MainTheory.D3LogicalCoordinateUnitary
open scoped BigOperators ComplexConjugate

noncomputable section

/-- The coordinate inner-product equation written without a finite sum. -/
theorem coordinateInner_eq_zero_iff_explicit (v z : Fin 2 → ℂ) :
    coordinateInner v z = 0 ↔
      star (v 0) * z 0 + star (v 1) * z 1 = 0 := by
  simp [coordinateInner, Fin.sum_univ_two]

/-- The orthogonal complement of a nonzero vector in `ℂ²` is precisely the
line generated by its explicit perpendicular vector. -/
theorem eq_smul_perpendicular_of_coordinateInner_eq_zero
    {v z : Fin 2 → ℂ} (hv : v ≠ 0) (horth : coordinateInner v z = 0) :
    ∃ c : ℂ, z = c • perpendicular v := by
  have horth' : star (v 0) * z 0 + star (v 1) * z 1 = 0 :=
    (coordinateInner_eq_zero_iff_explicit v z).1 horth
  by_cases h0 : v 0 = 0
  · have h1 : v 1 ≠ 0 := by
      intro h1
      apply hv
      funext i
      fin_cases i
      · exact h0
      · exact h1
    have hs1 : star (v 1) ≠ 0 := by
      intro hs
      exact h1 (star_eq_zero.mp hs)
    have hz1 : z 1 = 0 := by
      have h := horth'
      rw [h0] at h
      simp at h
      exact h.resolve_left h1
    refine ⟨-(z 0 / star (v 1)), ?_⟩
    funext i
    fin_cases i
    · change z 0 = -(z 0 / star (v 1)) * (-star (v 1))
      symm
      calc
        -(z 0 / star (v 1)) * (-star (v 1)) =
            (z 0 / star (v 1)) * star (v 1) := by ring
        _ = z 0 := div_mul_cancel₀ _ hs1
    · change z 1 = -(z 0 / star (v 1)) * star (v 0)
      rw [hz1, h0]
      simp
  · have hs0 : star (v 0) ≠ 0 := by
      intro hs
      exact h0 (star_eq_zero.mp hs)
    have heq : star (v 0) * z 0 = -(star (v 1) * z 1) := by
      linear_combination horth'
    have hcancel : star (v 0) * (z 1 / star (v 0)) = z 1 := by
      rw [mul_comm, div_mul_cancel₀ _ hs0]
    refine ⟨z 1 / star (v 0), ?_⟩
    funext i
    fin_cases i
    · change z 0 = (z 1 / star (v 0)) * (-star (v 1))
      apply mul_left_cancel₀ hs0
      calc
        star (v 0) * z 0 = -(star (v 1) * z 1) := heq
        _ = z 1 * (-star (v 1)) := by ring
        _ = star (v 0) *
            ((z 1 / star (v 0)) * (-star (v 1))) := by
          rw [← mul_assoc, hcancel]
    · change z 1 = (z 1 / star (v 0)) * star (v 0)
      symm
      exact div_mul_cancel₀ _ hs0

end

end MainTheory.D3LogicalPerpSpan
