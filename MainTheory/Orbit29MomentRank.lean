def actualMatrix : Matrix (Fin 23) (Fin 30) ℤ := fun i j =>
  if i.val=0 then (if j.val<14 then 1 else 0) else
  if i.val=1 then (if j.val<14 then 0 else 1) else
  let x := if h : j.val<14 then MainTheory.Orbit29MomentRank.Orbit29.bottom ⟨j.val,h⟩
    else MainTheory.Orbit29MomentRank.Orbit29.top ⟨j.val-14,by omega⟩
  let sign : ℤ := if j.val<14 then 1 else -1
  if h : i.val<8 then sign*(if x ⟨i.val-2,by omega⟩ then 1 else 0) else
    let pair := coordinatePairs ⟨i.val-8,by omega⟩
    sign*(if x pair.1 then 1 else 0)*(if x pair.2 then 1 else 0)
