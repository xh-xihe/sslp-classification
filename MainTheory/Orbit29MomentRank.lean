theorem real_determinant : minorR.det=-384 := by
  rw [real_cast]
  change ((Rat.castHom ℝ).mapMatrix minorQ).det=-384
  rw [← RingHom.map_det]
  change (minorQ.det : ℝ)=-384
  exact_mod_cast determinant
theorem real_rank_factorization : matrixR=
