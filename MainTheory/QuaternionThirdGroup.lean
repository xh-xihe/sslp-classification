import MainTheory.QuaternionThirdPair
import MainTheory.QuaternionRationalNormalizer
import MainTheory.QuaternionConjugatedSubgroup

/-! A common Pauli frame generated by two nonparallel third-turns. -/

namespace MainTheory.QuaternionThirdGroup

noncomputable section

open Quaternion MainTheory.QuaternionAxisFrames MainTheory.QuaternionOrthogonalFrame
  MainTheory.QuaternionAxisGeometry MainTheory.QuaternionCliffordAxes
  MainTheory.QuaternionAxisAngles MainTheory.QuaternionRationalNormalizer
  MainTheory.QuaternionThirdPair MainTheory.QuaternionQuarterPair
  MainTheory.QuaternionConjugatedSubgroup

def NoQuarter (G : Subgroup (unitary ℍ[ℝ])) : Prop :=
  ∀ g∈G,AllowedWithoutQuarter g.val.re

theorem noQuarter_rotated (G : Subgroup (unitary ℍ[ℝ])) (u : unitary ℍ[ℝ])
    (hG : NoQuarter G) : NoQuarter (rotated G u) := by
  rintro g ⟨v,hv,rfl⟩
  change AllowedWithoutQuarter (conjugate u v).val.re
  rw [conjugate_re]
  exact hG v hv

theorem pauli_frame (G : Subgroup (unitary ℍ[ℝ])) (hG : NoQuarter G)
    (hI : axisI∈G) (hJ : axisJ∈G) : ∀ g∈G,Normalizes g := by
  intro g hg
  have hK : axisK∈G := basis_products.1 ▸ G.mul_mem hI hJ
  have hb := hG (axisI*g) (G.mul_mem hI hg)
  have hc := hG (axisJ*g) (G.mul_mem hJ hg)
  have hd := hG (axisK*g) (G.mul_mem hK hg)
  change AllowedWithoutQuarter (axisI.val*g.val).re at hb
  change AllowedWithoutQuarter (axisJ.val*g.val).re at hc
  change AllowedWithoutQuarter (axisK.val*g.val).re at hd
  apply rational_normalizes g (hG g hg)
  · simpa [AllowedWithoutQuarter,axisI] using hb
  · simpa [AllowedWithoutQuarter,axisJ] using hc
  · simpa [AllowedWithoutQuarter,axisK] using hd

theorem third_pair_frame (G : Subgroup (unitary ℍ[ℝ])) (hG : NoQuarter G)
    (q p : unitary ℍ[ℝ]) (hq : q∈G) (hp : p∈G)
    (hqre : q.val.re=1/2) (hpre : p.val.re=1/2)
    (hd : imaginaryDot q.val p.val= -1/4) :
    ∃ u : unitary ℍ[ℝ],∀ g∈G,Normalizes (conjugate u g) := by
  obtain ⟨hs,ht,ha⟩ := perpendicular_pair q p hqre hpre hd
  obtain ⟨u,huI,huJ⟩ := ordered_frame (q*p⁻¹) (conjugate q (q*p⁻¹)) hs ht ha
  have hqp : q*p⁻¹∈G := G.mul_mem hq (G.inv_mem hp)
  have hi : axisI∈rotated G u := huI ▸ rotated_mem G u _ hqp
  have hj : axisJ∈rotated G u := huJ ▸ rotated_mem G u _ (conjugate_mem G q _ hq hqp)
  refine ⟨u,?_⟩
  intro g hg
  exact pauli_frame (rotated G u) (noQuarter_rotated G u hG) hi hj _ (rotated_mem G u g hg)

end

end MainTheory.QuaternionThirdGroup
