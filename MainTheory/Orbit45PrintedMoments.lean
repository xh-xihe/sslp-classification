theorem bounds (p : Sum (Fin 10) (Fin 10) → ℝ) (H : Feasible bottom top p) :
    0 ≤ p (Sum.inl 3) ∧ p (Sum.inl 3) ≤ 1/4 ∧
    0 ≤ p (Sum.inl 1) ∧ 0 ≤ p (Sum.inl 0) ∧
    p (Sum.inl 1) + p (Sum.inl 0) ≤ 1/4 := by
  have h4 := congrFun (probabilities p H).1 4
  have h2 := congrFun (probabilities p H).1 2
  change p (Sum.inl 4) = 1/4-p (Sum.inl 3) at h4
  change p (Sum.inl 2) = 1/4-p (Sum.inl 1)-p (Sum.inl 0) at h2
  have hn4 := H.nonneg (Sum.inl 4)
  have hn2 := H.nonneg (Sum.inl 2)
  exact ⟨H.nonneg (Sum.inl 3),by linarith,H.nonneg (Sum.inl 1),
    H.nonneg (Sum.inl 0),by linarith⟩

