theorem owner_bound : ∀ r : Fin 528,ownerTable[r.val]?.getD 0<111 := by decide +kernel

def owner (r : Fin 528) : Fin 111 := ⟨ownerTable[r.val]?.getD 0,owner_bound r⟩

theorem slot_bound : ∀ r : Fin 528,slotTable[r.val]?.getD 0<(checkedBlocks (owner r)).n := by
  decide +kernel

def index (r : Fin 528) : Fin (checkedBlocks (owner r)).n :=
  ⟨slotTable[r.val]?.getD 0,slot_bound r⟩

theorem covered : ∀ r : Fin 528,Remaining r → (checkedBlocks (owner r)).indices (index r)=r := by
  decide +kernel

theorem unique : ∀ b : Fin 111,∀ i : Fin (checkedBlocks b).n,
    Remaining ((checkedBlocks b).indices i) ∧
      owner ((checkedBlocks b).indices i)=b ∧
      (index ((checkedBlocks b).indices i)).val=i.val := by
  decide +kernel

def coordinates : (Σ b : Fin 111,Fin (checkedBlocks b).n) ≃ {r : Fin 528 // Remaining r} where
  toFun p := ⟨(checkedBlocks p.1).indices p.2,(unique p.1 p.2).1⟩
  invFun r := ⟨owner r.val,index r.val⟩
  left_inv := by
    rintro ⟨b,i⟩
    have hb := (unique b i).2.1
    apply Sigma.ext hb
    apply (Fin.heq_ext_iff (congrArg (fun b => (checkedBlocks b).n) hb)).mpr
    exact (unique b i).2.2
  right_inv := by
    intro r
    apply Subtype.ext
    exact covered r.val r.property

theorem remaining_cardinality : (Finset.univ.filter Remaining).card=492 := by decide +kernel

theorem zero_cardinality : (Finset.univ.filter fun r => ¬Remaining r).card=36 := by decide +kernel

theorem family_mass (z : Fin 528 → ℂ) :
    familyMass checkedBlocks z=∑ r : Fin 528,if Remaining r then Complex.normSq (z r) else 0 := by
  have he := Equiv.sum_comp coordinates (fun r => Complex.normSq (z r.val))
  rw [Fintype.sum_sigma] at he
  change familyMass checkedBlocks z=_ at he
  rw [he]
  classical
  rw [← Finset.sum_filter]
  simpa using (Finset.sum_subtype_eq_sum_filter (s := Finset.univ) (p := Remaining)
    (fun r => Complex.normSq (z r)))

theorem coercivity (t : Fin 32 → ℂ) :
    (1/3 : ℝ)*(∑ r : Fin 528,if Remaining r then
      Complex.normSq (t (monomials r).1*t (monomials r).2) else 0)≤
        (orderedPolynomial rawCoefficient t).re/24 := by
  rw [orderedPolynomial_eq_fullEnergy,fullCoefficientEnergy_eq_certificate]
  have h := family_coercivity checkedBlocks (quadraticMonomials t)
  rw [family_mass] at h
  exact h

end

