{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit36CrossRelations.all_pair_and_star_relations\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ x ∉ SixQubit.Orbit36.S0, c x = 0) →\\n    (∀ x ∉ SixQubit.Orbit36.S1, d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        Star.star (c SixQubit.Orbit36.y6) * d SixQubit.Orbit36.z3 =\\n            Star.star (c SixQubit.Orbit36.y3) * d SixQubit.Orbit36.z6 ∧\\n          Star.star (c SixQubit.Orbit36.y7) * d SixQubit.Orbit36.z4 =\\n              Star.star (c SixQubit.Orbit36.y4) * d SixQubit.Orbit36.z7 ∧\\n            Star.star (c SixQubit.Orbit36.y8) * d SixQubit.Orbit36.z5 =\\n                Star.star (c SixQubit.Orbit36.y5) * d SixQubit.Orbit36.z8 ∧\\n              Star.star (c SixQubit.Orbit36.y6) * d SixQubit.Orbit36.z2 =\\n                  Star.star (c SixQubit.Orbit36.y2) * d SixQubit.Orbit36.z6 ∧\\n                Star.star (c SixQubit.Orbit36.y9) * d SixQubit.Orbit36.z4 =\\n                    Star.star (c SixQubit.Orbit36.y4) * d SixQubit.Orbit36.z9 ∧\\n                  Star.star (c SixQubit.Orbit36.y10) * d SixQubit.Orbit36.z5 =\\n                      Star.star (c SixQubit.Orbit36.y5) * d SixQubit.Orbit36.z10 ∧\\n                    Star.star (c SixQubit.Orbit36.y7) * d SixQubit.Orbit36.z2 =\\n                        Star.star (c SixQubit.Orbit36.y2) * d SixQubit.Orbit36.z7 ∧\\n                      Star.star (c SixQubit.Orbit36.y9) * d SixQubit.Orbit36.z3 =\\n                          Star.star (c SixQubit.Orbit36.y3) * d SixQubit.Orbit36.z9 ∧\\n                        Star.star (c SixQubit.Orbit36.y11) * d SixQubit.Orbit36.z5 =\\n                            Star.star (c SixQubit.Orbit36.y5) * d SixQubit.Orbit36.z11 ∧\\n                          Star.star (c SixQubit.Orbit36.y8) * d SixQubit.Orbit36.z2 =\\n                              Star.star (c SixQubit.Orbit36.y2) * d SixQubit.Orbit36.z8 ∧\\n                            Star.star (c SixQubit.Orbit36.y10) * d SixQubit.Orbit36.z3 =\\n                                Star.star (c SixQubit.Orbit36.y3) * d SixQubit.Orbit36.z10 ∧\\n                              Star.star (c SixQubit.Orbit36.y11) * d SixQubit.Orbit36.z4 =\\n                                  Star.star (c SixQubit.Orbit36.y4) * d SixQubit.Orbit36.z11 ∧\\n                                Star.star (c SixQubit.Orbit36.y6) * d SixQubit.Orbit36.z3 +\\n                                        Star.star (c SixQubit.Orbit36.y7) * d SixQubit.Orbit36.z4 +\\n                                      Star.star (c SixQubit.Orbit36.y8) * d SixQubit.Orbit36.z5 =\\n                                    0 ∧\\n                                  Star.star (c SixQubit.Orbit36.y6) * d SixQubit.Orbit36.z2 +\\n                                          Star.star (c SixQubit.Orbit36.y9) * d SixQubit.Orbit36.z4 +\\n                                        Star.star (c SixQubit.Orbit36.y10) * d SixQubit.Orbit36.z5 =\\n                                      0 ∧\\n                                    Star.star (c SixQubit.Orbit36.y7) * d SixQubit.Orbit36.z2 +\\n                                            Star.star (c SixQubit.Orbit36.y9) * d SixQubit.Orbit36.z3 +\\n                                          Star.star (c SixQubit.Orbit36.y11) * d SixQubit.Orbit36.z5 =\\n                                        0 ∧\\n                                      Star.star (c SixQubit.Orbit36.y8) * d SixQubit.Orbit36.z2 +\\n                                            Star.star (c SixQubit.Orbit36.y10) * d SixQubit.Orbit36.z3 +\\n                                          Star.star (c SixQubit.Orbit36.y11) * d SixQubit.Orbit36.z4 =\\n                                        0\"}","endPos":{"column":1,"line":1097},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1064},"severity":"information"}
