{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MinimumLengthOrderFive.canonical_attains\",\"type\":\"∃ U Q,\\n  (∀ (j : Fin 6), MainTheory.ClassificationLevels.IsOneQubitUnitary (U j)) ∧\\n    MainTheory.LocalTensorKernel.tensorKernel U *\\n          MainTheory.PauliKernelBTrace.frameMatrix MainTheory.MinimumLengthOrderFive.canonicalCode.frame =\\n        MainTheory.PauliKernelBTrace.frameMatrix MainTheory.MinimumLengthOrderFive.canonicalCode.frame * ↑Q ∧\\n      orderOf (MainTheory.UnitaryAdjointRepresentation.adjoint Q) = 5\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MinimumLengthOrderFive.minimum_length\",\"type\":\"∀ {n d : ℕ} (C : MainTheory.CodeSpec.ExactCode n 2 d),\\n  3 ≤ d →\\n    ∀ (U : Fin n → Matrix (Fin 2) (Fin 2) ℂ),\\n      (∀ (j : Fin n), MainTheory.ClassificationLevels.IsOneQubitUnitary (U j)) →\\n        ∀ (Q : ↥(Matrix.unitaryGroup (Fin 2) ℂ)),\\n          MainTheory.LocalTensorKernel.tensorKernel U * MainTheory.PauliKernelBTrace.frameMatrix C.frame =\\n              MainTheory.PauliKernelBTrace.frameMatrix C.frame * ↑Q →\\n            orderOf (MainTheory.UnitaryAdjointRepresentation.adjoint Q) = 5 → 6 ≤ n\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MinimumLengthOrderFive.six_qubit_lu_unique_of_distance_ge_three\",\"type\":\"∀ {d : ℕ} (C : MainTheory.CodeSpec.ExactCode 6 2 d),\\n  3 ≤ d →\\n    ∀ (U : Fin 6 → Matrix (Fin 2) (Fin 2) ℂ),\\n      (∀ (j : Fin 6), MainTheory.ClassificationLevels.IsOneQubitUnitary (U j)) →\\n        ∀ (Q : ↥(Matrix.unitaryGroup (Fin 2) ℂ)),\\n          MainTheory.LocalTensorKernel.tensorKernel U * MainTheory.PauliKernelBTrace.frameMatrix C.frame =\\n              MainTheory.PauliKernelBTrace.frameMatrix C.frame * ↑Q →\\n            orderOf (MainTheory.UnitaryAdjointRepresentation.adjoint Q) = 5 →\\n              MainTheory.ClassificationLevels.LUEquivalent\\n                (MainTheory.ClassificationLevels.CodeProjector.ofFrame C.frame)\\n                (MainTheory.ClassificationLevels.CodeProjector.ofFrame MainTheory.Orbit36LUBridge.canonicalFrame)\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MomentConvexHull.exists_feasible_iff_convexHull_inter\",\"type\":\"∀ {I₀ : Type u_2} {I₁ : Type u_3} [inst : Fintype I₀] [inst_1 : Fintype I₁]\\n  (x₀ : I₀ → MainTheory.MomentPolytope.BitPoint6) (x₁ : I₁ → MainTheory.MomentPolytope.BitPoint6),\\n  (∃ p, MainTheory.MomentPolytope.Feasible x₀ x₁ p) ↔\\n    ((convexHull ℝ) (Set.range fun i => MainTheory.MomentConvexHull.momentVec (x₀ i)) ∩\\n        (convexHull ℝ) (Set.range fun i => MainTheory.MomentConvexHull.momentVec (x₁ i))).Nonempty\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MomentMatrix23.exact_rational_iff_real\",\"type\":\"∀ {I : Type u_1} {J : Type u_2} [inst : Fintype I] [inst_1 : Fintype J] (left : I → MainTheory.FinitePipeline.Word6)\\n  (right : J → MainTheory.FinitePipeline.Word6),\\n  (∃ p,\\n      MainTheory.ExactLP.Feasible (MainTheory.MomentMatrix23.matrixQ left right) MainTheory.FiniteMomentMatrix.rhsQ p) ↔\\n    ∃ p,\\n      MainTheory.ExactLP.RealFeasible (MainTheory.MomentMatrix23.matrixQ left right) MainTheory.FiniteMomentMatrix.rhsQ\\n        p\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MomentMatrix23.feasible_iff\",\"type\":\"∀ {I : Type u_1} {J : Type u_2} [inst : Fintype I] [inst_1 : Fintype J] (left : I → MainTheory.FinitePipeline.Word6)\\n  (right : J → MainTheory.FinitePipeline.Word6) (p : I ⊕ J → ℚ),\\n  MainTheory.ExactLP.Feasible (MainTheory.MomentMatrix23.matrixQ left right) MainTheory.FiniteMomentMatrix.rhsQ p ↔\\n    (∀ (z : I ⊕ J), 0 ≤ p z) ∧\\n      ∑ i, p (Sum.inl i) = 1 ∧\\n        ∑ j, p (Sum.inr j) = 1 ∧\\n          ∀ (i : Fin 21),\\n            ∑ x, p (Sum.inl x) * MainTheory.FinitePipeline.feature (left x) i =\\n              ∑ y, p (Sum.inr y) * MainTheory.FinitePipeline.feature (right y) i\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.MomentPolytope.maximum_support_rank_and_threshold\",\"type\":\"∀ {I₀ : Type u_1} {I₁ : Type u_2} [inst : Fintype I₀] [inst_1 : Fintype I₁] [Nonempty I₁]\\n  (x₀ : I₀ → MainTheory.MomentPolytope.BitPoint6) (x₁ : I₁ → MainTheory.MomentPolytope.BitPoint6),\\n  (MainTheory.MomentPolytope.momentPolytope x₀ x₁).Nonempty →\\n    ∀ (rmin : ℕ),\\n      ((MainTheory.ActiveFace.activeAffineRankLeft (MainTheory.MomentPolytope.momentPolytope x₀ x₁) fun i =>\\n            MainTheory.MomentPolytope.coord (x₀ i)) =\\n          MainTheory.ActiveFace.activeAffineRankRight (MainTheory.MomentPolytope.momentPolytope x₀ x₁) fun i =>\\n            MainTheory.MomentPolytope.coord (x₁ i)) ∧\\n        ((∃ p ∈ MainTheory.MomentPolytope.momentPolytope x₀ x₁,\\n            rmin ≤\\n              MainTheory.ActiveFace.affineRank\\n                (MainTheory.ActiveFace.supportPointsLeft (fun i => MainTheory.MomentPolytope.coord (x₀ i)) p)) ↔\\n          rmin ≤\\n            MainTheory.ActiveFace.activeAffineRankLeft (MainTheory.MomentPolytope.momentPolytope x₀ x₁) fun i =>\\n              MainTheory.MomentPolytope.coord (x₀ i))\"}","endPos":{"column":1,"line":859},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":826},"severity":"information"}
