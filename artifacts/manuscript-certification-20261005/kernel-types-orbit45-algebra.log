{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.CommonMeanReplacement.average\",\"type\":\"∀ {n : ℕ} (T : Finset (SS.BitString n)) (p : SS.BitString n → ℝ) (h mu : Fin n → ℝ),\\n  (∀ (j : Fin n), ∑ x ∈ T, p x * QECC.bitReal (x j) = mu j) →\\n    ∑ x ∈ T, p x * QECC.realSupportWeight h x = MainTheory.CommonMeanReplacement.meanDot h mu\"}","endPos":{"column":1,"line":621},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":588},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.CommonMeanReplacement.replacement_on_direct_sum\",\"type\":\"∀ {n : ℕ} {ι : Type u_1} (T : ι → Finset (SS.BitString n)) (p : ι → SS.BitString n → ℝ)\\n  (E : ι → Submodule ℂ (SS.State n ℂ)),\\n  (∀ (i : ι), ∀ f ∈ E i, ∀ x ∉ T i, f x = 0) →\\n    ∀ (t delta mu : Fin n → ℝ),\\n      (∀ (i : ι), ∑ x ∈ T i, p i x = 1) →\\n        (∀ (i : ι) (j : Fin n), ∑ x ∈ T i, p i x * QECC.bitReal (x j) = mu j) →\\n          (∀ (i : ι), ∀ x ∈ T i, ∀ y ∈ T i, QECC.realSupportWeight delta x = QECC.realSupportWeight delta y) →\\n            ∀ f ∈ ⨆ i, E i,\\n              Matrix.mulVec (QECC.diagonalGate fun j => ↑(t j + delta j)) f =\\n                Complex.exp (2 * ↑Real.pi * Complex.I * ↑(MainTheory.CommonMeanReplacement.meanDot delta mu)) •\\n                  Matrix.mulVec (QECC.diagonalGate fun j => ↑(t j)) f\"}","endPos":{"column":1,"line":621},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":588},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.CommonMeanReplacement.replacement_on_supported_union\",\"type\":\"∀ {n : ℕ} {ι : Type u_1} (T : ι → Finset (SS.BitString n)) (p : ι → SS.BitString n → ℝ) (t delta mu : Fin n → ℝ),\\n  (∀ (i : ι), ∑ x ∈ T i, p i x = 1) →\\n    (∀ (i : ι) (j : Fin n), ∑ x ∈ T i, p i x * QECC.bitReal (x j) = mu j) →\\n      (∀ (i : ι), ∀ x ∈ T i, ∀ y ∈ T i, QECC.realSupportWeight delta x = QECC.realSupportWeight delta y) →\\n        ∀ f ∈ MainTheory.CommonMeanReplacement.supportedUnion T,\\n          Matrix.mulVec (QECC.diagonalGate fun j => ↑(t j + delta j)) f =\\n            Complex.exp (2 * ↑Real.pi * Complex.I * ↑(MainTheory.CommonMeanReplacement.meanDot delta mu)) •\\n              Matrix.mulVec (QECC.diagonalGate fun j => ↑(t j)) f\"}","endPos":{"column":1,"line":621},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":588},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.CommonMeanReplacement.support_value\",\"type\":\"∀ {n : ℕ} (T : Finset (SS.BitString n)) (p : SS.BitString n → ℝ) (h mu : Fin n → ℝ),\\n  ∑ x ∈ T, p x = 1 →\\n    (∀ (j : Fin n), ∑ x ∈ T, p x * QECC.bitReal (x j) = mu j) →\\n      (∀ x ∈ T, ∀ y ∈ T, QECC.realSupportWeight h x = QECC.realSupportWeight h y) →\\n        ∀ x ∈ T, QECC.realSupportWeight h x = MainTheory.CommonMeanReplacement.meanDot h mu\"}","endPos":{"column":1,"line":621},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":588},"severity":"information"}
