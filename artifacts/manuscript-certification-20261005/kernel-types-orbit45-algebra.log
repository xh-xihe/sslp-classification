{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.D_formula\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i : Fin 6), SixQubit.Orbit8Universal.D d i = 1 / 3 - 2 * SixQubit.Orbit8Universal.p d i\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.QP_eq\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (f : SS.BitString 6 → ℂ),\\n              SixQubit.Orbit8Universal.Qact (SixQubit.Orbit8Universal.u d) (SixQubit.Orbit8Universal.codeProj c d f) =\\n                fun x => 1 / 6 * SixQubit.Orbit8Universal.codeProj c d f x\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
