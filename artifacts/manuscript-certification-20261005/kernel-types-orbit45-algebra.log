{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3FreshSparseAssembly.angle_eq_on_common_actualSupports\",\"type\":\"∀ {n : ℕ} {c d : SS.State n ℂ} (B : MainTheory.SixQubitSemanticEntrance.SupportedBitBasis c),\\n  MainTheory.CodeAffineSpanBridge.CommonAffineSpanCertificate c d →\\n    ∀ (theta : Fin n → ℝ) (hintegral : MainTheory.D3FreshSparseAssembly.IntegralOnActualSupport c theta),\\n      (∀ x ∈ MainTheory.CodeAffineSpanBridge.actualSupport c,\\n          MainTheory.RealGate.angle (MainTheory.D3FreshSparseAssembly.sparseData B theta hintegral).fullSolutionReal x =\\n            MainTheory.RealGate.angle theta x) ∧\\n        ∀ x ∈ MainTheory.CodeAffineSpanBridge.actualSupport d,\\n          MainTheory.RealGate.angle (MainTheory.D3FreshSparseAssembly.sparseData B theta hintegral).fullSolutionReal x =\\n            MainTheory.RealGate.angle theta x\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3FreshSparseAssembly.originalPhase_solves\",\"type\":\"∀ {n : ℕ} {psi : SS.State n ℂ} (B : MainTheory.SixQubitSemanticEntrance.SupportedBitBasis psi) (theta : Fin n → ℝ)\\n  (hintegral : MainTheory.D3FreshSparseAssembly.IntegralOnActualSupport psi theta),\\n  ((MainTheory.D3FreshSparseAssembly.sparseData B theta hintegral).row.map ⇑(Int.castRingHom ℝ)).mulVec theta = fun i =>\\n    ↑((MainTheory.D3FreshSparseAssembly.sparseData B theta hintegral).rhs i)\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
