{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit28.incidence\",\"type\":\"{y ∈ SixQubit.Orbit28.S1 | SS.bxor y SixQubit.Orbit28.ef ∈ SixQubit.Orbit28.S0} =\\n  {SixQubit.Orbit28.z8, SixQubit.Orbit28.z9, SixQubit.Orbit28.z10, SixQubit.Orbit28.z11, SixQubit.Orbit28.z12,\\n    SixQubit.Orbit28.z13, SixQubit.Orbit28.z14, SixQubit.Orbit28.z15}\"}","endPos":{"column":1,"line":2831},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2798},"severity":"information"}
