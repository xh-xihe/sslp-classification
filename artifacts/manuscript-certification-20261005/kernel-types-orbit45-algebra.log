{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9EnumeratorDisplays.normalized_enumerators\",\"type\":\"∀ (psi : Fin 2 → SS.State 6 ℂ),\\n  SS.MacWilliams.IsE2A psi →\\n    SS.MacWilliams.IsE2B psi →\\n      (fun j => SS.MacWilliams.Aco psi ↑j / 4) = ![1, 0, 1, 0, 11, 16, 3] ∧\\n        (fun j => SS.MacWilliams.Bco psi ↑j / 4) = ![1, 0, 1, 24, 35, 40, 27]\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
