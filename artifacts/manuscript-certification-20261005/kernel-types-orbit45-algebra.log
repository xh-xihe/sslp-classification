{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"Orbit2.Encoder.mixed_compression_zero\",\"type\":\"∀ (V : Orbit2.Encoder) (p : Orbit2.TensorPauli.Label 2) (i a : Fin 4),\\n  (p ≠ fun x => 0) →\\n    a ≠ 0 →\\n      (∑ b, if p b = 0 then 0 else 1) ≤ 1 →\\n        V.tensorMatrix.conjTranspose * Orbit2.TensorPauli.operator (Orbit2.joinLabel p (Orbit2.Quartic.single i a)) *\\n            V.tensorMatrix =\\n          0\"}","endPos":{"column":1,"line":2491},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2458},"severity":"information"}
