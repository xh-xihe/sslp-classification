{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ParityFour.bdot_push\",\"type\":\"∀ {emb : Fin 4 → Fin 6},\\n  Function.Injective emb →\\n    ∀ (z : MainTheory.ParityFour.Cube) (y : SS.BitString 6),\\n      SS.bdot (MainTheory.ParityFour.push emb z) y = SS.bdot z (MainTheory.ParityFour.proj emb y)\"}","endPos":{"column":1,"line":2185},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2152},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ParityFour.boundary_support_formula\",\"type\":\"∀ (a : Fin 4 → ℝ),\\n  ∑ i, |a i| = 1 →\\n    ∀ (x : MainTheory.ParityFour.Cube),\\n      8 * MainTheory.ParityFour.probability a x =\\n        ∑ i with a i ≠ 0, |a i| * (1 + (a i).sign * MainTheory.ParityFour.character (SS.stdBasis i) x)\"}","endPos":{"column":1,"line":2185},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2152},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ParityFour.boundary_support_positive_iff\",\"type\":\"∀ (a : Fin 4 → ℝ),\\n  ∑ i, |a i| = 1 →\\n    ∀ (x : MainTheory.ParityFour.Cube),\\n      0 < MainTheory.ParityFour.probability a x ↔\\n        ∃ i, a i ≠ 0 ∧ MainTheory.ParityFour.character (SS.stdBasis i) x = (a i).sign\"}","endPos":{"column":1,"line":2185},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2152},"severity":"information"}
