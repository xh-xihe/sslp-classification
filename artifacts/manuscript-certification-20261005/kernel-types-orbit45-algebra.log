{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit64.no_code\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ x ∉ SixQubit.Orbit64.S0, c x = 0) →\\n    (∀ y ∉ SixQubit.Orbit64.S1, d y = 0) → SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → False\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
