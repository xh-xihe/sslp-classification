{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9CrossKernel.kernel_iff_constant\",\"type\":\"∀ (A B C : ℂ),\\n  A + B + C = 0 →\\n    A ^ 2 + B ^ 2 + C ^ 2 = 0 →\\n      C ≠ 0 → ∀ (z : Fin 4 → ℂ), (MainTheory.Orbit9SmallMatrixDisplays.cross A B C).mulVec z = 0 ↔ ∃ t, z = fun x => t\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9DegreeBudgets.degree_budgets\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∑ i ∈ SixQubit.Orbit9Universal.ActiveSet c, SixQubit.Orbit9Universal.Rdeg c i =\\n        ↑(SixQubit.Orbit9Universal.ActiveSet c).card / 6 + 1 / 3 ∧\\n      ∑ i ∈ Finset.univ \\\\ SixQubit.Orbit9Universal.ActiveSet c, SixQubit.Orbit9Universal.Rdeg c i =\\n        (6 - ↑(SixQubit.Orbit9Universal.ActiveSet c).card) / 6\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9DiagonalGauge.exists_phase_gauge\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      SixQubit.Orbit9Universal.TwoSupportAt c a b →\\n        ∃ u z,\\n          have c' := MainTheory.ClassificationLevels.diagonalAction u c;\\n          have d' := ↑z • MainTheory.ClassificationLevels.diagonalAction u d;\\n          SixQubit.Orbit9Universal.FullKL c' d' ∧\\n            SixQubit.Orbit9Universal.TwoSupportAt c' a b ∧\\n              SixQubit.Orbit9Universal.xamp c' a = ↑MainTheory.Orbit8PhaseNormalization.b ∧\\n                SixQubit.Orbit9Universal.xamp c' b = ↑MainTheory.Orbit8PhaseNormalization.b ∧\\n                  SixQubit.Orbit9Universal.rho c' d' a = 1 ∧ Complex.normSq (SixQubit.Orbit9Universal.rho c' d' b) = 1\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9EnumeratorDisplays.active_edge_from_p\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      a ≠ b →\\n        SixQubit.Orbit9Universal.EqualBitsSupport c a b →\\n          SixQubit.Orbit9Universal.EqualBitsSupport d a b →\\n            ∀ (i j : Fin 6),\\n              i ≠ j →\\n                i ≠ a ∧ i ≠ b →\\n                  j ≠ a ∧ j ≠ b →\\n                    SixQubit.Orbit9Universal.r c i j =\\n                      SixQubit.Orbit9Universal.p c i + SixQubit.Orbit9Universal.p c j - 1 / 12\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
