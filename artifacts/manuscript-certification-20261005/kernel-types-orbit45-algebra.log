{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ParityFour.edgeMasks_eq\",\"type\":\"∀ (k : Fin 4) (z : MainTheory.ParityFour.Cube),\\n  SS.hammingWt (Function.update z k Bool.false) ≤ 1 ↔\\n    (z = fun x => Bool.false) ∨\\n      z = MainTheory.ParityFour.single k ∨\\n        ∃ j,\\n          j ≠ k ∧\\n            (z = MainTheory.ParityFour.single j ∨\\n              z = SS.bxor (MainTheory.ParityFour.single k) (MainTheory.ParityFour.single j))\"}","endPos":{"column":1,"line":2185},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2152},"severity":"information"}
