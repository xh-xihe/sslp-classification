{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PhaseBlocks.occupation_eq_iff\",\"type\":\"∀ (a b c d : SS.BitString 6),\\n  MainTheory.CubicPhaseProjection.occupation MainTheory.Orbit3PhaseBlocks.bits\\n        (MainTheory.Orbit3PhaseBlocks.triple a b) =\\n      MainTheory.CubicPhaseProjection.occupation MainTheory.Orbit3PhaseBlocks.bits\\n        (MainTheory.Orbit3PhaseBlocks.triple c d) ↔\\n    MainTheory.Orbit3PhaseBlocks.block a b = MainTheory.Orbit3PhaseBlocks.block c d\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
