{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.OrderFour25AnchorFlip.equation\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ x ∉ SixQubit.Orbit25.S0, c x = 0) →\\n    (∀ x ∉ SixQubit.Orbit25.S1, d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (j : Fin 5),\\n          Star.star (c (MainTheory.OrderFour25Support.anchor Bool.true)) *\\n                d (MainTheory.OrderFour25Support.tail Bool.false j) +\\n              Star.star (c (MainTheory.OrderFour25Support.hat Bool.true j)) *\\n                d (MainTheory.OrderFour25Support.full Bool.false) =\\n            0\"}","endPos":{"column":1,"line":1641},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1608},"severity":"information"}
