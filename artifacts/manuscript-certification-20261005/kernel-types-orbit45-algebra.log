{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.edgeMatrix_mulVec\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (h : Fin n → ℝ) (e : C.Edge),\\n  (C.edgeMatrix.map ⇑(Int.castRingHom ℝ)).mulVec h e = QECC.realSupportWeight h (↑e).1 - QECC.realSupportWeight h (↑e).2\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.exists_injective_projectivePhaseRatio_of_two_sectors\",\"type\":\"∀ {n K q : ℕ} (C : QECC.CodeProjector n K) [NeZero q] (hq : 0 < q) (a : Fin n → ZMod q),\\n  C.Preserves ((QECC.phaseHom n q hq) a) →\\n    ∀ (b0 b1 : C.ActiveResidue a),\\n      (∀ (b : C.ActiveResidue a), b = b0 ∨ b = b1) →\\n        Module.finrank ℂ ↥(C.phaseSector a ↑b0) = 1 →\\n          Module.finrank ℂ ↥(C.phaseSector a ↑b1) = 1 → ∃ ratio, Function.Injective ⇑ratio\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.exists_normalized_rankTwo_activeResidues\",\"type\":\"∀ {n q m : ℕ} [NeZero q] (C : QECC.CodeProjector n 2) (hq : 0 < q) (a : Fin n → ZMod q)\\n  (hpres : C.Preserves ((QECC.phaseHom n q hq) a)),\\n  C.projectiveClassMap ⟨(QECC.phaseHom n q hq) a, hpres⟩ ≠ 0 →\\n    2 ≤ m →\\n      m ∣ q →\\n        addOrderOf (C.projectiveClassMap ⟨(QECC.phaseHom n q hq) a, hpres⟩) = m →\\n          ∃ b0 b1 u,\\n            b0 ≠ b1 ∧\\n              (∀ (b : C.ActiveResidue a), b = b0 ∨ b = b1) ∧\\n                Module.finrank ℂ ↥(C.phaseSector a ↑b0) = 1 ∧\\n                  Module.finrank ℂ ↥(C.phaseSector a ↑b1) = 1 ∧ ↑u * (↑b1 - ↑b0) = ↑(q / m)\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.exists_primitive_sslp_colors\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (U : C.ProjectiveDiagonalGroup) (R : QECC.ReducedDiagonalRepresentative n)\\n  (hpres : C.Preserves R.phase) (b0 : C.ActiveResidue R.a) (H : C.IntrinsicSSLPData U R hpres b0),\\n  ∃ gamma,\\n    gamma b0 = 0 ∧\\n      Function.Injective gamma ∧\\n        (∀ (b : C.ActiveResidue R.a), (QECC.colorEmbed (addOrderOf U) R.q ⋯) (gamma b) = C.relativeResidues R.a b0 b) ∧\\n          QECC.ColorPrimitive (addOrderOf U) gamma ∧ QECC.colorGCD (addOrderOf U) gamma = 1\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.exists_rankTwoCanonicalNormalization\",\"type\":\"∀ {n q : ℕ} (C : QECC.CodeProjector n 2) [NeZero q] (hq : 0 < q) (m : ℕ) (a : Fin n → ZMod q),\\n  addOrderOf a = q →\\n    ∀ (hpres : C.Preserves ((QECC.phaseHom n q hq) a)),\\n      C.projectiveClassMap ⟨(QECC.phaseHom n q hq) a, hpres⟩ ≠ 0 →\\n        2 ≤ m →\\n          m ∣ q →\\n            addOrderOf (C.projectiveClassMap ⟨(QECC.phaseHom n q hq) a, hpres⟩) = m →\\n              C.HasRankTwoCanonicalNormalization hq m a\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.exists_uniform_rationalPhase_representative\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K),\\n  C.DetectsNumberOps →\\n    ∃ Q,\\n      0 < Q ∧\\n        ∀ (theta : QECC.PhaseVector n),\\n          C.Preserves theta →\\n            ∃ a, C.Preserves (QECC.rationalPhase Q a) ∧ C.ActsAsScalar (theta - QECC.rationalPhase Q a)\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
