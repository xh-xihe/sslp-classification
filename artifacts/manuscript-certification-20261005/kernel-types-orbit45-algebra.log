{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3AffineRankBound.d3_bound_same_class_at_affineRank\",\"type\":\"∀ {n d : ℕ} (C : MainTheory.CodeSpec.ExactCode n 2 d),\\n  3 ≤ d →\\n    ∀\\n      (v :\\n        ↥(MainTheory.ClassificationLevels.diagonalSymmetryGroup\\n            (MainTheory.GlobalClassificationBridge.exactCodeProjector C)))\\n      (theta : Fin n → ℝ),\\n      (∀ (j : Fin n), Complex.exp (2 * ↑Real.pi * Complex.I * ↑(theta j)) = ↑(↑v j)) →\\n        MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) →\\n          MainTheory.ClassificationLevels.intrinsicClass (MainTheory.GlobalClassificationBridge.exactCodeProjector C)\\n                v ≠\\n              1 →\\n            ∃ F eigenvalue q,\\n              MainTheory.CodeSpec.codeSpan C.frame = MainTheory.CodeSpec.codeSpan F ∧\\n                SS.HasDistance F.vec d ∧\\n                  eigenvalue 0 ≠ eigenvalue 1 ∧\\n                    (∀ (k : Fin 2), MainTheory.RealGate.realGate theta (F.vec k) = fun s => eigenvalue k * F.vec k s) ∧\\n                      MainTheory.RealSupportAffineRank.supportAffineRank (F.vec 0) =\\n                          MainTheory.RealSupportAffineRank.supportAffineRank (F.vec 1) ∧\\n                        MainTheory.GeneralLiftOrder.HasPrimitiveLift C\\n                            (MainTheory.ClassificationLevels.intrinsicClass\\n                              (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v)\\n                            q ∧\\n                          orderOf\\n                                (MainTheory.ClassificationLevels.intrinsicClass\\n                                  (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v) ∣\\n                              q ∧\\n                            2 ≤ q ∧\\n                              q ≤\\n                                  MainTheory.BetaExists.betaOf\\n                                    (MainTheory.RealSupportAffineRank.supportAffineRank (F.vec 0)) ∧\\n                                MainTheory.BetaExists.betaOf\\n                                    (MainTheory.RealSupportAffineRank.supportAffineRank (F.vec 0)) ≤\\n                                  MainTheory.BetaExists.betaOf n\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3AffineRankBound.fresh_order_le_betaOf_source_affineRank\",\"type\":\"∀ {n q : ℕ} [inst : NeZero q] {C : MainTheory.CodeSpec.ExactCode n 2 3}\\n  {G : MainTheory.RankTwoGlobal.FiniteGeneratorResolution C q} (T : MainTheory.RankTwoGlobal.TwoFiberCertificate G),\\n  (MainTheory.D3AutomaticBoundedGenerator.frameFreshSparsePhase T).data.order ≤\\n    MainTheory.BetaExists.betaOf (MainTheory.RealSupportAffineRank.supportAffineRank (G.eigenFrame.vec 0))\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
