{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.one_coordinate\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i : Fin 6),\\n      SixQubit.Orbit9Universal.p c i + 2 / 3 - SixQubit.Orbit9Universal.Rdeg c i =\\n        SixQubit.Orbit9Universal.Sdeg d i + 1 / 3 - SixQubit.Orbit9Universal.q d i\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.probability_definitions\",\"type\":\"∀ (c d : SS.State 6 ℂ) (i j : Fin 6),\\n  SixQubit.Orbit9Universal.p c i = Complex.normSq (SixQubit.Orbit9Universal.xamp c i) ∧\\n    SixQubit.Orbit9Universal.q d i = Complex.normSq (SixQubit.Orbit9Universal.yamp d i) ∧\\n      SixQubit.Orbit9Universal.r c i j = Complex.normSq (SixQubit.Orbit9Universal.damp c i j) ∧\\n        SixQubit.Orbit9Universal.s d i j = Complex.normSq (SixQubit.Orbit9Universal.camp d i j)\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.second_weight_moment\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    6 * (1 - SixQubit.Orbit9Universal.Pmass c) = 1 + 9 * SixQubit.Orbit9Universal.Qmass d\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.total_definitions\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.Pmass c = ∑ i, SixQubit.Orbit9Universal.p c i ∧\\n    SixQubit.Orbit9Universal.Qmass d = ∑ i, SixQubit.Orbit9Universal.q d i\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.two_coordinate_sum\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i : Fin 6),\\n      2 - 3 * SixQubit.Orbit9Universal.Rdeg c i =\\n        SixQubit.Orbit9Universal.Sdeg d i + 4 / 3 - 4 * SixQubit.Orbit9Universal.q d i\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9SmallMatrixDisplays.cross_minor\",\"type\":\"∀ (A B C : ℂ),\\n  A ^ 2 + B ^ 2 + C ^ 2 = 0 →\\n    C ≠ 0 →\\n      ((MainTheory.Orbit9SmallMatrixDisplays.cross A B C).submatrix (fun i => i.castSucc) fun i => i.castSucc).det =\\n          -C * (A ^ 2 + B ^ 2 - C ^ 2) ∧\\n        -C * (A ^ 2 + B ^ 2 - C ^ 2) = 2 * C ^ 3 ∧ 2 * C ^ 3 ≠ 0\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9SmallMatrixDisplays.k5_determinant\",\"type\":\"∀ (E F : ℂ), (MainTheory.Orbit9SmallMatrixDisplays.k5 E F).det = 32 * E * F * (E + F)\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
