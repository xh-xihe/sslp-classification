{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8SpinProjector.spinflip_enumerator\",\"type\":\"∀ (psi : Fin 2 → SS.State 6 ℂ),\\n  (MainTheory.PairPartialTrace.familyKernel psi *\\n        MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi)).trace =\\n    1 / 16 * ↑(∑ j, (-1) ^ ↑j * MainTheory.Orbit8EnumeratorDisplays.normalizedA psi ↑j)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
