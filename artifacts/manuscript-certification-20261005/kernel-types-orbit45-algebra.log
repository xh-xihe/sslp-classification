lex.normSq (w i) = 1 →\\n                              ∀ (g : Fin 3),\\n                                Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (D g)) 0) +\\n                                    Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (D g)) 1) ≤\\n                                  1 / 4) →\\n                          (∀ (w : Fin 2 → ℂ),\\n                              ∑ i, Complex.normSq (w i) = 1 →\\n                                ∀ (j : Fin 2),\\n                                  Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (C 0)) j) +\\n                                        Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (C 1)) j) +\\n                                      Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (C 2)) j) ≤\\n                                    3 / 8) →\\n                            (∀ (w : Fin 2 → ℂ),\\n                                ∑ i, Complex.normSq (w i) = 1 →\\n                                  ∀ (j : Fin 2),\\n                                    Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (D 0)) j) +\\n                                          Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (D 1)) j) +\\n                                        Complex.normSq (Matrix.vecMul w (MainTheory.Orbit26.cj (D 2)) j) ≤\\n                                      3 / 8) →\\n                              ¬IsUnit (Matrix.det C3) ∧ ¬IsUnit (Matrix.det D3)\"}","endPos":{"column":1,"line":927},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":894},"severity":"information"}
