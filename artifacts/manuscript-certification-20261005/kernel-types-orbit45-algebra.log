{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3OriginalRealPivot.for_eigenframe\",\"type\":\"∀ {n q : ℕ} [inst : NeZero q] (C : MainTheory.CodeSpec.ExactCode n 2 3)\\n  (G : MainTheory.RankTwoGlobal.FiniteGeneratorResolution C q) (theta : Fin n → ℝ) (ev : Fin 2 → ℂ),\\n  ev 0 ≠ ev 1 →\\n    (∀ (k : Fin 2), MainTheory.RealGate.realGate theta (G.eigenFrame.vec k) = fun x => ev k * G.eigenFrame.vec k x) →\\n      ∃ T F Gb,\\n        Gb.eigenFrame = G.eigenFrame ∧\\n          MainTheory.CodeSpec.SameProjectiveOnCode C.frame (MainTheory.RankTwoGlobal.finiteGateEnd Gb.zeta Gb.angle)\\n              (MainTheory.PhaseSectorBridge.realGateEnd theta) ∧\\n            F.basis.rank = MainTheory.RealSupportAffineRank.supportAffineRank (G.eigenFrame.vec 0) ∧\\n              F.data.order ∣ MainTheory.DeterminantalFactor.lastInvariantFactor F.data.minor ∧\\n                2 ≤ F.data.order ∧\\n                  F.data.order ≤ MainTheory.BetaExists.betaOf F.basis.rank ∧\\n                    MainTheory.BetaExists.betaOf F.basis.rank ≤ MainTheory.BetaExists.betaOf n\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3OriginalRealPivot.full_sparse_bound\",\"type\":\"∀ {n d : ℕ} (C : MainTheory.CodeSpec.ExactCode n 2 d) (hd : 3 ≤ d)\\n  (v :\\n    ↥(MainTheory.ClassificationLevels.diagonalSymmetryGroup\\n        (MainTheory.GlobalClassificationBridge.exactCodeProjector C)))\\n  (theta : Fin n → ℝ),\\n  (∀ (j : Fin n), Complex.exp (2 * ↑Real.pi * Complex.I * ↑(theta j)) = ↑(↑v j)) →\\n    MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) →\\n      MainTheory.ClassificationLevels.intrinsicClass (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v ≠\\n          1 →\\n        let C3 := MainTheory.SSLPCompleteness.weakenDistance hd C;\\n        ∃ q,\\n          ∃ (x : NeZero q),\\n            ∃ Gb r A,\\n              SS.HasDistance Gb.eigenFrame.vec d ∧\\n                MainTheory.CodeSpec.SameProjectiveOnCode C.frame\\n                    (MainTheory.RankTwoGlobal.finiteGateEnd Gb.zeta Gb.angle)\\n                    (MainTheory.PhaseSectorBridge.realGateEnd theta) ∧\\n                  Gb.intrinsicClass =\\n                      MainTheory.ClassificationLevels.intrinsicClass\\n                        (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v ∧\\n                    r = MainTheory.RealSupportAffineRank.supportAffineRank (Gb.eigenFrame.vec 0) ∧\\n                      MainTheory.RealSupportAffineRank.supportAffineRank (Gb.eigenFrame.vec 0) =\\n                          MainTheory.RealSupportAffineRank.supportAffineRank (Gb.eigenFrame.vec 1) ∧\\n                        1 ≤ r ∧\\n                          r ≤ n ∧\\n                            MainTheory.BinaryBeta.IsZeroOne A ∧\\n                              A.det ≠ 0 ∧\\n                                orderOf\\n                                      (MainTheory.ClassificationLevels.intrinsicClass\\n                                        (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v) ∣\\n                                    q ∧\\n                                  q ∣ MainTheory.DeterminantalFactor.lastInvariantFactor A ∧\\n                                    2 ≤ q ∧\\n                                      q ≤ MainTheory.DeterminantalFactor.lastInvariantFactor A ∧\\n                                        MainTheory.DeterminantalFactor.lastInvariantFactor A ≤\\n                                            MainTheory.BetaExists.betaOf r ∧\\n                                          MainTheory.BetaExists.betaOf r ≤ MainTheory.BetaExists.betaOf n\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.D3OriginalRealPivot.shifted_eigen\",\"type\":\"∀ {n : ℕ} (theta : Fin n → ℝ) (x0 : SS.BitString n) (psi : SS.State n ℂ) (lam : ℂ),\\n  (MainTheory.RealGate.realGate theta psi = fun x => lam * psi x) →\\n    (MainTheory.RealGate.realGate (MainTheory.RealXNormalization.flipAngle theta x0) fun x => psi (SS.bxor x x0)) =\\n      fun x => lam / MainTheory.PhaseSectorFull.phaseExp (MainTheory.RealGate.angle theta x0) * psi (SS.bxor x x0)\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
