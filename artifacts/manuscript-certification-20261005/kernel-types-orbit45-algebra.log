{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PaperColoredFiniteLift.colored_finite_lift_of_zDetects\",\"type\":\"∀ {n K d : ℕ} (C : MainTheory.CodeSpec.ExactCode n K d) (hZ : MainTheory.ZDetection.ZDetectsFrame C.frame)\\n  (v :\\n    ↥(MainTheory.ClassificationLevels.diagonalSymmetryGroup\\n        (MainTheory.GlobalClassificationBridge.exactCodeProjector C)))\\n  (theta : Fin n → ℝ),\\n  (∀ (j : Fin n), Complex.exp (2 * ↑Real.pi * Complex.I * ↑(theta j)) = ↑(↑v j)) →\\n    ∀ (hpres : MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta)),\\n      MainTheory.ClassificationLevels.intrinsicClass (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v ≠\\n          1 →\\n        2 ≤ MainTheory.GeneralSpectral.sectorCount hpres ∧\\n          MainTheory.GeneralSpectral.sectorCount hpres ≤ K ∧\\n            have R := MainTheory.GeneralSpectral.logicalSectorResolution hpres C ⋯;\\n            have hZR := ⋯;\\n            ∃ s,\\n              ∃ (hs : NeZero s),\\n                ∃ P,\\n                  ∃ (hdet : P.matrix.det ≠ 0),\\n                    ∃ W,\\n                      have L := P.rationalLift hdet hZR;\\n                      s = (MainTheory.FiniteLift.coloredMatrix R.sectors).rank ∧\\n                        s ≤ n + MainTheory.GeneralSpectral.sectorCount hpres - 1 ∧\\n                          MainTheory.BinaryBeta.IsZeroOne (MainTheory.BinaryPivot.binMatrix P) ∧\\n                            (MainTheory.BinaryPivot.binMatrix P).det ≠ 0 ∧\\n                              ((MainTheory.SharpClearing.ratMatrix (MainTheory.BinaryPivot.binMatrix P)).mulVec\\n                                    (MainTheory.BinaryPivotLift.binarySolution P) =\\n                                  fun i => ↑(P.rhs i)) ∧\\n                                (L.augmented =\\n                                    MainTheory.FiniteLift.extendByZero P.column fun i =>\\n                                      ↑(MainTheory.BinaryPivot.signColumn R.sectors (P.column i)) *\\n                                        MainTheory.BinaryPivotLift.binarySolution P i) ∧\\n                                  MainTheory.Gate.Primitive L.order\\n                                      (MainTheory.D3RationalLiftFiniteGenerator.modularAngle L) ∧\\n                                    MainTheory.ClassificationLevels.intrinsicClass\\n                                          (MainTheory.GlobalClassificationBridge.exactCodeProjector C)\\n                                          (MainTheory.GeneralLiftOrder.liftSymmetry R L) =\\n                                        MainTheory.ClassificationLevels.intrinsicClass\\n                                          (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v ∧\\n                                      MainTheory.GeneralLiftOrder.HasPrimitiveLift C\\n                                          (MainTheory.ClassificationLevels.intrinsicClass\\n                                            (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v)\\n                                          L.order ∧\\n                                        orderOf\\n                                              (MainTheory.ClassificationLevels.intrinsicClass\\n                                                (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v) ∣\\n                                            L.order ∧\\n                                          2 ≤\\n                                              orderOf\\n                                                (MainTheory.ClassificationLevels.intrinsicClass\\n                                                  (MainTheory.GlobalClassificationBridge.exactCodeProjector C) v) ∧\\n                                            2 ≤ L.order ∧\\n                                              L.order ∣ W.lastFactor ∧\\n                                                L.order ≤\\n                                                    MainTheory.BetaExists.betaOf\\n                                                      (n + MainTheory.GeneralSpectral.sectorCount hpres - 1) ∧\\n                                                  W.lastFactor ≤\\n                                                      MainTheory.BetaExists.betaOf\\n                                                        (n + MainTheory.GeneralSpectral.sectorCount hpres - 1) ∧\\n                                                    MainTheory.BetaExists.betaOf\\n                                                          (n + MainTheory.GeneralSpectral.sectorCount hpres - 1) ≤\\n                                                        MainTheory.BetaExists.betaOf (n + K - 1) ∧\\n                                                      ∃ qmin,\\n                                                        MainTheory.GeneralLiftOrder.HasPrimitiveLift C\\n                                                            (MainTheory.ClassificationLevels.intrinsicClass\\n                                                              (MainTheory.GlobalClassificationBridge.exactCodeProjector\\n                                                                C)\\n                                                              v)\\n                                                            qmin ∧\\n                                                          (∀ (q : ℕ),\\n                                                              MainTheory.GeneralLiftOrder.HasPrimitiveLift C\\n                                                                  (MainTheory.ClassificationLevels.intrinsicClass\\n                                                                    (MainTheory.GlobalClassificationBridge.exactCodeProjector\\n                                                                      C)\\n                                                                    v)\\n                                                                  q →\\n                                                                qmin ≤ q) ∧\\n                                                            qmin ≤ L.order ∧\\n                                                              qmin ≤\\n                                                                MainTheory.BetaExists.betaOf\\n                                                                  (n + MainTheory.GeneralSpectral.sectorCount hpres - 1)\"}","endPos":{"column":1,"line":2083},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2050},"severity":"information"}
