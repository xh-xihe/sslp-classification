{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PauliCubicExpansion.product_expansion\",\"type\":\"∀ (P : Fin 3 → SS.PauliString 6) (w : SS.State 6 ℂ),\\n  MainTheory.Orbit3PauliCubicExpansion.totalY P % 2 = 0 →\\n    MainTheory.Orbit3CliffordAverage.product P w =\\n      MainTheory.Orbit3PauliCubicExpansion.phase P *\\n        ∑ a,\\n          ∑ b,\\n            ∑ c,\\n              MainTheory.Orbit3PauliCubicExpansion.character P (a, b, c) *\\n                MainTheory.Orbit3CubicPhaseStability.entry (MainTheory.Orbit3PauliCubicExpansion.shifted P (a, b, c))\\n                  (a, b, c) w\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PauliMomentInterpretation.sampled_product_coordinates\",\"type\":\"∀ (W : MainTheory.Orbit3ScalarCategoryRealization.Encoder) (P : Fin 3 → SS.PauliString 6),\\n  SS.bxor (P 0).x (P 1).x = (P 2).x →\\n    SS.bxor (P 0).z (P 1).z = (P 2).z →\\n      MainTheory.Orbit3PauliCubicExpansion.totalY P % 2 = 0 →\\n        ∑ g, MainTheory.Orbit3CliffordAverage.product P (MainTheory.Orbit3ActualSampling.wave W g) =\\n          MainTheory.Orbit3PauliMomentInterpretation.rawEvaluation P\\n            (MainTheory.Orbit3CoordinateRealization.coordinates W)\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PauliTranslationReduction.triple_sum_reduction\",\"type\":\"∀ (W : MainTheory.Orbit3ScalarCategoryRealization.Encoder) (P : Fin 3 → SS.PauliString 6),\\n  SS.bxor (P 0).z (P 1).z = (P 2).z →\\n    ∑ a,\\n        ∑ b,\\n          ∑ c,\\n            MainTheory.Orbit3PauliCubicExpansion.character P (a, b, c) *\\n              ∑ g,\\n                MainTheory.Orbit3CubicPhaseStability.entry (MainTheory.Orbit3PauliCubicExpansion.shifted P (a, b, c))\\n                  (a, b, c) (MainTheory.Orbit3ActualSampling.wave W g) =\\n      64 *\\n        ∑ a,\\n          ∑ b,\\n            MainTheory.Orbit3PauliCubicExpansion.character P (MainTheory.Orbit3PauliTranslationReduction.pair a b) *\\n              ∑ g,\\n                MainTheory.Orbit3CubicPhaseStability.entry\\n                  (MainTheory.Orbit3PauliCubicExpansion.shifted P (MainTheory.Orbit3PauliTranslationReduction.pair a b))\\n                  (MainTheory.Orbit3PauliTranslationReduction.pair a b) (MainTheory.Orbit3ActualSampling.wave W g)\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
