{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8RaisingGram.raisingGram_eq_normalMatrix\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit8RaisingGram.raisingGram c =\\n              SixQubit.Orbit8RaisingGram.normalMatrix (SixQubit.Orbit8Universal.u d)\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
