{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.FlipCharacter.offSum_eq_indexed\",\"type\":\"∀ {n N : ℕ} (S₀ S₁ : Finset (SS.BitString n)) (c d : SS.State n ℂ) (e z : SS.BitString n) (y : Fin N → SS.BitString n),\\n  Function.Injective y →\\n    Finset.image y Finset.univ = MainTheory.FlipCharacter.incidenceSet S₀ S₁ e →\\n      SixQubit.offSumOn S₀ S₁ c d e z =\\n        ∑ r, MainTheory.FlipCharacter.character z (y r) * MainTheory.FlipCharacter.incidenceMonomial c d e (y r)\"}","endPos":{"column":1,"line":757},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":724},"severity":"information"}
