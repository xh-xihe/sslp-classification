{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9TwoSupportExpectations.opposite_expectations\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    SixQubit.Orbit9Universal.TwoSupportAt c 0 1 →\\n      ∀ (z : ℝ),\\n        z ≠ 0 →\\n          SixQubit.Orbit9Universal.xamp c 0 = ↑z →\\n            SixQubit.Orbit9Universal.xamp c 1 = ↑z →\\n              SixQubit.Orbit9Universal.rho c d 0 = 1 →\\n                SS.innerC c (SixQubit.Orbit8Universal.hop 0 1 c) = 1 / 2 ∧\\n                  SS.innerC d (SixQubit.Orbit8Universal.hop 0 1 d) = -1 / 2\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9TwoSupportPhases.phase_form\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      SixQubit.Orbit9Universal.TwoSupportAt c a b →\\n        ∀ (z : ℝ),\\n          z ≠ 0 →\\n            SixQubit.Orbit9Universal.xamp c a = ↑z →\\n              SixQubit.Orbit9Universal.xamp c b = ↑z →\\n                SixQubit.Orbit9Universal.rho c d a = 1 →\\n                  ∀ (eta : ℂ),\\n                    SixQubit.Orbit9Universal.rho c d b = eta →\\n                      ∀ (t : Fin 6),\\n                        t ≠ a →\\n                          t ≠ b →\\n                            SixQubit.Orbit9Universal.damp c b t = -eta * SixQubit.Orbit9Universal.damp c a t ∧\\n                              SixQubit.Orbit9Universal.camp d a t = Star.star (SixQubit.Orbit9Universal.damp c a t) ∧\\n                                SixQubit.Orbit9Universal.camp d b t = -Star.star (SixQubit.Orbit9Universal.damp c a t)\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
