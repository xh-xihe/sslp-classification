{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PivotSmithNormalForm.clearing_smithLastFactor\",\"type\":\"∀ {s : Type u_1} [inst : Fintype s] [inst_1 : DecidableEq s] [inst_2 : LinearOrder s] [inst_3 : Nonempty s]\\n  (C : Matrix s s ℤ),\\n  C.det ≠ 0 →\\n    ∀ (h : s → ℤ) (z : s → ℚ),\\n      ((MainTheory.SharpClearing.ratMatrix C).mulVec z = fun i => ↑(h i)) →\\n        ∀ (w : MainTheory.SharpClearing.SmithWitness C),\\n          (∃ k, ∀ (i : s), ↑w.lastFactor * z i = ↑(k i)) ∧ MainTheory.Denominator.lcmDen z ∣ w.lastFactor\"}","endPos":{"column":1,"line":2219},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2186},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PositiveAffineFunctionExpansion.affineSpan_eq_of_coordinate_squares\",\"type\":\"∀ {n : ℕ} {α : Type u_1} {β : Type u_2} [inst : Fintype α] [inst_1 : Fintype β] [Nonempty α] [Nonempty β] (p : α → ℝ)\\n  (r : β → ℝ) (pt : α → Fin n → ℝ) (qt : β → Fin n → ℝ),\\n  (∀ (x : α), 0 < p x) →\\n    (∀ (y : β), 0 < r y) →\\n      (∀ (c : ℝ) (w : Fin n → ℝ), ∑ x, p x * (c + ∑ j, w j * pt x j) ^ 2 = ∑ y, r y * (c + ∑ j, w j * qt y j) ^ 2) →\\n        affineSpan ℝ (Set.range pt) = affineSpan ℝ (Set.range qt)\"}","endPos":{"column":1,"line":2219},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2186},"severity":"information"}
