{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9MomentDisplays.factor_equation\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i : Fin 6),\\n      (SixQubit.Orbit9Universal.p c i - SixQubit.Orbit9Universal.q d i) *\\n          (1 + 9 * SixQubit.Orbit9Universal.p c i + 9 * SixQubit.Orbit9Universal.q d i) =\\n        0\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
