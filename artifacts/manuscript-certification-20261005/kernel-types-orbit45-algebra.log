{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit63.offSum_flip\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (SixQubit.Orbit63.offSum c d SixQubit.Orbit63.ef fun x => Bool.false) =\\n    SixQubit.Orbit63.A c d + SixQubit.Orbit63.B c d\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit63.offSum_flipZ\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  SixQubit.Orbit63.offSum c d SixQubit.Orbit63.ef SixQubit.Orbit63.ez = SixQubit.Orbit63.A c d - SixQubit.Orbit63.B c d\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
