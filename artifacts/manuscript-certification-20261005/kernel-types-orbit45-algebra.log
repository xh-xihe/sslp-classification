{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.OrderFour25LiteralNoGo.total_coherences\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (j : Fin 5),\\n      Star.star (d (MainTheory.OrderFour25Support.tail Bool.false j)) *\\n            d (MainTheory.OrderFour25Support.tail Bool.true j) =\\n          -MainTheory.OrderFour25LiteralNoGo.A c / 3 ∧\\n        Star.star (c (MainTheory.OrderFour25Support.hat Bool.false j)) *\\n            c (MainTheory.OrderFour25Support.hat Bool.true j) =\\n          -MainTheory.OrderFour25LiteralNoGo.S d / 3) →\\n    MainTheory.OrderFour25Diagonal.K0 c =\\n        MainTheory.OrderFour25LiteralNoGo.A c - 5 / 3 * MainTheory.OrderFour25LiteralNoGo.S d ∧\\n      MainTheory.OrderFour25Diagonal.K1 d =\\n        MainTheory.OrderFour25LiteralNoGo.S d - 5 / 3 * MainTheory.OrderFour25LiteralNoGo.A c\"}","endPos":{"column":1,"line":1641},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1608},"severity":"information"}
