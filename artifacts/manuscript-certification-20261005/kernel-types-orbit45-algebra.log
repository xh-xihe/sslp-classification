{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8StateDisplays.bottom_expansion\",\"type\":\"∀ (c : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    c SixQubit.Orbit8Universal.zero6 = 0 →\\n      c = fun x =>\\n        SixQubit.Orbit8Universal.ball c * MainTheory.Orbit8SpinSemantics.ket SixQubit.Orbit8Universal.ones6 x +\\n          ∑ y with SS.hammingWt y = 3, c y * MainTheory.Orbit8SpinSemantics.ket y x\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8StateDisplays.top_expansion\",\"type\":\"∀ (d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n    d = fun x =>\\n      ∑ i, SixQubit.Orbit8Universal.u d i * MainTheory.Orbit8SpinSemantics.ket (SS.stdBasis i) x +\\n        ∑ ij ∈ SixQubit.Orbit8Universal.pairs6,\\n          SixQubit.Orbit8Universal.v d ij.1 ij.2 *\\n            MainTheory.Orbit8SpinSemantics.ket (SS.complement (SixQubit.Orbit8Universal.pairMask ij.1 ij.2)) x\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.four_support_hafnian\",\"type\":\"∀ (t : ℂ), t ≠ 0 → t * t + -t / 2 * (-t / 2) + -t / 2 * (-t / 2) = 3 / 2 * t ^ 2 ∧ 3 / 2 * t ^ 2 ≠ 0\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.nine_triangle_solution\",\"type\":\"∀ (x12 x13 x14 x15 x23 x24 x25 x34 x35 x45 : ℂ),\\n  x13 + x14 + x34 = 0 →\\n    x13 + x15 + x35 = 0 →\\n      x14 + x15 + x45 = 0 →\\n        x23 + x24 + x34 = 0 →\\n          x23 + x25 + x35 = 0 →\\n            x24 + x25 + x45 = 0 →\\n              x34 + x35 + x45 = 0 →\\n                x12 + x14 + x24 = 0 →\\n                  x12 + x15 + x25 = 0 →\\n                    x13 = x12 ∧\\n                      x23 = x12 ∧\\n                        x45 = x12 ∧\\n                          x14 = -x12 / 2 ∧\\n                            x15 = -x12 / 2 ∧ x24 = -x12 / 2 ∧ x25 = -x12 / 2 ∧ x34 = -x12 / 2 ∧ x35 = -x12 / 2\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.normalized_triangle\",\"type\":\"∀ (xij xik xjk : ℂ), 1 * xjk + 1 * xik + 1 * xij = xij + xik + xjk\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.scaling_zero_iff\",\"type\":\"∀ (a b c d xab xac xad xbc xbd xcd : ℂ),\\n  a ≠ 0 →\\n    b ≠ 0 →\\n      c ≠ 0 →\\n        d ≠ 0 →\\n          (a * b * xab * (c * d * xcd) + a * c * xac * (b * d * xbd) + a * d * xad * (b * c * xbc) = 0 ↔\\n            xab * xcd + xac * xbd + xad * xbc = 0)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.seven_hafnian_equations\",\"type\":\"∀ (x12 x13 x14 x15 x23 x24 x25 x34 x35 x45 : ℂ),\\n  x13 + x14 + x34 = 0 →\\n    x13 + x15 + x35 = 0 →\\n      x14 + x15 + x45 = 0 →\\n        x23 + x24 + x34 = 0 →\\n          x23 + x25 + x35 = 0 →\\n            x24 + x25 + x45 = 0 →\\n              x34 + x35 + x45 = 0 →\\n                x13 * x45 + x14 * x35 + x15 * x34 = 0 →\\n                  x12 * x35 + x13 * x25 + x15 * x23 = 0 →\\n                    x12 * x45 + x14 * x25 + x15 * x24 = 0 →\\n                      x13 ^ 2 + x13 * x14 + x14 ^ 2 = 0 ∧\\n                        x12 * x14 - 2 * x13 * (x13 + x14) = 0 ∧ x12 * x13 - 2 * x14 * (x13 + x14) = 0\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.seven_triangle_solution\",\"type\":\"∀ (x13 x14 x15 x23 x24 x25 x34 x35 x45 : ℂ),\\n  x13 + x14 + x34 = 0 →\\n    x13 + x15 + x35 = 0 →\\n      x14 + x15 + x45 = 0 →\\n        x23 + x24 + x34 = 0 →\\n          x23 + x25 + x35 = 0 →\\n            x24 + x25 + x45 = 0 →\\n              x34 + x35 + x45 = 0 →\\n                x23 = x13 ∧\\n                  x45 = x13 ∧ x24 = x14 ∧ x35 = x14 ∧ x15 = -(x13 + x14) ∧ x25 = -(x13 + x14) ∧ x34 = -(x13 + x14)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.star_normalize\",\"type\":\"∀ (v : Fin 6 → Fin 6 → ℂ),\\n  (∀ (j : Fin 6), j ≠ 0 → v 0 j ≠ 0) → ∃ d, (∀ (i : Fin 6), d i ≠ 0) ∧ ∀ (j : Fin 6), j ≠ 0 → d 0 * d j * v 0 j = 1\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TriangleDisplays.vertex_scaling\",\"type\":\"∀ (a b c d xab xac xad xbc xbd xcd : ℂ),\\n  a * b * xab * (c * d * xcd) + a * c * xac * (b * d * xbd) + a * d * xad * (b * c * xbc) =\\n    a * b * c * d * (xab * xcd + xac * xbd + xad * xbc)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TrigonometricDisplays.XX_YY_expectations\",\"type\":\"∀ (theta : ℝ),\\n  MainTheory.Orbit8EnumeratorDisplays.lambda (SixQubit.Orbit8Family.code (Real.cos theta) (Real.sin theta))\\n        SixQubit.Orbit8Family.PXX =\\n      -↑(Real.sin theta * Real.cos theta) ∧\\n    MainTheory.Orbit8EnumeratorDisplays.lambda (SixQubit.Orbit8Family.code (Real.cos theta) (Real.sin theta))\\n        SixQubit.Orbit8Family.PYY =\\n      -↑(Real.sin theta * Real.cos theta)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TrigonometricDisplays.Z_expectations\",\"type\":\"∀ (theta : ℝ),\\n  MainTheory.Orbit8EnumeratorDisplays.lambda (SixQubit.Orbit8Family.code (Real.cos theta) (Real.sin theta))\\n        SixQubit.Orbit8Family.PZ4 =\\n      -↑(Real.cos theta ^ 2) ∧\\n    MainTheory.Orbit8EnumeratorDisplays.lambda (SixQubit.Orbit8Family.code (Real.cos theta) (Real.sin theta))\\n        SixQubit.Orbit8Family.PZ0 =\\n      -↑(Real.sin theta ^ 2)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8TrigonometricDisplays.alpha_theta\",\"type\":\"∀ (theta : ℝ),\\n  MainTheory.Orbit8EnumeratorDisplays.normalizedA (SixQubit.Orbit8Family.code (Real.cos theta) (Real.sin theta)) 1 =\\n      Real.cos theta ^ 4 + Real.sin theta ^ 4 ∧\\n    Real.cos theta ^ 4 + Real.sin theta ^ 4 = 1 - 1 / 2 * Real.sin (2 * theta) ^ 2\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
