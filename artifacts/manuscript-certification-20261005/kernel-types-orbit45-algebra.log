{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Trace5.bell_contradiction\",\"type\":\"∀ (u a1 a2 a3 a4 b1 b2 b3 b4 : Fin 4 → ℂ),\\n  SixQubit.Trace5.nsq u = 1 / 3 →\\n    SixQubit.Trace5.nsq a1 = 1 / 6 →\\n      SixQubit.Trace5.nsq a2 = 1 / 6 →\\n        SixQubit.Trace5.nsq a3 = 1 / 6 →\\n          SixQubit.Trace5.nsq a4 = 1 / 6 →\\n            SixQubit.Trace5.nsq b1 = 1 / 6 →\\n              SixQubit.Trace5.nsq b2 = 1 / 6 →\\n                SixQubit.Trace5.nsq b3 = 1 / 6 →\\n                  SixQubit.Trace5.nsq b4 = 1 / 6 →\\n                    SixQubit.Trace5.ip u a1 = 0 →\\n                      SixQubit.Trace5.ip u a2 = 0 →\\n                        SixQubit.Trace5.ip u a3 = 0 →\\n                          SixQubit.Trace5.ip u a4 = 0 →\\n                            (∀ (k l : Fin 4), SixQubit.Trace5.fr a1 a2 a3 a4 k l = SixQubit.Trace5.fr b1 b2 b3 b4 k l) →\\n                              SixQubit.Trace5.ip a1 b2 = 0 →\\n                                SixQubit.Trace5.ip a1 b3 = 0 →\\n                                  SixQubit.Trace5.ip a1 b4 = 0 →\\n                                    SixQubit.Trace5.ip a2 b1 = 0 →\\n                                      SixQubit.Trace5.ip a2 b3 = 0 →\\n                                        SixQubit.Trace5.ip a2 b4 = 0 →\\n                                          SixQubit.Trace5.ip a3 b1 = 0 →\\n                                            SixQubit.Trace5.ip a3 b2 = 0 →\\n                                              SixQubit.Trace5.ip a3 b4 = 0 →\\n                                                SixQubit.Trace5.ip a4 b1 = 0 →\\n                                                  SixQubit.Trace5.ip a4 b2 = 0 → SixQubit.Trace5.ip a4 b3 = 0 → False\"}","endPos":{"column":1,"line":3477},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3444},"severity":"information"}
