{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7DirectMarginal.direct_uniform_eq_pairMarginal\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (s : Fin 5),\\n          SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s = SixQubit.Orbit7Universal.pairMarginal c d s\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
