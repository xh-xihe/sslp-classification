{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.offSumOn_eq_zero_of_hasDistance\",\"type\":\"∀ {n : ℕ} (S₀ S₁ : Finset (SS.BitString n)) (c d : SS.BitString n → ℂ),\\n  (∀ x ∉ S₀, c x = 0) →\\n    (∀ y ∉ S₁, d y = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (e z : SS.BitString n), { x := e, z := z }.wt ≤ 2 → SixQubit.offSumOn S₀ S₁ c d e z = 0\"}","endPos":{"column":1,"line":3486},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3478},"severity":"information"}
