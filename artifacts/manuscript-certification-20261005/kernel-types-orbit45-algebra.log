{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3ActualSampling.baseWave_formula\",\"type\":\"∀ (W : MainTheory.Orbit3ScalarCategoryRealization.Encoder) (g : MainTheory.Orbit3ActualSampling.BaseIndex),\\n  MainTheory.Orbit3ActualSampling.baseWave W g =\\n    MainTheory.Orbit3CliffordAverage.act (SixQubit.Generated.SpectatorClifford.clifford g.2.2)\\n      (SixQubit.CodeEquiv.flipAct g.2.1\\n        (SixQubit.CodeEquiv.permAct (↑g.1) (SixQubit.ParityLogicalState.superposition W.states)))\"}","endPos":{"column":1,"line":1131},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1098},"severity":"information"}
