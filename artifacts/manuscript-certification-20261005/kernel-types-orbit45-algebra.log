{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9StateDisplays.bottom_expansion\",\"type\":\"∀ (c : SS.State 6 ℂ),\\n  (∀ x ∉ SixQubit.Orbit9Universal.S0, c x = 0) →\\n    c = fun x =>\\n      ∑ i, SixQubit.Orbit9Universal.xamp c i * MainTheory.Orbit9StateDisplays.ket (SixQubit.Orbit9Universal.one i) x +\\n        ∑ ij ∈ SixQubit.Orbit9Universal.pairIdx,\\n          SixQubit.Orbit9Universal.damp c ij.1 ij.2 *\\n            MainTheory.Orbit9StateDisplays.ket (SS.complement (SixQubit.Orbit9Universal.pair ij.1 ij.2)) x\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9StateDisplays.top_expansion\",\"type\":\"∀ (d : SS.State 6 ℂ),\\n  (∀ x ∉ SixQubit.Orbit9Universal.S1, d x = 0) →\\n    d = fun x =>\\n      ∑ ij ∈ SixQubit.Orbit9Universal.pairIdx,\\n          SixQubit.Orbit9Universal.camp d ij.1 ij.2 *\\n            MainTheory.Orbit9StateDisplays.ket (SixQubit.Orbit9Universal.pair ij.1 ij.2) x +\\n        ∑ i,\\n          SixQubit.Orbit9Universal.yamp d i *\\n            MainTheory.Orbit9StateDisplays.ket (SS.complement (SixQubit.Orbit9Universal.one i)) x\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9TwoSupportDisplays.monotone_equation\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      SixQubit.Orbit9Universal.TwoSupportAt c a b →\\n        SixQubit.Orbit9Universal.p c a * (1 / 6 + SixQubit.Orbit9Universal.p c a) =\\n          SixQubit.Orbit9Universal.p c b * (1 / 6 + SixQubit.Orbit9Universal.p c b)\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
