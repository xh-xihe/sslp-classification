{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatCompression.XX_YY\",\"type\":\"∀ (i j : Fin 5),\\n  i ≠ j →\\n    ∀ (r s : Fin 5),\\n      ((MainTheory.PrimitiveOrderTwoCatCompression.cats.conjTranspose *\\n                Orbit2.TensorPauli.operator (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 1 1) *\\n              MainTheory.PrimitiveOrderTwoCatCompression.cats)\\n            r s =\\n          (if r = i ∧ s = j then 1 else 0) + if r = j ∧ s = i then 1 else 0) ∧\\n        (MainTheory.PrimitiveOrderTwoCatCompression.cats.conjTranspose *\\n                Orbit2.TensorPauli.operator (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 2 2) *\\n              MainTheory.PrimitiveOrderTwoCatCompression.cats)\\n            r s =\\n          (if r = i ∧ s = j then 1 else 0) + if r = j ∧ s = i then 1 else 0\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatCompression.XX_YY_raw\",\"type\":\"∀ (i j : Fin 5),\\n  i ≠ j →\\n    ∀ (r s : Fin 5),\\n      (MainTheory.PrimitiveOrderTwoCatCompression.rawCompression\\n            (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 1 1) r s =\\n          if r = i ∧ s = j ∨ r = j ∧ s = i then 2 else 0) ∧\\n        MainTheory.PrimitiveOrderTwoCatCompression.rawCompression\\n            (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 2 2) r s =\\n          if r = i ∧ s = j ∨ r = j ∧ s = i then 2 else 0\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatCompression.ZZ\",\"type\":\"∀ (i j : Fin 5),\\n  i ≠ j →\\n    ∀ (r s : Fin 5),\\n      (MainTheory.PrimitiveOrderTwoCatCompression.cats.conjTranspose *\\n              Orbit2.TensorPauli.operator (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 3 3) *\\n            MainTheory.PrimitiveOrderTwoCatCompression.cats)\\n          r s =\\n        ((if r = s then 1 else 0) - 2 * if r = i ∧ s = i then 1 else 0) - 2 * if r = j ∧ s = j then 1 else 0\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatCompression.ZZ_raw\",\"type\":\"∀ (i j : Fin 5),\\n  i ≠ j →\\n    ∀ (r s : Fin 5),\\n      MainTheory.PrimitiveOrderTwoCatCompression.rawCompression\\n          (MainTheory.PrimitiveOrderTwoCatCompression.pair i j 3 3) r s =\\n        if r = s then if r = i ∨ r = j then -2 else 2 else 0\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
