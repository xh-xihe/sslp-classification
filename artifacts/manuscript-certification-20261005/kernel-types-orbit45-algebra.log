{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.FlipCharacter.matched_ten_monomials_zero\",\"type\":\"∀ {n : ℕ} (c d : SS.State n ℂ) (i : Fin n) (j : Fin 4 → Fin n) (x : Fin 10 → SS.BitString n),\\n  Function.Injective x →\\n    (∀ v ∉ Finset.image x Finset.univ, c v = 0) →\\n      (∀ v ∉ Finset.image (MainTheory.FlipCharacter.matchedTop (SS.stdBasis i) x) Finset.univ, d v = 0) →\\n        SS.HasDistance ![c, d] 3 →\\n          (MainTheory.FlipCharacter.matchedTenCharacterMatrix i j x).det ≠ 0 →\\n            ∀ (r : Fin 10), Star.star (c (x r)) * d (SS.bxor (x r) (SS.stdBasis i)) = 0\"}","endPos":{"column":1,"line":757},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":724},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.FlipCharacter.matched_ten_obstruction\",\"type\":\"∀ {n : ℕ} (c d : SS.State n ℂ) (i : Fin n) (j : Fin 4 → Fin n) (x : Fin 10 → SS.BitString n),\\n  Function.Injective x →\\n    (∀ v ∉ Finset.image x Finset.univ, c v = 0) →\\n      (∀ v ∉ Finset.image (MainTheory.FlipCharacter.matchedTop (SS.stdBasis i) x) Finset.univ, d v = 0) →\\n        SS.innerC c c = 1 →\\n          (∀ (r : Fin 10), Complex.normSq (c (x r)) = Complex.normSq (d (SS.bxor (x r) (SS.stdBasis i)))) →\\n            (MainTheory.FlipCharacter.matchedTenCharacterMatrix i j x).det ≠ 0 → ¬SS.HasDistance ![c, d] 3\"}","endPos":{"column":1,"line":757},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":724},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.FlipCharacter.monomials_zero_of_det_ne_zero\",\"type\":\"∀ {n N : ℕ} (S₀ S₁ : Finset (SS.BitString n)) (c d : SS.State n ℂ),\\n  (∀ x ∉ S₀, c x = 0) →\\n    (∀ x ∉ S₁, d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (e : SS.BitString n) (z y : Fin N → SS.BitString n),\\n          Function.Injective y →\\n            Finset.image y Finset.univ = MainTheory.FlipCharacter.incidenceSet S₀ S₁ e →\\n              (∀ (a : Fin N), { x := e, z := z a }.wt ≤ 2) →\\n                (MainTheory.FlipCharacter.restrictedCharacterMatrix z y).det ≠ 0 →\\n                  ∀ (r : Fin N), MainTheory.FlipCharacter.incidenceMonomial c d e (y r) = 0\"}","endPos":{"column":1,"line":757},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":724},"severity":"information"}
