{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.OrderTwoEnumeratorDisplays.forced_low\",\"type\":\"∀ (psi : Fin 2 → SS.State 6 ℂ),\\n  (∀ (i : Fin 2), SS.innerC (psi i) (psi i) = 1) →\\n    SS.HasDistance psi 3 →\\n      ∀ (G : SS.PauliString 6),\\n        (∀ (i : Fin 2), SS.pauliAct G (psi i) = psi i) →\\n          (G.wt = 1 →\\n              SS.MacWilliams.Aco psi 1 / 4 = 1 ∧ SS.MacWilliams.Aco psi 2 / 4 = 0 ∧ SS.MacWilliams.Aco psi 3 / 4 = 0) ∧\\n            (G.wt = 2 →\\n              SS.MacWilliams.Aco psi 1 / 4 = 0 ∧ SS.MacWilliams.Aco psi 2 / 4 = 1 ∧ SS.MacWilliams.Aco psi 3 / 4 = 0)\"}","endPos":{"column":1,"line":2049},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2016},"severity":"information"}
