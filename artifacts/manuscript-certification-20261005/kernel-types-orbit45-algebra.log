{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9TwoSupportDisplays.two_row\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      SixQubit.Orbit9Universal.TwoSupportAt c a b →\\n        ∀ (t : Fin 6),\\n          SixQubit.Orbit9Universal.damp c t a * Star.star (SixQubit.Orbit9Universal.yamp d a) +\\n              SixQubit.Orbit9Universal.damp c t b * Star.star (SixQubit.Orbit9Universal.yamp d b) =\\n            0\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
