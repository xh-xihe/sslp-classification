{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.reindexOperator_xor_diagonalGate_phaseHom\",\"type\":\"∀ {n q : ℕ} (hq : 0 < q) (a : Fin n → ZMod q) (t : QECC.BitString n),\\n  QECC.reindexOperator (QECC.xorEquiv t) (QECC.diagonalGate ((QECC.phaseHom n q hq) a)) =\\n    QECC.zmodPhaseScalar q hq (QECC.subsetSum a t) •\\n      QECC.diagonalGate ((QECC.phaseHom n q hq) (QECC.xorCoefficient t a))\"}","endPos":{"column":1,"line":2627},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2594},"severity":"information"}
