{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.rigid_shells\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            c SixQubit.Orbit8Universal.zero6 = 0 ∧\\n              SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 0 = 0 ∧\\n                SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 3 = 5 / 6 ∧\\n                  SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 6 = 1 / 6 ∧\\n                    SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 1 = 1 / 6 ∧\\n                      SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4 = 5 / 6\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.shell_parameter\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            have t := SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4;\\n            SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 1 = 1 - t ∧\\n              SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 0 = 5 / 9 - 2 * t / 3 ∧\\n                SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 3 = 5 / 9 + t / 3 ∧\\n                  SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 6 = (3 * t - 1) / 9\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.singleton_support_le_two\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            (SixQubit.Orbit8Universal.probabilitySupport (SixQubit.Orbit8Universal.p d)).card ≤ 2\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.star_equation\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (i j : Fin 6),\\n          i ≠ j →\\n            (∑ ij ∈ SixQubit.Orbit8Universal.awayPairs i,\\n                if SixQubit.Orbit8Universal.touches ij j = Bool.true then\\n                  Star.star (SixQubit.Orbit8Universal.v d ij.1 ij.2) * c (SixQubit.Orbit8Universal.topRecip i ij)\\n                else 0) =\\n              0\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit8Universal.trace_zero_low_outside\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ P ∈ SixQubit.Orbit8Universal.lowPaulis,\\n              P ∉ Finset.image SixQubit.Orbit8Universal.qPauli Finset.univ → SS.MacWilliams.trProj ![c, d] P = 0\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
