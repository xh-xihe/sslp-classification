{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9SmallMatrixDisplays.k5_normal_form\",\"type\":\"∀ (x12 x13 x14 x23 x24 x34 : ℂ),\\n  x12 + x13 + x23 = 0 →\\n    x12 + x14 + x24 = 0 →\\n      x13 + x14 + x34 = 0 →\\n        x23 + x24 + x34 = 0 →\\n          !![0, 1, 1, 1, 1; 1, 0, x12, x13, x14; 1, x12, 0, x23, x24; 1, x13, x23, 0, x34; 1, x14, x24, x34, 0] =\\n            MainTheory.Orbit9SmallMatrixDisplays.k5 x13 x12\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9SmallMatrixDisplays.k5_triangle_solution\",\"type\":\"∀ (x12 x13 x14 x23 x24 x34 : ℂ),\\n  x12 + x13 + x23 = 0 →\\n    x12 + x14 + x24 = 0 →\\n      x13 + x14 + x34 = 0 → x23 + x24 + x34 = 0 → x23 = -x13 - x12 ∧ x14 = -x13 - x12 ∧ x24 = x13 ∧ x34 = x12\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9StabilizerDisplay.A2_lower\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (r s : Fin 6),\\n      r ≠ s →\\n        SixQubit.Orbit9Universal.EqualBitsSupport c r s →\\n          SixQubit.Orbit9Universal.EqualBitsSupport d r s → 1 ≤ SS.MacWilliams.Aco ![c, d] 2 / 4\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9StabilizerDisplay.exists_stabilizer\",\"type\":\"∀ (c d : SS.State 6 ℂ) (H : SixQubit.Orbit9Universal.FullKL c d),\\n  (SixQubit.Orbit9Universal.ActiveSet c).card = 4 →\\n    ∃ r s,\\n      (MainTheory.Orbit9StabilizerDisplay.zz r s).wt = 2 ∧\\n        MainTheory.PauliKernelTrace.pauliKernel (MainTheory.Orbit9StabilizerDisplay.zz r s) *\\n            MainTheory.Orbit9StabilizerDisplay.projector (MainTheory.Orbit9DiagonalGauge.frame c d H) =\\n          MainTheory.Orbit9StabilizerDisplay.projector (MainTheory.Orbit9DiagonalGauge.frame c d H)\"}","endPos":{"column":1,"line":1539},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1506},"severity":"information"}
