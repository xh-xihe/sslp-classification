{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPCompleteness.completeness_distance_three\",\"type\":\"∀ {n B1 Bn d0 d : ℕ} (hd0 : 3 ≤ d0) (hdd : d0 ≤ d),\\n  MainTheory.BinaryBeta.BetaBound n Bn →\\n    ∀ (C : MainTheory.CodeSpec.ExactCode n 2 d) (theta : Fin n → ℝ),\\n      MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) →\\n        ¬MainTheory.CodeSpec.SameProjectiveOnCode C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta)\\n              LinearMap.id →\\n          ∃ S,\\n            2 ≤ S.q ∧\\n              S.q ≤ MainTheory.SSLPCompleteness.outerCutoff B1 Bn d0 ∧\\n                2 ≤ S.m ∧\\n                  S.m ∣ S.q ∧\\n                    (∃ g, orderOf g = S.m) ∧\\n                      (Monotone fun j => (S.angle j).val) ∧\\n                        (∀ (j : Fin n), (S.angle j).val < S.q) ∧\\n                          MainTheory.Gate.Primitive S.q S.angle ∧ SS.HasDistance S.frame.vec d\"}","endPos":{"column":1,"line":2321},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2288},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPCompleteness.completeness_distance_two\",\"type\":\"∀ {n B1 Bn d0 d : ℕ},\\n  d0 = 2 →\\n    d0 ≤ d →\\n      MainTheory.BinaryBeta.BetaBound (n + 1) B1 →\\n        ∀ (C : MainTheory.CodeSpec.ExactCode n 2 d) (theta : Fin n → ℝ),\\n          MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) →\\n            ¬MainTheory.CodeSpec.SameProjectiveOnCode C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta)\\n                  LinearMap.id →\\n              ∃ S,\\n                2 ≤ S.q ∧\\n                  S.q ≤ MainTheory.SSLPCompleteness.outerCutoff B1 Bn d0 ∧\\n                    2 ≤ S.m ∧\\n                      S.m ∣ S.q ∧\\n                        (∃ g, orderOf g = S.m) ∧\\n                          (Monotone fun j => (S.angle j).val) ∧\\n                            (∀ (j : Fin n), (S.angle j).val < S.q) ∧\\n                              MainTheory.Gate.Primitive S.q S.angle ∧ SS.HasDistance S.frame.vec d\"}","endPos":{"column":1,"line":2355},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2322},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPCompleteness.completeness_six_qubit\",\"type\":\"∀ {d0 d : ℕ} (hd0 : 3 ≤ d0) (hdd : d0 ≤ d) (C : MainTheory.CodeSpec.ExactCode 6 2 d) (theta : Fin 6 → ℝ),\\n  MainTheory.CodeSpec.CodePreserving C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) →\\n    ¬MainTheory.CodeSpec.SameProjectiveOnCode C.frame (MainTheory.PhaseSectorBridge.realGateEnd theta) LinearMap.id →\\n      ∃ S,\\n        2 ≤ S.q ∧\\n          S.q ≤ 9 ∧\\n            2 ≤ S.m ∧\\n              S.m ∣ S.q ∧\\n                (∃ g, orderOf g = S.m) ∧\\n                  (Monotone fun j => (S.angle j).val) ∧\\n                    (∀ (j : Fin 6), (S.angle j).val < S.q) ∧\\n                      MainTheory.Gate.Primitive S.q S.angle ∧ SS.HasDistance S.frame.vec d\"}","endPos":{"column":1,"line":2355},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2322},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPConverse.orderOf_intrinsicClass_resolutionOfPair\",\"type\":\"∀ {n d q m : ℕ} [inst : NeZero q] {zeta : ℂ} (hzeta : IsPrimitiveRoot zeta q) {a : Fin n → ZMod q}\\n  (hprim : MainTheory.Gate.Primitive q a) (hmq : m ∣ q) (hm : 2 ≤ m) (F : MainTheory.CodeSpec.OrthonormalFrame n 2)\\n  (hdist : SS.HasDistance F.vec d) (h0 : SS.SSConditionState a 0 (F.vec 0))\\n  (h1 : SS.SSConditionState a (↑(q / m)) (F.vec 1)),\\n  orderOf (MainTheory.SSLPConverse.resolutionOfPair hzeta hprim hmq hm F hdist h0 h1).intrinsicClass = m\"}","endPos":{"column":1,"line":2355},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2322},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPPipelineExact.code_of_sortedNormalForm\",\"type\":\"∀ {n d : ℕ} {C : MainTheory.CodeSpec.ExactCode n 2 d} (S : MainTheory.SortedForm.SortedNormalForm C),\\n  ∃ C' g, C'.frame = S.frame ∧ orderOf g = S.m ∧ g ≠ 1\"}","endPos":{"column":1,"line":2355},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2322},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.SSLPPipelineExact.pipeline_exact_three\",\"type\":\"∀ {n B1 Bn d0 d : ℕ} (hd0 : 3 ≤ d0) (hdd : d0 ≤ d),\\n  MainTheory.BinaryBeta.BetaBound n Bn →\\n    ∀ (C : MainTheory.CodeSpec.ExactCode n 2 d),\\n      (∃ g, g ≠ 1) →\\n        ∃ S,\\n          (2 ≤ S.q ∧\\n              S.q ≤ MainTheory.SSLPCompleteness.outerCutoff B1 Bn d0 ∧\\n                2 ≤ S.m ∧\\n                  S.m ∣ S.q ∧\\n                    (Monotone fun j => (S.angle j).val) ∧\\n                      (∀ (j : Fin n), (S.angle j).val < S.q) ∧\\n                        MainTheory.Gate.Primitive S.q S.angle ∧ SS.HasDistance S.frame.vec d) ∧\\n            ∃ C' g, C'.frame = S.frame ∧ orderOf g = S.m ∧ g ≠ 1\"}","endPos":{"column":1,"line":2355},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2322},"severity":"information"}
