{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PrintedAmplitudes.commuting_expectation\",\"type\":\"∀ {n : ℕ} (psi : Fin 2 → SS.State n ℂ) {mask : SS.BitString n},\\n  SixQubit.ParityPauliScalars.ParityPair mask psi →\\n    ∀ (P : SS.PauliString n),\\n      SS.MacWilliams.chi mask P.x = 1 →\\n        SS.innerC (MainTheory.Orbit3PrintedAmplitudes.w psi)\\n            (SS.pauliAct P (MainTheory.Orbit3PrintedAmplitudes.w psi)) =\\n          SS.MacWilliams.trProj psi P / 2\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit3PrintedAmplitudes.expectation\",\"type\":\"∀ {n : ℕ} (psi : Fin 2 → SS.State n ℂ) (P : SS.PauliString n),\\n  SS.innerC (MainTheory.Orbit3PrintedAmplitudes.w psi) (SS.pauliAct P (MainTheory.Orbit3PrintedAmplitudes.w psi)) =\\n    1 / 2 *\\n      (SS.innerC (psi 0) (SS.pauliAct P (psi 0)) + SS.innerC (psi 0) (SS.pauliAct P (psi 1)) +\\n          SS.innerC (psi 1) (SS.pauliAct P (psi 0)) +\\n        SS.innerC (psi 1) (SS.pauliAct P (psi 1)))\"}","endPos":{"column":1,"line":1165},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1132},"severity":"information"}
