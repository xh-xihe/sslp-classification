{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit28.offSum_flip\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  d SixQubit.Orbit28.z9 = 0 →\\n    d SixQubit.Orbit28.z10 = 0 →\\n      d SixQubit.Orbit28.z11 = 0 →\\n        d SixQubit.Orbit28.z12 = 0 →\\n          d SixQubit.Orbit28.z13 = 0 →\\n            d SixQubit.Orbit28.z14 = 0 →\\n              (SixQubit.Orbit28.offSum c d SixQubit.Orbit28.ef fun x => Bool.false) =\\n                SixQubit.Orbit28.A c d + SixQubit.Orbit28.B c d\"}","endPos":{"column":1,"line":2831},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2798},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit28.offSum_flipZ\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  d SixQubit.Orbit28.z9 = 0 →\\n    d SixQubit.Orbit28.z10 = 0 →\\n      d SixQubit.Orbit28.z11 = 0 →\\n        d SixQubit.Orbit28.z12 = 0 →\\n          d SixQubit.Orbit28.z13 = 0 →\\n            d SixQubit.Orbit28.z14 = 0 →\\n              SixQubit.Orbit28.offSum c d SixQubit.Orbit28.ef SixQubit.Orbit28.ez =\\n                SixQubit.Orbit28.A c d - SixQubit.Orbit28.B c d\"}","endPos":{"column":1,"line":2831},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2798},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit28.offSum_reduce\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ) (zz : SS.BitString 6),\\n  d SixQubit.Orbit28.z9 = 0 →\\n    d SixQubit.Orbit28.z10 = 0 →\\n      d SixQubit.Orbit28.z11 = 0 →\\n        d SixQubit.Orbit28.z12 = 0 →\\n          d SixQubit.Orbit28.z13 = 0 →\\n            d SixQubit.Orbit28.z14 = 0 →\\n              SixQubit.Orbit28.offSum c d SixQubit.Orbit28.ef zz =\\n                SixQubit.signMul (SS.bdot zz SixQubit.Orbit28.z8) (SixQubit.Orbit28.A c d) +\\n                  SixQubit.signMul (SS.bdot zz SixQubit.Orbit28.z15) (SixQubit.Orbit28.B c d)\"}","endPos":{"column":1,"line":2831},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2798},"severity":"information"}
