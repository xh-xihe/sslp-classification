{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DeterminantOneCyclicConvention.convention\",\"type\":\"∀ (m : ℕ),\\n  0 < m →\\n    ∀ (z : ℂ),\\n      IsPrimitiveRoot z (2 * m) →\\n        (MainTheory.DeterminantOneCyclicConvention.G z).det = 1 ∧\\n          (MainTheory.DeterminantOneCyclicConvention.G z).conjTranspose *\\n                MainTheory.DeterminantOneCyclicConvention.G z =\\n              1 ∧\\n            orderOf (MainTheory.DeterminantOneCyclicConvention.G z) = 2 * m ∧ orderOf (z / z⁻¹) = m\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DeterminantOneCyclicConvention.exists_convention\",\"type\":\"∀ (m : ℕ),\\n  0 < m →\\n    ∃ z,\\n      (MainTheory.DeterminantOneCyclicConvention.G z).det = 1 ∧\\n        (MainTheory.DeterminantOneCyclicConvention.G z).conjTranspose * MainTheory.DeterminantOneCyclicConvention.G z =\\n            1 ∧\\n          orderOf (MainTheory.DeterminantOneCyclicConvention.G z) = 2 * m ∧ orderOf (z / z⁻¹) = m\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
