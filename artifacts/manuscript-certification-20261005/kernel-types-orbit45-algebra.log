{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.disjoint_equation\",\"type\":\"∀ (c d : ℝ) (xe xf te tf pe pf : ℂ),\\n  xe ≠ 0 →\\n    xf ≠ 0 →\\n      SixQubit.Orbit7Universal.spinInner (MainTheory.Orbit7SpinorCoordinates.avec c d xe (te * xe))\\n            (MainTheory.Orbit7FourHafnians.bvec xf (pf * xf)) =\\n          SixQubit.Orbit7Universal.spinInner (MainTheory.Orbit7SpinorCoordinates.avec c d xf (tf * xf))\\n            (MainTheory.Orbit7FourHafnians.bvec xe (pe * xe)) →\\n        ↑d * (te - tf + pf - pe) + ↑c * (te * pf - tf * pe) = 0\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.factored_disjoint\",\"type\":\"∀ (c d te tf pe pf : ℂ),\\n  d ≠ 0 →\\n    d * (te - tf + pf - pe) + c * (te * pf - tf * pe) = 0 → (te - pe) * (1 + c / d * tf) = (tf - pf) * (1 + c / d * te)\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.hafnian_y_zero\",\"type\":\"∀ (x y : Fin 5 × Fin 5 → ℂ) (mu nu : ℂ),\\n  mu ≠ 0 →\\n    (∀ (i : Fin 5), SixQubit.Orbit7Universal.PolarHafnian5 x y i = 0) →\\n      (∀ (i : Fin 5), SixQubit.Orbit7Universal.PolarHafnian5 y (fun e => mu * y e + nu * x e) i = 0) →\\n        ∀ (i : Fin 5), SixQubit.Orbit7Universal.Hafnian5 y i = 0\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.pair_condition\",\"type\":\"∀ (k : ℂ) (r q : Fin 5 → ℂ) (i j a b : Fin 5),\\n  (r i + r j - (q i + q j)) * (1 + k * (r a + r b)) = (r a + r b - (q a + q b)) * (1 + k * (r i + r j)) →\\n    (MainTheory.Orbit7AffineDisplays.hvertex k r i + MainTheory.Orbit7AffineDisplays.hvertex k r j) *\\n        (MainTheory.Orbit7AffineDisplays.delta r q a + MainTheory.Orbit7AffineDisplays.delta r q b) =\\n      (MainTheory.Orbit7AffineDisplays.hvertex k r a + MainTheory.Orbit7AffineDisplays.hvertex k r b) *\\n        (MainTheory.Orbit7AffineDisplays.delta r q i + MainTheory.Orbit7AffineDisplays.delta r q j)\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.parameter_norm\",\"type\":\"∀ (x t p : ℂ), x ≠ 0 → ‖p * x‖ = ‖t * x‖ → ‖p‖ = ‖t‖\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7AffineDisplays.polar_affine\",\"type\":\"∀ (x y : Fin 5 × Fin 5 → ℂ) (mu nu : ℂ) (i : Fin 5),\\n  SixQubit.Orbit7Universal.PolarHafnian5 y (fun e => mu * y e + nu * x e) i =\\n    2 * mu * SixQubit.Orbit7Universal.Hafnian5 y i + nu * SixQubit.Orbit7Universal.PolarHafnian5 x y i\"}","endPos":{"column":1,"line":1335},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1302},"severity":"information"}
