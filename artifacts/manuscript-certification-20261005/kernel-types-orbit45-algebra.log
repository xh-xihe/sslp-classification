{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7PairPurity.universal_pair_purity\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∃ s,\\n              (SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s *\\n                    SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s).trace =\\n                1 / 2\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7PauliPurityDisplay.universal_expansion\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∃ s,\\n              4 *\\n                  (SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s *\\n                      SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s).trace =\\n                1 +\\n                  ↑(∑ P ∈ MainTheory.PairPauliTrace.supportedNonidentity s,\\n                      Complex.normSq\\n                        (1 / 2 *\\n                          (MainTheory.PauliKernelTrace.pauliKernel P *\\n                              MainTheory.PairPartialTrace.familyKernel ![c, d]).trace))\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ProjectorComparison.circle_and_conjugate\",\"type\":\"∀ (c d : ℝ) (t p : ℂ),\\n  c ≠ 0 →\\n    c ^ 2 + d ^ 2 = 1 →\\n      Complex.normSq p = Complex.normSq t →\\n        MainTheory.Orbit7NormalizedProjectors.Pa c d t + MainTheory.Orbit7NormalizedProjectors.Pb p =\\n            SixQubit.Orbit7Universal.outer ![1, 0] +\\n              SixQubit.Orbit7Universal.outer (MainTheory.Orbit7SpinorCoordinates.nvec c d) →\\n          c * Complex.normSq t + d * t.re = 0 ∧ p = Star.star t\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ScalarDisplays.degree_displays\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i : Fin 5),\\n              5 / 6 - SixQubit.Orbit7Universal.degreeA c i = SixQubit.Orbit7Universal.degreeB d i + 1 / 6 ∧\\n                SixQubit.Orbit7Universal.degreeA c i + SixQubit.Orbit7Universal.degreeB d i = 2 / 3 ∧\\n                  2 * (5 / 6 - SixQubit.Orbit7Universal.degreeA c i) = SixQubit.Orbit7Universal.degreeB d i + 2 / 3 ∧\\n                    5 / 6 - SixQubit.Orbit7Universal.degreeA c i = 1 / 2 ∧\\n                      SixQubit.Orbit7Universal.degreeB d i + 1 / 6 = 1 / 2\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ScalarDisplays.fiber_residues\",\"type\":\"∀ (x : SS.BitString 6),\\n  (x ∈ SixQubit.Orbit7Universal.S0 ↔ SixQubit.Orbit7Universal.activeWt x % 3 = 0) ∧\\n    (x ∈ SixQubit.Orbit7Universal.S2 ↔ SixQubit.Orbit7Universal.activeWt x % 3 = 2)\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ScalarDisplays.inclusion_exclusion_display\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i j : Fin 5),\\n              5 / 6 - SixQubit.Orbit7Universal.degreeA c i - SixQubit.Orbit7Universal.degreeA c j +\\n                  SixQubit.Orbit7Universal.aMass c i j =\\n                1 / 6 + SixQubit.Orbit7Universal.aMass c i j\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ScalarDisplays.pair_moment\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n              ∑ f ∈ SixQubit.Orbit7Universal.nonincidentBoth e, SixQubit.Orbit7Universal.aMass c f.1 f.2 =\\n                SixQubit.Orbit7Universal.bMass d e.1 e.2 + 1 / 6\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7ScalarDisplays.shell_system\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 0 +\\n                  SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 3 =\\n                1 ∧\\n              SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 2 +\\n                    SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 5 =\\n                  1 ∧\\n                3 * SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 3 =\\n                    2 * SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 2 +\\n                      5 * SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 5 ∧\\n                  3 * SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 3 =\\n                    SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 2 +\\n                      10 * SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 5\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7SpinorCoordinates.coordinate_expansion\",\"type\":\"∀ (c d : ℝ),\\n  c ^ 2 + d ^ 2 = 1 →\\n    ∀ (a : SixQubit.Orbit7Universal.Spinor),\\n      a = fun i =>\\n        SixQubit.Orbit7Universal.spinInner (MainTheory.Orbit7SpinorCoordinates.nvec c d) a *\\n            MainTheory.Orbit7SpinorCoordinates.nvec c d i +\\n          SixQubit.Orbit7Universal.spinInner (MainTheory.Orbit7SpinorCoordinates.mvec c d) a *\\n            MainTheory.Orbit7SpinorCoordinates.mvec c d i\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7SpinorCoordinates.cross_parameter\",\"type\":\"∀ (c d : ℝ),\\n  c ^ 2 + d ^ 2 = 1 →\\n    ∀ (x y : ℂ) (b : SixQubit.Orbit7Universal.Spinor),\\n      b 0 +\\n            SixQubit.Orbit7Universal.spinInner (MainTheory.Orbit7SpinorCoordinates.avec c d x y)\\n              (MainTheory.Orbit7SpinorCoordinates.nvec c d) =\\n          0 →\\n        Complex.normSq (b 0) + Complex.normSq (b 1) =\\n            Complex.normSq (MainTheory.Orbit7SpinorCoordinates.avec c d x y 0) +\\n              Complex.normSq (MainTheory.Orbit7SpinorCoordinates.avec c d x y 1) →\\n          ∃ z, b = ![-Star.star x, Star.star z] ∧ ‖z‖ = ‖y‖\"}","endPos":{"column":1,"line":1403},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1370},"severity":"information"}
