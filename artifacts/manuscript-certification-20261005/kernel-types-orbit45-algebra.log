{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.OrderSix56LiteralNoGo.phase_relation\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  c (MainTheory.OrderSixSupportDisplays.bottom56 1) ≠ 0 →\\n    (∀ x ∉ SixQubit.Orbit56.S0, c x = 0) →\\n      (∀ x ∉ SixQubit.Orbit56.S1, d x = 0) →\\n        SS.HasDistance ![c, d] 3 →\\n          ∀ (i : Fin 10),\\n            2 ≤ ↑i ∧ ↑i ≤ 7 →\\n              d (MainTheory.OrderSixSupportDisplays.top56 i) =\\n                -MainTheory.OrderSix56LiteralNoGo.phase c d *\\n                  Star.star (c (MainTheory.OrderSixSupportDisplays.bottom56 i))\"}","endPos":{"column":1,"line":1913},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1880},"severity":"information"}
