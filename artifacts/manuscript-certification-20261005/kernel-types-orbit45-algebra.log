{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7EnumeratorDisplays.line_identities\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 1 +\\n                  MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 2 =\\n                1 ∧\\n              MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 3 = 0\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7EnumeratorDisplays.low_bound\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            1 ≤\\n              MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 1 +\\n                MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 2\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7EnumeratorDisplays.shadow_formula\",\"type\":\"∀ (psi : Fin 2 → SS.State 6 ℂ),\\n  SS.HasDistance psi 3 →\\n    SS.MacWilliams.Aco psi 0 = 4 →\\n      MainTheory.Orbit7EnumeratorDisplays.shadowZero psi =\\n          1 / 4 *\\n            (1 - MainTheory.Orbit7EnumeratorDisplays.normalizedA psi 1 -\\n                MainTheory.Orbit7EnumeratorDisplays.normalizedA psi 2 -\\n              MainTheory.Orbit7EnumeratorDisplays.normalizedA psi 3) ∧\\n        0 ≤ MainTheory.Orbit7EnumeratorDisplays.shadowZero psi\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7EnumeratorDisplays.universal_vectors\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∃ a,\\n              0 ≤ a ∧\\n                a ≤ 1 ∧\\n                  a = MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] 1 ∧\\n                    (fun j => MainTheory.Orbit7EnumeratorDisplays.normalizedA ![c, d] ↑j) =\\n                        ![1, a, 1 - a, 0, 11 + 4 * a, 16 - a, 3 - 3 * a] ∧\\n                      (fun j => MainTheory.Orbit7EnumeratorDisplays.normalizedB ![c, d] ↑j) =\\n                        ![1, a, 1 - a, 24 + 6 * a, 35 + 10 * a, 40 - 7 * a, 27 - 9 * a]\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7FourHafnians.of_code_coordinates\",\"type\":\"∀ (C D : SS.State 6 ℂ),\\n  (∀ (s : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv s ≠ 0 → C s = 0) →\\n    (∀ (s : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv s ≠ 2 → D s = 0) →\\n      SS.HasDistance ![C, D] 3 →\\n        ∀ (c d : ℝ),\\n          c ^ 2 + d ^ 2 = 1 →\\n            ∀ (x y z : MainTheory.Orbit7MatchingDisplays.Edge → ℂ),\\n              (∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n                  SixQubit.Orbit7Universal.spinor C (SixQubit.Orbit7Universal.aBase e.1 e.2) =\\n                    MainTheory.Orbit7SpinorCoordinates.avec c d (x e) (y e)) →\\n                (∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n                    SixQubit.Orbit7Universal.spinor D (SixQubit.Orbit7Universal.bBase e.1 e.2) =\\n                      MainTheory.Orbit7FourHafnians.bvec (x e) (z e)) →\\n                  ∀ (i : Fin 5),\\n                    SixQubit.Orbit7Universal.Hafnian5 x i = 0 ∧\\n                      SixQubit.Orbit7Universal.PolarHafnian5 x y i = 0 ∧\\n                        SixQubit.Orbit7Universal.PolarHafnian5 x z i = 0 ∧\\n                          SixQubit.Orbit7Universal.PolarHafnian5 y z i = 0\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7FrameCoordinates.constant_slope_impossible\",\"type\":\"∀ (c d : ℝ), c ≠ 0 → d ≠ 0 → -(d / c) * ((3 + 2 * c ^ 2) / 6) ≠ -(c * d) / 3\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7FrameCoordinates.xz_total\",\"type\":\"∀ {E : Type u_1} [DecidableEq E] (F : Finset E) (x z : E → ℂ) (c d : ℝ),\\n  (fun i j => ∑ e ∈ F, SixQubit.Orbit7Universal.outer (MainTheory.Orbit7FourHafnians.bvec (x e) (z e)) i j) =\\n      (1 / 2) • SixQubit.Orbit7Universal.outer ![1, 0] +\\n        (1 / 3) • SixQubit.Orbit7Universal.outer (MainTheory.Orbit7SpinorCoordinates.nvec c d) →\\n    ∑ e ∈ F, Star.star (x e) * z e = -↑c * ↑d / 3\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7GraphCaseEquations.bipartite_equations\",\"type\":\"∀ (x : Fin 5 × Fin 5 → ℂ),\\n  (∀ (i : Fin 5), SixQubit.Orbit7Universal.Hafnian5 x i = 0) →\\n    x (2, 3) = 0 →\\n      x (2, 4) = 0 →\\n        x (3, 4) = 0 →\\n          x (0, 3) * x (1, 4) + x (0, 4) * x (1, 3) = 0 ∧\\n            x (0, 2) * x (1, 4) + x (0, 4) * x (1, 2) = 0 ∧ x (0, 2) * x (1, 3) + x (0, 3) * x (1, 2) = 0\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit7GraphCaseEquations.missing_edge_equations\",\"type\":\"∀ (x : Fin 5 × Fin 5 → ℂ),\\n  (∀ (i : Fin 5), SixQubit.Orbit7Universal.Hafnian5 x i = 0) →\\n    x (3, 4) = 0 →\\n      x (1, 3) * x (2, 4) + x (1, 4) * x (2, 3) = 0 ∧\\n        x (0, 3) * x (2, 4) + x (0, 4) * x (2, 3) = 0 ∧ x (0, 3) * x (1, 4) + x (0, 4) * x (1, 3) = 0\"}","endPos":{"column":1,"line":1369},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1336},"severity":"information"}
