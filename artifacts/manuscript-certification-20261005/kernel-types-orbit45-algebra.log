{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit9Universal.companion_row\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ x ∉ SixQubit.Orbit9Universal.S0, c x = 0) →\\n    (∀ x ∉ SixQubit.Orbit9Universal.S1, d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (i : Fin 6),\\n          ∑ j ∈ Finset.univ.erase i,\\n              SixQubit.Orbit9Universal.damp c i j * Star.star (SixQubit.Orbit9Universal.yamp d j) =\\n            0\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
