{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.hamiltonian_commutator\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (h : Fin n → ℝ) (x y : QECC.BitString n),\\n  (QECC.CodeProjector.weightedNumberOp h * C.proj - C.proj * QECC.CodeProjector.weightedNumberOp h) x y =\\n    ↑(QECC.realSupportWeight h x - QECC.realSupportWeight h y) * C.proj x y\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.hamiltonian_scalar\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (h mu : Fin n → ℝ),\\n  (∀ (j : Fin n), C.proj * QECC.numberOp j * C.proj = ↑(mu j) • C.proj) →\\n    (∀ (x y : QECC.BitString n), C.proj x y ≠ 0 → QECC.realSupportWeight h x = QECC.realSupportWeight h y) →\\n      QECC.CodeProjector.weightedNumberOp h * C.proj = ↑(∑ j, h j * mu j) • C.proj\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.kernel_direction_scalar\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (h mu : Fin n → ℝ),\\n  (∀ (j : Fin n), C.proj * QECC.numberOp j * C.proj = ↑(mu j) • C.proj) →\\n    (∀ (x y : QECC.BitString n), C.proj x y ≠ 0 → QECC.realSupportWeight h x = QECC.realSupportWeight h y) →\\n      (QECC.diagonalGate fun j => ↑(h j)) * C.proj =\\n        Complex.exp (2 * ↑Real.pi * Complex.I * ↑(∑ j, h j * mu j)) • C.proj\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.preserving_integer_matrix_iff\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) [Fintype C.Edge] (t : Fin n → ℝ),\\n  (QECC.diagonalGate fun j => ↑(t j)) * C.proj * Matrix.conjTranspose (QECC.diagonalGate fun j => ↑(t j)) = C.proj ↔\\n    ∃ b, (C.edgeMatrix.map ⇑(Int.castRingHom ℝ)).mulVec t = fun e => ↑(b e)\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.real_conjugation_entry\",\"type\":\"∀ {n : ℕ} (t : Fin n → ℝ) (P : QECC.Operator n) (x y : QECC.BitString n),\\n  ((QECC.diagonalGate fun j => ↑(t j)) * P * Matrix.conjTranspose (QECC.diagonalGate fun j => ↑(t j))) x y =\\n    Complex.exp (2 * ↑Real.pi * Complex.I * ↑(QECC.realSupportWeight t x - QECC.realSupportWeight t y)) * P x y\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.DiagonalProofSteps.real_projective_replacement\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (r h mu : Fin n → ℝ),\\n  (∀ (j : Fin n), C.proj * QECC.numberOp j * C.proj = ↑(mu j) • C.proj) →\\n    (∀ (x y : QECC.BitString n), C.proj x y ≠ 0 → QECC.realSupportWeight h x = QECC.realSupportWeight h y) →\\n      (QECC.diagonalGate fun j => ↑(r j + h j)) * C.proj =\\n        Complex.exp (2 * ↑Real.pi * Complex.I * ↑(∑ j, h j * mu j)) • ((QECC.diagonalGate fun j => ↑(r j)) * C.proj)\"}","endPos":{"column":1,"line":689},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":656},"severity":"information"}
