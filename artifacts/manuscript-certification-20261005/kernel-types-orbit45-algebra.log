{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8PhaseNormalization.normalized_pair\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit8Universal.ball (MainTheory.Orbit8PhaseNormalization.phase c • c) =\\n                ↑MainTheory.Orbit8PhaseNormalization.b ∧\\n              (∀ (x : SS.BitString 6),\\n                  SS.weight SixQubit.Orbit8Universal.av x ≠ 0 →\\n                    (MainTheory.Orbit8PhaseNormalization.phase c • c) x = 0) ∧\\n                SS.innerC (MainTheory.Orbit8PhaseNormalization.phase c • c)\\n                      (MainTheory.Orbit8PhaseNormalization.phase c • c) =\\n                    1 ∧\\n                  SS.HasDistance ![MainTheory.Orbit8PhaseNormalization.phase c • c, d] 3\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ProjectorNormalization.normalized_kernel\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            MainTheory.PairPartialTrace.familyKernel ![MainTheory.Orbit8PhaseNormalization.phase c • c, d] =\\n              MainTheory.PairPartialTrace.familyKernel ![c, d]\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8QDisplay.operator_expansion\",\"type\":\"∀ (ud : Fin 6 → ℂ) (f : SS.State 6 ℂ),\\n  SixQubit.Orbit8Universal.Qact ud f = fun x =>\\n    ∑ i, ↑(Complex.normSq (ud i)) * (f x - SS.pauliAct (SixQubit.Orbit8Universal.Pz i) f x) / 2 +\\n      ∑ i,\\n        ∑ j,\\n          if i = j then 0\\n          else\\n            ud i * Star.star (ud j) *\\n              (MainTheory.Orbit8LadderMatrices.plus i * MainTheory.Orbit8LadderMatrices.minus j).mulVec f x\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ReconstructionDisplays.edge_mass_chain\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i j : Fin 6),\\n              i ≠ j →\\n                SixQubit.Orbit8Universal.w d i j =\\n                    1 / 12 - (SixQubit.Orbit8Universal.p d i + SixQubit.Orbit8Universal.p d j) / 2 ∧\\n                  1 / 12 - (SixQubit.Orbit8Universal.p d i + SixQubit.Orbit8Universal.p d j) / 2 =\\n                      (SixQubit.Orbit8Universal.r d - SixQubit.Orbit8Universal.p d i - SixQubit.Orbit8Universal.p d j) /\\n                        2 ∧\\n                    (SixQubit.Orbit8Universal.r d - SixQubit.Orbit8Universal.p d i - SixQubit.Orbit8Universal.p d j) /\\n                        2 =\\n                      1 / 2 * ∑ k, if k ≠ i ∧ k ≠ j then SixQubit.Orbit8Universal.p d k else 0\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ReconstructionDisplays.hafnian_forced\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i j : Fin 6), i ≠ j → SixQubit.Orbit8Universal.u d j * SixQubit.Orbit8Universal.compHaf d i j = 0\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ReconstructionDisplays.triple_normalized\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (b : ℝ),\\n              SixQubit.Orbit8Universal.ball c = ↑b →\\n                ∀ (i j k : Fin 6),\\n                  i ≠ j →\\n                    i ≠ k →\\n                      j ≠ k →\\n                        SixQubit.Orbit8Universal.a c i j k =\\n                          -(1 / ↑b) *\\n                            (SixQubit.Orbit8Universal.u d i * Star.star (SixQubit.Orbit8Universal.v d j k) +\\n                                SixQubit.Orbit8Universal.u d j * Star.star (SixQubit.Orbit8Universal.v d i k) +\\n                              SixQubit.Orbit8Universal.u d k * Star.star (SixQubit.Orbit8Universal.v d i j))\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8RotationSemantics.actual_family\",\"type\":\"∀ (C S : ℝ),\\n  (MainTheory.Orbit8RotationSemantics.physicalRotation C S).mulVec SixQubit.Orbit8Real.w0 =\\n      SixQubit.Orbit8Family.w0 C S ∧\\n    (MainTheory.Orbit8RotationSemantics.physicalRotation C S).mulVec SixQubit.Orbit8Real.w1 =\\n      SixQubit.Orbit8Family.w1 C S\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ShellDisplays.fiber_residues\",\"type\":\"∀ (x : SS.BitString 6),\\n  (x ∈ SixQubit.Orbit8Universal.S0 ↔ SS.hammingWt x % 3 = 0) ∧\\n    (x ∈ SixQubit.Orbit8Universal.S1 ↔ SS.hammingWt x % 3 = 1)\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ShellDisplays.pair_cross_normalized\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (b : ℝ),\\n          SixQubit.Orbit8Universal.ball c = ↑b →\\n            ∀ (i j : Fin 6),\\n              i ≠ j →\\n                ↑b * SixQubit.Orbit8Universal.v d i j +\\n                    ∑ k with k ≠ i ∧ k ≠ j,\\n                      SixQubit.Orbit8Universal.u d k * Star.star (SixQubit.Orbit8Universal.a c i j k) =\\n                  0\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ShellDisplays.shell_linear\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit8Universal.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 0 +\\n                    SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 3 +\\n                  SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 6 =\\n                1 ∧\\n              3 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 3 +\\n                    6 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 6 =\\n                  SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 1 +\\n                    4 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4 ∧\\n                SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 1 +\\n                      4 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4 =\\n                    1 + 3 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4 ∧\\n                  3 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 3 +\\n                      15 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S0 c 6 =\\n                    6 * SixQubit.Orbit8Universal.shellMass SixQubit.Orbit8Universal.S1 d 4\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8ShellDisplays.support_expansion\",\"type\":\"∀ (S : Finset (SS.BitString 6)) (f : SS.State 6 ℂ),\\n  (∀ x ∉ S, f x = 0) → ∀ (x : SS.BitString 6), f x = ∑ y ∈ S, if x = y then f y else 0\"}","endPos":{"column":1,"line":1471},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1438},"severity":"information"}
