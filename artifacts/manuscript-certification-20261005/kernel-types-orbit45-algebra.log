{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8PairDensity.actual_pair_density\",\"type\":\"∀ (C S : ℝ),\\n  C ^ 2 + S ^ 2 = 1 →\\n    SixQubit.Orbit7DirectMarginal.directPairMarginal (SixQubit.Orbit8Family.code C S) 3 =\\n      MainTheory.Orbit8PairDensity.density C S\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8PauliCoefficients.Q_pauli_all\",\"type\":\"∀ (ud : Fin 6 → ℂ) (f : SS.State 6 ℂ),\\n  SixQubit.Orbit8Universal.Qact ud f = fun x =>\\n    ↑(∑ i, Complex.normSq (ud i)) / 2 * f x +\\n      ∑ P ∈ SixQubit.Orbit8Universal.lowPaulis, MainTheory.Orbit8PauliCoefficients.coefficient ud P * SS.pauliAct P f x\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8PauliCoefficients.coefficient_real\",\"type\":\"∀ (ud : Fin 6 → ℂ) (P : SS.PauliString 6),\\n  Star.star (MainTheory.Orbit8PauliCoefficients.coefficient ud P) = MainTheory.Orbit8PauliCoefficients.coefficient ud P\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit8PauliCoefficients.coefficient_square_chain\",\"type\":\"∀ (ud : Fin 6 → ℂ),\\n  ∑ P ∈ SixQubit.Orbit8Universal.lowPaulis, (MainTheory.Orbit8PauliCoefficients.coefficient ud P).re ^ 2 =\\n      1 / 4 * ∑ i, Complex.normSq (ud i) ^ 2 +\\n        1 / 2 * ∑ ij ∈ SixQubit.Orbit8Universal.pairs6, Complex.normSq (ud ij.1) * Complex.normSq (ud ij.2) ∧\\n    1 / 4 * ∑ i, Complex.normSq (ud i) ^ 2 +\\n        1 / 2 * ∑ ij ∈ SixQubit.Orbit8Universal.pairs6, Complex.normSq (ud ij.1) * Complex.normSq (ud ij.2) =\\n      (∑ i, Complex.normSq (ud i)) ^ 2 / 4\"}","endPos":{"column":1,"line":1437},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1404},"severity":"information"}
