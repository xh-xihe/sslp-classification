{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit20.incidenceA\",\"type\":\"{y ∈ SixQubit.Orbit20.S1 | SS.bxor y SixQubit.Orbit20.efA ∈ SixQubit.Orbit20.S0} =\\n  {SixQubit.Orbit20.z0, SixQubit.Orbit20.z1, SixQubit.Orbit20.z2, SixQubit.Orbit20.z3, SixQubit.Orbit20.z4,\\n    SixQubit.Orbit20.z5, SixQubit.Orbit20.z6, SixQubit.Orbit20.z7, SixQubit.Orbit20.z8, SixQubit.Orbit20.z9,\\n    SixQubit.Orbit20.z10, SixQubit.Orbit20.z11, SixQubit.Orbit20.z12, SixQubit.Orbit20.z13, SixQubit.Orbit20.z14,\\n    SixQubit.Orbit20.z15}\"}","endPos":{"column":1,"line":2763},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2730},"severity":"information"}
