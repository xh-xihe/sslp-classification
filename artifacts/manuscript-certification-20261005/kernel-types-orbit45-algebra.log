{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit36TopPhaseDisplays.last_flip_relations\",\"type\":\"∀ {c d : SS.BitString 6 → ℂ} {tau : ℂ},\\n  SixQubit.Orbit36Enum.TopForm c d tau →\\n    ∀ (i : Fin 4),\\n      Star.star (c SixQubit.Orbit36.y1) *\\n              d (![SixQubit.Orbit36.z2, SixQubit.Orbit36.z3, SixQubit.Orbit36.z4, SixQubit.Orbit36.z5] i) +\\n            Star.star (c (![SixQubit.Orbit36.y2, SixQubit.Orbit36.y3, SixQubit.Orbit36.y4, SixQubit.Orbit36.y5] i)) *\\n              d SixQubit.Orbit36.z1 =\\n          0 ∧\\n        Star.star (c SixQubit.Orbit36.y0) *\\n              d (![SixQubit.Orbit36.z2, SixQubit.Orbit36.z3, SixQubit.Orbit36.z4, SixQubit.Orbit36.z5] i) +\\n            Star.star (c (![SixQubit.Orbit36.y2, SixQubit.Orbit36.y3, SixQubit.Orbit36.y4, SixQubit.Orbit36.y5] i)) *\\n              d SixQubit.Orbit36.z0 =\\n          0\"}","endPos":{"column":1,"line":1131},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1098},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit36TopPhaseDisplays.matching_of_topForm\",\"type\":\"∀ {c d : SS.BitString 6 → ℂ} {tau : ℂ},\\n  SixQubit.Orbit36Enum.TopForm c d tau →\\n    SixQubit.Orbit36.offSum c d SixQubit.Orbit36.ex56 SixQubit.Orbit36.w0 = 0 →\\n      c SixQubit.Orbit36.y6 * c SixQubit.Orbit36.y11 + c SixQubit.Orbit36.y7 * c SixQubit.Orbit36.y10 +\\n          c SixQubit.Orbit36.y8 * c SixQubit.Orbit36.y9 =\\n        0\"}","endPos":{"column":1,"line":1131},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1098},"severity":"information"}
