{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit21FarkasDisplay.identity\",\"type\":\"∀ (psi : Fin 2 → SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit21Cert.av x ≠ 0 → psi 0 x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit21Cert.av x ≠ 2 → psi 1 x = 0) →\\n      (∀ (i : Fin 2), SS.innerC (psi i) (psi i) = 1) →\\n        SS.HasDistance psi 3 →\\n          SS.MacWilliams.Aco psi 2 / 4 - 1 =\\n            2 *\\n                      (List.map (fun E => MainTheory.CompletePauliCoefficients.b psi (SixQubit.Orbit21Farkas.ofMask E))\\n                          SixQubit.Orbit21Coef.bset).sum +\\n                    2 *\\n                      (List.map\\n                          (fun E => MainTheory.CompleteShadowTrace.coefficient psi (SixQubit.Orbit21Farkas.ofMask E))\\n                          SixQubit.Orbit21Coef.tset).sum +\\n                  2 * MainTheory.Orbit21FarkasDisplay.selectedA psi SixQubit.Orbit21Coef.r2set +\\n                3 * MainTheory.Orbit21FarkasDisplay.selectedA psi SixQubit.Orbit21Coef.r3set +\\n              4 * MainTheory.Orbit21FarkasDisplay.selectedA psi SixQubit.Orbit21Coef.r4set\"}","endPos":{"column":1,"line":893},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":860},"severity":"information"}
