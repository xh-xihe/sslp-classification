{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ConnectedOrthogonality.exists_line\",\"type\":\"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] {V : Type u_2} {W : Type u_3}\\n  [FiniteDimensional ℂ E],\\n  Module.finrank ℂ E = 2 →\\n    ∀ (c : V → E) (d : W → E) (adj : V → W → Prop),\\n      (∀ (x : V), c x ≠ 0) →\\n        (∀ (y : W), d y ≠ 0) →\\n          (∀ (x : V) (y : W), adj x y → Inner.inner ℂ (c x) (d y) = 0) →\\n            ∀ (x0 : V),\\n              (∀ (x : V), Relation.ReflTransGen (fun a b => ∃ y, adj a y ∧ adj b y) x0 x) →\\n                (∀ (y : W), ∃ x, adj x y) → ∃ L, Module.finrank ℂ ↥L = 1 ∧ (∀ (x : V), c x ∈ L) ∧ ∀ (y : W), d y ∈ Lᗮ\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.ConnectedOrthogonality.frame_forms_ne\",\"type\":\"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] {V : Type u_2} {W : Type u_3}\\n  [inst_2 : Fintype V] [inst_3 : Fintype W] [FiniteDimensional ℂ E],\\n  Module.finrank ℂ E = 2 →\\n    ∀ (c : V → E) (d : W → E) (adj : V → W → Prop),\\n      (∀ (x : V), c x ≠ 0) →\\n        (∀ (y : W), d y ≠ 0) →\\n          (∀ (x : V) (y : W), adj x y → Inner.inner ℂ (c x) (d y) = 0) →\\n            ∀ (x0 : V),\\n              (∀ (x : V), Relation.ReflTransGen (fun a b => ∃ y, adj a y ∧ adj b y) x0 x) →\\n                (∀ (y : W), ∃ x, adj x y) → ∃ v, ∑ x, ‖Inner.inner ℂ (c x) v‖ ^ 2 ≠ ∑ y, ‖Inner.inner ℂ (d y) v‖ ^ 2\"}","endPos":{"column":1,"line":655},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":622},"severity":"information"}
