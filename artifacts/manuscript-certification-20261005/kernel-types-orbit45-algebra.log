{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"Orbit2.Encoder.magicCompression_diagonal_sum\",\"type\":\"∀ (V : Orbit2.Encoder) (i a : Fin 4),\\n  a ≠ 0 →\\n    V.magicCompression 0 0 (Orbit2.Quartic.single i a) + V.magicCompression 1 1 (Orbit2.Quartic.single i a) =\\n      (2 * V.activeMu (Orbit2.Quartic.single i a)) • 1\"}","endPos":{"column":1,"line":2491},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2458},"severity":"information"}
