{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Gauge.uniform0_iff_original1\",\"type\":\"∀ (x : SS.BitString 6),\\n  SS.weight SixQubit.Orbit7Universal.uniformAv x = 0 ↔\\n    SS.weight SixQubit.Orbit7Real.av (SS.bxor x SixQubit.Orbit7Gauge.flip45) = 1\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Gauge.uniform2_iff_original0\",\"type\":\"∀ (x : SS.BitString 6),\\n  SS.weight SixQubit.Orbit7Universal.uniformAv x = 2 ↔\\n    SS.weight SixQubit.Orbit7Real.av (SS.bxor x SixQubit.Orbit7Gauge.flip45) = 0\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.active_marginal_maximally_mixed\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∀ (i : Fin 5),\\n              SixQubit.Orbit7Universal.oneMarginal c i.succ = (1 / 2) • 1 ∧\\n                SixQubit.Orbit7Universal.oneMarginal d i.succ = (1 / 2) • 1\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.common_reduced\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (i j : Fin 2), SixQubit.Orbit7Universal.rhoC c i j = SixQubit.Orbit7Universal.rhoD d i j\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.disjoint_relation\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n          ∀ f ∈ SixQubit.Orbit7Universal.nonincidentBoth e,\\n            SixQubit.Orbit7Universal.spinInner\\n                (SixQubit.Orbit7Universal.spinor c (SixQubit.Orbit7Universal.aBase e.1 e.2))\\n                (SixQubit.Orbit7Universal.spinor d (SixQubit.Orbit7Universal.bBase f.1 f.2)) =\\n              SixQubit.Orbit7Universal.spinInner\\n                (SixQubit.Orbit7Universal.spinor c (SixQubit.Orbit7Universal.aBase f.1 f.2))\\n                (SixQubit.Orbit7Universal.spinor d (SixQubit.Orbit7Universal.bBase e.1 e.2))\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.exceptional_edge_sum_partition\",\"type\":\"∀ (r : Fin 5 → ℂ) (s : Fin 5) (R : ℂ),\\n  (∀ (i : Fin 5), i ≠ s → r i = R) →\\n    (∀ e ∈ SixQubit.Orbit7Universal.incidentPairs s, r e.1 + r e.2 = R + r s) ∧\\n      ∀ e ∈ SixQubit.Orbit7Universal.nonincidentPairs s, r e.1 + r e.2 = 2 * R\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.exceptional_vertex_of_full_tangent\",\"type\":\"∀ (x y : Fin 5 × Fin 5 → ℂ),\\n  SixQubit.Orbit7Universal.FullEdgeSupport x →\\n    (∀ (v : Fin 5), SixQubit.Orbit7Universal.Hafnian5 x v = 0) →\\n      SixQubit.Orbit7Universal.IsVertexTangent x y →\\n        (∀ (v : Fin 5), SixQubit.Orbit7Universal.Hafnian5 y v = 0) →\\n          ∃ r,\\n            (∀ e ∈ SixQubit.Orbit7Universal.edgePairs, y e = (r e.1 + r e.2) * x e) ∧\\n              ∃ s R, ∀ (i : Fin 5), i ≠ s → r i = R\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.full_hafnian_chart\",\"type\":\"∀ (x : Fin 5 × Fin 5 → ℂ),\\n  SixQubit.Orbit7Universal.FullEdgeSupport x →\\n    (∀ (v : Fin 5), SixQubit.Orbit7Universal.Hafnian5 x v = 0) →\\n      ∃ tau omega,\\n        tau ≠ 0 ∧\\n          1 + omega + omega ^ 2 = 0 ∧\\n            x (1, 2) / (x (0, 1) * x (0, 2)) = tau ∧\\n              x (3, 4) / (x (0, 3) * x (0, 4)) = tau ∧\\n                x (1, 3) / (x (0, 1) * x (0, 3)) = tau * omega ∧\\n                  x (2, 4) / (x (0, 2) * x (0, 4)) = tau * omega ∧\\n                    x (1, 4) / (x (0, 1) * x (0, 4)) = tau * omega ^ 2 ∧\\n                      x (2, 3) / (x (0, 2) * x (0, 3)) = tau * omega ^ 2\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.fully_certified\",\"type\":\"(∀ (c d : SS.State 6 ℂ),\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Real.av x ≠ 0 → c x = 0) →\\n      (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Real.av x ≠ 1 → d x = 0) →\\n        SS.innerC c c = 1 →\\n          SS.innerC d d = 1 →\\n            SS.HasDistance ![c, d] 3 →\\n              ∃ a,\\n                0 ≤ a ∧\\n                  a ≤ 1 ∧\\n                    SixQubit.Orbit7Family.IsFamilyA ![c, d] a ∧\\n                      SixQubit.Orbit7Family.IsFamilyB ![c, d] a ∧\\n                        ∃ s, (SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s).rank = 2) ∧\\n  ∀ (a : ℝ),\\n    0 ≤ a →\\n      a ≤ 1 →\\n        ∃ C S,\\n          C ^ 2 + S ^ 2 = 1 ∧\\n            SixQubit.Orbit7Family.alpha C S = a ∧\\n              (∀ (k : Fin 2), SS.innerC (SixQubit.Orbit7Family.code C S k) (SixQubit.Orbit7Family.code C S k) = 1) ∧\\n                SS.HasDistance (SixQubit.Orbit7Family.code C S) 3 ∧\\n                  (∀ (x : SS.BitString 6),\\n                      SS.weight SixQubit.Orbit7Real.av x ≠ 0 → SixQubit.Orbit7Family.w0 C S x = 0) ∧\\n                    (∀ (x : SS.BitString 6),\\n                        SS.weight SixQubit.Orbit7Real.av x ≠ 1 → SixQubit.Orbit7Family.w1 C S x = 0) ∧\\n                      SixQubit.Orbit7Family.IsFamilyA (SixQubit.Orbit7Family.code C S) a ∧\\n                        SixQubit.Orbit7Family.IsFamilyB (SixQubit.Orbit7Family.code C S) a ∧\\n                          ∃ s,\\n                            (SixQubit.Orbit7DirectMarginal.directPairMarginal (SixQubit.Orbit7Family.code C S) s).rank =\\n                              2\"}","endPos":{"column":1,"line":3409},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3376},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.global_frames\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        (∀ (i j : Fin 2),\\n            SixQubit.Orbit7Universal.sumA c i j =\\n              2 * SixQubit.Orbit7Universal.U c i j + 3 * SixQubit.Orbit7Universal.W d i j) ∧\\n          ∀ (i j : Fin 2),\\n            SixQubit.Orbit7Universal.sumB d i j =\\n              3 * SixQubit.Orbit7Universal.U c i j + 2 * SixQubit.Orbit7Universal.W d i j\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.interval_attainment\",\"type\":\"∀ (a : ℝ),\\n  0 ≤ a →\\n    a ≤ 1 →\\n      ∃ C S,\\n        C ^ 2 + S ^ 2 = 1 ∧\\n          SixQubit.Orbit7Family.alpha C S = a ∧\\n            (∀ (k : Fin 2), SS.innerC (SixQubit.Orbit7Family.code C S k) (SixQubit.Orbit7Family.code C S k) = 1) ∧\\n              SS.HasDistance (SixQubit.Orbit7Family.code C S) 3 ∧\\n                (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Real.av x ≠ 0 → SixQubit.Orbit7Family.w0 C S x = 0) ∧\\n                  (∀ (x : SS.BitString 6),\\n                      SS.weight SixQubit.Orbit7Real.av x ≠ 1 → SixQubit.Orbit7Family.w1 C S x = 0) ∧\\n                    SixQubit.Orbit7Family.IsFamilyA (SixQubit.Orbit7Family.code C S) a ∧\\n                      SixQubit.Orbit7Family.IsFamilyB (SixQubit.Orbit7Family.code C S) a ∧\\n                        ∃ s,\\n                          (SixQubit.Orbit7DirectMarginal.directPairMarginal (SixQubit.Orbit7Family.code C S) s).rank = 2\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.original_universal_converse\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Real.av x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Real.av x ≠ 1 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            ∃ a,\\n              0 ≤ a ∧\\n                a ≤ 1 ∧\\n                  SixQubit.Orbit7Family.IsFamilyA ![c, d] a ∧\\n                    SixQubit.Orbit7Family.IsFamilyB ![c, d] a ∧\\n                      ∃ s, (SixQubit.Orbit7DirectMarginal.directPairMarginal ![c, d] s).rank = 2\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.paircross\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n          SixQubit.Orbit7Universal.spinInner (SixQubit.Orbit7Universal.spinor c SixQubit.Orbit7Universal.zero)\\n                (SixQubit.Orbit7Universal.spinor d (SixQubit.Orbit7Universal.bBase e.1 e.2)) +\\n              SixQubit.Orbit7Universal.spinInner\\n                (SixQubit.Orbit7Universal.spinor c (SixQubit.Orbit7Universal.aBase e.1 e.2))\\n                (SixQubit.Orbit7Universal.spinor d SixQubit.Orbit7Universal.activeAll) =\\n            0\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.prestar_identity\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (v : Fin 5) (i j : Fin 2),\\n          SixQubit.Orbit7Universal.starA c v i j + SixQubit.Orbit7Universal.starB d v i j =\\n            SixQubit.Orbit7Universal.rhoC c i j - SixQubit.Orbit7Universal.U c i j - SixQubit.Orbit7Universal.W d i j\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.rho_identity\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (i j : Fin 2),\\n          SixQubit.Orbit7Universal.rhoC c i j =\\n            3 * (SixQubit.Orbit7Universal.U c i j + SixQubit.Orbit7Universal.W d i j)\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.rigid_shells\",\"type\":\"∀ (c d : SS.BitString 6 → ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 0 = 1 / 6 ∧\\n              SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S0 c 3 = 5 / 6 ∧\\n                SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 2 = 5 / 6 ∧\\n                  SixQubit.Orbit7Universal.shellMass SixQubit.Orbit7Universal.S2 d 5 = 1 / 6\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Orbit7Universal.scalar_normal_form\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 0 → c x = 0) →\\n    (∀ (x : SS.BitString 6), SS.weight SixQubit.Orbit7Universal.uniformAv x ≠ 2 → d x = 0) →\\n      SS.innerC c c = 1 →\\n        SS.innerC d d = 1 →\\n          SS.HasDistance ![c, d] 3 →\\n            SixQubit.Orbit7Universal.uMass c = 1 / 6 ∧\\n              SixQubit.Orbit7Universal.vMass d = 1 / 6 ∧\\n                SixQubit.Orbit7Universal.totalA c = 5 / 6 ∧\\n                  SixQubit.Orbit7Universal.totalB d = 5 / 6 ∧\\n                    (∀ (i : Fin 5),\\n                        SixQubit.Orbit7Universal.degreeA c i = 1 / 3 ∧ SixQubit.Orbit7Universal.degreeB d i = 1 / 3) ∧\\n                      ∀ e ∈ SixQubit.Orbit7Universal.edgePairs,\\n                        SixQubit.Orbit7Universal.aMass c e.1 e.2 = SixQubit.Orbit7Universal.bMass d e.1 e.2\"}","endPos":{"column":1,"line":3443},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3410},"severity":"information"}
