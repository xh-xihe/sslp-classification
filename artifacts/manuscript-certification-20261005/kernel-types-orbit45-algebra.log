{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatAlgebra.path_norm\",\"type\":\"∀ r ∈ Set.Icc 0 1,\\n  2 * MainTheory.PrimitiveOrderTwoCatAlgebra.pathA r ^ 2 + MainTheory.PrimitiveOrderTwoCatAlgebra.pathB r ^ 2 = 1 / 4\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatAlgebra.path_parameter\",\"type\":\"∀ r ∈ Set.Icc 0 1,\\n  MainTheory.PrimitiveOrderTwoCatAlgebra.parameter (MainTheory.PrimitiveOrderTwoCatAlgebra.pathA r)\\n      (MainTheory.PrimitiveOrderTwoCatAlgebra.pathB r) =\\n    2 / 3 + r ^ 2 / 3\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatAlgebra.path_surjective\",\"type\":\"∀ t ∈ Set.Icc (2 / 3) 1,\\n  ∃ r ∈ Set.Icc 0 1,\\n    MainTheory.PrimitiveOrderTwoCatAlgebra.parameter (MainTheory.PrimitiveOrderTwoCatAlgebra.pathA r)\\n        (MainTheory.PrimitiveOrderTwoCatAlgebra.pathB r) =\\n      t\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatAlgebra.real_gram\",\"type\":\"∀ (a b : ℝ),\\n  2 * a ^ 2 + b ^ 2 = 1 / 4 →\\n    ∀ (j k : Fin 5),\\n      (∑ t,\\n            (starRingEnd ℂ) (MainTheory.PrimitiveOrderTwoCatAlgebra.x a b j t) *\\n              MainTheory.PrimitiveOrderTwoCatAlgebra.x a b k t).re =\\n        (if j = k then 1 / 4 else 0) -\\n          MainTheory.PrimitiveOrderTwoCatAlgebra.e a b j * MainTheory.PrimitiveOrderTwoCatAlgebra.e a b k\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatAlgebra.tail_symmetric\",\"type\":\"∀ (a b : ℝ) (M : Matrix (Fin 5) (Fin 5) ℝ),\\n  (∀ (j k : Fin 5), M j k = M k j) →\\n    ∑ j,\\n          ∑ k,\\n            ↑(M j k) *\\n              MainTheory.PrimitiveOrderTwoCatAlgebra.gram (MainTheory.PrimitiveOrderTwoCatAlgebra.x a b j)\\n                (MainTheory.PrimitiveOrderTwoCatAlgebra.x a b k) =\\n        ∑ j,\\n          ∑ k,\\n            ↑(M j k) *\\n              MainTheory.PrimitiveOrderTwoCatAlgebra.gram (MainTheory.PrimitiveOrderTwoCatAlgebra.y a b j)\\n                (MainTheory.PrimitiveOrderTwoCatAlgebra.y a b k) ∧\\n      ∑ j,\\n          ∑ k,\\n            ↑(M j k) *\\n              MainTheory.PrimitiveOrderTwoCatAlgebra.gram (MainTheory.PrimitiveOrderTwoCatAlgebra.x a b j)\\n                (MainTheory.PrimitiveOrderTwoCatAlgebra.y a b k) =\\n        0\"}","endPos":{"column":1,"line":2253},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2220},"severity":"information"}
