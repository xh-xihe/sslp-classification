{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.canonicalPhaseSectorEquiv_support\",\"type\":\"∀ {n K q : ℕ} (C : QECC.CodeProjector n K) (a : Fin n → ZMod q) (t : QECC.BitString n) (sigma : Equiv.Perm (Fin n))\\n  (b : ZMod q) (psi : ↥(C.phaseSector a b)) (x : QECC.BitString n),\\n  QECC.subsetSum (QECC.permuteCoefficient sigma (QECC.xorCoefficient t a)) x ≠ b - QECC.subsetSum a t →\\n    ↑((C.canonicalPhaseSectorEquiv a t sigma b) psi) x = 0\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.card_activeResidue_eq_two_of_projectiveClass_ne_zero\",\"type\":\"∀ {n q : ℕ} [inst : NeZero q] (C : QECC.CodeProjector n 2) (hq : 0 < q) (a : Fin n → ZMod q)\\n  (hpres : C.Preserves ((QECC.phaseHom n q hq) a)),\\n  C.projectiveClassMap ⟨(QECC.phaseHom n q hq) a, hpres⟩ ≠ 0 → Fintype.card (C.ActiveResidue a) = 2\"}","endPos":{"column":1,"line":2559},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2526},"severity":"information"}
