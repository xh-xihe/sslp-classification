{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9ConnectedK4.component_of_edge\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (a b : Fin 6),\\n      (MainTheory.Orbit9ConnectedComponents.graph c).Adj a b →\\n        ∃ k l,\\n          MainTheory.Orbit9ConnectedComponents.component c a = {a, b, k, l} ∧\\n            (MainTheory.Orbit9ConnectedComponents.component c a).card = 4\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
