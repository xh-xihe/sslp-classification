{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatEncoder.encoder_apply\",\"type\":\"∀ (a b : ℝ) (i : Fin 2) (s : MainTheory.PrimitiveOrderTwoCatCompression.Bits) (k : Fin 2),\\n  MainTheory.PrimitiveOrderTwoCatEncoder.encoder a b (i, s) k =\\n    ∑ j,\\n      (if k = 0 then MainTheory.PrimitiveOrderTwoCatAlgebra.x a b j i\\n        else MainTheory.PrimitiveOrderTwoCatAlgebra.y a b j i) *\\n        MainTheory.PrimitiveOrderTwoCatCompression.cats s j\"}","endPos":{"column":1,"line":2287},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2254},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.PrimitiveOrderTwoCatEncoder.encoder_compression\",\"type\":\"∀ (a b : ℝ) (A : Matrix (Fin 2) (Fin 2) ℂ)\\n  (B : Matrix MainTheory.PrimitiveOrderTwoCatCompression.Bits MainTheory.PrimitiveOrderTwoCatCompression.Bits ℂ),\\n  (MainTheory.PrimitiveOrderTwoCatEncoder.encoder a b).conjTranspose * Matrix.kroneckerMap (fun x1 x2 => x1 * x2) A B *\\n      MainTheory.PrimitiveOrderTwoCatEncoder.encoder a b =\\n    (MainTheory.PrimitiveOrderTwoCatEncoder.spinors a b).conjTranspose *\\n        Matrix.kroneckerMap (fun x1 x2 => x1 * x2) A\\n          (MainTheory.PrimitiveOrderTwoCatCompression.cats.conjTranspose * B *\\n            MainTheory.PrimitiveOrderTwoCatCompression.cats) *\\n      MainTheory.PrimitiveOrderTwoCatEncoder.spinors a b\"}","endPos":{"column":1,"line":2287},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2254},"severity":"information"}
