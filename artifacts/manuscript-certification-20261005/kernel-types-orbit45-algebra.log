{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Trace5.frame_idem\",\"type\":\"∀ (a1 a2 a3 a4 : Fin 4 → ℂ),\\n  SixQubit.Trace5.ip a1 a2 = 0 →\\n    SixQubit.Trace5.ip a1 a3 = 0 →\\n      SixQubit.Trace5.ip a1 a4 = 0 →\\n        SixQubit.Trace5.ip a2 a1 = 0 →\\n          SixQubit.Trace5.ip a2 a3 = 0 →\\n            SixQubit.Trace5.ip a2 a4 = 0 →\\n              SixQubit.Trace5.ip a3 a1 = 0 →\\n                SixQubit.Trace5.ip a3 a2 = 0 →\\n                  SixQubit.Trace5.ip a3 a4 = 0 →\\n                    SixQubit.Trace5.ip a4 a1 = 0 →\\n                      SixQubit.Trace5.ip a4 a2 = 0 →\\n                        SixQubit.Trace5.ip a4 a3 = 0 →\\n                          SixQubit.Trace5.ip a1 a1 = 1 / 6 →\\n                            SixQubit.Trace5.ip a2 a2 = 1 / 6 →\\n                              SixQubit.Trace5.ip a3 a3 = 1 / 6 →\\n                                SixQubit.Trace5.ip a4 a4 = 1 / 6 →\\n                                  ∀ (k : Fin 4),\\n                                    SixQubit.Trace5.fr a1 a2 a3 a4 k 0 *\\n                                              Star.star (SixQubit.Trace5.fr a1 a2 a3 a4 k 0) +\\n                                            SixQubit.Trace5.fr a1 a2 a3 a4 k 1 *\\n                                              Star.star (SixQubit.Trace5.fr a1 a2 a3 a4 k 1) +\\n                                          SixQubit.Trace5.fr a1 a2 a3 a4 k 2 *\\n                                            Star.star (SixQubit.Trace5.fr a1 a2 a3 a4 k 2) +\\n                                        SixQubit.Trace5.fr a1 a2 a3 a4 k 3 *\\n                                          Star.star (SixQubit.Trace5.fr a1 a2 a3 a4 k 3) =\\n                                      1 / 6 *\\n                                        ↑(Complex.normSq (a1 k) + Complex.normSq (a2 k) + Complex.normSq (a3 k) +\\n                                            Complex.normSq (a4 k))\"}","endPos":{"column":1,"line":3477},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3444},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"SixQubit.Trace5.frame_swap\",\"type\":\"∀ (a1 a2 a3 a4 b1 b2 b3 b4 : Fin 4 → ℂ),\\n  (∀ (k l : Fin 4), SixQubit.Trace5.fr a1 a2 a3 a4 k l = SixQubit.Trace5.fr b1 b2 b3 b4 k l) →\\n    SixQubit.Trace5.ip a1 a1 * SixQubit.Trace5.ip a1 a1 + SixQubit.Trace5.ip a1 a2 * SixQubit.Trace5.ip a2 a1 +\\n                                  SixQubit.Trace5.ip a1 a3 * SixQubit.Trace5.ip a3 a1 +\\n                                SixQubit.Trace5.ip a1 a4 * SixQubit.Trace5.ip a4 a1 +\\n                              SixQubit.Trace5.ip a2 a1 * SixQubit.Trace5.ip a1 a2 +\\n                            SixQubit.Trace5.ip a2 a2 * SixQubit.Trace5.ip a2 a2 +\\n                          SixQubit.Trace5.ip a2 a3 * SixQubit.Trace5.ip a3 a2 +\\n                        SixQubit.Trace5.ip a2 a4 * SixQubit.Trace5.ip a4 a2 +\\n                      SixQubit.Trace5.ip a3 a1 * SixQubit.Trace5.ip a1 a3 +\\n                    SixQubit.Trace5.ip a3 a2 * SixQubit.Trace5.ip a2 a3 +\\n                  SixQubit.Trace5.ip a3 a3 * SixQubit.Trace5.ip a3 a3 +\\n                SixQubit.Trace5.ip a3 a4 * SixQubit.Trace5.ip a4 a3 +\\n              SixQubit.Trace5.ip a4 a1 * SixQubit.Trace5.ip a1 a4 +\\n            SixQubit.Trace5.ip a4 a2 * SixQubit.Trace5.ip a2 a4 +\\n          SixQubit.Trace5.ip a4 a3 * SixQubit.Trace5.ip a3 a4 +\\n        SixQubit.Trace5.ip a4 a4 * SixQubit.Trace5.ip a4 a4 =\\n      SixQubit.Trace5.ip a1 b1 * SixQubit.Trace5.ip b1 a1 + SixQubit.Trace5.ip a1 b2 * SixQubit.Trace5.ip b2 a1 +\\n                                  SixQubit.Trace5.ip a1 b3 * SixQubit.Trace5.ip b3 a1 +\\n                                SixQubit.Trace5.ip a1 b4 * SixQubit.Trace5.ip b4 a1 +\\n                              SixQubit.Trace5.ip a2 b1 * SixQubit.Trace5.ip b1 a2 +\\n                            SixQubit.Trace5.ip a2 b2 * SixQubit.Trace5.ip b2 a2 +\\n                          SixQubit.Trace5.ip a2 b3 * SixQubit.Trace5.ip b3 a2 +\\n                        SixQubit.Trace5.ip a2 b4 * SixQubit.Trace5.ip b4 a2 +\\n                      SixQubit.Trace5.ip a3 b1 * SixQubit.Trace5.ip b1 a3 +\\n                    SixQubit.Trace5.ip a3 b2 * SixQubit.Trace5.ip b2 a3 +\\n                  SixQubit.Trace5.ip a3 b3 * SixQubit.Trace5.ip b3 a3 +\\n                SixQubit.Trace5.ip a3 b4 * SixQubit.Trace5.ip b4 a3 +\\n              SixQubit.Trace5.ip a4 b1 * SixQubit.Trace5.ip b1 a4 +\\n            SixQubit.Trace5.ip a4 b2 * SixQubit.Trace5.ip b2 a4 +\\n          SixQubit.Trace5.ip a4 b3 * SixQubit.Trace5.ip b3 a4 +\\n        SixQubit.Trace5.ip a4 b4 * SixQubit.Trace5.ip b4 a4\"}","endPos":{"column":1,"line":3477},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":3444},"severity":"information"}
