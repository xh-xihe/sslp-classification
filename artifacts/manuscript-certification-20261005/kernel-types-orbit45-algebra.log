{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.general_sslp_directSum_converse\",\"type\":\"∀ {n q : ℕ} {ι : Type u_1} [inst : Fintype ι] (F : QECC.FiberProjectorFamily n q ι) (hq : 0 < q) (m d0 : ℕ),\\n  2 ≤ m →\\n    ∀ (hmq : m ∣ q) (i0 : ι) (gamma : ι → ZMod m),\\n      (∀ (i : ι), F.residue i = F.residue i0 + (QECC.colorEmbed m q hmq) (gamma i)) →\\n        QECC.ColorPrimitive m gamma →\\n          F.codeProjector.HasDistanceAtLeast d0 →\\n            (∀ (i : ι), 0 < F.multiplicity i) ∧\\n              Matrix.rank F.totalProjector = ∑ i, F.multiplicity i ∧\\n                F.codeProjector.Preserves ((QECC.phaseHom n q hq) F.coefficient) ∧\\n                  addOrderOf (F.codeProjector.projectiveClassMap ⟨(QECC.phaseHom n q hq) F.coefficient, ⋯⟩) = m ∧\\n                    F.codeProjector.HasDistanceAtLeast d0\"}","endPos":{"column":1,"line":2627},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2594},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.integerMatrix_uniform_rational_lift\",\"type\":\"∀ {r : Type u_1} {c : Type u_2} [Fintype r] [inst : Fintype c] [DecidableEq c] (A : Matrix r c ℤ),\\n  ∃ Q,\\n    0 < Q ∧\\n      ∀ (t : c → ℝ) (b : r → ℤ),\\n        ((A.map ⇑(Int.castRingHom ℝ)).mulVec t = fun i => ↑(b i)) →\\n          ∃ a, (A.map ⇑(Int.castRingHom ℝ)).mulVec (t - fun j => ↑(a j) / ↑Q) = 0\"}","endPos":{"column":1,"line":2627},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2594},"severity":"information"}
