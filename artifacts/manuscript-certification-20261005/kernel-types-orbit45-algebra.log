{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.sectorMoment_eq_of_detects_binaryMonomial\",\"type\":\"∀ {n K q : ℕ} (C : QECC.CodeProjector n K) (hq : 0 < q) (a : Fin n → ZMod q),\\n  C.Preserves ((QECC.phaseHom n q hq) a) →\\n    ∀ (J : Finset (Fin n)),\\n      C.Detects (QECC.CodeProjector.binaryMonomial J) →\\n        ∀ (b c : C.ActiveResidue a),\\n          ∑ x, C.sectorDistribution a b x * QECC.CodeProjector.binaryMonomialValue J x =\\n            ∑ x, C.sectorDistribution a c x * QECC.CodeProjector.binaryMonomialValue J x\"}","endPos":{"column":1,"line":2593},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2560},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"QECC.CodeProjector.sslp_color_residue_formula\",\"type\":\"∀ {n K : ℕ} (C : QECC.CodeProjector n K) (U : C.ProjectiveDiagonalGroup) (R : QECC.ReducedDiagonalRepresentative n)\\n  (hpres : C.Preserves R.phase) (b0 : C.ActiveResidue R.a),\\n  C.IntrinsicSSLPData U R hpres b0 →\\n    ∃ gamma, ∀ (b : C.ActiveResidue R.a), C.relativeResidues R.a b0 b = ↑(R.q / addOrderOf U) * ↑(gamma b).val\"}","endPos":{"column":1,"line":2593},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2560},"severity":"information"}
