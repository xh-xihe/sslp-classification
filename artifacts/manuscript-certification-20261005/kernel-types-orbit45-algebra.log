{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.OrderFour25Walsh.kernel_relations\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  (∀ x ∉ SixQubit.Orbit25.S0, c x = 0) →\\n    (∀ x ∉ SixQubit.Orbit25.S1, d x = 0) →\\n      SS.HasDistance ![c, d] 3 →\\n        ∀ (j : Fin 5),\\n          ∃ l,\\n            Star.star (c (MainTheory.OrderFour25Support.anchor Bool.false)) *\\n                  d (MainTheory.OrderFour25Support.tail Bool.false j) =\\n                l ∧\\n              Star.star (c (MainTheory.OrderFour25Support.anchor Bool.true)) *\\n                    d (MainTheory.OrderFour25Support.tail Bool.true j) =\\n                  -l ∧\\n                Star.star (c (MainTheory.OrderFour25Support.hat Bool.false j)) *\\n                      d (MainTheory.OrderFour25Support.full Bool.false) =\\n                    -l ∧\\n                  Star.star (c (MainTheory.OrderFour25Support.hat Bool.true j)) *\\n                      d (MainTheory.OrderFour25Support.full Bool.true) =\\n                    l\"}","endPos":{"column":1,"line":1675},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1642},"severity":"information"}
