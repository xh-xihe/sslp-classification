{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9FlipDisplays.dressed_flip\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i j : Fin 6),\\n      j ≠ i →\\n        ∑ k ∈ Finset.univ.erase i, MainTheory.Orbit9FlipDisplays.A c d i k -\\n                2 * MainTheory.Orbit9FlipDisplays.A c d i j -\\n              ∑ k ∈ Finset.univ.erase i, MainTheory.Orbit9FlipDisplays.B c d i k +\\n            2 * MainTheory.Orbit9FlipDisplays.B c d i j =\\n          0\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9FlipDisplays.edge_balance_both\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i j : Fin 6),\\n      j ≠ i →\\n        SixQubit.Orbit9Universal.p c j * SixQubit.Orbit9Universal.s d i j =\\n            SixQubit.Orbit9Universal.q d j * SixQubit.Orbit9Universal.r c i j ∧\\n          SixQubit.Orbit9Universal.p c i * SixQubit.Orbit9Universal.s d i j =\\n            SixQubit.Orbit9Universal.q d i * SixQubit.Orbit9Universal.r c i j\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.Orbit9FlipDisplays.phase_sync\",\"type\":\"∀ (c d : SS.State 6 ℂ),\\n  SixQubit.Orbit9Universal.FullKL c d →\\n    ∀ (i j : Fin 6),\\n      j ≠ i →\\n        0 < SixQubit.Orbit9Universal.p c i →\\n          0 < SixQubit.Orbit9Universal.p c j →\\n            SixQubit.Orbit9Universal.camp d i j =\\n                SixQubit.Orbit9Universal.rho c d i * Star.star (SixQubit.Orbit9Universal.damp c i j) ∧\\n              SixQubit.Orbit9Universal.camp d i j =\\n                SixQubit.Orbit9Universal.rho c d j * Star.star (SixQubit.Orbit9Universal.damp c i j)\"}","endPos":{"column":1,"line":1505},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":1472},"severity":"information"}
