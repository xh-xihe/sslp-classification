{"caption":"","data":"CERTIFICATION_TYPE {\"kind\":\"theorem\",\"name\":\"MainTheory.RationalSchurStep.completed_square\",\"type\":\"∀ {ι : Type u_1} [inst : Fintype ι] (d : ℚ),\\n  d ≠ 0 →\\n    ∀ (b : ι → ℚ) (A : Matrix ι ι ℚ) (x : ℚ) (y : ι → ℚ),\\n      d * x ^ 2 + 2 * x * ∑ i, b i * y i + MainTheory.RationalSchurStep.energy A y =\\n        d * (x + (∑ i, b i * y i) / d) ^ 2 +\\n          MainTheory.RationalSchurStep.energy (MainTheory.RationalSchurStep.residual d b A) y\"}","endPos":{"column":1,"line":2321},"fileName":"artifacts\\manuscript-certification-20261005\\kernel-types-orbit45-algebra.lean","isSilent":false,"keepFullRange":false,"kind":"[anonymous]","pos":{"column":0,"line":2288},"severity":"information"}
