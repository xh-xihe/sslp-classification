  have u3 : star (d z3) * d z3 = star (c y3) * c y3 := by
    rw [htf.t3]
    simp only [star_neg, star_mul', star_star]
    linear_combination (c y3 * star (c y3)) * htf.unit
  have u4 : star (d z4) * d z4 = star (c y4) * c y4 := by
    rw [htf.t4]
    simp only [star_neg, star_mul', star_star]
    linear_combination (c y4 * star (c y4)) * htf.unit
  have u5 : star (d z5) * d z5 = star (c y5) * c y5 := by
