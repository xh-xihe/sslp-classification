/-- The even diagonal projector traces. -/
theorem pv000000 (c d : SS.BitString 6 -> ℂ)
    (hc : ∀ s, s ∉ S0 → c s = 0) (hd : ∀ s, s ∉ S1 → d s = 0)
    (tau : ℂ) (htf : TopForm c d tau) (zz : SS.BitString 6)
    (hl : SS.bdot zz (SS.ones 6) = false) :
    projTrace c d ⟨bt000000, zz⟩
      = Complex.I ^ (SS.PauliString.mk bt000000 zz).numY * (2 * (SS.signC (SS.bdot zz y0) (star (c y0) * c y0) + SS.signC (SS.bdot zz y1) (star (c y1) * c y1) + SS.signC (SS.bdot zz y2) (star (c y2) * c y2) + SS.signC (SS.bdot zz y3) (star (c y3) * c y3) + SS.signC (SS.bdot zz y4) (star (c y4) * c y4) + SS.signC (SS.bdot zz y5) (star (c y5) * c y5) + SS.signC (SS.bdot zz y6) (star (c y6) * c y6) + SS.signC (SS.bdot zz y7) (star (c y7) * c y7) + SS.signC (SS.bdot zz y8) (star (c y8) * c y8) + SS.signC (SS.bdot zz y9) (star (c y9) * c y9) + SS.signC (SS.bdot zz y10) (star (c y10) * c y10) + SS.signC (SS.bdot zz y11) (star (c y11) * c y11))) := by
  obtain ⟨q0, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11⟩ := rel_mk000000 zz
  have u0 : star (d z0) * d z0 = star (c y0) * c y0 := by
    rw [htf.t0]
    simp only [star_mul', star_star]
    linear_combination (c y0 * star (c y0)) * htf.unit
  have u1 : star (d z1) * d z1 = star (c y1) * c y1 := by
    rw [htf.t1]
    simp only [star_mul', star_star]
