    q0, q1, q2, hl]
  simp only [signC_eq, sgn_xor, sgn_not]
  linear_combination (Complex.I ^ (SS.PauliString.mk bt101010 zz).numY * (sgn (SS.bdot zz y7) * (star (c y1) * c y7))) * sgn_sq (SS.bdot zz bt101010)

