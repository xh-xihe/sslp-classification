theorem dead_w4_000111 : ∀ zz : SS.BitString 6,
    (SS.PauliString.mk bt000111 zz).wt = 4 → SS.bdot zz (SS.ones 6) = !(SS.bdot zz bt000111) := by decide

theorem w4_000111 (c d : SS.BitString 6 -> ℂ)
    (hc : ∀ s, s ∉ S0 → c s = 0) (hd : ∀ s, s ∉ S1 → d s = 0)
    (tau : ℂ) (htf : TopForm c d tau) :
    (∑ zz : SS.BitString 6, if (SS.PauliString.mk bt000111 zz).wt = 4
        then Complex.normSq (projTrace c d ⟨bt000111, zz⟩) else 0) = 0 := by
  refine Finset.sum_eq_zero (fun zz _ => ?_)
  by_cases hw : (SS.PauliString.mk bt000111 zz).wt = 4
  · rw [if_pos hw, zv000111 c d hc hd tau htf zz (dead_w4_000111 zz hw), Complex.normSq_zero]
  · rw [if_neg hw]

