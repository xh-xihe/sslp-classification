/-- The live projector traces of the flip mask `000011`. -/
theorem pv000011 (c d : SS.BitString 6 -> ℂ)
    (hc : ∀ s, s ∉ S0 → c s = 0) (hd : ∀ s, s ∉ S1 → d s = 0)
    (tau : ℂ) (htf : TopForm c d tau) (zz : SS.BitString 6)
    (hl : SS.bdot zz (SS.ones 6) = SS.bdot zz bt000011) :
    projTrace c d ⟨bt000011, zz⟩
      = Complex.I ^ (SS.PauliString.mk bt000011 zz).numY
        * (2 * ((SS.signC (SS.bdot zz y0) (star (c y1) * c y0))
            + SS.signC (SS.bdot zz bt000011) (SS.signC (SS.bdot zz y0) (c y1 * star (c y0))))) := by
