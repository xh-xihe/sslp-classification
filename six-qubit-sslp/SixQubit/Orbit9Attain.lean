import Mathlib
import SS.HilbertKL
import SixQubit.Pin
import SixQubit.Orbit9Real

/-!
# Orbit 9: the enumerator of the exhibited code

The code of `SixQubit/Orbit9Real.lean` carries the `Z`-string on qubits
`011000`, whose overlap with every word of both supports is even, so it
fixes both logical words.  Its Pauli weight is 2, so `SixQubit/Pin.lean`
pins the enumerator to

    (1, 0, 1, 0, 11, 16, 3)

**Scope.**  This module supplies attainment of the rigid endpoint, not the
universal classification.  No mask has uniform parity on the complete orbit-9
fibres, so the mask argument cannot prove uniqueness.  The required complete-
fibre support reduction, exact A/B endpoint, and uniform-gauge weight-two scalar
are now kernel-proved in `Orbit9UniversalFinal` and its dependencies.

Generated by `tools/generators/genattain.py`.
-/

namespace SixQubit.Orbit9Attain

open SS.MacWilliams SixQubit.Pin SixQubit.Orbit9Real

/-- The `Z`-string on qubits `011000`. -/
def zmask : SS.BitString 6 := ![false, true, true, false, false, false]

/-- Its overlap with every bottom word is even. -/
theorem zmask_L0 : ∀ s ∈ L0, SS.bdot zmask s = false := by decide

/-- Its overlap with every top word is even. -/
theorem zmask_L1 : ∀ s ∈ L1, SS.bdot zmask s = false := by decide

/-- Its Pauli weight. -/
theorem zmask_wt :
    (⟨fun _ => false, zmask⟩ : SS.PauliString 6).wt = 2 := by decide

/-- **The exhibited orbit-9 code has enumerator `(1, 0, 1, 0, 11, 16, 3)`.** -/
theorem enumerator :
    Aco ![w0, w1] 1 = 0 ∧ Aco ![w0, w1] 2 = 4 ∧ Aco ![w0, w1] 3 = 0
      ∧ Aco ![w0, w1] 4 = 44 ∧ Aco ![w0, w1] 5 = 64
      ∧ Aco ![w0, w1] 6 = 12 := by
  have hnorm : ∀ k, SS.innerC ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) = 1 := by
    intro k
    fin_cases k
    · exact w0_normalized
    · exact w1_normalized
  have hG : ∀ k, SS.pauliAct (⟨fun _ => false, zmask⟩ : SS.PauliString 6)
      ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k)
        = ((![w0, w1] : Fin 2 → SS.State 6 ℂ) k) := by
    intro k
    fin_cases k
    · exact zstring_fixes w0 L0 w0_vanishes zmask zmask_L0
    · exact zstring_fixes w1 L1 w1_vanishes zmask zmask_L1
  exact (enumerator_of_forced ![w0, w1] is_code (Aco_zero _ hnorm) hnorm _ hG).2 zmask_wt

end SixQubit.Orbit9Attain
