theorem direct_diag_rows
    (a1 a2 a3 q u1 v1 u2 v2 u3 v3 : ℝ)
    (hp : Params a1 a2 a3 q u1 v1 u2 v2 u3 v3) :
    ∀ e z, (⟨e,z⟩ : SS.PauliString 6).wt ≤ 2 →
      SixQubit.diagOn S0 (cword a1 a2 a3 q u1 v1 u2 v2 u3 v3) e z =
      SixQubit.diagOn S1 (dword a1 a2 a3 q u1 v1 u2 v2 u3 v3) e z := by
  intro e z hw
  have hew : SS.hammingWt e ≤ 2 :=
    (Orbit45A2.hammingWt_x_le_wt (⟨e,z⟩ : SS.PauliString 6)).trans hw
  by_cases he : e ∈ Orbit45A2.liveX
  · simp only [Orbit45A2.liveX, Finset.mem_insert, Finset.mem_singleton] at he
    rcases he with rfl | rfl | rfl | rfl | rfl
    have hz := diagZ0_mem z hw
    simp only [diagZ0, Finset.mem_insert, Finset.mem_singleton] at hz
    rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact diag_0_0 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_1 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_2 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_3 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_4 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_5 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_6 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_8 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_9 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
    · exact diag_0_10 a1 a2 a3 q u1 v1 u2 v2 u3 v3 hp
