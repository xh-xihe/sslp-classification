import Mathlib

/-!
# Orbit 21: the certificate's coefficient

This file carries the residual coefficient, scaled by 32 so it is integral,
written over `Nat` masks so the kernel can compute with it: `decide` over
`Fin 6 -> Bool` is slow, and the development already uses the mask trick in
`SixQubit/Realize.lean`.  The final proof takes its support-level Walsh
transform in `Orbit21Walsh.lean`; it does not use the historical class-average
branch below.

Every term is a closed form in the label -- three fixed sets of Paulis from the
certificate, a few weight tests, the commutation pairing.  No sum over all 4096
labels appears.  The historical group-sum regression is split by `X`-mask so
Lean can release reduction caches between declarations.  For the 48 forced
masks its right-hand disjunct is selected directly; only 16 blocks of 64
coefficient identities are reduced.

Generated by `tools/generators/geno21coef.py`, which refuses to write unless the
closed form agrees with the reference computation on all 4096 labels.  The
script also retains the old group-sum identity as a regression check, with an
explicit warning that it is not a vanishing theorem.
-/

namespace SixQubit.Orbit21Coef

/-- Population count of a six-bit mask. -/
def pc (m : Nat) : Nat :=
  (m &&& 1) + ((m >>> 1) &&& 1) + ((m >>> 2) &&& 1)
    + ((m >>> 3) &&& 1) + ((m >>> 4) &&& 1) + ((m >>> 5) &&& 1)

/-- Pauli weight of the label `(x, z)`. -/
def wt (x z : Nat) : Nat := pc (x ||| z)

/-- The angle-vector weight of a mask, modulo four. -/
def wtA (m : Nat) : Nat :=
  ((m &&& 1) + ((m >>> 1) &&& 1) + ((m >>> 2) &&& 1)
    + 2 * ((m >>> 3) &&& 1) + 2 * ((m >>> 4) &&& 1)
    + 3 * ((m >>> 5) &&& 1)) % 4

/-- The commutation pairing, as `0` or `1`. -/
def pr (ex ez fx fz : Nat) : Nat := (pc (ex &&& fz) + pc (ez &&& fx)) % 2

/-- `(-1)^k`. -/
def sgn (k : Nat) : Int := if k % 2 = 0 then 1 else -1

/-- The `Z`-mask of the forced stabilizer `G = Z1 Z2 Z3 Z6`. -/
def gmask : Nat := 39

def bset : List (Nat × Nat) := [(0, 36), (0, 34), (0, 6)]

def tset : List (Nat × Nat) := [(0, 56), (16, 36), (16, 52), (0, 52), (8, 36), (8, 44), (0, 44), (0, 28), (16, 34), (16, 50), (0, 50), (8, 34), (8, 42), (0, 42), (0, 26), (16, 6), (16, 22), (0, 22), (8, 6), (8, 14), (0, 14), (0, 62)]

def r2set : List (Nat × Nat) := [(24, 0), (24, 16), (24, 8), (24, 24), (0, 24), (0, 52), (0, 44), (0, 50), (0, 42), (0, 22), (0, 14)]

def r3set : List (Nat × Nat) := [(0, 32), (0, 16), (0, 8), (0, 4), (0, 2), (0, 38)]

def r4set : List (Nat × Nat) := [(36, 0), (36, 32), (34, 0), (34, 32), (6, 0), (6, 4), (33, 0), (33, 32), (5, 0), (5, 4), (3, 0), (3, 2)]

def zset : List (Nat × Nat) := [(0, 1), (0, 2), (0, 4), (0, 32)]

def mem (x z : Nat) (L : List (Nat × Nat)) : Bool := L.contains (x, z)

/-- Thirty-two times the coefficient of `normSq (trProj psi F)` in

    (A_2 - 1) - RHS - (the constraint combination),

as a closed form in the label `F = (x, z)`. -/
def coef (x z : Nat) : Int :=
  (if wt x z = 2 then 32 else 0)
  - bset.foldl (fun acc E => acc + 2 * sgn (pr E.1 E.2 x z)) 0
  - tset.foldl (fun acc E => acc + 2 * sgn (pr E.1 E.2 x z + wt x z)) 0
  - (if mem x z r2set then 64 else 0)
  - (if mem x z r3set then 96 else 0)
  - (if mem x z r4set then 128 else 0)
  + (if wt x z = 6 then 16 else 0)
  + (if wt x z = 1 then 64 else 0)
  + (if wt x z = 2 then 16 else 0)
  + (if wt x z = 3 then 16 else 0)
  - 6 * sgn (pr 0 0 x z)
  + zset.foldl (fun acc Z => acc + 2 * sgn (pr Z.1 Z.2 x z)) 0
  - (if mem x z zset then 64 else 0)
  + (if x = 0 && z = 0 then 96 else 0)

/-- Historical predicate used by the superseded class-average attempt.

The second disjunct is *not* a vanishing condition for a word supported on a
proper subset of its fibre.  The final theorem never uses this predicate; it
uses the full-fibre Walsh cancellation in `Orbit21Walsh.lean`. -/
def forced (x : Nat) : Bool := pc (gmask &&& x) % 2 = 1 || wtA x != 0

/-- Multiplication by `G`, on labels. -/
def shiftG (x z : Nat) : Nat × Nat := (x, z ^^^ gmask)

/-- Conjugation by the diagonal gate `D`, on labels. -/
def shiftD (x z : Nat) : Nat × Nat := (x, z ^^^ (x &&& gmask))

/-- The group-sum check at X-mask `0`. -/
private theorem coef_group_sum_m00 : ∀ k < 64,
    coef 0 k + coef (shiftG 0 k).1 (shiftG 0 k).2
      + coef (shiftD 0 k).1 (shiftD 0 k).2
      + coef (shiftG (shiftD 0 k).1 (shiftD 0 k).2).1
          (shiftG (shiftD 0 k).1 (shiftD 0 k).2).2 = 0
    ∨ forced 0 = true := by
  decide

/-- The group-sum check at X-mask `1`. -/
private theorem coef_group_sum_m01 : ∀ k < 64,
    coef 1 k + coef (shiftG 1 k).1 (shiftG 1 k).2
      + coef (shiftD 1 k).1 (shiftD 1 k).2
      + coef (shiftG (shiftD 1 k).1 (shiftD 1 k).2).1
          (shiftG (shiftD 1 k).1 (shiftD 1 k).2).2 = 0
    ∨ forced 1 = true := by
  intro k hk
  exact Or.inr (by decide)

