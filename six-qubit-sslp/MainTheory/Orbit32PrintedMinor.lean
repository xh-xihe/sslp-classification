theorem factorization : P*minorQ=L*U := by
  have he : ∀ i j : Fin 23, (P*minorQ) i j=(L*U) i j := by decide +kernel
  exact Matrix.ext he

theorem permutation_orthogonal : P*P.transpose=1 := by
  have he : ∀ i j : Fin 23, (P*P.transpose) i j=(1 : Matrix (Fin 23) (Fin 23) ℚ) i j := by decide +kernel
  exact Matrix.ext he

theorem lower_triangular : L.BlockTriangular OrderDual.toDual := by
  change ∀ i j : Fin 23, i < j → L i j=0
  decide +kernel
theorem upper_triangular : U.BlockTriangular id := by
  change ∀ i j : Fin 23, j < i → U i j=0
  decide +kernel
theorem lower_diagonal : (∏ i : Fin 23, L i i)=1 := by decide +kernel
theorem upper_diagonal : (∏ i : Fin 23, U i i)=3456 := by decide +kernel
theorem lower_det : L.det=1 := by
  rw [Matrix.det_of_lowerTriangular L lower_triangular,lower_diagonal]
theorem upper_det : U.det=3456 := by
  rw [Matrix.det_of_upperTriangular upper_triangular,upper_diagonal]

def permFunction : Fin 23 → Fin 23 := ![⟨0,by decide⟩,⟨5,by decide⟩,⟨4,by decide⟩,⟨6,by decide⟩,⟨3,by decide⟩,⟨14,by decide⟩,⟨13,by decide⟩,⟨15,by decide⟩,⟨12,by decide⟩,⟨10,by decide⟩,⟨9,by decide⟩,⟨11,by decide⟩,⟨8,by decide⟩,⟨17,by decide⟩,⟨18,by decide⟩,⟨19,by decide⟩,⟨1,by decide⟩,⟨21,by decide⟩,⟨20,by decide⟩,⟨22,by decide⟩,⟨16,by decide⟩,⟨2,by decide⟩,⟨7,by decide⟩]
def inverseFunction : Fin 23 → Fin 23 := ![⟨0,by decide⟩,⟨16,by decide⟩,⟨21,by decide⟩,⟨4,by decide⟩,⟨2,by decide⟩,⟨1,by decide⟩,⟨3,by decide⟩,⟨22,by decide⟩,⟨12,by decide⟩,⟨10,by decide⟩,⟨9,by decide⟩,⟨11,by decide⟩,⟨8,by decide⟩,⟨6,by decide⟩,⟨5,by decide⟩,⟨7,by decide⟩,⟨20,by decide⟩,⟨13,by decide⟩,⟨14,by decide⟩,⟨15,by decide⟩,⟨18,by decide⟩,⟨17,by decide⟩,⟨19,by decide⟩]
def permutation : Equiv.Perm (Fin 23) where
  toFun := permFunction
  invFun := inverseFunction
  left_inv := by decide +kernel
  right_inv := by decide +kernel
theorem permutation_matrix : P=(1 : Matrix (Fin 23) (Fin 23) ℚ).submatrix permutation id := by
  decide +kernel
theorem permutation_sign : Equiv.Perm.sign permutation=1 := by decide +kernel
theorem permutation_det : P.det=1 := by
  rw [permutation_matrix,Matrix.det_permute,Matrix.det_one,permutation_sign]
  norm_num
theorem determinant : minorQ.det=3456 := by
  have he := congrArg Matrix.det factorization
  simpa only [Matrix.det_mul,permutation_det,lower_det,upper_det,one_mul] using he
theorem determinant_abs : |minorQ.det|=3456 := by rw [determinant]; norm_num

def matrixR : Matrix (Fin 23) (Fin 32) ℝ := matrixZ.map (Int.castRingHom ℝ)

def minorR : Matrix (Fin 23) (Fin 23) ℝ :=
  matrixR.submatrix id printedColumns
theorem real_cast : minorR=minorQ.map (Rat.castHom ℝ) := by
  ext i j
  simp [minorR,minorQ,matrixR,Matrix.map_apply,Matrix.submatrix_apply]
theorem real_determinant : minorR.det=3456 := by
  rw [real_cast]
  change ((Rat.castHom ℝ).mapMatrix minorQ).det=3456
  rw [← RingHom.map_det]
  change (minorQ.det : ℝ)=3456
  exact_mod_cast determinant

theorem real_determinant_abs : |minorR.det|=3456 := by
  rw [real_cast]
  change |((Rat.castHom ℝ).mapMatrix minorQ).det|=3456
  rw [← RingHom.map_det]
  change |(minorQ.det : ℝ)|=3456
  exact_mod_cast determinant_abs
theorem full_rank : matrixR.rank=23 := by
  have hu : IsUnit minorR.det := by
    rw [real_determinant]
    norm_num
  have hm : minorR.rank=23 := by
    simpa using Matrix.rank_of_isUnit minorR ((Matrix.isUnit_iff_isUnit_det minorR).mpr hu)
  have hle : minorR.rank ≤ matrixR.rank := by
    rw [← Matrix.rank_transpose minorR,← Matrix.rank_transpose matrixR]
    exact Matrix.rank_submatrix_le printedColumns (Equiv.refl (Fin 23)) matrixR.transpose
  apply le_antisymm
  · simpa using Matrix.rank_le_card_height matrixR
  · simpa only [hm] using hle
theorem kernel_dimension : Module.finrank ℝ (LinearMap.ker matrixR.mulVecLin)=9 := by
  have he := LinearMap.finrank_range_add_finrank_ker matrixR.mulVecLin
  change matrixR.rank+Module.finrank ℝ (LinearMap.ker matrixR.mulVecLin)=Module.finrank ℝ (Fin 32 → ℝ) at he
  rw [full_rank] at he
  norm_num at he
  omega
end
