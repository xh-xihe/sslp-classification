import MainTheory.RankTwoSSLP

/-!
# The order of the intrinsic group, and where the paper's `m` sits inside it

`thm:rank-two-sslp` says the projective diagonal logical group "is cyclic, say
`C_m`".  Two different numbers are called `m` in the neighbourhood of that
sentence, and this repository proves things about both without ever having
related them:

* `TwoFiberCertificate.logicalOrder` -- the order of the eigenvalue ratio of
  ONE chosen symmetry.  `intrinsic_order_eq` identifies it with
  `orderOf G.intrinsicClass`.
* the order of the whole group, `Nat.card (IntrinsicGroup C)`.

They coincide exactly when the chosen symmetry generates, which the
construction does not arrange: `finiteGenerator` is built from an arbitrary
projectively nontrivial symmetry.  What is true unconditionally is that the
first divides the second, and that the second is the order of some element.
Both are recorded here.
-/

namespace MainTheory.GroupOrder

open MainTheory.ClassificationLevels
open MainTheory.GlobalClassificationBridge

variable {n : ℕ}

/-- **The group is `C_M` with `M = |G|`**: a cyclic group of finite order is
generated by an element whose order is the cardinality. -/
theorem exists_generator_orderOf_eq_natCard (C : CodeSpec.ExactCode n 2 3) :
    ∃ g : IntrinsicGroup C,
      (∀ x : IntrinsicGroup C, x ∈ Subgroup.zpowers g) ∧
        orderOf g = Nat.card (IntrinsicGroup C) := by
  haveI := GeneralFiniteness.finite_intrinsicGroup C
  haveI := GeneralFiniteness.isCyclic C
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := IntrinsicGroup C)
  refine ⟨g, hg, ?_⟩
  have htop : Subgroup.zpowers g = (⊤ : Subgroup (IntrinsicGroup C)) :=
    (Subgroup.eq_top_iff' _).2 hg
  calc
    orderOf g = Nat.card (Subgroup.zpowers g) := (Nat.card_zpowers g).symm
    _ = Nat.card ((⊤ : Subgroup (IntrinsicGroup C)) : Set (IntrinsicGroup C)) := by
        rw [htop]; rfl
    _ = Nat.card (IntrinsicGroup C) := by
        simp

/-- **The paper's `m` divides the group order.**

`m` is the order of one class, so Lagrange applies; the finiteness that makes
this informative is the substantive theorem `finite_intrinsicGroup`. -/
theorem logicalOrder_dvd_natCard {q : ℕ} [NeZero q]
    {C : CodeSpec.ExactCode n 2 3}
    {G : RankTwoGlobal.FiniteGeneratorResolution C q}
    (T : RankTwoGlobal.TwoFiberCertificate G) :
    T.logicalOrder ∣ Nat.card (IntrinsicGroup C) := by
  rw [← T.intrinsic_order_eq]
  exact orderOf_dvd_natCard _

/-- **The paper's `m` is the whole group order exactly when its symmetry
generates.**  This is the honest form of "the group is `C_m`": the identity
`m = |G|` is not automatic, it is a hypothesis on the chosen symmetry. -/
theorem logicalOrder_eq_natCard_of_generator {q : ℕ} [NeZero q]
    {C : CodeSpec.ExactCode n 2 3}
    {G : RankTwoGlobal.FiniteGeneratorResolution C q}
    (T : RankTwoGlobal.TwoFiberCertificate G)
    (hgen : ∀ x : IntrinsicGroup C, x ∈ Subgroup.zpowers G.intrinsicClass) :
    T.logicalOrder = Nat.card (IntrinsicGroup C) := by
  have htop : Subgroup.zpowers G.intrinsicClass
      = (⊤ : Subgroup (IntrinsicGroup C)) :=
    (Subgroup.eq_top_iff' _).2 hgen
  rw [← T.intrinsic_order_eq]
  calc
    orderOf G.intrinsicClass
        = Nat.card (Subgroup.zpowers G.intrinsicClass) :=
      (Nat.card_zpowers _).symm
    _ = Nat.card ((⊤ : Subgroup (IntrinsicGroup C)) : Set (IntrinsicGroup C)) := by
        rw [htop]; rfl
    _ = Nat.card (IntrinsicGroup C) := by simp

/-- **A nontrivial symmetry forces `2 <= |G|`**, so the paper's `m >= 2` is
inherited by the group order. -/
theorem two_le_natCard {q : ℕ} [NeZero q]
    {C : CodeSpec.ExactCode n 2 3}
    {G : RankTwoGlobal.FiniteGeneratorResolution C q}
    (T : RankTwoGlobal.TwoFiberCertificate G) :
    2 ≤ Nat.card (IntrinsicGroup C) := by
  haveI := GeneralFiniteness.finite_intrinsicGroup C
  have hpos : 0 < Nat.card (IntrinsicGroup C) := Nat.card_pos
  exact le_trans T.two_le_logicalOrder
    (Nat.le_of_dvd hpos (logicalOrder_dvd_natCard T))

end MainTheory.GroupOrder
