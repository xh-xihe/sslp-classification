import Mathlib
import MainTheory.CodeSpec
import MainTheory.CubeAction
import MainTheory.Levels
import MainTheory.MomentPolytope

/-!
# The four classification levels of Definition 6.1

`documents/20260822/main.tex` deliberately distinguishes four objects which
are often all called a "classification".  This file gives each one a separate
Lean type and, where a quotient is involved, a separately proved equivalence
relation:

1. the intrinsic projective diagonal logical group of a code projector;
2. the SSLP moment orbit of labelled `(q,m)` full-fibre data;
3. the normalized weight-enumerator image `Levels.WImage`;
4. the local-unitary/permutation equivalence class of a code projector.

The operator layer is written as finite matrix kernels on the computational
basis.  In particular the LU relation below does not use an informal tensor
product placeholder: its one-qubit and permutation generators have explicit
kernels, and the equivalence closure is the group orbit generated by them.
-/

namespace MainTheory.ClassificationLevels

open scoped BigOperators ComplexConjugate

noncomputable section

/-! ## Projectors as matrix kernels -/

/-- A square operator kernel on the `n`-qubit computational basis. -/
abbrev OperatorKernel (n : ℕ) := Matrix (SS.BitString n) (SS.BitString n) ℂ

/-- Orthogonal-projector axioms, stated entirely at matrix-kernel level. -/
structure CodeProjector (n : ℕ) where
  kernel : OperatorKernel n
  hermitian : star kernel = kernel
  idempotent : kernel * kernel = kernel

@[ext] theorem CodeProjector.ext {n : ℕ} {P Q : CodeProjector n}
    (h : P.kernel = Q.kernel) : P = Q := by
  cases P
  cases Q
  simp_all

/-- Action of an operator kernel on a state. -/
def kernelAction {n : ℕ} (A : OperatorKernel n) (phi : SS.State n ℂ) :
    SS.State n ℂ :=
  fun x => ∑ y, A x y * phi y

/-- The range of a code projector, characterized by its fixed vectors. -/
def InProjectorRange {n : ℕ} (P : CodeProjector n) (phi : SS.State n ℂ) : Prop :=
  kernelAction P.kernel phi = phi

/-- Every orthonormal logical frame supplies an honest code projector. -/
def CodeProjector.ofFrame {n K : ℕ} (F : CodeSpec.OrthonormalFrame n K) :
    CodeProjector n where
  kernel := CodeSpec.projectorKernel F
  hermitian := by
    ext x y
    rw [Matrix.star_apply]
    exact CodeSpec.star_projectorKernel F y x
  idempotent := by
    ext x y
    let e : SS.State n ℂ := fun z => if z = y then 1 else 0
    have he : CodeSpec.projectorAction F e =
        fun z => CodeSpec.projectorKernel F z y := by
      funext z
      rw [CodeSpec.projectorAction_eq_kernel]
      simp [e]
    have hid := congrFun (CodeSpec.projectorAction_idempotent F e) x
    rw [CodeSpec.projectorAction_eq_kernel] at hid
    rw [he] at hid
    simpa [Matrix.mul_apply] using hid

/-! ## Level (i): the intrinsic projective diagonal logical group -/

/-- Local diagonal phases after quotienting the physically irrelevant
`|0⟩` phases: the phase at site `j` multiplies the `|1⟩` component. -/
abbrev LocalPhase (n : ℕ) := Fin n → unitary ℂ

/-- Product phase acquired by a computational basis string. -/
def diagonalValue {n : ℕ} (u : LocalPhase n) (x : SS.BitString n) : ℂ :=
  ∏ j, if x j then (u j : ℂ) else 1

/-- Action of a local diagonal unitary on a state. -/
def diagonalAction {n : ℕ} (u : LocalPhase n) (phi : SS.State n ℂ) :
    SS.State n ℂ :=
  fun x => diagonalValue u x * phi x

/-- Matrix kernel of the same diagonal physical unitary. -/
def diagonalKernel {n : ℕ} (u : LocalPhase n) : OperatorKernel n :=
  fun x y => if x = y then diagonalValue u x else 0

/-- The matrix-kernel and pointwise descriptions of a diagonal unitary agree. -/
theorem kernelAction_diagonalKernel {n : ℕ} (u : LocalPhase n)
    (phi : SS.State n ℂ) :
    kernelAction (diagonalKernel u) phi = diagonalAction u phi := by
  funext x
  simp [kernelAction, diagonalKernel, diagonalAction]

@[simp] theorem diagonalValue_one {n : ℕ} (x : SS.BitString n) :
    diagonalValue (1 : LocalPhase n) x = 1 := by
  simp [diagonalValue]

theorem diagonalValue_mul {n : ℕ} (u v : LocalPhase n) (x : SS.BitString n) :
    diagonalValue (u * v) x = diagonalValue u x * diagonalValue v x := by
  simp only [diagonalValue, Pi.mul_apply, Submonoid.coe_mul]
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro j _
  by_cases hx : x j <;> simp [hx]

@[simp] theorem diagonalAction_one {n : ℕ} (phi : SS.State n ℂ) :
    diagonalAction (1 : LocalPhase n) phi = phi := by
  funext x
  simp [diagonalAction]

theorem diagonalAction_mul {n : ℕ} (u v : LocalPhase n) (phi : SS.State n ℂ) :
    diagonalAction (u * v) phi = diagonalAction u (diagonalAction v phi) := by
  funext x
  simp [diagonalAction, diagonalValue_mul]
  ring

theorem diagonalAction_smul {n : ℕ} (u : LocalPhase n) (a : ℂ)
    (phi : SS.State n ℂ) :
    diagonalAction u (a • phi) = a • diagonalAction u phi := by
  funext x
  simp [diagonalAction]
  ring

@[simp] theorem diagonalAction_inv_left {n : ℕ} (u : LocalPhase n)
    (phi : SS.State n ℂ) :
    diagonalAction u⁻¹ (diagonalAction u phi) = phi := by
  rw [← diagonalAction_mul]
  simp

@[simp] theorem diagonalAction_inv_right {n : ℕ} (u : LocalPhase n)
    (phi : SS.State n ℂ) :
    diagonalAction u (diagonalAction u⁻¹ phi) = phi := by
  rw [← diagonalAction_mul]
  simp

/-- A diagonal phase preserves the projector range in both directions.  The
two directions express equality of the code subspace, not mere inclusion. -/
def PreservesProjectorRange {n : ℕ} (P : CodeProjector n)
    (u : LocalPhase n) : Prop :=
  (∀ phi, InProjectorRange P phi → InProjectorRange P (diagonalAction u phi)) ∧
  (∀ phi, InProjectorRange P phi → InProjectorRange P (diagonalAction u⁻¹ phi))

/-- The full group of local diagonal physical symmetries of `P`. -/
def diagonalSymmetryGroup {n : ℕ} (P : CodeProjector n) : Subgroup (LocalPhase n) where
  carrier := {u | PreservesProjectorRange P u}
  one_mem' := by
    constructor <;> intro phi hphi <;> simpa using hphi
  mul_mem' := by
    intro u v hu hv
    constructor
    · intro phi hphi
      rw [diagonalAction_mul]
      exact hu.1 _ (hv.1 _ hphi)
    · intro phi hphi
      rw [show (u * v)⁻¹ = v⁻¹ * u⁻¹ by simp, diagonalAction_mul]
      exact hv.2 _ (hu.2 _ hphi)
  inv_mem' := by
    intro u hu
    exact ⟨hu.2, by simpa using hu.1⟩

/-- A diagonal symmetry is projectively trivial when it acts by one common
nonzero scalar on the entire projector range. -/
def IsProjectivelyTrivial {n : ℕ} (P : CodeProjector n)
    (u : diagonalSymmetryGroup P) : Prop :=
  ∃ lam : ℂ, lam ≠ 0 ∧
    ∀ phi, InProjectorRange P phi → diagonalAction (u : LocalPhase n) phi = lam • phi

/-- Projectively trivial symmetries form a subgroup. -/
def projectivelyTrivialSubgroup {n : ℕ} (P : CodeProjector n) :
    Subgroup (diagonalSymmetryGroup P) where
  carrier := {u | IsProjectivelyTrivial P u}
  one_mem' := by
    refine ⟨1, one_ne_zero, ?_⟩
    intro phi hphi
    simp
  mul_mem' := by
    rintro u v ⟨lam, hlam, hu⟩ ⟨mu, hmu, hv⟩
    refine ⟨lam * mu, mul_ne_zero hlam hmu, ?_⟩
    intro phi hphi
    change diagonalAction ((u : LocalPhase n) * (v : LocalPhase n)) phi =
      (lam * mu) • phi
    rw [diagonalAction_mul, hv phi hphi, diagonalAction_smul, hu phi hphi]
    simp [smul_smul, mul_comm]
  inv_mem' := by
    rintro u ⟨lam, hlam, hu⟩
    refine ⟨lam⁻¹, inv_ne_zero hlam, ?_⟩
    intro phi hphi
    have hrange : InProjectorRange P (diagonalAction (u : LocalPhase n)⁻¹ phi) :=
      u.property.2 phi hphi
    have h := hu (diagonalAction (u : LocalPhase n)⁻¹ phi) hrange
    have hscalar : phi = lam • diagonalAction (u : LocalPhase n)⁻¹ phi := by
      simpa using h
    calc
      diagonalAction ((↑(u⁻¹) : LocalPhase n)) phi =
          diagonalAction (u : LocalPhase n)⁻¹ phi := by rfl
      _ = lam⁻¹ • (lam • diagonalAction (u : LocalPhase n)⁻¹ phi) := by
        simp [smul_smul, hlam]
      _ = lam⁻¹ • phi := by rw [← hscalar]

/-- **Definition 6.1(i).**  The intrinsic projective diagonal logical group:
all diagonal physical symmetries of `P`, modulo those inducing a scalar on the
code.  This is a genuine quotient group, not the chosen order label `m`. -/
abbrev IntrinsicProjectiveDiagonalLogicalGroup {n : ℕ} (P : CodeProjector n) :=
  diagonalSymmetryGroup P ⧸ projectivelyTrivialSubgroup P

/-- Canonical class of one diagonal symmetry in the intrinsic group. -/
def intrinsicClass {n : ℕ} (P : CodeProjector n)
    (u : diagonalSymmetryGroup P) : IntrinsicProjectiveDiagonalLogicalGroup P :=
  QuotientGroup.mk u

/-- Equality in level (i) is an equivalence relation independently of every
outer SSLP order label. -/
def IntrinsicEquivalent {n : ℕ} (P : CodeProjector n)
    (u v : diagonalSymmetryGroup P) : Prop :=
  intrinsicClass P u = intrinsicClass P v

theorem intrinsicEquivalent_equivalence {n : ℕ} (P : CodeProjector n) :
    Equivalence (IntrinsicEquivalent P) :=
  ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-! ## Level (ii): labelled SSLP moment orbits -/

/-- Full two-colour fibre data with the order labels retained.  Positivity and
`m ∣ q` ensure that the distinguished residue step `q/m` is meaningful. -/
structure SSLPMomentDatum where
  q : ℕ
  m : ℕ
  q_pos : 0 < q
  m_pos : 0 < m
  m_dvd_q : m ∣ q
  fibers : CubeAction.FiberPair 6

/-- Indices of the first full fibre. -/
abbrev SSLPMomentDatum.LeftIndex (R : SSLPMomentDatum) :=
  {x : SS.BitString 6 // x ∈ R.fibers false}

/-- Indices of the second full fibre. -/
abbrev SSLPMomentDatum.RightIndex (R : SSLPMomentDatum) :=
  {x : SS.BitString 6 // x ∈ R.fibers true}

/-- The degree-two feasible geometry attached to the labelled full-fibre
pair.  It is derived from the fibres, so an orbit record cannot carry a
different, unrelated polytope. -/
def SSLPMomentDatum.geometry (R : SSLPMomentDatum) :
    Set (Sum R.LeftIndex R.RightIndex → ℝ) :=
  MomentPolytope.momentPolytope (fun x : R.LeftIndex => x.1)
    (fun x : R.RightIndex => x.1)

/-- Act on the fibres while retaining `(q,m)`.  `g.swap = true` is precisely
the paper's combined operation "interchange the logical colours and invert
the targeted cyclic generator"; generator orientation is not a third colour
datum. -/
def actSSLPDatum (g : CubeAction.Parameter 6) (R : SSLPMomentDatum) :
    SSLPMomentDatum where
  q := R.q
  m := R.m
  q_pos := R.q_pos
  m_pos := R.m_pos
  m_dvd_q := R.m_dvd_q
  fibers := CubeAction.actFibers g R.fibers

/-- **Definition 6.1(ii).**  Two labelled records lie in the same SSLP moment
orbit exactly when the labels agree and their coloured full fibres differ by
a coordinate permutation, common XOR translation, and optional combined
colour-swap/generator-inversion. -/
def SSLPMomentEquivalent (R S : SSLPMomentDatum) : Prop :=
  R.q = S.q ∧ R.m = S.m ∧ CubeAction.FiberEquivalent R.fibers S.fibers

theorem sslpMomentEquivalent_refl (R : SSLPMomentDatum) :
    SSLPMomentEquivalent R R :=
  ⟨rfl, rfl, CubeAction.fiberEquivalent_refl R.fibers⟩

theorem sslpMomentEquivalent_symm {R S : SSLPMomentDatum}
    (h : SSLPMomentEquivalent R S) : SSLPMomentEquivalent S R :=
  ⟨h.1.symm, h.2.1.symm, CubeAction.fiberEquivalent_symm h.2.2⟩

theorem sslpMomentEquivalent_trans {R S T : SSLPMomentDatum}
    (hRS : SSLPMomentEquivalent R S) (hST : SSLPMomentEquivalent S T) :
    SSLPMomentEquivalent R T :=
  ⟨hRS.1.trans hST.1, hRS.2.1.trans hST.2.1,
    CubeAction.fiberEquivalent_trans hRS.2.2 hST.2.2⟩

theorem sslpMomentEquivalent_equivalence : Equivalence SSLPMomentEquivalent :=
  ⟨sslpMomentEquivalent_refl, sslpMomentEquivalent_symm,
    sslpMomentEquivalent_trans⟩

def sslpMomentSetoid : Setoid SSLPMomentDatum :=
  ⟨SSLPMomentEquivalent, sslpMomentEquivalent_equivalence⟩

/-- The quotient object counted at level (ii). -/
abbrev SSLPMomentOrbit := Quotient sslpMomentSetoid

/-- Level-(ii) equivalence cannot change the retained order labels. -/
theorem labels_eq_of_sslpMomentEquivalent {R S : SSLPMomentDatum}
    (h : SSLPMomentEquivalent R S) : R.q = S.q ∧ R.m = S.m :=
  ⟨h.1, h.2.1⟩

/-! ## Level (iii): normalized weight-enumerator images -/

/-- The object classified at level (iii): a set of normalized enumerator
vectors `(A₀,…,A₆)`. -/
abbrev WeightEnumeratorObject := Set (Fin 7 → ℝ)

/-- **Definition 6.1(iii).**  This is exactly the already certified,
paper-normalized `Levels.WImage`; no raw-`Aco` variant is introduced here. -/
abbrev weightEnumeratorImage {q : ℕ} [NeZero q]
    (av : Fin 6 → ZMod q) (r₀ r₁ : ZMod q) : WeightEnumeratorObject :=
  Levels.WImage av r₀ r₁

/-- At level (iii) the equivalence notion is equality of image sets. -/
def WeightEnumeratorEquivalent (W V : WeightEnumeratorObject) : Prop := W = V

theorem weightEnumeratorEquivalent_equivalence :
    Equivalence WeightEnumeratorEquivalent :=
  ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-! ## Level (iv): local-unitary code classes -/

/-- A two-by-two matrix is unitary, stated with both inverse identities. -/
def IsOneQubitUnitary (U : Matrix (Fin 2) (Fin 2) ℂ) : Prop :=
  star U * U = 1 ∧ U * star U = 1

/-- Boolean computational-basis index as `Fin 2`. -/
def bitIndex : Bool → Fin 2
  | false => 0
  | true => 1

/-- Kernel of `U` acting on qubit `j` and identity on every other qubit. -/
def oneQubitKernel {n : ℕ} (j : Fin n) (U : Matrix (Fin 2) (Fin 2) ℂ) :
    OperatorKernel n :=
  fun x y =>
    if ∀ k, k ≠ j → x k = y k then U (bitIndex (x j)) (bitIndex (y j)) else 0

/-- Kernel of the computational-basis permutation induced by a qubit
permutation. -/
def qubitPermutationKernel {n : ℕ} (σ : Equiv.Perm (Fin n)) : OperatorKernel n :=
  fun x y => if x = SixQubit.CodeEquiv.permStr σ y then 1 else 0

/-- Conjugation of a projector kernel by a physical operator kernel. -/
def conjugateProjector {n : ℕ} (W : OperatorKernel n) (P : CodeProjector n) :
    OperatorKernel n :=
  W * P.kernel * star W

/-- One elementary allowed step at level (iv): either one genuine one-qubit
unitary or one physical-qubit permutation. -/
def ElementaryLU {n : ℕ} (P Q : CodeProjector n) : Prop :=
  (∃ (j : Fin n) (U : Matrix (Fin 2) (Fin 2) ℂ),
      IsOneQubitUnitary U ∧ Q.kernel = conjugateProjector (oneQubitKernel j U) P) ∨
  (∃ σ : Equiv.Perm (Fin n),
      Q.kernel = conjugateProjector (qubitPermutationKernel σ) P)

/-- **Definition 6.1(iv).**  Equivalence closure of the explicit local-unitary
and qubit-permutation conjugations.  Composition gives arbitrary products of
single-qubit gates (hence `⊗ⱼ Uⱼ`) together with a qubit permutation; the
closure also supplies inverse paths and therefore compares projectors, not
chosen logical frames. -/
def LUEquivalent {n : ℕ} : CodeProjector n → CodeProjector n → Prop :=
  Relation.EqvGen ElementaryLU

theorem luEquivalent_equivalence {n : ℕ} :
    Equivalence (@LUEquivalent n) :=
  Relation.EqvGen.is_equivalence _

def luSetoid (n : ℕ) : Setoid (CodeProjector n) :=
  ⟨LUEquivalent, luEquivalent_equivalence⟩

/-- The quotient object classified at level (iv). -/
abbrev LocalUnitaryCodeClass (n : ℕ) := Quotient (luSetoid n)

/-- A certified one-qubit conjugation is an LU-equivalence step. -/
theorem luEquivalent_of_oneQubit {n : ℕ} (P Q : CodeProjector n)
    (j : Fin n) (U : Matrix (Fin 2) (Fin 2) ℂ) (hU : IsOneQubitUnitary U)
    (hQ : Q.kernel = conjugateProjector (oneQubitKernel j U) P) :
    LUEquivalent P Q :=
  Relation.EqvGen.rel _ _ (Or.inl ⟨j, U, hU, hQ⟩)

/-- A physical-qubit permutation is an LU-equivalence step. -/
theorem luEquivalent_of_permutation {n : ℕ} (P Q : CodeProjector n)
    (σ : Equiv.Perm (Fin n))
    (hQ : Q.kernel = conjugateProjector (qubitPermutationKernel σ) P) :
    LUEquivalent P Q :=
  Relation.EqvGen.rel _ _ (Or.inr ⟨σ, hQ⟩)

/-! The four quotient objects above are intentionally not connected by any
coercion or claimed bijection.  That absence is semantic: Definition 6.1 says
the levels are inequivalent, and equality at one level must not silently be
used as equality at another. -/

end

end MainTheory.ClassificationLevels
