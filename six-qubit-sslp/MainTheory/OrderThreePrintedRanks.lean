def actualMatrix : Matrix (Fin 23) (Fin 18) ℤ := fun i j =>
  if i.val=0 then (if j.val<9 then 1 else 0) else
  if i.val=1 then (if j.val<9 then 0 else 1) else
  let x := if h : j.val<9 then MainTheory.OrderThreePrintedMoments.Orbit47.bottom ⟨j.val,h⟩
    else MainTheory.OrderThreePrintedMoments.Orbit47.top ⟨j.val-9,by omega⟩
  let sign : ℤ := if j.val<9 then 1 else -1
  if h : i.val<8 then sign*(if x ⟨i.val-2,by omega⟩ then 1 else 0) else
    let pair := coordinatePairs ⟨i.val-8,by omega⟩
    sign*(if x pair.1 then 1 else 0)*(if x pair.2 then 1 else 0)
theorem actual_matrix : matrixZ=actualMatrix := by decide +kernel
