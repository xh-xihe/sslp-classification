theorem factorization : P*minorQ=L*U := by
  have he : ∀ i j : Fin 16, (P*minorQ) i j=(L*U) i j := by decide +kernel
  exact Matrix.ext he
theorem lower_triangular : L.BlockTriangular OrderDual.toDual := by
  change ∀ i j : Fin 16, i < j → L i j=0
  decide +kernel
theorem upper_triangular : U.BlockTriangular id := by
  change ∀ i j : Fin 16, j < i → U i j=0
  decide +kernel
theorem lower_diagonal : (∏ i : Fin 16, L i i)=1 := by decide +kernel
theorem upper_diagonal : (∏ i : Fin 16, U i i)=-48 := by decide +kernel
theorem lower_det : L.det=1 := by
  rw [Matrix.det_of_lowerTriangular L lower_triangular,lower_diagonal]
theorem upper_det : U.det=-48 := by
  rw [Matrix.det_of_upperTriangular upper_triangular,upper_diagonal]
def permFunction : Fin 16 → Fin 16 := ![⟨0,by decide⟩,⟨4,by decide⟩,⟨3,by decide⟩,⟨5,by decide⟩,⟨2,by decide⟩,⟨9,by decide⟩,⟨8,by decide⟩,⟨7,by decide⟩,⟨6,by decide⟩,⟨1,by decide⟩,⟨11,by decide⟩,⟨10,by decide⟩,⟨13,by decide⟩,⟨14,by decide⟩,⟨12,by decide⟩,⟨15,by decide⟩]
