CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_four_row","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (MainTheory.Orbit51PrintedAlgebra.C c 0) * MainTheory.Orbit51PrintedAlgebra.D d ⟨3, ⋯⟩ +\n                Star.star (MainTheory.Orbit51PrintedAlgebra.C c 1) * MainTheory.Orbit51PrintedAlgebra.D d ⟨2, ⋯⟩ +\n              Star.star (MainTheory.Orbit51PrintedAlgebra.C c ⟨2, ⋯⟩) * MainTheory.Orbit51PrintedAlgebra.D d 1 +\n            Star.star (MainTheory.Orbit51PrintedAlgebra.C c ⟨3, ⋯⟩) * MainTheory.Orbit51PrintedAlgebra.D d 0 =\n          0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_full_sync","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices,\n              MainTheory.Orbit51PrintedAlgebra.rho (MainTheory.Orbit51PrintedAlgebra.C c)\n                  (MainTheory.Orbit51PrintedAlgebra.D d) i =\n                MainTheory.Orbit51PrintedAlgebra.rho (MainTheory.Orbit51PrintedAlgebra.C c)\n                  (MainTheory.Orbit51PrintedAlgebra.D d) ⟨8, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_kernel_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit51PrintedAlgebra.KernelRows (MainTheory.Orbit51PrintedAlgebra.C c)\n          (MainTheory.Orbit51PrintedAlgebra.D d)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_moment","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.OrderThreePrintedMoments.Orbit51.Moment\n              (fun i => Complex.normSq (MainTheory.Orbit51PrintedAlgebra.C c i)) fun i =>\n              Complex.normSq (MainTheory.Orbit51PrintedAlgebra.D d i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) → SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_pinned_point","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices,\n                Complex.normSq (MainTheory.Orbit51PrintedAlgebra.C c i) =\n                  MainTheory.Orbit51PrintedAlgebra.fixedProbability i) ∧\n              (∀ (i : Fin 10),\n                  Complex.normSq (MainTheory.Orbit51PrintedAlgebra.D d i) =\n                    Complex.normSq (MainTheory.Orbit51PrintedAlgebra.C c i)) ∧\n                Complex.normSq (MainTheory.Orbit51PrintedAlgebra.C c ⟨6, ⋯⟩) +\n                    Complex.normSq (MainTheory.Orbit51PrintedAlgebra.C c ⟨7, ⋯⟩) =\n                  1 / 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_quadrics","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit51PrintedAlgebra.C c 0 * MainTheory.Orbit51PrintedAlgebra.C c ⟨9, ⋯⟩ +\n                  MainTheory.Orbit51PrintedAlgebra.C c 1 * MainTheory.Orbit51PrintedAlgebra.C c ⟨8, ⋯⟩ =\n                0 ∧\n              MainTheory.Orbit51PrintedAlgebra.C c ⟨2, ⋯⟩ * MainTheory.Orbit51PrintedAlgebra.C c ⟨9, ⋯⟩ +\n                    MainTheory.Orbit51PrintedAlgebra.C c ⟨3, ⋯⟩ * MainTheory.Orbit51PrintedAlgebra.C c ⟨8, ⋯⟩ =\n                  0 ∧\n                MainTheory.Orbit51PrintedAlgebra.C c 0 * MainTheory.Orbit51PrintedAlgebra.C c ⟨3, ⋯⟩ +\n                    MainTheory.Orbit51PrintedAlgebra.C c 1 * MainTheory.Orbit51PrintedAlgebra.C c ⟨2, ⋯⟩ =\n                  0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_ratios","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit51PrintedAlgebra.C c 0 / MainTheory.Orbit51PrintedAlgebra.C c 1 +\n                  MainTheory.Orbit51PrintedAlgebra.C c ⟨8, ⋯⟩ / MainTheory.Orbit51PrintedAlgebra.C c ⟨9, ⋯⟩ =\n                0 ∧\n              MainTheory.Orbit51PrintedAlgebra.C c ⟨2, ⋯⟩ / MainTheory.Orbit51PrintedAlgebra.C c ⟨3, ⋯⟩ +\n                    MainTheory.Orbit51PrintedAlgebra.C c ⟨8, ⋯⟩ / MainTheory.Orbit51PrintedAlgebra.C c ⟨9, ⋯⟩ =\n                  0 ∧\n                MainTheory.Orbit51PrintedAlgebra.C c 0 / MainTheory.Orbit51PrintedAlgebra.C c 1 +\n                    MainTheory.Orbit51PrintedAlgebra.C c ⟨2, ⋯⟩ / MainTheory.Orbit51PrintedAlgebra.C c ⟨3, ⋯⟩ =\n                  0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.physical_sync_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit51PrintedAlgebra.SyncRows (MainTheory.Orbit51PrintedAlgebra.C c)\n          (MainTheory.Orbit51PrintedAlgebra.D d)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PhysicalCompletion.quadrics_of_sync","type":"∀ (c d : Fin 10 → ℂ) (r : ℂ),\n  r ≠ 0 →\n    (∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices, d i = r * Star.star (c i)) →\n      MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n        Star.star (c 0) * d ⟨3, ⋯⟩ + Star.star (c 1) * d ⟨2, ⋯⟩ + Star.star (c ⟨2, ⋯⟩) * d 1 +\n              Star.star (c ⟨3, ⋯⟩) * d 0 =\n            0 →\n          c 0 * c ⟨9, ⋯⟩ + c 1 * c ⟨8, ⋯⟩ = 0 ∧\n            c ⟨2, ⋯⟩ * c ⟨9, ⋯⟩ + c ⟨3, ⋯⟩ * c ⟨8, ⋯⟩ = 0 ∧ c 0 * c ⟨3, ⋯⟩ + c 1 * c ⟨2, ⋯⟩ = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.anchor_sync","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      MainTheory.Orbit51PrintedAlgebra.SyncRows c d →\n        MainTheory.Orbit51PrintedAlgebra.rho c d ⟨8, ⋯⟩ = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨9, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.boundary_active","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d → c ⟨6, ⋯⟩ ≠ 0 ∨ c ⟨7, ⋯⟩ ≠ 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedAlgebra.fixedIndices","type":"Finset (Fin 10)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedAlgebra.fixedProbability","type":"Fin 10 → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.fixed_nonzero","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      ∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices, c i ≠ 0 ∧ d i ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.full_sync","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      MainTheory.Orbit51PrintedAlgebra.SyncRows c d →\n        ∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices,\n          MainTheory.Orbit51PrintedAlgebra.rho c d i = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨8, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.kernel_norm_equalities","type":"∀ (c d : Fin 10 → ℂ),\n  MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n    Complex.normSq (c 1) * Complex.normSq (d ⟨8, ⋯⟩) = Complex.normSq (c 0) * Complex.normSq (d ⟨9, ⋯⟩) ∧\n      Complex.normSq (c ⟨3, ⋯⟩) * Complex.normSq (d ⟨8, ⋯⟩) = Complex.normSq (c ⟨2, ⋯⟩) * Complex.normSq (d ⟨9, ⋯⟩)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.linear_pin","type":"∀ (b g : ℝ),\n  g * (b + g) = (1 / 6 - g) * (1 / 3 - b - g) →\n    b * (b + g) = (1 / 6 - b) * (1 / 3 - b - g) → 3 * b + 9 * g = 1 ∧ 9 * b + 3 * g = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.partial_sync","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      MainTheory.Orbit51PrintedAlgebra.rho c d 0 = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨9, ⋯⟩ ∧\n        MainTheory.Orbit51PrintedAlgebra.rho c d 1 = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨8, ⋯⟩ ∧\n          MainTheory.Orbit51PrintedAlgebra.rho c d ⟨2, ⋯⟩ = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨9, ⋯⟩ ∧\n            MainTheory.Orbit51PrintedAlgebra.rho c d ⟨3, ⋯⟩ = MainTheory.Orbit51PrintedAlgebra.rho c d ⟨8, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.pin_parameters","type":"∀ (b g : ℝ),\n  g * (b + g) = (1 / 6 - g) * (1 / 3 - b - g) → b * (b + g) = (1 / 6 - b) * (1 / 3 - b - g) → b = 1 / 12 ∧ g = 1 / 12"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.pinned_point","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      (∀ i ∈ MainTheory.Orbit51PrintedAlgebra.fixedIndices,\n          Complex.normSq (c i) = MainTheory.Orbit51PrintedAlgebra.fixedProbability i) ∧\n        (∀ (i : Fin 10), Complex.normSq (d i) = Complex.normSq (c i)) ∧\n          Complex.normSq (c ⟨6, ⋯⟩) + Complex.normSq (c ⟨7, ⋯⟩) = 1 / 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedAlgebra.printed_pin_identities","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit51.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    MainTheory.Orbit51PrintedAlgebra.KernelRows c d →\n      have b := Complex.normSq (c ⟨2, ⋯⟩);\n      have g := Complex.normSq (c 0);\n      g * (b + g) = (1 / 6 - g) * (1 / 3 - b - g) ∧ b * (b + g) = (1 / 6 - b) * (1 / 3 - b - g)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedAlgebra.rho","type":"(Fin 10 → ℂ) → (Fin 10 → ℂ) → Fin 10 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row00.W","type":"Matrix (Fin 3) (Fin 4) ℚ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row00.WC","type":"Matrix (Fin 3) (Fin 4) ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.actual_characters","type":"∀ (i : Fin 3) (j : Fin 4),\n  MainTheory.Orbit51PrintedRows.Row00.W i j =\n    if\n        SS.bdot (MainTheory.Orbit51PrintedRows.Row00.characters i) (MainTheory.Orbit51PrintedRows.Row00.sources j) =\n          Bool.true then\n      -1\n    else 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.actual_images","type":"∀ (j : Fin 4),\n  SS.bxor (MainTheory.Orbit51PrintedRows.Row00.sources j) MainTheory.Orbit51PrintedRows.Row00.flip =\n    MainTheory.Orbit51PrintedRows.Row00.destinations j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.actual_incidence","type":"Finset.image MainTheory.Orbit51PrintedRows.Row00.sources Finset.univ =\n  {y ∈ SixQubit.Orbit51.S1 | SS.bxor y MainTheory.Orbit51PrintedRows.Row00.flip ∈ SixQubit.Orbit51.S0}"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row00.characters","type":"Fin 3 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row00.destinations","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row00.flip","type":"SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.kernel_span","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit51PrintedRows.Row00.WC.mulVec v = 0 ↔ ∃ a, v = ![a, -a, -a, a]"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.matrix_checked","type":"MainTheory.RectangularFlipCharacters.matrix MainTheory.Orbit51PrintedRows.Row00.characters\n    MainTheory.Orbit51PrintedRows.Row00.sources =\n  MainTheory.Orbit51PrintedRows.Row00.WC"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.physical_relations","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (c SixQubit.Orbit51.y0) * d SixQubit.Orbit51.z9 =\n            Star.star (c SixQubit.Orbit51.y9) * d SixQubit.Orbit51.z0 ∧\n          Star.star (c SixQubit.Orbit51.y1) * d SixQubit.Orbit51.z8 =\n              Star.star (c SixQubit.Orbit51.y8) * d SixQubit.Orbit51.z1 ∧\n            Star.star (c SixQubit.Orbit51.y0) * d SixQubit.Orbit51.z9 +\n                Star.star (c SixQubit.Orbit51.y1) * d SixQubit.Orbit51.z8 =\n              0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.physical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit51PrintedRows.Row00.WC.mulVec (MainTheory.Orbit51PrintedRows.Row00.products c d) = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row00.row_reduction","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit51PrintedRows.Row00.WC.mulVec v = 0 ↔ v 0 = v ⟨3, ⋯⟩ ∧ v 1 = v ⟨2, ⋯⟩ ∧ v 0 + v 1 = 0"}
