CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitPerfectCode.double_tail","type":"∀ (p : Orbit2.TensorPauli.Label 4),\n  MainTheory.ArbitrarySplitPerfectCode.weight p ≤ 2 →\n    ∀ (j k : Fin 2),\n      ∑ a, MainTheory.ArbitrarySplitPerfectCode.coefficient p j k a a = if (p = fun x => 0) ∧ j = k then 16 else 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.ArbitrarySplitPerfectCode.raw","type":"Fin 2 → Fin 2 → MainTheory.ArbitrarySplitPerfectCode.Tail → GaussianInt"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitPerfectCode.single_tail","type":"∀ (p : Orbit2.TensorPauli.Label 4),\n  MainTheory.ArbitrarySplitPerfectCode.weight p ≤ 1 →\n    ∀ (j k a b : Fin 2),\n      MainTheory.ArbitrarySplitPerfectCode.coefficient p j k a b = if (p = fun x => 0) ∧ j = k ∧ a = b then 8 else 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitPerfectCode.split_pair_compression","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ) (E : Matrix (Fin 4) (Fin 4) ℂ),\n  (MainTheory.ArbitrarySplitPerfectCode.split W).conjTranspose * Matrix.kroneckerMap (fun x1 x2 => x1 * x2) E 1 *\n      MainTheory.ArbitrarySplitPerfectCode.split W =\n    (1 / 2 * (W.conjTranspose * E * W).trace) • 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitPerfectCode.split_trace","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ) (E : Matrix (Fin 4) (Fin 4) ℂ),\n  1 / 2 * (W.conjTranspose * E * W).trace = 1 / 2 * (W * W.conjTranspose * E).trace"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.ArbitrarySplitSixQubit.basis","type":"Fin 4 × MainTheory.ArbitrarySplitPerfectCode.Tail ≃ (Fin 6 → Fin 2)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.code_KL","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ),\n  W.conjTranspose * W = 1 →\n    ∀ (p : Orbit2.TensorPauli.Label 6),\n      MainTheory.ArbitrarySplitSixQubit.weight6 p ≤ 2 →\n        (MainTheory.ArbitrarySplitSixQubit.code W).conjTranspose * Orbit2.TensorPauli.operator p *\n            MainTheory.ArbitrarySplitSixQubit.code W =\n          MainTheory.ArbitrarySplitSixQubit.scalar W p • 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.code_isometry","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ),\n  W.conjTranspose * W = 1 →\n    (MainTheory.ArbitrarySplitSixQubit.code W).conjTranspose * MainTheory.ArbitrarySplitSixQubit.code W = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.compression_transport","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ) (p : Orbit2.TensorPauli.Label 6),\n  (MainTheory.ArbitrarySplitSixQubit.code W).conjTranspose * Orbit2.TensorPauli.operator p *\n      MainTheory.ArbitrarySplitSixQubit.code W =\n    (MainTheory.ArbitrarySplitPerfectCode.split W).conjTranspose *\n        Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (MainTheory.ArbitrarySplitSixQubit.pairOperator p)\n          (Orbit2.TensorPauli.operator (MainTheory.ArbitrarySplitSixQubit.tailLabel p)) *\n      MainTheory.ArbitrarySplitPerfectCode.split W"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.hilbert_distance_three","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ),\n  W.conjTranspose * W = 1 → SS.HasDistance (Orbit2.HilbertBridge.words (MainTheory.ArbitrarySplitSixQubit.code W)) 3"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.hilbert_orthonormal","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ),\n  W.conjTranspose * W = 1 →\n    ∀ (j k : Fin 2),\n      SS.innerC (Orbit2.HilbertBridge.words (MainTheory.ArbitrarySplitSixQubit.code W) j)\n          (Orbit2.HilbertBridge.words (MainTheory.ArbitrarySplitSixQubit.code W) k) =\n        if j = k then 1 else 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.operator_factor","type":"∀ (p : Orbit2.TensorPauli.Label 6),\n  (Orbit2.TensorPauli.operator p).submatrix ⇑MainTheory.ArbitrarySplitSixQubit.basis\n      ⇑MainTheory.ArbitrarySplitSixQubit.basis =\n    Matrix.kroneckerMap (fun x1 x2 => x1 * x2) (MainTheory.ArbitrarySplitSixQubit.pairOperator p)\n      (Orbit2.TensorPauli.operator (MainTheory.ArbitrarySplitSixQubit.tailLabel p))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.projector_KL","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ),\n  W.conjTranspose * W = 1 →\n    ∀ (p : Orbit2.TensorPauli.Label 6),\n      MainTheory.ArbitrarySplitSixQubit.weight6 p ≤ 2 →\n        MainTheory.ArbitrarySplitSixQubit.projector W * Orbit2.TensorPauli.operator p *\n            MainTheory.ArbitrarySplitSixQubit.projector W =\n          MainTheory.ArbitrarySplitSixQubit.scalar W p • MainTheory.ArbitrarySplitSixQubit.projector W"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.ArbitrarySplitSixQubit.unsplit_scalar_zero","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ) (p : Orbit2.TensorPauli.Label 6),\n  (MainTheory.ArbitrarySplitSixQubit.tailLabel p ≠ fun x => 0) → MainTheory.ArbitrarySplitSixQubit.scalar W p = 0"}
