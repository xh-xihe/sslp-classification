CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderThreePrintedCrossRows.Orbit52.physical_products_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit52.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit52.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 → ∀ (j : Fin 4), MainTheory.OrderThreePrintedCrossRows.Orbit52.products c d j = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderThreePrintedCrossRows.Orbit52.physical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit52.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit52.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.OrderThreePrintedCrossRows.Orbit52.WC.mulVec\n            (MainTheory.OrderThreePrintedCrossRows.Orbit52.products c d) =\n          0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderThreePrintedCrossRows.Orbit52.physical_squared_products","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit52.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit52.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            Complex.normSq (MainTheory.OrderThreePrintedCrossRows.Orbit52.products c d 0) =\n                1 / 2 * Complex.normSq (d SixQubit.Orbit52.z2) ^ 2 ∧\n              Complex.normSq (MainTheory.OrderThreePrintedCrossRows.Orbit52.products c d 1) =\n                1 / 2 * Complex.normSq (d SixQubit.Orbit52.z3) ^ 2"}
