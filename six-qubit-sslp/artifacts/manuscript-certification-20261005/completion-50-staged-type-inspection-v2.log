CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderTwoShellProjectors.Orbit41.topTypes","type":"Fin 4 → ℕ × ℕ × ℕ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderTwoShellProjectors.Orbit41.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.OrderTwoShellProjectors.Orbit41.flip,\n        z := MainTheory.OrderTwoShellProjectors.Orbit41.characters i }.wt ≤\n    2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.PhysicalPhaseQuotients.opposition","type":"∀ (c d b e : ℂ),\n  c ≠ 0 →\n    b ≠ 0 →\n      Star.star c * e + Star.star b * d = 0 →\n        MainTheory.PhysicalPhaseQuotients.rho c d + MainTheory.PhysicalPhaseQuotients.rho b e = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.PhysicalPhaseQuotients.unit","type":"∀ (c d : ℂ),\n  c ≠ 0 → Complex.normSq d = Complex.normSq c → Complex.normSq (MainTheory.PhysicalPhaseQuotients.rho c d) = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveJointSpace.independent_generators","type":"Function.Injective MainTheory.StandardFiveJointSpace.words ∧\n  ∀ (s : Fin 16), (MainTheory.StandardFiveJointSpace.words s = fun x => 0) ↔ s = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveJointSpace.joint_dimension","type":"Module.finrank ℂ ↥MainTheory.StandardFiveJointSpace.jointSpace = 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveJointSpace.joint_range","type":"MainTheory.StandardFiveJointSpace.jointSpace = MainTheory.StandardFiveJointSpace.R.mulVecLin.range"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveJointSpace.projector_checked","type":"MainTheory.StandardFiveJointSpace.rawProjector =\n  MainTheory.StandardFiveJointSpace.rawSeed * MainTheory.StandardFiveJointSpace.rawSeed.conjTranspose"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveJointSpace.seed_gram","type":"MainTheory.StandardFiveJointSpace.R.conjTranspose * MainTheory.StandardFiveJointSpace.R = 16 • 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.all_nonzero_unique","type":"(Function.Injective fun ia => MainTheory.StandardFiveSyndromeDisplays.table ia.1 ia.2) ∧\n  Finset.image (fun ia => MainTheory.StandardFiveSyndromeDisplays.table ia.1 ia.2) Finset.univ =\n    Finset.univ.erase fun x => Bool.false"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.commuting_generators","type":"∀ (g h : Fin 4),\n  Orbit2.TensorPauli.phase (MainTheory.Orbit2StandardFiveQubit.generators g)\n      (MainTheory.Orbit2StandardFiveQubit.generators h) =\n    Orbit2.TensorPauli.phase (MainTheory.Orbit2StandardFiveQubit.generators h)\n      (MainTheory.Orbit2StandardFiveQubit.generators g)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.generators_commute","type":"∀ (g h : Fin 4),\n  Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators g) *\n      Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators h) =\n    Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators h) *\n      Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators g)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.literal_table","type":"∀ (i : Fin 5) (a : Fin 3),\n  MainTheory.StandardFiveSyndromeDisplays.syndrome (MainTheory.StandardFiveSyndromeDisplays.single i a.succ) =\n    MainTheory.StandardFiveSyndromeDisplays.table i a"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.logical_X","type":"∀ (j : Fin 2) (s : Fin 5 → Fin 2),\n  Orbit2.FiveQubit.act ![1, 1, 1, 1, 1] (MainTheory.Orbit2StandardFiveQubit.standard j) s =\n    MainTheory.Orbit2StandardFiveQubit.standard (if j = 0 then 1 else 0) s"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.logical_anticommute","type":"Orbit2.TensorPauli.operator ![3, 3, 3, 3, 3] * Orbit2.TensorPauli.operator ![1, 1, 1, 1, 1] =\n  -(Orbit2.TensorPauli.operator ![1, 1, 1, 1, 1] * Orbit2.TensorPauli.operator ![3, 3, 3, 3, 3])"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.low_weight_anticommutes","type":"∀ (p : Orbit2.TensorPauli.Label 5),\n  Orbit2.FiveQubit.weight p ≤ 2 →\n    (p ≠ fun x => 0) →\n      ∃ g,\n        Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators g) * Orbit2.TensorPauli.operator p =\n          -(Orbit2.TensorPauli.operator p *\n              Orbit2.TensorPauli.operator (MainTheory.Orbit2StandardFiveQubit.generators g))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.StandardFiveSyndromeDisplays.low_weight_nonzero","type":"∀ (p : Orbit2.TensorPauli.Label 5),\n  Orbit2.FiveQubit.weight p ≤ 2 →\n    (p ≠ fun x => 0) → MainTheory.StandardFiveSyndromeDisplays.syndrome p ≠ fun x => Bool.false"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.StandardFiveSyndromeDisplays.table","type":"Fin 5 → Fin 3 → Fin 4 → Bool"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.SupportKetExpansion.expansion","type":"∀ {n : ℕ} (S : Finset (SS.BitString n)) (c : SS.State n ℂ),\n  (∀ x ∉ S, c x = 0) → c = ∑ x ∈ S, c x • MainTheory.SupportKetExpansion.ket x"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.SupportKetExpansion.indexed_expansion","type":"∀ {n k : ℕ} (S : Finset (SS.BitString n)) (xs : Fin k → SS.BitString n),\n  Function.Injective xs →\n    Finset.image xs Finset.univ = S →\n      ∀ (c : SS.State n ℂ), (∀ x ∉ S, c x = 0) → c = ∑ i, c (xs i) • MainTheory.SupportKetExpansion.ket (xs i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"SixQubit.Orbit31.momentMatrix_rank","type":"SixQubit.Orbit31.momentMatrix.rank = 23"}
CERTIFICATION_TYPE {"kind":"theorem","name":"SixQubit.Orbit32.local_nogo","type":"∀ (au bu cu eu fu gu : ℂ) (Au Bu Cu Eu Fu Gu : ℝ),\n  Au = Complex.normSq au →\n    Bu = Complex.normSq bu →\n      Cu = Complex.normSq cu →\n        Eu = Complex.normSq eu →\n          Fu = Complex.normSq fu →\n            Gu = Complex.normSq gu →\n              Au = (2 * Eu + 2 * Fu - Gu) / 3 →\n                Cu = (-Eu + 2 * Fu + 2 * Gu) / 3 →\n                  Bu = (2 * Eu - Fu + 2 * Gu) / 3 →\n                    0 < Eu →\n                      Star.star au * fu + Star.star bu * gu = 0 →\n                        Star.star au * eu + Star.star cu * gu = 0 → Star.star bu * eu + Star.star cu * fu = 0 → False"}
