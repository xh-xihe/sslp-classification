CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31RelativeInterior.relative_interior_iff_vertexUnion","type":"∀ (mask : ℕ),\n  (∃ p ∈ intrinsicInterior ℝ (MainTheory.Orbit31MomentFaces.face mask),\n      MainTheory.MatrixPositiveSupportCertificates.ExactSupport (MainTheory.Orbit31SupportSemantics.maskSet mask) p) ↔\n    MainTheory.Orbit31RelativeInterior.vertexUnion mask = MainTheory.Orbit31SupportSemantics.maskSet mask ∧\n      (MainTheory.Orbit31SupportSemantics.maskSet mask).Nonempty"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.column_opposition","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      ∀ (k : Fin 6),\n        c (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).1) ≠ 0 →\n          c (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).2) ≠ 0 →\n            (∀ (i : Fin 3) (e : Fin 4), c (MainTheory.Orbit31SignedSupport.B i e) ≠ 0) →\n              MainTheory.Orbit31PhaseRatios.sigma c d\n                  (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).2) =\n                -MainTheory.Orbit31PhaseRatios.sigma c d\n                    (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).1)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.column_rectangle","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      ∀ (r : Fin 3) (k : Fin 6),\n        c (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).1) ≠ 0 →\n          c (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).2) ≠ 0 →\n            (∀ (i : Fin 3) (e : Fin 4), c (MainTheory.Orbit31SignedSupport.B i e) ≠ 0) →\n              (MainTheory.Orbit31PhaseRatios.sigma c d\n                      (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).1) +\n                    MainTheory.Orbit31PhaseRatios.sigma c d\n                      (MainTheory.Orbit31SignedSupport.A (MainTheory.Orbit31SignedSupport.colPairs k).2)) *\n                  MainTheory.Orbit31PermanentAlgebra.permanent c (MainTheory.Orbit31SignedSupport.rowPairs r).1\n                    (MainTheory.Orbit31SignedSupport.rowPairs r).2 (MainTheory.Orbit31SignedSupport.colPairs k).1\n                    (MainTheory.Orbit31SignedSupport.colPairs k).2 =\n                0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.physical_type14_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit31.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit31.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit31CanonicalPhase.AmplitudeSupport (MainTheory.Orbit31ResidualTriangles.mask ⟨13, ⋯⟩)\n                (MainTheory.Orbit31PhaseRatios.C c) →\n              False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.physical_type16_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit31.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit31.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit31CanonicalPhase.AmplitudeSupport (MainTheory.Orbit31ResidualTriangles.mask ⟨15, ⋯⟩)\n                (MainTheory.Orbit31PhaseRatios.C c) →\n              False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.physical_type9_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit31.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit31.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n                (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine)\n                (MainTheory.Orbit31PhaseRatios.C c) →\n              False"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit31ResidualTriangles.ratio","type":"(Fin 16 → ℂ) → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.three_column_no_go","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      c (MainTheory.Orbit31SignedSupport.A 0) ≠ 0 →\n        c (MainTheory.Orbit31SignedSupport.A 1) ≠ 0 →\n          c (MainTheory.Orbit31SignedSupport.A 2) ≠ 0 →\n            (∀ (i : Fin 3) (e : Fin 4), c (MainTheory.Orbit31SignedSupport.B i e) ≠ 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_A_nonzero","type":"∀ {c : Fin 16 → ℂ},\n  MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n      (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n    c (MainTheory.Orbit31SignedSupport.A 0) ≠ 0 ∧ c (MainTheory.Orbit31SignedSupport.A 1) ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_B_nonzero","type":"∀ {c : Fin 16 → ℂ},\n  MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n      (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n    ∀ (i : Fin 3) (e : Fin 4), c (MainTheory.Orbit31SignedSupport.B i e) ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_opposite","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n          (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n        MainTheory.Orbit31PhaseRatios.sigma c d (MainTheory.Orbit31SignedSupport.A 1) =\n          -MainTheory.Orbit31PhaseRatios.sigma c d (MainTheory.Orbit31SignedSupport.A 0)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_permanents","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n          (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n        ∀ (r : Fin 3),\n          MainTheory.Orbit31PermanentAlgebra.permanent c (MainTheory.Orbit31SignedSupport.rowPairs r).1\n              (MainTheory.Orbit31SignedSupport.rowPairs r).2 1 2 =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_propagated","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n          (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n        ∀ (r : Fin 3),\n          (MainTheory.Orbit31PhaseRatios.sigma c d (MainTheory.Orbit31SignedSupport.A 0) -\n                MainTheory.Orbit31PhaseRatios.sigma c d (MainTheory.Orbit31SignedSupport.A 1)) *\n              MainTheory.Orbit31PermanentAlgebra.permanent c (MainTheory.Orbit31SignedSupport.rowPairs r).1\n                (MainTheory.Orbit31SignedSupport.rowPairs r).2 1 2 =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_proportional","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n          (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n        MainTheory.Orbit31ResidualTriangles.ratio c ≠ 0 ∧\n          ∀ (i : Fin 3),\n            c (MainTheory.Orbit31SignedSupport.B i 0) =\n              MainTheory.Orbit31ResidualTriangles.ratio c * c (MainTheory.Orbit31SignedSupport.B i 1)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31ResidualTriangles.type9_weight_product","type":"∀ {c d : Fin 16 → ℂ},\n  MainTheory.Orbit31PhaseRatios.EqualProbabilities c d →\n    MainTheory.Orbit31CanonicalPhase.CrossSystem c d →\n      MainTheory.Orbit31CanonicalPhase.AmplitudeSupport\n          (MainTheory.Orbit31ResidualTriangles.mask MainTheory.Orbit31ResidualTriangles.typeNine) c →\n        ∀ (i : Fin 3),\n          c (MainTheory.Orbit31SignedSupport.A 0) * c (MainTheory.Orbit31SignedSupport.B i 0) =\n            c (MainTheory.Orbit31SignedSupport.A 1) * c (MainTheory.Orbit31SignedSupport.B i 1)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit31SignedSupport.A","type":"Fin 4 → Fin 16"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit31SignedSupport.B","type":"Fin 3 → Fin 4 → Fin 16"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31SupportBase.actual_rows","type":"MainTheory.Orbit31SupportBase.actualRows = MainTheory.Orbit31SupportBase.integerRows"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31SupportBase.bottom_native","type":"∀ (j : Fin 16),\n  MainTheory.Orbit31SupportBase.bottom j =\n    MainTheory.Orbit31SupportBase.native (MainTheory.Orbit31SupportBase.nativeIndex j)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit31SupportBase.words","type":"Fin 16 → ℕ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedLocalAlgebra.factors","type":"∀ (A B C E F G : ℝ),\n  A = (2 * E + 2 * F - G) / 3 →\n    B = (2 * E - F + 2 * G) / 3 →\n      C = (-E + 2 * F + 2 * G) / 3 →\n        A * F - B * G = 2 / 3 * (F - G) * (E + F + G) ∧\n          A * E - C * G = 2 / 3 * (E - G) * (E + F + G) ∧ B * E - C * F = 2 / 3 * (E - F) * (E + F + G)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedLocalAlgebra.moduli","type":"∀ {a b c e f g : ℂ},\n  Star.star a * f + Star.star b * g = 0 →\n    Star.star a * e + Star.star c * g = 0 →\n      Star.star b * e + Star.star c * f = 0 →\n        Complex.normSq a * Complex.normSq f = Complex.normSq b * Complex.normSq g ∧\n          Complex.normSq a * Complex.normSq e = Complex.normSq c * Complex.normSq g ∧\n            Complex.normSq b * Complex.normSq e = Complex.normSq c * Complex.normSq f"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedLocalAlgebra.positive_triple","type":"∀ (A B C E F G : ℝ),\n  A = (2 * E + 2 * F - G) / 3 →\n    B = (2 * E - F + 2 * G) / 3 →\n      C = (-E + 2 * F + 2 * G) / 3 →\n        0 < E → 0 ≤ F → 0 ≤ G → A * F = B * G → A * E = C * G → E = F ∧ F = G ∧ A = E ∧ B = E ∧ C = E ∧ 0 < E + F + G"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedLocalAlgebra.reflection_involution","type":"MainTheory.Orbit32PrintedLocalAlgebra.T * MainTheory.Orbit32PrintedLocalAlgebra.T = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedLocalAlgebra.triangle_identity","type":"∀ (a b c e f g : ℂ),\n  Star.star c * (Star.star a * f + Star.star b * g) - Star.star b * (Star.star a * e + Star.star c * g) +\n      Star.star a * (Star.star b * e + Star.star c * f) =\n    2 * Star.star a * Star.star c * f"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMinor.actual_matrix","type":"MainTheory.Orbit32PrintedMinor.matrixZ = MainTheory.Orbit32PrintedMinor.actualMatrix"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMinor.full_rank","type":"MainTheory.Orbit32PrintedMinor.matrixR.rank = 23"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMinor.kernel_dimension","type":"Module.finrank ℝ ↥MainTheory.Orbit32PrintedMinor.matrixR.mulVecLin.ker = 9"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit32PrintedMinor.printedColumns","type":"Fin 23 → Fin 32"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMinor.real_determinant","type":"MainTheory.Orbit32PrintedMinor.minorR.det = 3456"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.actual_bottom_groups","type":"∀ (e : Fin 4),\n  MainTheory.Orbit32PrintedMomentNormal.bottom (MainTheory.Orbit32PrintedMomentNormal.AIndex e) =\n      MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.false, Bool.false, Bool.false]\n        (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n    MainTheory.Orbit32PrintedMomentNormal.bottom (MainTheory.Orbit32PrintedMomentNormal.BIndex e) =\n        MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.false, Bool.true, Bool.true]\n          (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n      MainTheory.Orbit32PrintedMomentNormal.bottom (MainTheory.Orbit32PrintedMomentNormal.CIndex e) =\n          MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.true, Bool.false, Bool.true]\n            (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n        MainTheory.Orbit32PrintedMomentNormal.bottom (MainTheory.Orbit32PrintedMomentNormal.RIndex e) =\n          MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.true, Bool.true, Bool.false] fun j =>\n            !MainTheory.Orbit32PrintedMomentNormal.middle e j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.actual_top_groups","type":"∀ (e : Fin 4),\n  MainTheory.Orbit32PrintedMomentNormal.top (MainTheory.Orbit32PrintedMomentNormal.EIndex e) =\n      MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.false, Bool.true, Bool.false]\n        (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n    MainTheory.Orbit32PrintedMomentNormal.top (MainTheory.Orbit32PrintedMomentNormal.FIndex e) =\n        MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.true, Bool.false, Bool.false]\n          (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n      MainTheory.Orbit32PrintedMomentNormal.top (MainTheory.Orbit32PrintedMomentNormal.GIndex e) =\n          MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.true, Bool.true, Bool.true]\n            (MainTheory.Orbit32PrintedMomentNormal.middle e) ∧\n        MainTheory.Orbit32PrintedMomentNormal.top (MainTheory.Orbit32PrintedMomentNormal.SIndex e) =\n          MainTheory.Orbit32PrintedMomentNormal.embed ![Bool.false, Bool.false, Bool.true] fun j =>\n            !MainTheory.Orbit32PrintedMomentNormal.middle e j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.complete_normal_form","type":"∀ (q r : Fin 16 → ℝ),\n  MainTheory.Orbit32PrintedMomentNormal.VectorMoments q r ↔ MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q r"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.oddweights","type":"∀ (q r : Fin 16 → ℝ),\n  MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q r →\n    ∀ (e : Fin 4),\n      q (MainTheory.Orbit32PrintedMomentNormal.RIndex e) =\n          1 / 8 -\n            (r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) + r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) +\n                r (MainTheory.Orbit32PrintedMomentNormal.GIndex e)) /\n              3 ∧\n        r (MainTheory.Orbit32PrintedMomentNormal.SIndex e) =\n          1 / 8 -\n            (r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) + r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) +\n                r (MainTheory.Orbit32PrintedMomentNormal.GIndex e)) /\n              3"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.parameter_injectivity","type":"∀ (q r q' r' : Fin 16 → ℝ),\n  MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q r →\n    MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q' r' →\n      MainTheory.Orbit32PrintedMomentNormal.parameters r = MainTheory.Orbit32PrintedMomentNormal.parameters r' →\n        q = q' ∧ r = r'"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.physical_normal_form","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit32.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit32.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm\n              (fun j => Complex.normSq (c (MainTheory.Orbit32PrintedMomentNormal.bottom j))) fun j =>\n              Complex.normSq (d (MainTheory.Orbit32PrintedMomentNormal.top j))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.reflected","type":"∀ (q r : Fin 16 → ℝ),\n  MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q r →\n    ∀ (e : Fin 4),\n      q (MainTheory.Orbit32PrintedMomentNormal.AIndex e) =\n          (2 * r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) +\n                2 * r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) -\n              r (MainTheory.Orbit32PrintedMomentNormal.GIndex e)) /\n            3 ∧\n        q (MainTheory.Orbit32PrintedMomentNormal.BIndex e) =\n            (2 * r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) -\n                  r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) +\n                2 * r (MainTheory.Orbit32PrintedMomentNormal.GIndex e)) /\n              3 ∧\n          q (MainTheory.Orbit32PrintedMomentNormal.CIndex e) =\n            (-r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) +\n                  2 * r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) +\n                2 * r (MainTheory.Orbit32PrintedMomentNormal.GIndex e)) /\n              3"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit32PrintedMomentNormal.rowsums","type":"∀ (q r : Fin 16 → ℝ),\n  MainTheory.Orbit32PrintedMomentNormal.PrintedNormalForm q r →\n    ∑ e, r (MainTheory.Orbit32PrintedMomentNormal.EIndex e) = 1 / 4 ∧\n      ∑ e, r (MainTheory.Orbit32PrintedMomentNormal.FIndex e) = 1 / 4 ∧\n        ∑ e, r (MainTheory.Orbit32PrintedMomentNormal.GIndex e) = 1 / 4"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.divided_cross","type":"∀ (u v cf df : Fin 2 → ℂ) (a b : ℂ),\n  a ≠ 0 →\n    MainTheory.Orbit33NormalizedPairs.inner cf (b • v) + MainTheory.Orbit33NormalizedPairs.inner (a • u) df = 0 →\n      MainTheory.Orbit33NormalizedPairs.gamma a b * MainTheory.Orbit33NormalizedPairs.inner cf v +\n          MainTheory.Orbit33NormalizedPairs.inner u df =\n        0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.factorization","type":"∀ (u v : Fin 2 → ℂ) (r t : ℝ),\n  0 < r →\n    0 < t →\n      MainTheory.Orbit33NormalizedPairs.normSq u = r →\n        MainTheory.Orbit33NormalizedPairs.normSq v = t →\n          u 0 * v 1 - u 1 * v 0 = 0 → ∃ a, a ≠ 0 ∧ v = a • MainTheory.Orbit33NormalizedPairs.normalized u r"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33NormalizedPairs.gamma","type":"ℂ → ℂ → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33NormalizedPairs.inner","type":"(Fin 2 → ℂ) → (Fin 2 → ℂ) → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.normalized_pairs","type":"∀ (c d : Fin 3 → Fin 2 → ℂ),\n  (∀ (i : Fin 3), MainTheory.Orbit33NormalizedPairs.normSq (c i) = MainTheory.Orbit33NormalizedPairs.R3 i) →\n    (∀ (i : Fin 3), MainTheory.Orbit33NormalizedPairs.normSq (d i) = MainTheory.Orbit33NormalizedPairs.R3 i) →\n      (∀ (i : Fin 2),\n          MainTheory.Orbit33PrintedBlocks.mixed (d 0) (c (MainTheory.Orbit33NormalizedPairs.next i)) +\n              MainTheory.Orbit33PrintedBlocks.mixed (d (MainTheory.Orbit33NormalizedPairs.next i)) (c 0) =\n            0) →\n        ∃ u v a b,\n          MainTheory.Orbit33NormalizedPairs.normSq u = 1 ∧\n            MainTheory.Orbit33NormalizedPairs.normSq v = 1 ∧\n              ∀ (i : Fin 3), a i ≠ 0 ∧ b i ≠ 0 ∧ c i = a i • u ∧ d i = b i • v"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.orthogonal_from_opposite","type":"∀ (g A B : ℂ), g ≠ 0 → g * A + B = 0 → -g * A + B = 0 → A = 0 ∧ B = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.physical_far_orthogonal","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (u v : Fin 2 → ℂ) (a b : Fin 3 → ℂ),\n          (∀ (i : Fin 3),\n              a i ≠ 0 ∧\n                MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.near i) = a i • u ∧\n                  MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.near i) = b i • v) →\n            MainTheory.Orbit33NormalizedPairs.gamma (a 0) (b 0) ≠ 0 →\n              MainTheory.Orbit33NormalizedPairs.gamma (a 1) (b 1) =\n                  -MainTheory.Orbit33NormalizedPairs.gamma (a 0) (b 0) →\n                ∀ (j : Fin 3),\n                  MainTheory.Orbit33NormalizedPairs.inner\n                        (MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.far j)) v =\n                      0 ∧\n                    MainTheory.Orbit33NormalizedPairs.inner u\n                        (MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.far j)) =\n                      0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.physical_frame","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → Nonempty (MainTheory.Orbit33NormalizedPairs.Frame c d)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.physical_normalized_pairs","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∃ u v a b,\n              MainTheory.Orbit33NormalizedPairs.normSq u = 1 ∧\n                MainTheory.Orbit33NormalizedPairs.normSq v = 1 ∧\n                  (∀ (i : Fin 3),\n                      a i ≠ 0 ∧\n                        b i ≠ 0 ∧\n                          MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.near i) = a i • u ∧\n                            MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.near i) =\n                              b i • v) ∧\n                    (∀ (i : Fin 2),\n                        MainTheory.Orbit33NormalizedPairs.gamma (a (MainTheory.Orbit33NormalizedPairs.next i))\n                            (b (MainTheory.Orbit33NormalizedPairs.next i)) =\n                          -MainTheory.Orbit33NormalizedPairs.gamma (a 0) (b 0)) ∧\n                      MainTheory.Orbit33NormalizedPairs.gamma (a 0) (b 0) ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33NormalizedPairs.quotient_sign","type":"∀ (a0 a1 b0 b1 : ℂ),\n  a0 ≠ 0 →\n    a1 ≠ 0 →\n      b0 * Star.star a1 + b1 * Star.star a0 = 0 →\n        MainTheory.Orbit33NormalizedPairs.gamma a1 b1 = -MainTheory.Orbit33NormalizedPairs.gamma a0 b0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PhysicalReflection.physical_character_reflection","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (F : Matrix (Fin 2) (Fin 2) ℂ),\n              (fun i => MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.CBlock c i)) =\n                (MainTheory.Orbit33ScalarReflection.C⁻¹ * MainTheory.Orbit33ScalarReflection.J *\n                      MainTheory.Orbit33ScalarReflection.C).mulVec\n                  fun i => MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.DBlock d i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PhysicalReflection.physical_common_reduced_state","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit33PrintedBlocks.rho c =\n              ∑ i, MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.DBlock d i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PhysicalReflection.physical_scalar_reflection","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (F : Matrix (Fin 2) (Fin 2) ℂ) (i : Fin 6),\n              MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.CBlock c i) +\n                  MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.DBlock d i) =\n                2 * MainTheory.Orbit33ScalarReflection.R i *\n                  ∑ j, MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.CBlock c j)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.CBlock","type":"SS.State 6 ℂ → Fin 6 → Fin 2 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.DBlock","type":"SS.State 6 ℂ → Fin 6 → Fin 2 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.R","type":"Fin 6 → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.actual_characters","type":"MainTheory.Orbit33PrintedReflection.C = MainTheory.Orbit33PrintedBlocks.character"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.actual_fibers","type":"Finset.image (fun p => MainTheory.Orbit33PrintedBlocks.bottom p.1 p.2) Finset.univ = SixQubit.Orbit33.S0 ∧\n  Finset.image (fun p => MainTheory.Orbit33PrintedBlocks.top p.1 p.2) Finset.univ = SixQubit.Orbit33.S1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.actual_words","type":"∀ (i : Fin 6) (r : Fin 2),\n  MainTheory.Orbit33PrintedBlocks.bottom i r =\n      MainTheory.Orbit33PrintedBlocks.embed r (MainTheory.Orbit33PrintedBlocks.tail i) ∧\n    MainTheory.Orbit33PrintedBlocks.top i r =\n      MainTheory.Orbit33PrintedBlocks.embed r fun j => !MainTheory.Orbit33PrintedBlocks.tail i j"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.crossFlip","type":"Fin 3 → Fin 3 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.cross_incidence","type":"∀ (i j : Fin 3),\n  {y ∈ SixQubit.Orbit33.S1 | SS.bxor y (MainTheory.Orbit33PrintedBlocks.crossFlip i j) ∈ SixQubit.Orbit33.S0} =\n    {MainTheory.Orbit33PrintedBlocks.top (MainTheory.Orbit33PrintedBlocks.near i) 0,\n      MainTheory.Orbit33PrintedBlocks.top (MainTheory.Orbit33PrintedBlocks.near i) 1,\n      MainTheory.Orbit33PrintedBlocks.top (MainTheory.Orbit33PrintedBlocks.far j) 0,\n      MainTheory.Orbit33PrintedBlocks.top (MainTheory.Orbit33PrintedBlocks.far j) 1}"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.cross_weight","type":"∀ (i j : Fin 3), { x := MainTheory.Orbit33PrintedBlocks.crossFlip i j, z := SixQubit.Orbit33.w0 }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.evaluation","type":"Matrix (Fin 2) (Fin 2) ℂ → (Fin 2 → ℂ) → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.evaluation_formula","type":"∀ (F : Matrix (Fin 2) (Fin 2) ℂ) (v : Fin 2 → ℂ),\n  MainTheory.Orbit33PrintedBlocks.evaluation F v = ∑ r, ∑ s, Star.star (v r) * F r s * v s"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.far","type":"Fin 3 → Fin 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.matrix_reflection_iff","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ (i : Fin 6),\n      MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.CBlock c i) +\n          MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.DBlock d i) =\n        (2 * ↑(MainTheory.Orbit33PrintedBlocks.R i)) • MainTheory.Orbit33PrintedBlocks.rho c) ↔\n    ∀ (F : Matrix (Fin 2) (Fin 2) ℂ) (i : Fin 6),\n      MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.CBlock c i) +\n          MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.DBlock d i) =\n        2 * ↑(MainTheory.Orbit33PrintedBlocks.R i) *\n          ∑ j, MainTheory.Orbit33PrintedBlocks.evaluation F (MainTheory.Orbit33PrintedBlocks.CBlock c j)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.near","type":"Fin 3 → Fin 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.physical_blocks_nonzero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 6),\n              MainTheory.Orbit33PrintedBlocks.CBlock c i ≠ 0 ∧ MainTheory.Orbit33PrintedBlocks.DBlock d i ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.physical_complete_cross","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i j : Fin 3),\n          ∑ r,\n              (Star.star (MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.far j) r) *\n                  MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.near i) r +\n                Star.star (MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.near i) r) *\n                  MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.far j) r) =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.physical_norms_and_reflection","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (∀ (i : Fin 6),\n                ∑ r, Complex.normSq (MainTheory.Orbit33PrintedBlocks.CBlock c i r) =\n                    MainTheory.Orbit33PrintedBlocks.R i ∧\n                  ∑ r, Complex.normSq (MainTheory.Orbit33PrintedBlocks.DBlock d i r) =\n                    MainTheory.Orbit33PrintedBlocks.R i) ∧\n              ∀ (i : Fin 6),\n                MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.CBlock c i) +\n                    MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.DBlock d i) =\n                  (2 * ↑(MainTheory.Orbit33PrintedBlocks.R i)) • MainTheory.Orbit33PrintedBlocks.rho c"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.physical_rankone_pairs","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i : Fin 2),\n          MainTheory.Orbit33PrintedBlocks.mixed (MainTheory.Orbit33PrintedBlocks.DBlock d 0)\n                (MainTheory.Orbit33PrintedBlocks.CBlock c (MainTheory.Orbit33PrintedBlocks.pairIndex i)) +\n              MainTheory.Orbit33PrintedBlocks.mixed\n                (MainTheory.Orbit33PrintedBlocks.DBlock d (MainTheory.Orbit33PrintedBlocks.pairIndex i))\n                (MainTheory.Orbit33PrintedBlocks.CBlock c 0) =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.rankone_rows_iff_1","type":"∀ (c d : SS.State 6 ℂ),\n  MainTheory.Orbit33PrintedBlocks.RankOneRows1 c d ↔\n    MainTheory.Orbit33PrintedBlocks.mixed (MainTheory.Orbit33PrintedBlocks.DBlock d 0)\n          (MainTheory.Orbit33PrintedBlocks.CBlock c ⟨1, ⋯⟩) +\n        MainTheory.Orbit33PrintedBlocks.mixed (MainTheory.Orbit33PrintedBlocks.DBlock d ⟨1, ⋯⟩)\n          (MainTheory.Orbit33PrintedBlocks.CBlock c 0) =\n      0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedBlocks.rankone_rows_iff_2","type":"∀ (c d : SS.State 6 ℂ),\n  MainTheory.Orbit33PrintedBlocks.RankOneRows2 c d ↔\n    MainTheory.Orbit33PrintedBlocks.mixed (MainTheory.Orbit33PrintedBlocks.DBlock d 0)\n          (MainTheory.Orbit33PrintedBlocks.CBlock c ⟨2, ⋯⟩) +\n        MainTheory.Orbit33PrintedBlocks.mixed (MainTheory.Orbit33PrintedBlocks.DBlock d ⟨2, ⋯⟩)\n          (MainTheory.Orbit33PrintedBlocks.CBlock c 0) =\n      0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.rho","type":"SS.State 6 ℂ → Matrix (Fin 2) (Fin 2) ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit33PrintedBlocks.tail","type":"Fin 6 → SS.BitString 5"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33PrintedReflection.determinant","type":"MainTheory.Orbit33PrintedReflection.C.det = 160"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.orthogonal_outer","type":"∀ (v w : Fin 2 → ℂ) (r : ℝ),\n  MainTheory.Orbit33NormalizedPairs.normSq v = 1 →\n    MainTheory.Orbit33NormalizedPairs.normSq w = r →\n      MainTheory.Orbit33NormalizedPairs.inner w v = 0 →\n        MainTheory.Orbit33PrintedBlocks.outer w = ↑r • (1 - MainTheory.Orbit33PrintedBlocks.outer v)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_all_bottom_outers","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (f : MainTheory.Orbit33NormalizedPairs.Frame c d) (i : Fin 6),\n              MainTheory.Orbit33PrintedBlocks.outer (MainTheory.Orbit33PrintedBlocks.CBlock c i) =\n                ↑(MainTheory.Orbit33PrintedBlocks.R i) • MainTheory.Orbit33PrintedBlocks.outer f.u"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_near_and_far_sums","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (f : MainTheory.Orbit33NormalizedPairs.Frame c d),\n              MainTheory.Orbit33PrintedBlocks.outer f.u + MainTheory.Orbit33PrintedBlocks.outer f.v =\n                  2 • MainTheory.Orbit33PrintedBlocks.rho c ∧\n                1 - MainTheory.Orbit33PrintedBlocks.outer f.v + (1 - MainTheory.Orbit33PrintedBlocks.outer f.u) =\n                  2 • MainTheory.Orbit33PrintedBlocks.rho c"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) → SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_projector_sums","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (f : MainTheory.Orbit33NormalizedPairs.Frame c d),\n              MainTheory.Orbit33PrintedBlocks.outer f.u + MainTheory.Orbit33PrintedBlocks.outer f.v = 1 ∧\n                MainTheory.Orbit33PrintedBlocks.rho c = (1 / 2) • 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_rho_projector","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (f : MainTheory.Orbit33NormalizedPairs.Frame c d),\n              MainTheory.Orbit33PrintedBlocks.rho c = MainTheory.Orbit33PrintedBlocks.outer f.u"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.physical_unit_orthogonality","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit33.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit33.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (f : MainTheory.Orbit33NormalizedPairs.Frame c d), MainTheory.Orbit33NormalizedPairs.inner f.u f.v = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.rank_one_not_half","type":"∀ (u : Fin 2 → ℂ), MainTheory.Orbit33PrintedBlocks.outer u ≠ (1 / 2) • 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ProjectorArgument.scaled_outer","type":"∀ (u w : Fin 2 → ℂ) (a : ℂ) (r : ℝ),\n  MainTheory.Orbit33NormalizedPairs.normSq u = 1 →\n    MainTheory.Orbit33NormalizedPairs.normSq w = r →\n      w = a • u → MainTheory.Orbit33PrintedBlocks.outer w = ↑r • MainTheory.Orbit33PrintedBlocks.outer u"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ScalarReflection.C_cast","type":"MainTheory.Orbit33ScalarReflection.C = fun i j => ↑(MainTheory.Orbit33PrintedReflection.C i j)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ScalarReflection.inverse","type":"MainTheory.Orbit33ScalarReflection.C⁻¹ = MainTheory.Orbit33ScalarReflection.inverseC"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit33ScalarReflection.reflection_entries","type":"MainTheory.Orbit33ScalarReflection.inverseC * MainTheory.Orbit33ScalarReflection.J *\n    MainTheory.Orbit33ScalarReflection.C =\n  fun i j => 2 * MainTheory.Orbit33ScalarReflection.R i - if i = j then 1 else 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit3PrintedSplitMatrices.a","type":"ℝ → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit3PrintedSplitMatrices.b","type":"ℝ → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.columns","type":"∀ (θ : ℝ),\n  MainTheory.Orbit3PrintedSplitMatrices.W θ =\n    ![![↑(Real.cos (θ / 2)), 0], ![0, ↑(Real.cos (θ / 2))], ![↑(Real.sin (θ / 2)), 0], ![0, -↑(Real.sin (θ / 2))]]"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.isometry","type":"∀ (θ : ℝ), (MainTheory.Orbit3PrintedSplitMatrices.W θ).conjTranspose * MainTheory.Orbit3PrintedSplitMatrices.W θ = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.logical","type":"∀ (θ : ℝ),\n  MainTheory.Orbit3PrintedSplitMatrices.IZ * MainTheory.Orbit3PrintedSplitMatrices.W θ =\n    MainTheory.Orbit3PrintedSplitMatrices.W θ * Orbit2.zTwo"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.output_order","type":"∀ (θ : ℝ),\n  MainTheory.Orbit3PrintedSplitMatrices.W θ =\n    (MainTheory.PrimitiveSplitDisplays.W3 θ).submatrix MainTheory.Orbit3PrintedSplitMatrices.outputSwap id"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.projection","type":"∀ (θ : ℝ),\n  MainTheory.Orbit3PrintedSplitMatrices.W θ * (MainTheory.Orbit3PrintedSplitMatrices.W θ).conjTranspose =\n    (1 / 2) •\n      (1 + ↑(Real.cos θ) • MainTheory.Orbit3PrintedSplitMatrices.ZI +\n        ↑(Real.sin θ) • MainTheory.Orbit3PrintedSplitMatrices.XZ)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit3PrintedSplitMatrices.trace_identity","type":"∀ (W : Matrix (Fin 4) (Fin 2) ℂ) (E : Matrix (Fin 4) (Fin 4) ℂ),\n  1 / 2 * (W.conjTranspose * E * W).trace = 1 / 2 * (E * (W * W.conjTranspose)).trace"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45AffineGauge.A","type":"Matrix (Fin 7) (Fin 7) ℚ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45AffineGauge.actual_rows","type":"∀ (i j : Fin 7),\n  MainTheory.Orbit45AffineGauge.A i j =\n    if ↑j = 0 then 1\n    else\n      if MainTheory.Orbit45PrintedFibers.bottom (MainTheory.Orbit45AffineGauge.anchors i) ⟨↑j - 1, ⋯⟩ = Bool.true then 1\n      else 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45AffineGauge.affine_angle","type":"∀ (theta : Fin 7 → ℝ) (i : Fin 7),\n  MainTheory.Orbit45AffineGauge.AR.mulVec theta i =\n    theta 0 +\n      ∑ j,\n        if MainTheory.Orbit45PrintedFibers.bottom (MainTheory.Orbit45AffineGauge.anchors i) j = Bool.true then\n          theta j.succ\n        else 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45AffineGauge.anchors","type":"Fin 7 → Fin 10"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45AffineGauge.anchors_positive","type":"∀ (c : SS.State 6 ℂ),\n  ∃ theta,\n    ∀ (i : Fin 7),\n      MainTheory.Orbit45AffineGauge.phaseAction theta c\n          (MainTheory.Orbit45PrintedFibers.bottom (MainTheory.Orbit45AffineGauge.anchors i)) =\n        ↑‖c (MainTheory.Orbit45PrintedFibers.bottom (MainTheory.Orbit45AffineGauge.anchors i))‖"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45AffineGauge.determinant","type":"MainTheory.Orbit45AffineGauge.A.det = 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45AffineGauge.factorization","type":"MainTheory.Orbit45AffineGauge.A.submatrix (⇑MainTheory.Orbit45AffineGauge.permutation) id =\n  MainTheory.Orbit45AffineGauge.lower * MainTheory.Orbit45AffineGauge.upper"}
