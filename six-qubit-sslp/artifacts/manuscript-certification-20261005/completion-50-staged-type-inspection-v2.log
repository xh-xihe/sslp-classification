CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row4.matrix_checked","type":"MainTheory.RectangularFlipCharacters.matrix MainTheory.Orbit45CrossFactors.Row4.characters\n    MainTheory.Orbit45CrossFactors.Row4.sources =\n  MainTheory.Orbit45CrossFactors.Row4.WC"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row4.physical_factors","type":"∀ (B G S H : ℝ) (U V W xi eta zeta : ℂ),\n  Complex.normSq U = 1 →\n    Complex.normSq V = 1 →\n      Complex.normSq W = 1 →\n        ↑S * ↑H ≠ 0 →\n          ∀ (c d : SS.State 6 ℂ),\n            (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n              (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n                SS.HasDistance ![c, d] 3 →\n                  (fun j => c (MainTheory.Orbit45PrintedFibers.bottom j)) =\n                      MainTheory.Orbit45CrossFactors.C B G S H U V W →\n                    (fun j => d (MainTheory.Orbit45PrintedFibers.top j)) =\n                        MainTheory.Orbit45CrossFactors.D B G S H U V W xi eta zeta →\n                      MainTheory.Orbit45CrossFactors.Row4.factors U V W xi eta zeta = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row4.physical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit45CrossFactors.Row4.WC.mulVec (MainTheory.Orbit45CrossFactors.Row4.products c d) = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row4.sourceIndices","type":"Fin 4 → Fin 10"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row4.sources","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row4.substitution","type":"∀ (B G S H : ℝ) (U V W xi eta zeta : ℂ),\n  Complex.normSq U = 1 →\n    Complex.normSq V = 1 →\n      Complex.normSq W = 1 →\n        ∀ (a : Fin 4),\n          U *\n              MainTheory.Orbit45CrossFactors.Row4.WC.mulVec\n                (MainTheory.Orbit45CrossFactors.Row4.gaugeProducts B G S H U V W xi eta zeta) a =\n            ↑S * ↑H * MainTheory.Orbit45CrossFactors.Row4.factors U V W xi eta zeta a"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row4.walsh","type":"Matrix (Fin 4) (Fin 4) ℚ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row4.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit45CrossFactors.flip ⟨4, ⋯⟩, z := MainTheory.Orbit45CrossFactors.Row4.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.actual_characters","type":"∀ (i j : Fin 4),\n  MainTheory.Orbit45CrossFactors.Row5.walsh i j =\n    if\n        SS.bdot (MainTheory.Orbit45CrossFactors.Row5.characters i) (MainTheory.Orbit45CrossFactors.Row5.sources j) =\n          Bool.true then\n      -1\n    else 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.actual_images","type":"∀ (j : Fin 4),\n  SS.bxor (MainTheory.Orbit45CrossFactors.Row5.sources j) (MainTheory.Orbit45CrossFactors.flip ⟨5, ⋯⟩) =\n    MainTheory.Orbit45CrossFactors.Row5.destinations j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.actual_incidence","type":"Finset.image MainTheory.Orbit45CrossFactors.Row5.sources Finset.univ =\n  {y ∈ SixQubit.Orbit45Support.S1 | SS.bxor y (MainTheory.Orbit45CrossFactors.flip ⟨5, ⋯⟩) ∈ SixQubit.Orbit45Support.S0}"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.characters","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.destinationIndices","type":"Fin 4 → Fin 10"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.destinations","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.factors","type":"ℂ → ℂ → ℂ → ℂ → ℂ → ℂ → Fin 4 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.gaugeProducts","type":"ℝ → ℝ → ℝ → ℝ → ℂ → ℂ → ℂ → ℂ → ℂ → ℂ → Fin 4 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.matrix_checked","type":"MainTheory.RectangularFlipCharacters.matrix MainTheory.Orbit45CrossFactors.Row5.characters\n    MainTheory.Orbit45CrossFactors.Row5.sources =\n  MainTheory.Orbit45CrossFactors.Row5.WC"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.physical_factors","type":"∀ (B G S H : ℝ) (U V W xi eta zeta : ℂ),\n  Complex.normSq U = 1 →\n    Complex.normSq V = 1 →\n      Complex.normSq W = 1 →\n        ↑G * ↑H ≠ 0 →\n          ∀ (c d : SS.State 6 ℂ),\n            (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n              (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n                SS.HasDistance ![c, d] 3 →\n                  (fun j => c (MainTheory.Orbit45PrintedFibers.bottom j)) =\n                      MainTheory.Orbit45CrossFactors.C B G S H U V W →\n                    (fun j => d (MainTheory.Orbit45PrintedFibers.top j)) =\n                        MainTheory.Orbit45CrossFactors.D B G S H U V W xi eta zeta →\n                      MainTheory.Orbit45CrossFactors.Row5.factors U V W xi eta zeta = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.physical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit45CrossFactors.Row5.WC.mulVec (MainTheory.Orbit45CrossFactors.Row5.products c d) = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.sourceIndices","type":"Fin 4 → Fin 10"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.sources","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.substitution","type":"∀ (B G S H : ℝ) (U V W xi eta zeta : ℂ),\n  Complex.normSq U = 1 →\n    Complex.normSq V = 1 →\n      Complex.normSq W = 1 →\n        ∀ (a : Fin 4),\n          U * W *\n              MainTheory.Orbit45CrossFactors.Row5.WC.mulVec\n                (MainTheory.Orbit45CrossFactors.Row5.gaugeProducts B G S H U V W xi eta zeta) a =\n            ↑G * ↑H * MainTheory.Orbit45CrossFactors.Row5.factors U V W xi eta zeta a"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.Row5.walsh","type":"Matrix (Fin 4) (Fin 4) ℚ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.Row5.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit45CrossFactors.flip ⟨5, ⋯⟩, z := MainTheory.Orbit45CrossFactors.Row5.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.all_cross_masks","type":"∀ (e : SS.BitString 6),\n  SS.hammingWt e ≤ 2 →\n    ((∃ y ∈ SixQubit.Orbit45Support.S1, SS.bxor y e ∈ SixQubit.Orbit45Support.S0) ↔\n      e = SS.stdBasis 3 ∨ ∃ r, e = MainTheory.Orbit45CrossFactors.flip r)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.flip","type":"Fin 6 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.forced_phases","type":"∀ (U V W xi eta zeta : ℂ),\n  Complex.normSq xi = 1 →\n    Complex.normSq eta = 1 →\n      MainTheory.Orbit45CrossFactors.Row0.factors U V W xi eta zeta = 0 →\n        MainTheory.Orbit45CrossFactors.Row1.factors U V W xi eta zeta = 0 →\n          MainTheory.Orbit45CrossFactors.Row2.factors U V W xi eta zeta = 0 →\n            MainTheory.Orbit45CrossFactors.Row3.factors U V W xi eta zeta = 0 →\n              U = -1 ∧ V = Star.star xi ∧ W = Star.star eta ∧ zeta = 1"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45CrossFactors.pairs","type":"Fin 6 → Fin 6 × Fin 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.remaining_factors_zero","type":"∀ (xi eta : ℂ),\n  Complex.normSq xi = 1 →\n    Complex.normSq eta = 1 →\n      MainTheory.Orbit45CrossFactors.Row0.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0 ∧\n        MainTheory.Orbit45CrossFactors.Row1.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0 ∧\n          MainTheory.Orbit45CrossFactors.Row2.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0 ∧\n            MainTheory.Orbit45CrossFactors.Row3.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0 ∧\n              MainTheory.Orbit45CrossFactors.Row4.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0 ∧\n                MainTheory.Orbit45CrossFactors.Row5.factors (-1) (Star.star xi) (Star.star eta) xi eta 1 = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45CrossFactors.triangle_after_gauge","type":"∀ (b g s : ℝ) (xi eta zeta : ℂ), ↑b * xi + ↑g * eta + ↑s * zeta = 0 → zeta = 1 → ↑b * xi + ↑g * eta + ↑s = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.actual_row_signs","type":"∀ (i : Fin 12) (j : Fin 10),\n  (if\n        SS.bdot (MainTheory.Orbit45PhysicalPrintedRows.characters i) (MainTheory.Orbit45PrintedFibers.top j) =\n          Bool.true then\n      -1\n    else 1) =\n    MainTheory.Orbit45PhysicalPrintedRows.rowSign i * MainTheory.Orbit45PrintedWalsh.rows i j"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PhysicalPrintedRows.characters","type":"Fin 12 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.codewords","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      c =\n          ∑ i,\n            c (MainTheory.Orbit45PrintedFibers.bottom i) •\n              MainTheory.SupportKetExpansion.ket (MainTheory.Orbit45PrintedFibers.bottom i) ∧\n        d =\n          ∑ i,\n            d (MainTheory.Orbit45PrintedFibers.top i) •\n              MainTheory.SupportKetExpansion.ket (MainTheory.Orbit45PrintedFibers.top i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.physical_paired_products","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 10),\n              c (MainTheory.Orbit45PrintedFibers.bottom i) * d (MainTheory.Orbit45PrintedFibers.top i.rev) =\n                c (MainTheory.Orbit45PrintedFibers.bottom i.rev) * d (MainTheory.Orbit45PrintedFibers.top i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.physical_reversal","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 10),\n              MainTheory.Orbit45PhysicalPrintedRows.p c i.rev = MainTheory.Orbit45PhysicalPrintedRows.p c i ∧\n                MainTheory.Orbit45PhysicalPrintedRows.z c d i.rev = MainTheory.Orbit45PhysicalPrintedRows.z c d i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.physical_spin_sum_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → MainTheory.Orbit45PhysicalPrintedRows.spinSum c d = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.physical_walsh","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit45PrintedWalsh.W.mulVec (MainTheory.Orbit45PhysicalPrintedRows.z c d) = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PhysicalPrintedRows.spinSum","type":"SS.State 6 ℂ → SS.State 6 ℂ → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalPrintedRows.weights","type":"∀ (i : Fin 12),\n  { x := MainTheory.Orbit45PhysicalPrintedRows.flip, z := MainTheory.Orbit45PhysicalPrintedRows.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalProbabilityDomain.physical_probabilities","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit45PhysicalPrintedRows.p c =\n                MainTheory.Orbit45PrintedMoments.pattern (1 / 8) (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n                  (MainTheory.Orbit45PhysicalPrintedRows.p c 0) ∧\n              MainTheory.Orbit45PhysicalPrintedRows.q d =\n                MainTheory.Orbit45PrintedMoments.pattern (1 / 8) (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n                  (MainTheory.Orbit45PhysicalPrintedRows.p c 0)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalProbabilityDomain.positive_stratum","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (0 <\n                MainTheory.Orbit45PhysicalPrintedRows.p c 1 * MainTheory.Orbit45PhysicalPrintedRows.p c 0 *\n                  MainTheory.Orbit45PhysicalPrintedRows.p c 2 ↔\n              (∀ (i : Fin 10), c (MainTheory.Orbit45PrintedFibers.bottom i) ≠ 0) ∧\n                ∀ (i : Fin 10), d (MainTheory.Orbit45PrintedFibers.top i) ≠ 0)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalProbabilityDomain.triangle_domain","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit45TrianglePolynomial.Domain (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n              (MainTheory.Orbit45PhysicalPrintedRows.p c 0) (MainTheory.Orbit45PhysicalPrintedRows.p c 2)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.complementary_fibers","type":"(∀ (i : Fin 10), SS.complement (MainTheory.Orbit45PrintedFibers.bottom i) = MainTheory.Orbit45PrintedFibers.top i.rev) ∧\n  (∀ (i : Fin 10),\n      SS.complement (MainTheory.Orbit45PrintedFibers.top i) = MainTheory.Orbit45PrintedFibers.bottom i.rev) ∧\n    (∀ (i : Fin 10), SS.complement (MainTheory.Orbit45PrintedFibers.bottom i) ∉ SixQubit.Orbit45Support.S0) ∧\n      ∀ (i : Fin 10), SS.complement (MainTheory.Orbit45PrintedFibers.top i) ∉ SixQubit.Orbit45Support.S1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.diagonal_overlaps","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) → SS.Shadow.Tf ![c, d] 0 0 = 0 ∧ SS.Shadow.Tf ![c, d] 1 1 = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.general_shadow_trace","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  (∀ (i : Fin 2), SS.innerC (psi i) (psi i) = 1) →\n    SS.HasDistance psi 3 →\n      (MainTheory.PairPartialTrace.familyKernel psi *\n            MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi)).trace =\n        ↑(1 / 2 *\n            (1 - MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 1 -\n                MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 2 -\n              MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 3))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.pair_overlap","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    SS.Shadow.Tf ![c, d] 0 1 = MainTheory.Orbit45PhysicalPrintedRows.spinSum c d"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.pairing_symmetric","type":"∀ (psi : Fin 2 → SS.State 6 ℂ) (a b : Fin 2), SS.Shadow.Tf psi a b = SS.Shadow.Tf psi b a"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.parity_sign","type":"∀ (x : SS.BitString 6), ↑(SS.Shadow.psign x) = ↑(-1) ^ SS.hammingWt x"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.physical_A1_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → MainTheory.Orbit8EnumeratorDisplays.normalizedA ![c, d] 1 = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.physical_A2_A3_line","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit8EnumeratorDisplays.normalizedA ![c, d] 2 +\n                MainTheory.Orbit8EnumeratorDisplays.normalizedA ![c, d] 3 =\n              1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.physical_overlaps_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → ∀ (a b : Fin 2), SS.Shadow.Tf ![c, d] a b = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PhysicalSpinFlip.physical_spin_trace_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (MainTheory.PairPartialTrace.familyKernel ![c, d] *\n                  MainTheory.Orbit8SpinProjector.spinConjugate\n                    (MainTheory.PairPartialTrace.familyKernel ![c, d])).trace =\n              0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.actual_bottom_characters","type":"∀ (i : Fin 15) (j : Fin 10),\n  (if\n        SS.bdot (MainTheory.Orbit45PrintedDiagonalContribution.pairZ i) (MainTheory.Orbit45PrintedFibers.bottom j) =\n          Bool.true then\n      -1\n    else 1) =\n    MainTheory.Orbit45PrintedDiagonalContribution.bottomChars i j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.actual_top_characters","type":"∀ (i : Fin 15) (j : Fin 10),\n  (if\n        SS.bdot (MainTheory.Orbit45PrintedDiagonalContribution.pairZ i) (MainTheory.Orbit45PrintedFibers.top j) =\n          Bool.true then\n      -1\n    else 1) =\n    MainTheory.Orbit45PrintedDiagonalContribution.topChars i j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.indexed_expectation","type":"∀ (S : Finset (SS.BitString 6)) (xs : Fin 10 → SS.BitString 6),\n  Function.Injective xs →\n    Finset.image xs Finset.univ = S →\n      ∀ (c : SS.State 6 ℂ),\n        (∀ x ∉ S, c x = 0) →\n          ∀ (a : SS.BitString 6),\n            SS.innerC c (SS.pauliAct { x := fun x => Bool.false, z := a } c) =\n              ↑(∑ i, Complex.normSq (c (xs i)) * MainTheory.Orbit45PrintedDiagonalContribution.character a (xs i))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.literal_table","type":"∀ (b g s : ℝ),\n  b + g + s = 1 / 4 →\n    ∀ (i : Fin 15),\n      ∑ j,\n            MainTheory.Orbit45PrintedMoments.pattern (1 / 8) b g j *\n              MainTheory.Orbit45PrintedDiagonalContribution.character\n                (MainTheory.Orbit45PrintedDiagonalContribution.pairZ i) (MainTheory.Orbit45PrintedFibers.bottom j) =\n          MainTheory.Orbit45PrintedDiagonalContribution.table b g s i ∧\n        ∑ j,\n            MainTheory.Orbit45PrintedMoments.pattern (1 / 8) b g j *\n              MainTheory.Orbit45PrintedDiagonalContribution.character\n                (MainTheory.Orbit45PrintedDiagonalContribution.pairZ i) (MainTheory.Orbit45PrintedFibers.top j) =\n          MainTheory.Orbit45PrintedDiagonalContribution.table b g s i"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedDiagonalContribution.pairZ","type":"Fin 15 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.pair_injective","type":"Function.Injective MainTheory.Orbit45PrintedDiagonalContribution.pairZ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedDiagonalContribution.pairs","type":"Fin 15 → Fin 6 × Fin 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.physical_contribution","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∑ i,\n                Complex.normSq\n                  (SS.innerC c\n                    (SS.pauliAct\n                      { x := fun x => Bool.false, z := MainTheory.Orbit45PrintedDiagonalContribution.pairZ i } c)) =\n              48 *\n                  MainTheory.Orbit45TrianglePolynomial.R (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n                    (MainTheory.Orbit45PhysicalPrintedRows.p c 0) (MainTheory.Orbit45PhysicalPrintedRows.p c 2) -\n                1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.physical_table","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 15),\n              SS.innerC c\n                    (SS.pauliAct\n                      { x := fun x => Bool.false, z := MainTheory.Orbit45PrintedDiagonalContribution.pairZ i } c) =\n                  ↑(MainTheory.Orbit45PrintedDiagonalContribution.table (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n                      (MainTheory.Orbit45PhysicalPrintedRows.p c 0) (MainTheory.Orbit45PhysicalPrintedRows.p c 2) i) ∧\n                SS.innerC d\n                    (SS.pauliAct\n                      { x := fun x => Bool.false, z := MainTheory.Orbit45PrintedDiagonalContribution.pairZ i } d) =\n                  ↑(MainTheory.Orbit45PrintedDiagonalContribution.table (MainTheory.Orbit45PhysicalPrintedRows.p c 1)\n                      (MainTheory.Orbit45PhysicalPrintedRows.p c 0) (MainTheory.Orbit45PhysicalPrintedRows.p c 2) i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.pure_pair_classification","type":"∀ (a : SS.BitString 6), SS.hammingWt a = 2 ↔ ∃ i, a = MainTheory.Orbit45PrintedDiagonalContribution.pairZ i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedDiagonalContribution.squared_contribution","type":"∀ (b g s : ℝ),\n  b + g + s = 1 / 4 →\n    ∑ i, MainTheory.Orbit45PrintedDiagonalContribution.table b g s i ^ 2 =\n      48 * MainTheory.Orbit45TrianglePolynomial.R b g s - 1 / 2"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedDiagonalContribution.table","type":"ℝ → ℝ → ℝ → Fin 15 → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedWalsh.actual_rows","type":"MainTheory.Orbit45PrintedWalsh.actual = MainTheory.Orbit45PrintedWalsh.rows"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedWalsh.masks","type":"Fin 12 → ℕ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedWalsh.minor_absolute_determinant","type":"|MainTheory.Orbit45PrintedWalsh.minor.det| = 256"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45PrintedWalsh.rank_seven","type":"MainTheory.Orbit45PrintedWalsh.W.rank = 7"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedWalsh.selectedCols","type":"Fin 7 → Fin 10"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45PrintedWalsh.selectedRows","type":"Fin 7 → Fin 12"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45RelativeLogicalPhase.fixed_norm","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 → Complex.normSq (MainTheory.Orbit45PhysicalPrintedRows.z c d 3) = 1 / 64"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45RelativeLogicalPhase.phase","type":"SS.State 6 ℂ → SS.State 6 ℂ → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45RelativeLogicalPhase.phase_unit","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            Star.star (MainTheory.Orbit45RelativeLogicalPhase.phase c d) *\n                MainTheory.Orbit45RelativeLogicalPhase.phase c d =\n              1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45RelativeLogicalPhase.relative_gauge","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit45PhysicalPrintedRows.z c (MainTheory.Orbit45RelativeLogicalPhase.phase c d • d) 3 = 1 / 8 ∧\n              (∀ x ∉ SixQubit.Orbit45Support.S1, (MainTheory.Orbit45RelativeLogicalPhase.phase c d • d) x = 0) ∧\n                SS.innerC (MainTheory.Orbit45RelativeLogicalPhase.phase c d • d)\n                      (MainTheory.Orbit45RelativeLogicalPhase.phase c d • d) =\n                    1 ∧\n                  SS.HasDistance ![c, MainTheory.Orbit45RelativeLogicalPhase.phase c d • d] 3"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45ShadowNormalization.S0","type":"(Fin 2 → SS.State 6 ℂ) → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit45ShadowNormalization.identity","type":"SS.PauliString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45ShadowNormalization.identity_kernel","type":"MainTheory.PauliKernelTrace.pauliKernel MainTheory.Orbit45ShadowNormalization.identity = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45ShadowNormalization.physical_shadow_zero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit45Support.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit45Support.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → MainTheory.Orbit45ShadowNormalization.S0 ![c, d] = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45ShadowNormalization.shadow_normal_form","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  (∀ (i : Fin 2), SS.innerC (psi i) (psi i) = 1) →\n    SS.HasDistance psi 3 →\n      MainTheory.Orbit45ShadowNormalization.S0 psi =\n        1 / 4 *\n          (1 - MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 1 -\n              MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 2 -\n            MainTheory.Orbit8EnumeratorDisplays.normalizedA psi 3)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit45ShadowNormalization.shadow_trace","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  ↑(MainTheory.Orbit45ShadowNormalization.S0 psi) =\n    1 / 2 *\n      (MainTheory.PairPartialTrace.familyKernel psi *\n          MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi)).trace"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PhysicalCompletion.fourRows","type":"(Fin 10 → ℂ) → (Fin 10 → ℂ) → Prop"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.four_polynomials","type":"∀ (c d : Fin 10 → ℂ),\n  d ⟨8, ⋯⟩ ≠ 0 →\n    (∀ (i : Fin 8), MainTheory.Orbit49PrintedAlgebra.rec c d ⟨8, ⋯⟩ ⟨↑i, ⋯⟩ = 0) →\n      MainTheory.Orbit49PhysicalCompletion.fourRows c d → MainTheory.Orbit49PhysicalCompletion.quadrics c"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_four_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        MainTheory.Orbit49PhysicalCompletion.fourRows (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n          (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_moment","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.OrderThreePrintedMoments.Orbit49.Moment\n              (fun i => Complex.normSq (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c i)) fun i =>\n              Complex.normSq (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) → SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_pinned_point","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (∀ (i : Fin 10),\n                Complex.normSq (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c i) =\n                  if ↑i < 8 then 1 / 12 else 1 / 6) ∧\n              ∀ (i : Fin 10),\n                Complex.normSq (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d i) = if ↑i < 8 then 1 / 12 else 1 / 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_quadrics","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit49PhysicalCompletion.quadrics (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PhysicalCompletion.physical_uniform_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit49PrintedAlgebra.rho (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                  (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨8, ⋯⟩ =\n                MainTheory.Orbit49PrintedAlgebra.rho (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                  (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨9, ⋯⟩ ∧\n              MainTheory.Orbit49PrintedAlgebra.rho (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                    (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨8, ⋯⟩ ≠\n                  0 ∧\n                ∀ (i : Fin 8),\n                  MainTheory.Orbit49PrintedAlgebra.topAmplitudes d ⟨↑i, ⋯⟩ =\n                    -MainTheory.Orbit49PrintedAlgebra.rho (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                          (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨8, ⋯⟩ *\n                      Star.star (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c ⟨↑i, ⋯⟩)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PhysicalCompletion.quadrics","type":"(Fin 10 → ℂ) → Prop"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.norm_product","type":"∀ (a b c d : ℂ), a * b + c * d = 0 → Complex.normSq a * Complex.normSq b = Complex.normSq c * Complex.normSq d"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.pin_parameters","type":"∀ (a b g : ℝ),\n  g * (1 / 6 - b) = (1 / 6 - g) * b →\n    g * (1 / 6 - a) = (1 / 6 - g) * a →\n      g * (a + b + g - 1 / 6) = (1 / 6 - g) * (1 / 3 - a - b - g) → a = 1 / 12 ∧ b = 1 / 12 ∧ g = 1 / 12"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.pinned_point","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit49.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    c 0 * c ⟨3, ⋯⟩ + c 1 * c ⟨2, ⋯⟩ = 0 →\n      c 0 * c ⟨5, ⋯⟩ + c 1 * c ⟨4, ⋯⟩ = 0 →\n        c 0 * c ⟨7, ⋯⟩ + c 1 * c ⟨6, ⋯⟩ = 0 →\n          (∀ (i : Fin 10), Complex.normSq (c i) = if ↑i < 8 then 1 / 12 else 1 / 6) ∧\n            ∀ (i : Fin 10), Complex.normSq (d i) = if ↑i < 8 then 1 / 12 else 1 / 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.poly_from_four_reciprocals","type":"∀ (a b c d e f g h s t : ℂ),\n  t ≠ 0 →\n    Star.star s * e + Star.star a * t = 0 →\n      Star.star s * f + Star.star b * t = 0 →\n        Star.star s * g + Star.star c * t = 0 →\n          Star.star s * h + Star.star d * t = 0 →\n            Star.star a * h + Star.star b * g + Star.star c * f + Star.star d * e = 0 → a * d + b * c = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.ratio_triangle","type":"∀ (a b c d e f : ℂ),\n  b ≠ 0 →\n    d ≠ 0 →\n      f ≠ 0 →\n        a * d + b * c = 0 →\n          a * f + b * e = 0 → c * f + d * e = 0 → a / b + c / d = 0 ∧ a / b + e / f = 0 ∧ c / d + e / f = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.reciprocal_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i : Fin 8),\n          MainTheory.Orbit49PrintedAlgebra.rec (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨8, ⋯⟩ ⟨↑i, ⋯⟩ =\n              0 ∧\n            MainTheory.Orbit49PrintedAlgebra.rec (MainTheory.Orbit49PrintedAlgebra.bottomAmplitudes c)\n                (MainTheory.Orbit49PrintedAlgebra.topAmplitudes d) ⟨9, ⋯⟩ ⟨↑i, ⋯⟩ =\n              0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.reconstruct_from_anchor","type":"∀ (c d b e : ℂ), b ≠ 0 → Star.star c * e + Star.star b * d = 0 → d = -(e / Star.star b) * Star.star c"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedAlgebra.rho","type":"(Fin 10 → ℂ) → (Fin 10 → ℂ) → Fin 10 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedAlgebra.triangle","type":"Matrix (Fin 3) (Fin 3) ℚ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedAlgebra.triangleC","type":"Matrix (Fin 3) (Fin 3) ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.triangle_determinant","type":"MainTheory.Orbit49PrintedAlgebra.triangle.det = -2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.triangle_equations","type":"∀ (a b c : ℂ), MainTheory.Orbit49PrintedAlgebra.triangleC.mulVec ![a, b, c] = 0 ↔ a + b = 0 ∧ a + c = 0 ∧ b + c = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedAlgebra.uniform_phase","type":"∀ (c d : Fin 10 → ℂ),\n  (MainTheory.OrderThreePrintedMoments.Orbit49.Moment (fun i => Complex.normSq (c i)) fun i => Complex.normSq (d i)) →\n    (∀ (i : Fin 8),\n        MainTheory.Orbit49PrintedAlgebra.rec c d ⟨8, ⋯⟩ ⟨↑i, ⋯⟩ = 0 ∧\n          MainTheory.Orbit49PrintedAlgebra.rec c d ⟨9, ⋯⟩ ⟨↑i, ⋯⟩ = 0) →\n      MainTheory.Orbit49PrintedAlgebra.rho c d ⟨8, ⋯⟩ = MainTheory.Orbit49PrintedAlgebra.rho c d ⟨9, ⋯⟩ ∧\n        MainTheory.Orbit49PrintedAlgebra.rho c d ⟨8, ⋯⟩ ≠ 0 ∧\n          ∀ (i : Fin 8), d ⟨↑i, ⋯⟩ = -MainTheory.Orbit49PrintedAlgebra.rho c d ⟨8, ⋯⟩ * Star.star (c ⟨↑i, ⋯⟩)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.actual_characters","type":"∀ (i j : Fin 4),\n  MainTheory.Orbit49PrintedRows.Row00.W i j =\n    if\n        SS.bdot (MainTheory.Orbit49PrintedRows.Row00.characters i) (MainTheory.Orbit49PrintedRows.Row00.sources j) =\n          Bool.true then\n      -1\n    else 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.actual_images","type":"∀ (j : Fin 4),\n  SS.bxor (MainTheory.Orbit49PrintedRows.Row00.sources j) MainTheory.Orbit49PrintedRows.Row00.flip =\n    MainTheory.Orbit49PrintedRows.Row00.destinations j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.actual_incidence","type":"Finset.image MainTheory.Orbit49PrintedRows.Row00.sources Finset.univ =\n  {y ∈ SixQubit.Orbit49.S1 | SS.bxor y MainTheory.Orbit49PrintedRows.Row00.flip ∈ SixQubit.Orbit49.S0}"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedRows.Row00.characters","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedRows.Row00.destinations","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedRows.Row00.flip","type":"SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.matrix_checked","type":"MainTheory.FlipCharacter.restrictedCharacterMatrix MainTheory.Orbit49PrintedRows.Row00.characters\n    MainTheory.Orbit49PrintedRows.Row00.sources =\n  MainTheory.Orbit49PrintedRows.Row00.WC"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.physical_relations","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit49.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit49.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (c SixQubit.Orbit49.y8) * d SixQubit.Orbit49.z0 +\n              Star.star (c SixQubit.Orbit49.y0) * d SixQubit.Orbit49.z8 =\n            0 ∧\n          Star.star (c SixQubit.Orbit49.y9) * d SixQubit.Orbit49.z1 +\n              Star.star (c SixQubit.Orbit49.y1) * d SixQubit.Orbit49.z9 =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.row_reduction","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit49PrintedRows.Row00.WC.mulVec v = 0 ↔ v 0 + v ⟨2, ⋯⟩ = 0 ∧ v 1 + v ⟨3, ⋯⟩ = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit49PrintedRows.Row00.sources","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row00.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit49PrintedRows.Row00.flip, z := MainTheory.Orbit49PrintedRows.Row00.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit49PrintedRows.Row01.actual_characters","type":"∀ (i j : Fin 4),\n  MainTheory.Orbit49PrintedRows.Row01.W i j =\n    if\n        SS.bdot (MainTheory.Orbit49PrintedRows.Row01.characters i) (MainTheory.Orbit49PrintedRows.Row01.sources j) =\n          Bool.true then\n      -1\n    else 1"}
