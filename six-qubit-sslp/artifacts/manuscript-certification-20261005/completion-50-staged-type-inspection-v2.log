CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderTwoShellProjectors.Orbit41.shell_types","type":"(∀ (x : SS.BitString 6),\n    x ∈ SixQubit.Orbit41.S0 ↔\n      ∃ j,\n        MainTheory.OrderTwoShellProjectors.Orbit41.coordinates x =\n          MainTheory.OrderTwoShellProjectors.Orbit41.bottomTypes j) ∧\n  ∀ (x : SS.BitString 6),\n    x ∈ SixQubit.Orbit41.S1 ↔\n      ∃ j,\n        MainTheory.OrderTwoShellProjectors.Orbit41.coordinates x = MainTheory.OrderTwoShellProjectors.Orbit41.topTypes j"}
