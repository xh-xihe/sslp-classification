CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row01.actual_characters","type":"∀ (i : Fin 3) (j : Fin 4),\n  MainTheory.Orbit51PrintedRows.Row01.W i j =\n    if\n        SS.bdot (MainTheory.Orbit51PrintedRows.Row01.characters i) (MainTheory.Orbit51PrintedRows.Row01.sources j) =\n          Bool.true then\n      -1\n    else 1"}
