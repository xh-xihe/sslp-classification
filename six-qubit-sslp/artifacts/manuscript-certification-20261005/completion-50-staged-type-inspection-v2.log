CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit31MomentFaces.convex_hull_supported_vertices","type":"∀ (mask : ℕ),\n  (convexHull ℝ)\n      (MainTheory.Orbit31SupportSemantics.primal ''\n        {v |\n          MainTheory.Orbit31SupportSemantics.maskSet (MainTheory.Generated.Orbit31SupportArithmetic.primalMasks v) ⊆\n            MainTheory.Orbit31SupportSemantics.maskSet mask}) =\n    MainTheory.Orbit31MomentFaces.face mask"}
