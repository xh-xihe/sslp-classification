CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row02.physical_relations","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (c SixQubit.Orbit51.y8) * d SixQubit.Orbit51.z6 +\n              Star.star (c SixQubit.Orbit51.y6) * d SixQubit.Orbit51.z8 =\n            0 ∧\n          Star.star (c SixQubit.Orbit51.y9) * d SixQubit.Orbit51.z7 +\n              Star.star (c SixQubit.Orbit51.y7) * d SixQubit.Orbit51.z9 =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row02.row_reduction","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit51PrintedRows.Row02.WC.mulVec v = 0 ↔ v 0 + v ⟨2, ⋯⟩ = 0 ∧ v 1 + v ⟨3, ⋯⟩ = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row02.sources","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row02.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit51PrintedRows.Row02.flip, z := MainTheory.Orbit51PrintedRows.Row02.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.actual_characters","type":"∀ (i j : Fin 4),\n  MainTheory.Orbit51PrintedRows.Row03.W i j =\n    if\n        SS.bdot (MainTheory.Orbit51PrintedRows.Row03.characters i) (MainTheory.Orbit51PrintedRows.Row03.sources j) =\n          Bool.true then\n      -1\n    else 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.actual_images","type":"∀ (j : Fin 4),\n  SS.bxor (MainTheory.Orbit51PrintedRows.Row03.sources j) MainTheory.Orbit51PrintedRows.Row03.flip =\n    MainTheory.Orbit51PrintedRows.Row03.destinations j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.actual_incidence","type":"Finset.image MainTheory.Orbit51PrintedRows.Row03.sources Finset.univ =\n  {y ∈ SixQubit.Orbit51.S1 | SS.bxor y MainTheory.Orbit51PrintedRows.Row03.flip ∈ SixQubit.Orbit51.S0}"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row03.characters","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row03.destinations","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row03.flip","type":"SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.physical_relations","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (c SixQubit.Orbit51.y9) * d SixQubit.Orbit51.z6 +\n              Star.star (c SixQubit.Orbit51.y6) * d SixQubit.Orbit51.z9 =\n            0 ∧\n          Star.star (c SixQubit.Orbit51.y8) * d SixQubit.Orbit51.z7 +\n              Star.star (c SixQubit.Orbit51.y7) * d SixQubit.Orbit51.z8 =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.row_reduction","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit51PrintedRows.Row03.WC.mulVec v = 0 ↔ v 0 + v ⟨3, ⋯⟩ = 0 ∧ v 1 + v ⟨2, ⋯⟩ = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit51PrintedRows.Row03.sources","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row03.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit51PrintedRows.Row03.flip, z := MainTheory.Orbit51PrintedRows.Row03.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row04.actual_images","type":"∀ (j : Fin 4),\n  SS.bxor (MainTheory.Orbit51PrintedRows.Row04.sources j) MainTheory.Orbit51PrintedRows.Row04.flip =\n    MainTheory.Orbit51PrintedRows.Row04.destinations j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row04.actual_incidence","type":"Finset.image MainTheory.Orbit51PrintedRows.Row04.sources Finset.univ =\n  {y ∈ SixQubit.Orbit51.S1 | SS.bxor y MainTheory.Orbit51PrintedRows.Row04.flip ∈ SixQubit.Orbit51.S0}"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row04.physical_relations","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit51.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit51.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        Star.star (c SixQubit.Orbit51.y0) * d SixQubit.Orbit51.z3 +\n                Star.star (c SixQubit.Orbit51.y1) * d SixQubit.Orbit51.z2 +\n              Star.star (c SixQubit.Orbit51.y2) * d SixQubit.Orbit51.z1 +\n            Star.star (c SixQubit.Orbit51.y3) * d SixQubit.Orbit51.z0 =\n          0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row04.row_reduction","type":"∀ (v : Fin 4 → ℂ), MainTheory.Orbit51PrintedRows.Row04.WC.mulVec v = 0 ↔ v 0 + v 1 + v ⟨2, ⋯⟩ + v ⟨3, ⋯⟩ = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit51PrintedRows.Row04.weights","type":"∀ (i : Fin 4),\n  { x := MainTheory.Orbit51PrintedRows.Row04.flip, z := MainTheory.Orbit51PrintedRows.Row04.characters i }.wt ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinProjector.spin_conjugate_action","type":"∀ (A : Matrix (SS.BitString 6) (SS.BitString 6) ℂ) (f : SS.State 6 ℂ),\n  SixQubit.Orbit8Universal.spinJ (A.mulVec (SixQubit.Orbit8Universal.spinJ f)) =\n    (MainTheory.Orbit8SpinProjector.spinConjugate A).mulVec f"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinProjector.spin_family","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi) =\n    MainTheory.PairPartialTrace.familyKernel fun i => SixQubit.Orbit8Universal.spinJ (psi i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinProjector.spinflip_enumerator","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  (MainTheory.PairPartialTrace.familyKernel psi *\n        MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi)).trace =\n    1 / 16 * ↑(∑ j, (-1) ^ ↑j * MainTheory.Orbit8EnumeratorDisplays.normalizedA psi ↑j)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinProjector.trace_core","type":"∀ (psi : Fin 2 → SS.State 6 ℂ),\n  (MainTheory.PairPartialTrace.familyKernel psi *\n        MainTheory.Orbit8SpinProjector.spinConjugate (MainTheory.PairPartialTrace.familyKernel psi)).trace =\n    SS.Shadow.core psi"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinSemantics.spinJ_basis","type":"∀ (x : SS.BitString 6),\n  SixQubit.Orbit8Universal.spinJ (MainTheory.Orbit8SpinSemantics.ket x) =\n    ↑(SixQubit.Orbit8Universal.spinSign x) • MainTheory.Orbit8SpinSemantics.ket (SS.complement x)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinSemantics.spinJ_pauli","type":"∀ (f : SS.State 6 ℂ),\n  SixQubit.Orbit8Universal.spinJ f = SS.pauliAct MainTheory.Orbit8SpinSemantics.allY fun x => Star.star (f x)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinSemantics.spinJ_tensor","type":"∀ (f : SS.State 6 ℂ),\n  SixQubit.Orbit8Universal.spinJ f =\n    Matrix.mulVec (MainTheory.LocalTensorKernel.tensorKernel fun x => MainTheory.PauliTransferTwo.pauli 2) fun x =>\n      Star.star (f x)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit8SpinSemantics.spinSign_power","type":"∀ (x : SS.BitString 6), SixQubit.Orbit8Universal.spinSign x = (-1) ^ (SS.hammingWt x + 1)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A","type":"Fin 3 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.B","type":"Fin 3 → Fin 3 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.activeColumns","type":"SS.State 6 ℂ → Finset (Fin 3)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.actual_complements","type":"(∀ (j : Fin 3),\n    SS.complement (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j) =\n      MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topA j) ∧\n  (∀ (i j : Fin 3),\n      SS.complement (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.B i j) =\n        MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topB i j) ∧\n    SS.complement SixQubit.Orbit37.y12 = SixQubit.Orbit37.z0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.physical_active_column_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit37.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit37.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 3),\n              c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j) ≠ 0 →\n                c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.B i j) ≠ 0 →\n                  MainTheory.ComplementaryPhasePair.sigma (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.B i j))\n                        (d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topB i j)) =\n                      MainTheory.ComplementaryPhasePair.sigma\n                        (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j))\n                        (d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topA j)) ∧\n                    MainTheory.ComplementaryPhasePair.sigma (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j))\n                        (d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topA j)) =\n                      -MainTheory.ComplementaryPhasePair.sigma (c SixQubit.Orbit37.y12) (d SixQubit.Orbit37.z0)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.physical_reciprocal","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit37.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit37.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (j : Fin 3),\n          Star.star (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j)) * d SixQubit.Orbit37.z0 +\n              Star.star (c SixQubit.Orbit37.y12) * d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topA j) =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.physical_sync","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit37.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit37.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i j : Fin 3),\n          Star.star (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.A j)) *\n              d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topB i j) =\n            Star.star (c (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.B i j)) *\n              d (MainTheory.OrderFiveGridRemainingDisplays.Orbit37.topA j)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit37.rowSupport","type":"SS.State 6 ℂ → Fin 3 → Finset (Fin 3)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.A","type":"Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.B","type":"Fin 2 → Fin 4 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.literal_labels","type":"SixQubit.Orbit38.S0 =\n    Finset.image MainTheory.OrderFiveGridRemainingDisplays.Orbit38.A Finset.univ ∪\n        Finset.image (fun p => MainTheory.OrderFiveGridRemainingDisplays.Orbit38.B p.1 p.2) Finset.univ ∪\n      {SixQubit.Orbit38.y12} ∧\n  (∀ (i : Fin 2) (j : Fin 4),\n      SS.complement (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.B i j) =\n        MainTheory.OrderFiveGridRemainingDisplays.Orbit38.topGrid i j) ∧\n    SS.complement SixQubit.Orbit38.y12 = SixQubit.Orbit38.z0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_common_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 2) (j : Fin 4),\n              MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c i j ≠ 0 →\n                MainTheory.ComplementaryPhasePair.sigma (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c i j)\n                    (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d i j) =\n                  -MainTheory.OrderFiveGridRemainingDisplays.Orbit38.phaseS c d"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_hub","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i : Fin 2) (j : Fin 4),\n          Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c i j) * d SixQubit.Orbit38.z0 +\n              Star.star (c SixQubit.Orbit38.y12) * MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d i j =\n            0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_permanents","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (j k : Fin 4),\n              j ≠ k →\n                MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 0 j *\n                      MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 1 k +\n                    MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 0 k *\n                      MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 1 j =\n                  0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_rectangle","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (j k : Fin 4),\n          j ≠ k →\n            Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 0 j) *\n                      MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d 1 k +\n                    Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 0 k) *\n                      MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d 1 j +\n                  Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 1 j) *\n                    MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d 0 k +\n                Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c 1 k) *\n                  MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d 0 j =\n              0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_star_nonzero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → c SixQubit.Orbit38.y12 ≠ 0 ∧ d SixQubit.Orbit38.z0 ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_supports_full","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.OrderFiveGridRemainingDisplays.Orbit38.rowSupport c 0 = Finset.univ ∧\n              MainTheory.OrderFiveGridRemainingDisplays.Orbit38.rowSupport c 1 = Finset.univ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.physical_weighted_phases","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit38.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit38.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 2) (j : Fin 4),\n              Star.star (MainTheory.OrderFiveGridRemainingDisplays.Orbit38.db d i j) =\n                -MainTheory.OrderFiveGridRemainingDisplays.Orbit38.phaseS c d *\n                  MainTheory.OrderFiveGridRemainingDisplays.Orbit38.b c i j"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveGridRemainingDisplays.Orbit38.rowSupport","type":"SS.State 6 ℂ → Fin 2 → Finset (Fin 4)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.flip_images","type":"∀ (i : Fin 6),\n  SS.bxor (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i)\n        (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) =\n      MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.zero ∧\n    SS.bxor MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.ones\n        (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) =\n      SS.complement (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.incidence_all","type":"∀ (i : Fin 6),\n  {y ∈ SixQubit.Orbit34.S1 |\n      SS.bxor y (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) ∈ SixQubit.Orbit34.S0} =\n    {MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i,\n      MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.ones}"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.physical_two_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit34.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit34.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        ∀ (i j : Fin 6),\n          i ≠ j →\n            Star.star (c MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.zero) *\n                    d (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) +\n                  Star.star (c (SS.complement (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i))) *\n                    d MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.ones =\n                0 ∧\n              Star.star (c MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.zero) *\n                    d (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) -\n                  Star.star (c (SS.complement (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i))) *\n                    d MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.ones =\n                0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.separating_signs","type":"∀ (i j : Fin 6),\n  i ≠ j →\n    SS.bdot (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point j)\n          (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i) =\n        Bool.false ∧\n      SS.bdot (MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point j)\n          MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.ones =\n        Bool.true"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.weights","type":"∀ (i j : Fin 6),\n  { x := MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i,\n          z := MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.zero }.wt ≤\n      2 ∧\n    { x := MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point i,\n          z := MainTheory.OrderFiveWalshRemainingDisplays.Orbit34.point j }.wt ≤\n      2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.actual_images","type":"∀ (j : Fin 5),\n  SS.bxor (MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.destinations j) SixQubit.Orbit39.ef =\n    MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.sources j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.actual_incidence","type":"{y ∈ SixQubit.Orbit39.S1 | SS.bxor y SixQubit.Orbit39.ef ∈ SixQubit.Orbit39.S0} =\n  Finset.image MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.destinations Finset.univ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.characters","type":"Fin 5 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.destinations","type":"Fin 5 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.determinant","type":"MainTheory.OrderFiveWalshRemainingDisplays.Orbit39.W.det = 16"}
