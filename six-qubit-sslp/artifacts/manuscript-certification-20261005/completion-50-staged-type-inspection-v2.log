CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.GridSupportAlgebra.full_support","type":"∀ (b : Fin 2 → Fin 4 → ℂ),\n  (∀ (i : Fin 2), ∃ j, b i j ≠ 0) →\n    (∀ (j : Fin 4), b 0 j ≠ 0 ∨ b 1 j ≠ 0) →\n      (∀ (j k : Fin 4), j ≠ k → b 0 j * b 1 k + b 0 k * b 1 j = 0) → ∀ (j : Fin 4), b 0 j ≠ 0 ∧ b 1 j ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.GridSupportAlgebra.supports_univ","type":"∀ (b : Fin 2 → Fin 4 → ℂ),\n  (∀ (i : Fin 2), ∃ j, b i j ≠ 0) →\n    (∀ (j : Fin 4), b 0 j ≠ 0 ∨ b 1 j ≠ 0) →\n      (∀ (j k : Fin 4), j ≠ k → b 0 j * b 1 k + b 0 k * b 1 j = 0) →\n        MainTheory.GridSupportAlgebra.rowSupport b 0 = Finset.univ ∧\n          MainTheory.GridSupportAlgebra.rowSupport b 1 = Finset.univ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.fiber_bijection","type":"∀ {n q : ℕ} (a : Fin n → ZMod q) (i : Fin n) (δ : ZMod q),\n  a i = δ →\n    δ + δ = 0 → {x | SS.weight a x = δ} = Finset.image (fun x => SS.bxor x (SS.stdBasis i)) {x | SS.weight a x = 0}"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.flip_involutive","type":"∀ {n : ℕ} (i : Fin n), Function.Involutive fun x => SS.bxor x (SS.stdBasis i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.half_modulus","type":"∀ (k : ℕ), ↑k + ↑k = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.negative_half","type":"∀ {q : ℕ} (δ : ZMod q), δ + δ = 0 → -δ = δ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.weight_shift","type":"∀ {n q : ℕ} (a : Fin n → ZMod q) (i : Fin n) (δ : ZMod q),\n  a i = δ → δ + δ = 0 → ∀ (x : SS.BitString n), SS.weight a (SS.bxor x (SS.stdBasis i)) = SS.weight a x + δ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.HalfAngleFiberFlip.zero_to_half","type":"∀ {n q : ℕ} (a : Fin n → ZMod q) (i : Fin n) (δ : ZMod q),\n  a i = δ → δ + δ = 0 → ∀ (x : SS.BitString n), SS.weight a (SS.bxor x (SS.stdBasis i)) = δ ↔ SS.weight a x = 0"}
