CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement0","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨0, ⋯⟩ = p ⟨0, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement1","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨1, ⋯⟩ = p ⟨1, ⋯⟩"}
