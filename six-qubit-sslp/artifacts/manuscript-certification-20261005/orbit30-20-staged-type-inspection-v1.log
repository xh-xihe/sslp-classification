CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30BoundaryDisplays.active_mass_split","type":"∀ (D : MainTheory.Orbit30.Data),\n  D.A.card = 3 →\n    2 * MainTheory.Orbit30BoundaryDisplays.innerWeight D + MainTheory.Orbit30BoundaryDisplays.crossWeight D = 3 / 4"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30BoundaryDisplays.crossWeight","type":"MainTheory.Orbit30.Data → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30BoundaryDisplays.exceptional_mass_equations","type":"∀ (D : MainTheory.Orbit30.Data) (r s : Fin 5),\n  r ≠ s →\n    D.Aᶜ = {r, s} →\n      D.A.card = 3 →\n        2 * MainTheory.Orbit30BoundaryDisplays.innerWeight D + MainTheory.Orbit30BoundaryDisplays.crossWeight D =\n            3 / 4 ∧\n          MainTheory.Orbit30BoundaryDisplays.innerWeight D + MainTheory.Orbit30BoundaryDisplays.crossWeight D +\n                D.w r s =\n              1 / 2 ∧\n            MainTheory.Orbit30BoundaryDisplays.innerWeight D - D.w r s = 1 / 4"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30BoundaryDisplays.inactiveWeight","type":"MainTheory.Orbit30.Data → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30BoundaryDisplays.inactive_pair_mass","type":"∀ (D : MainTheory.Orbit30.Data) (r s : Fin 5),\n  r ≠ s → D.Aᶜ = {r, s} → MainTheory.Orbit30BoundaryDisplays.inactiveWeight D = D.w r s"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30BoundaryDisplays.innerWeight","type":"MainTheory.Orbit30.Data → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30BoundaryDisplays.total_mass_split","type":"∀ (D : MainTheory.Orbit30.Data),\n  MainTheory.Orbit30BoundaryDisplays.innerWeight D + MainTheory.Orbit30BoundaryDisplays.crossWeight D +\n      MainTheory.Orbit30BoundaryDisplays.inactiveWeight D =\n    1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30BoundaryDisplays.unique_neighbor_weight","type":"∀ (D : MainTheory.Orbit30.Data) (i j : Fin 5),\n  D.nbhd i = {j} → D.Active i → D.w i j = D.D i ∧ D.D i = D.r i + 1 / 8 ∧ 1 / 8 < D.w i j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30FullSupport.full_hafnian_det_ne_zero","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ),\n  (∀ (i j : Fin 5), A i j = A j i) →\n    (∀ (i : Fin 5), A i i = 0) →\n      A ⟨0, ⋯⟩ ⟨1, ⋯⟩ ≠ 0 →\n        A ⟨0, ⋯⟩ ⟨2, ⋯⟩ ≠ 0 →\n          A ⟨1, ⋯⟩ ⟨2, ⋯⟩ ≠ 0 →\n            A ⟨3, ⋯⟩ ⟨4, ⋯⟩ ≠ 0 → (∀ (i : Fin 5), MainTheory.Orbit30VertexScaling.hafnian A i = 0) → A.det ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30FullSupport.normalized_hafnians","type":"∀ (c d f g h k : ℂ) (i : Fin 5),\n  MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30NormalizedDeterminant.matrix c d f g h k) i =\n    ![1 + f * k + g * h, 1 + c * k + d * h, 1 + c * g + d * f, k + g + d, h + f + c] i"}
