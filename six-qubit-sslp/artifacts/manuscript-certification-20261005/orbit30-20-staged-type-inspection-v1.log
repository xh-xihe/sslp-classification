CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement11","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨11, ⋯⟩ = p ⟨11, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement12","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨12, ⋯⟩ = p ⟨12, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement13","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨13, ⋯⟩ = p ⟨13, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement14","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨14, ⋯⟩ = p ⟨14, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement15","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨15, ⋯⟩ = p ⟨15, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement2","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨2, ⋯⟩ = p ⟨2, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement3","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨3, ⋯⟩ = p ⟨3, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement4","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨4, ⋯⟩ = p ⟨4, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement5","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨5, ⋯⟩ = p ⟨5, ⋯⟩"}
