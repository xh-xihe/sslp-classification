CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.Normal","type":"(Fin 16 → ℝ) → (Fin 16 → ℝ) → Prop"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.actual_fibers","type":"SixQubit.Orbit30.S0 = Finset.image MainTheory.Orbit30PrintedMoments.bottom Finset.univ ∧\n  SixQubit.Orbit30.S1 = Finset.image MainTheory.Orbit30PrintedMoments.top Finset.univ ∧\n    ∀ (i : Fin 16),\n      MainTheory.Orbit30PrintedMoments.top (MainTheory.Orbit30PrintedMoments.complementIndex i) =\n        SS.complement (MainTheory.Orbit30PrintedMoments.bottom i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance0","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨0, ⋯⟩ = 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance1","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨1, ⋯⟩ = 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance2","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨2, ⋯⟩ = 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance3","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨3, ⋯⟩ = 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance4","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨4, ⋯⟩ = 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.balance5","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.coordinateSum p ⟨5, ⋯⟩ = 1 / 2"}
