CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.cleared_determinant","type":"∀ (c d f g h k : ℂ),\n  c * d = 1 →\n    f * g = 1 →\n      k + g + d = 0 →\n        h + f + c = 0 →\n          (c * g) ^ 2 * (MainTheory.Orbit30NormalizedDeterminant.matrix c d f g h k).det =\n            2 * ((c * g) ^ 2 - 3 * (c * g) + 1) * (3 * (c * g) ^ 2 + 7 * (c * g) + 3)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.cube","type":"∀ (c d f g : ℂ), c * d = 1 → f * g = 1 → 1 + c * g + d * f = 0 → (c * g) ^ 2 + c * g + 1 = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.determinant_minus32","type":"∀ (c d f g h k : ℂ),\n  1 + f * k + g * h = 0 →\n    1 + c * k + d * h = 0 →\n      1 + c * g + d * f = 0 →\n        k + g + d = 0 → h + f + c = 0 → (MainTheory.Orbit30NormalizedDeterminant.matrix c d f g h k).det = -32"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.determinant_polynomial","type":"∀ (c d f g h k : ℂ),\n  (MainTheory.Orbit30NormalizedDeterminant.matrix c d f g h k).det =\n    -2 * c ^ 2 * g * k + 2 * c * d * f * k + 2 * c * d * g * h - 2 * c * d + 2 * c * f * g * k - 2 * c * f * k ^ 2 -\n                                    2 * c * g ^ 2 * h +\n                                  2 * c * g * h * k +\n                                2 * c * g +\n                              2 * c * k -\n                            2 * d ^ 2 * f * h -\n                          2 * d * f ^ 2 * k +\n                        2 * d * f * g * h +\n                      2 * d * f * h * k +\n                    2 * d * f -\n                  2 * d * g * h ^ 2 +\n                2 * d * h -\n              2 * f * g +\n            2 * f * k +\n          2 * g * h -\n        2 * h * k -\n      2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.displayed_determinant","type":"∀ (c d f g h k : ℂ),\n  c * d = 1 →\n    f * g = 1 →\n      k + g + d = 0 →\n        h + f + c = 0 →\n          (MainTheory.Orbit30NormalizedDeterminant.matrix c d f g h k).det =\n            2 * ((c * g) ^ 2 - 3 * (c * g) + 1) * (3 * (c * g) ^ 2 + 7 * (c * g) + 3) / (c * g) ^ 2"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30NormalizedDeterminant.matrix","type":"ℂ → ℂ → ℂ → ℂ → ℂ → ℂ → Matrix (Fin 5) (Fin 5) ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.numerator_reduction","type":"∀ (t : ℂ), t ^ 2 + t + 1 = 0 → 2 * (t ^ 2 - 3 * t + 1) * (3 * t ^ 2 + 7 * t + 3) = -32 * t ^ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.parameter_nonzero","type":"∀ (c d f g : ℂ), c * d = 1 → f * g = 1 → c * g ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30NormalizedDeterminant.products","type":"∀ (c d f g h k : ℂ),\n  1 + f * k + g * h = 0 →\n    1 + c * k + d * h = 0 → 1 + c * g + d * f = 0 → k + g + d = 0 → h + f + c = 0 → c * d = 1 ∧ f * g = 1"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalFullSupport.actual_full_support_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 → (∀ (i j : Fin 5), i ≠ j → MainTheory.Orbit30PhysicalRows.edgeC c i j ≠ 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalFullSupport.actual_matrix_kernel","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (MainTheory.Orbit30PhysicalHafnians.edgeMatrix c).mulVec (MainTheory.Orbit30PhysicalRows.pointC c) = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalFullSupport.actual_point_vector_nonzero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → MainTheory.Orbit30PhysicalRows.pointC c ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.actual_four_active","type":"∀ (c d : SS.State 6 ℂ) (hc : ∀ x ∉ SixQubit.Orbit30.S0, c x = 0) (hd : ∀ x ∉ SixQubit.Orbit30.S1, d x = 0)\n  (hnc : SS.innerC c c = 1) (hnd : SS.innerC d d = 1) (hkl : SS.HasDistance ![c, d] 3),\n  4 ≤ (MainTheory.Orbit30PhysicalGraph.physicalData c d hc hd hnc hnd hkl).A.card"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.actual_three_active","type":"∀ (c d : SS.State 6 ℂ) (hc : ∀ x ∉ SixQubit.Orbit30.S0, c x = 0) (hd : ∀ x ∉ SixQubit.Orbit30.S1, d x = 0)\n  (hnc : SS.innerC c c = 1) (hnd : SS.innerC d d = 1) (hkl : SS.HasDistance ![c, d] 3),\n  3 ≤ (MainTheory.Orbit30PhysicalGraph.physicalData c d hc hd hnc hnd hkl).A.card"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.bilinear_erase_row","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              ∑ j ∈ Finset.univ.erase i,\n                  MainTheory.Orbit30PhysicalRows.pointC c j * MainTheory.Orbit30PhysicalRows.edgeC c i j =\n                0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.bilinear_row","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              ∑ j, MainTheory.Orbit30PhysicalRows.pointC c j * MainTheory.Orbit30PhysicalRows.edgeC c i j = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.degree_norm","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              ∑ j, Complex.normSq (MainTheory.Orbit30PhysicalRows.edgeC c i j) =\n                Complex.normSq (MainTheory.Orbit30PhysicalRows.pointC c i) + 1 / 8"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.edge_symmetric","type":"∀ (c : SS.State 6 ℂ) (i j : Fin 5),\n  MainTheory.Orbit30PhysicalRows.edgeC c i j = MainTheory.Orbit30PhysicalRows.edgeC c j i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.literal_star_sum","type":"∀ (c d : SS.State 6 ℂ) (i : Fin 5),\n  MainTheory.Orbit30PhysicalRows.starSum c d i =\n    ∑ j, MainTheory.Orbit30PhysicalRows.pointU c j * MainTheory.Orbit30PhysicalRows.edgeV d i j"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalGraph.physicalData","type":"(c d : SS.State 6 ℂ) →\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → MainTheory.Orbit30.Data"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.synchronized_term","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              MainTheory.Orbit30PhysicalRows.pointU c j * MainTheory.Orbit30PhysicalRows.edgeV d i j =\n                -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩ *\n                  Star.star (MainTheory.Orbit30PhysicalRows.pointC c j * MainTheory.Orbit30PhysicalRows.edgeC c i j)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalGraph.zero_edge_top","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              MainTheory.Orbit30PhysicalRows.edgeC c i j = 0 → MainTheory.Orbit30PhysicalRows.edgeV d i j = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.actual_all_edge_phases","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              i ≠ j →\n                MainTheory.Orbit30PhysicalRows.edgeC c i j ≠ 0 →\n                  MainTheory.Orbit30PhysicalPhases.phase c d (MainTheory.Orbit30PhysicalRows.edgeIndexMatrix i j) =\n                    -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.actual_edge_reconstruction","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              MainTheory.Orbit30PhysicalRows.edgeV d i j =\n                -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩ *\n                  Star.star (MainTheory.Orbit30PhysicalRows.edgeC c i j)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.actual_hafnians","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30PhysicalHafnians.edgeMatrix c) i = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.actual_matching_factor","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              MainTheory.Orbit30PhysicalRows.matchingSum c d i =\n                2 * -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩ *\n                  Star.star\n                    (MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30PhysicalHafnians.edgeMatrix c) i)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.actual_regular_points","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              i ≠ j → MainTheory.Orbit30PhysicalRows.pointC c i ≠ 0 ∨ MainTheory.Orbit30PhysicalRows.pointC c j ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.almost_full_set","type":"∀ (S : Finset (Fin 5)), 4 ≤ S.card → ∀ (i j : Fin 5), i ≠ j → i ∈ S ∨ j ∈ S"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalHafnians.edgeMatrix","type":"SS.State 6 ℂ → Matrix (Fin 5) (Fin 5) ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalHafnians.edge_index_symmetric","type":"∀ (i j : Fin 5), MainTheory.Orbit30PhysicalRows.edgeIndexMatrix i j = MainTheory.Orbit30PhysicalRows.edgeIndexMatrix j i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.actual_admissible","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            (∃ i j, i ≠ j ∧ MainTheory.Orbit30PhysicalRows.edgeC c i j = 0) →\n              MainTheory.Orbit30GraphClassification.Admissible (MainTheory.Orbit30PhysicalMask.mask c)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.actual_complement_degree","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5), MainTheory.Orbit30GraphClassification.degree (MainTheory.Orbit30PhysicalMask.mask c) i ≤ 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.actual_minimum_degree","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 → ∀ (i : Fin 5), 2 ≤ {j | MainTheory.Orbit30PhysicalRows.edgeC c i j ≠ 0}.card"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalMask.amplitudes","type":"SS.State 6 ℂ → Fin 10 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.complement_degree_card","type":"∀ (m : Fin 1024) (i : Fin 5),\n  MainTheory.Orbit30GraphClassification.degree m i +\n      {j | j ≠ i ∧ MainTheory.Orbit30GraphClassification.missing m i j = Bool.false}.card =\n    4"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.literal_edge_lookup","type":"∀ (c : SS.State 6 ℂ) (i j : Fin 5),\n  i ≠ j →\n    MainTheory.Orbit30PhysicalMask.amplitudes c (MainTheory.Orbit30GraphClassification.edgeIndex i j) =\n      MainTheory.Orbit30PhysicalRows.edgeC c i j"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalMask.mask","type":"SS.State 6 ℂ → Fin 1024"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalMask.missing_iff","type":"∀ (c : SS.State 6 ℂ) (i j : Fin 5),\n  i ≠ j →\n    (MainTheory.Orbit30GraphClassification.missing (MainTheory.Orbit30PhysicalMask.mask c) i j = Bool.true ↔\n      MainTheory.Orbit30PhysicalRows.edgeC c i j = 0)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalMask.zeroPattern","type":"SS.State 6 ℂ → Fin 10 → Bool"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.actual_anchor_nonzero","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → c SixQubit.Orbit30.y15 ≠ 0 ∧ d SixQubit.Orbit30.z0 ≠ 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.actual_edge_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i j : Fin 5),\n              i ≠ j →\n                MainTheory.Orbit30PhysicalRows.pointC c j ≠ 0 →\n                  MainTheory.Orbit30PhysicalRows.edgeC c i j ≠ 0 →\n                    MainTheory.Orbit30PhysicalPhases.phase c d (MainTheory.Orbit30PhysicalRows.edgeIndexMatrix i j) =\n                      -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.actual_equal_norms","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 16),\n              Complex.normSq\n                  (d (MainTheory.Orbit30PrintedMoments.top (MainTheory.Orbit30PrintedMoments.complementIndex i))) =\n                Complex.normSq (c (MainTheory.Orbit30PrintedMoments.bottom i))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.actual_point_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 5),\n              MainTheory.Orbit30PhysicalRows.pointC c i ≠ 0 →\n                MainTheory.Orbit30PhysicalPhases.phase c d (MainTheory.Orbit30ProbabilityLabels.vertexIndex i) =\n                  -MainTheory.Orbit30PhysicalPhases.phase c d ⟨15, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.actual_unit_phase","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            ∀ (i : Fin 16),\n              c (MainTheory.Orbit30PrintedMoments.bottom i) ≠ 0 →\n                Complex.normSq (MainTheory.Orbit30PhysicalPhases.phase c d i) = 1"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalPhases.phase","type":"SS.State 6 ℂ → SS.State 6 ℂ → Fin 16 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalPhases.reciprocal_product","type":"∀ (c d : SS.State 6 ℂ) (i j : Fin 16),\n  c (MainTheory.Orbit30PrintedMoments.bottom j) ≠ 0 →\n    Star.star (c (MainTheory.Orbit30PrintedMoments.bottom i)) *\n        d (MainTheory.Orbit30PrintedMoments.top (MainTheory.Orbit30PrintedMoments.complementIndex j)) =\n      MainTheory.Orbit30PhysicalPhases.phase c d j *\n        Star.star (c (MainTheory.Orbit30PrintedMoments.bottom i) * c (MainTheory.Orbit30PrintedMoments.bottom j))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalProperSupport.actual_missing","type":"∀ (c : SS.State 6 ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing (MainTheory.Orbit30PhysicalMask.amplitudes c)\n    (MainTheory.Orbit30PhysicalMask.mask c)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalProperSupport.actual_proper_support_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 → (∃ i j, i ≠ j ∧ MainTheory.Orbit30PhysicalRows.edgeC c i j = 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalProperSupport.literal_hafnians","type":"∀ (c : SS.State 6 ℂ) (i : Fin 5),\n  MainTheory.Orbit30ProperGraphTables.hafnian (MainTheory.Orbit30PhysicalMask.amplitudes c) i =\n    MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30PhysicalHafnians.edgeMatrix c) i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalProperSupport.physical_printed_no_go","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) → SS.innerC c c = 1 → SS.innerC d d = 1 → SS.HasDistance ![c, d] 3 → False"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.NativeRows","type":"SS.State 6 ℂ → SS.State 6 ℂ → Prop"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.anchorU","type":"SS.State 6 ℂ → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.anchorV","type":"SS.State 6 ℂ → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalRows.canonical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  MainTheory.Orbit30PhysicalRows.NativeRows c d →\n    (∀ (i j : Fin 5),\n        i ≠ j →\n          MainTheory.Orbit30PhysicalRows.pointU c j * MainTheory.Orbit30PhysicalRows.edgeV d i j -\n              MainTheory.Orbit30PhysicalRows.edgeU c i j * MainTheory.Orbit30PhysicalRows.pointV d j =\n            0) ∧\n      (∀ (i : Fin 5),\n          MainTheory.Orbit30PhysicalRows.anchorU c * MainTheory.Orbit30PhysicalRows.pointV d i +\n              MainTheory.Orbit30PhysicalRows.pointU c i * MainTheory.Orbit30PhysicalRows.anchorV d =\n            0) ∧\n        (∀ (i : Fin 5), MainTheory.Orbit30PhysicalRows.starSum c d i = 0) ∧\n          ∀ (i : Fin 5), MainTheory.Orbit30PhysicalRows.matchingSum c d i = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.edgeC","type":"SS.State 6 ℂ → Fin 5 → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.edgeIndexMatrix","type":"Fin 5 → Fin 5 → Fin 16"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.edgeU","type":"SS.State 6 ℂ → Fin 5 → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.edgeV","type":"SS.State 6 ℂ → Fin 5 → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.matchingSum","type":"SS.State 6 ℂ → SS.State 6 ℂ → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalRows.physical_native_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) → SS.HasDistance ![c, d] 3 → MainTheory.Orbit30PhysicalRows.NativeRows c d"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PhysicalRows.physical_rows","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.HasDistance ![c, d] 3 →\n        (∀ (i j : Fin 5),\n            i ≠ j →\n              MainTheory.Orbit30PhysicalRows.pointU c j * MainTheory.Orbit30PhysicalRows.edgeV d i j -\n                  MainTheory.Orbit30PhysicalRows.edgeU c i j * MainTheory.Orbit30PhysicalRows.pointV d j =\n                0) ∧\n          (∀ (i : Fin 5),\n              MainTheory.Orbit30PhysicalRows.anchorU c * MainTheory.Orbit30PhysicalRows.pointV d i +\n                  MainTheory.Orbit30PhysicalRows.pointU c i * MainTheory.Orbit30PhysicalRows.anchorV d =\n                0) ∧\n            (∀ (i : Fin 5), MainTheory.Orbit30PhysicalRows.starSum c d i = 0) ∧\n              ∀ (i : Fin 5), MainTheory.Orbit30PhysicalRows.matchingSum c d i = 0"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.pointC","type":"SS.State 6 ℂ → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.pointU","type":"SS.State 6 ℂ → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.pointV","type":"SS.State 6 ℂ → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PhysicalRows.starSum","type":"SS.State 6 ℂ → SS.State 6 ℂ → Fin 5 → ℂ"}
