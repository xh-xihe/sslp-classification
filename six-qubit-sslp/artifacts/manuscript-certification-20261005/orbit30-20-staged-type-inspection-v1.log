CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement7","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨7, ⋯⟩ = p ⟨7, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement8","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨8, ⋯⟩ = p ⟨8, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complement9","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → t ⟨9, ⋯⟩ = p ⟨9, ⋯⟩"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.complementIndex","type":"Fin 16 → Fin 16"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.complete_normal","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t ↔ MainTheory.Orbit30PrintedMoments.Normal p t"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.coordinateSum","type":"(Fin 16 → ℝ) → Fin 6 → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.literal_coordinate_sum","type":"∀ (p : Fin 16 → ℝ) (j : Fin 6),\n  MainTheory.Orbit30PrintedMoments.coordinateSum p j =\n    ∑ i, p i * if MainTheory.Orbit30PrintedMoments.bottom i j = Bool.true then 1 else 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.literal_total_sum","type":"∀ (p : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.totalSum p = ∑ i, p i"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.moment_of_normal","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Normal p t → MainTheory.Orbit30PrintedMoments.Moment p t"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.normal_of_moment","type":"∀ (p t : Fin 16 → ℝ), MainTheory.Orbit30PrintedMoments.Moment p t → MainTheory.Orbit30PrintedMoments.Normal p t"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.physical_moments","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit30PrintedMoments.Moment (MainTheory.Orbit30PrintedMoments.bottomProbability c)\n              (MainTheory.Orbit30PrintedMoments.topProbability d)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30PrintedMoments.physical_normal","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit30PrintedMoments.Normal (MainTheory.Orbit30PrintedMoments.bottomProbability c)\n              (MainTheory.Orbit30PrintedMoments.topProbability d)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.top","type":"Fin 16 → SS.BitString 6"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.topProbability","type":"SS.State 6 ℂ → Fin 16 → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30PrintedMoments.totalSum","type":"(Fin 16 → ℝ) → ℝ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProbabilityLabels.actual_probabilities","type":"∀ (p t : Fin 16 → ℝ),\n  MainTheory.Orbit30PrintedMoments.Moment p t →\n    p ⟨15, ⋯⟩ = 1 / 8 ∧\n      (∀ (v : Fin 5),\n          MainTheory.Orbit30ProbabilityLabels.degreeMass p v =\n            MainTheory.Orbit30ProbabilityLabels.pointMass p v + 1 / 8) ∧\n        ∑ v, MainTheory.Orbit30ProbabilityLabels.pointMass p v = 3 / 8 ∧\n          ∑ e, MainTheory.Orbit30ProbabilityLabels.edgeMass p e = 1 / 2"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.coordQ","type":"Fin 16 → Fin 6 → ℚ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.degreeIndicatorQ","type":"Fin 5 → Fin 16 → ℚ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.degreeMass","type":"(Fin 16 → ℝ) → Fin 5 → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.edgeIndex","type":"Fin 10 → Fin 16"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.edgeMass","type":"(Fin 16 → ℝ) → Fin 10 → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.endpoints","type":"Fin 10 → Fin 5 × Fin 5"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.firstFourQ","type":"Fin 16 → ℚ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProbabilityLabels.literal_degree_sum","type":"∀ (p : Fin 16 → ℝ) (v : Fin 5),\n  MainTheory.Orbit30ProbabilityLabels.degreeMass p v =\n    ∑ e,\n      if\n          (MainTheory.Orbit30ProbabilityLabels.endpoints e).1 = v ∨\n            (MainTheory.Orbit30ProbabilityLabels.endpoints e).2 = v then\n        MainTheory.Orbit30ProbabilityLabels.edgeMass p e\n      else 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProbabilityLabels.literal_pointwise_identities","type":"(∀ (i : Fin 16),\n    MainTheory.Orbit30ProbabilityLabels.starIndicatorQ i =\n      MainTheory.Orbit30ProbabilityLabels.firstFourQ i / 4 - MainTheory.Orbit30ProbabilityLabels.coordQ i 4 / 2 -\n        MainTheory.Orbit30ProbabilityLabels.coordQ i 5 / 4) ∧\n  (∀ (i : Fin 16),\n      MainTheory.Orbit30ProbabilityLabels.degreeIndicatorQ 0 i -\n          MainTheory.Orbit30ProbabilityLabels.vertexIndicatorQ 0 i =\n        -1 + MainTheory.Orbit30ProbabilityLabels.firstFourQ i / 4 + MainTheory.Orbit30ProbabilityLabels.coordQ i 4 / 2 +\n          3 * MainTheory.Orbit30ProbabilityLabels.coordQ i 5 / 4) ∧\n    ∀ (v : Fin 4) (i : Fin 16),\n      MainTheory.Orbit30ProbabilityLabels.degreeIndicatorQ ⟨↑v + 1, ⋯⟩ i -\n          MainTheory.Orbit30ProbabilityLabels.vertexIndicatorQ ⟨↑v + 1, ⋯⟩ i =\n        MainTheory.Orbit30ProbabilityLabels.firstFourQ i / 4 -\n              MainTheory.Orbit30ProbabilityLabels.coordQ i ⟨3 - ↑v, ⋯⟩ +\n            MainTheory.Orbit30ProbabilityLabels.coordQ i 4 / 2 -\n          MainTheory.Orbit30ProbabilityLabels.coordQ i 5 / 4"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProbabilityLabels.physical_probabilities","type":"∀ (c d : SS.State 6 ℂ),\n  (∀ x ∉ SixQubit.Orbit30.S0, c x = 0) →\n    (∀ x ∉ SixQubit.Orbit30.S1, d x = 0) →\n      SS.innerC c c = 1 →\n        SS.innerC d d = 1 →\n          SS.HasDistance ![c, d] 3 →\n            MainTheory.Orbit30PrintedMoments.bottomProbability c ⟨15, ⋯⟩ = 1 / 8 ∧\n              (∀ (v : Fin 5),\n                  MainTheory.Orbit30ProbabilityLabels.degreeMass (MainTheory.Orbit30PrintedMoments.bottomProbability c)\n                      v =\n                    MainTheory.Orbit30ProbabilityLabels.pointMass (MainTheory.Orbit30PrintedMoments.bottomProbability c)\n                        v +\n                      1 / 8) ∧\n                ∑ v,\n                      MainTheory.Orbit30ProbabilityLabels.pointMass\n                        (MainTheory.Orbit30PrintedMoments.bottomProbability c) v =\n                    3 / 8 ∧\n                  ∑ e,\n                      MainTheory.Orbit30ProbabilityLabels.edgeMass\n                        (MainTheory.Orbit30PrintedMoments.bottomProbability c) e =\n                    1 / 2"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.pointMass","type":"(Fin 16 → ℝ) → Fin 5 → ℝ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.starIndicatorQ","type":"Fin 16 → ℚ"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.vertexIndex","type":"Fin 5 → Fin 16"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProbabilityLabels.vertexIndicatorQ","type":"Fin 5 → Fin 16 → ℚ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphExclusion.literal_endpoints","type":"∀ (e : Fin 10),\n  (MainTheory.Orbit30GraphClassification.endpoints e).1 ≠ (MainTheory.Orbit30GraphClassification.endpoints e).2 ∧\n    MainTheory.Orbit30GraphClassification.edgeIndex (MainTheory.Orbit30GraphClassification.endpoints e).1\n        (MainTheory.Orbit30GraphClassification.endpoints e).2 =\n      e"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphExclusion.proper_no_go","type":"∀ (z : Fin 10 → ℂ) (m : Fin 1024),\n  MainTheory.Orbit30GraphClassification.Admissible m →\n    MainTheory.Orbit30ProperGraphTables.Missing z m →\n      (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphExclusion.relabeled_missing","type":"∀ (z : Fin 10 → ℂ) (m : Fin 1024) (hm : MainTheory.Orbit30GraphClassification.Admissible m),\n  MainTheory.Orbit30ProperGraphTables.Missing z m →\n    MainTheory.Orbit30ProperGraphTables.Missing\n      (fun e =>\n        z\n          (MainTheory.Orbit30GraphRelabel.relabelEdge\n            (⇑(Equiv.ofBijective (MainTheory.Orbit30GraphClassification.relabelWitness m) ⋯).symm) e))\n      (MainTheory.Orbit30GraphClassification.representative (MainTheory.Orbit30GraphClassification.typeWitness m))"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphExclusion.representative_no_go","type":"∀ (r : Fin 10) (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z (MainTheory.Orbit30GraphClassification.representative r) →\n    (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProperGraphTables.Missing","type":"(Fin 10 → ℂ) → Fin 1024 → Prop"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.binomial0","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨184, ⋯⟩ →\n    (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.binomial1","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨896, ⋯⟩ →\n    (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.binomial2","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨192, ⋯⟩ →\n    (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.binomial3","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨512, ⋯⟩ →\n    (∀ (i : Fin 5), MainTheory.Orbit30ProperGraphTables.hafnian z i = 0) → False"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30ProperGraphTables.hafnian","type":"(Fin 10 → ℂ) → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial0","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨220, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨0, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial1","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨480, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨0, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial2","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨424, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨0, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial3","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨704, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨0, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial4","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨200, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨2, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.monomial5","type":"∀ (z : Fin 10 → ℂ),\n  MainTheory.Orbit30ProperGraphTables.Missing z ⟨768, ⋯⟩ →\n    MainTheory.Orbit30ProperGraphTables.hafnian z ⟨0, ⋯⟩ = 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30ProperGraphTables.odd_product_contradiction","type":"∀ (a b c d e f : ℂ), a + d = 0 → b + e = 0 → c + f = 0 → a * b * c = d * e * f → d * e * f ≠ 0 → False"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.active_row","type":"∀ (d : MainTheory.Orbit30.Data) (i : Fin 5), ∑ j ∈ d.A, d.b j * d.c i j = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.degree_magnitude","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5), a ≠ b → d.A = {a, b} → d.r a * (d.r a + 1 / 8) = d.r b * (d.r b + 1 / 8)"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.disjoint_star_bound","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5), a ≠ b → d.A = {a, b} → d.D a + d.D b ≤ 1 / 2"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.equal_point_mass","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5), a ≠ b → d.A = {a, b} → d.r a = d.r b"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.internal_edge_zero","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5), a ≠ b → d.A = {a, b} → d.c a b = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.point_and_degree_values","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5),\n  a ≠ b → d.A = {a, b} → d.r a = 3 / 16 ∧ d.r b = 3 / 16 ∧ d.D a = 5 / 16 ∧ d.D b = 5 / 16"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.two_point_magnitude","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5), a ≠ b → d.A = {a, b} → ∀ (k : Fin 5), d.r a * d.w a k = d.r b * d.w b k"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30TwoPointDisplays.two_term_row","type":"∀ (d : MainTheory.Orbit30.Data) (a b : Fin 5),\n  a ≠ b → d.A = {a, b} → ∀ (i : Fin 5), d.b a * d.c i a + d.b b * d.c i b = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.four_edge_normalization","type":"∀ (a b c d : ℂ),\n  a ≠ 0 →\n    b ≠ 0 →\n      c ≠ 0 →\n        d ≠ 0 →\n          ∃ s,\n            (∀ (i : Fin 5), s i ≠ 0) ∧\n              s ⟨0, ⋯⟩ * s ⟨1, ⋯⟩ * a = 1 ∧\n                s ⟨0, ⋯⟩ * s ⟨2, ⋯⟩ * b = 1 ∧ s ⟨1, ⋯⟩ * s ⟨2, ⋯⟩ * c = 1 ∧ s ⟨3, ⋯⟩ * s ⟨4, ⋯⟩ * d = 1"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30VertexScaling.hafnian","type":"Matrix (Fin 5) (Fin 5) ℂ → Fin 5 → ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.preserves_hafnians","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ) (s : Fin 5 → ℂ),\n  (∀ (i : Fin 5), MainTheory.Orbit30VertexScaling.hafnian A i = 0) →\n    ∀ (i : Fin 5), MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30VertexScaling.scaled A s) i = 0"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.preserves_singularity","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ) (s : Fin 5 → ℂ),\n  (∀ (i : Fin 5), s i ≠ 0) → ((MainTheory.Orbit30VertexScaling.scaled A s).det = 0 ↔ A.det = 0)"}
CERTIFICATION_TYPE {"kind":"definition","name":"MainTheory.Orbit30VertexScaling.scaled","type":"Matrix (Fin 5) (Fin 5) ℂ → (Fin 5 → ℂ) → Matrix (Fin 5) (Fin 5) ℂ"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.scaled_determinant","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ) (s : Fin 5 → ℂ),\n  (MainTheory.Orbit30VertexScaling.scaled A s).det = (∏ i, s i) ^ 2 * A.det"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.scaled_entry","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ) (s : Fin 5 → ℂ) (i j : Fin 5),\n  MainTheory.Orbit30VertexScaling.scaled A s i j = s i * s j * A i j"}
CERTIFICATION_TYPE {"kind":"theorem","name":"MainTheory.Orbit30VertexScaling.scaled_hafnian","type":"∀ (A : Matrix (Fin 5) (Fin 5) ℂ) (s : Fin 5 → ℂ) (i : Fin 5),\n  MainTheory.Orbit30VertexScaling.hafnian (MainTheory.Orbit30VertexScaling.scaled A s) i =\n    (∏ j, if j = i then 1 else s j) * MainTheory.Orbit30VertexScaling.hafnian A i"}
