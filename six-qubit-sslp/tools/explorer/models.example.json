{
  "schema": "sslp.model-providers.v1",
  "default_provider": "local-qwen",
  "providers": [
    {
      "id": "local-qwen",
      "adapter": "ollama",
      "model": "qwen3:14b",
      "model_class": "open_weights",
      "base_url": "http://127.0.0.1:11434",
      "timeout_seconds": 120,
      "max_output_tokens": 1600,
      "context_tokens": 8192
    },
    {
      "id": "local-fast",
      "adapter": "ollama",
      "model": "qwen3:1.7b",
      "model_class": "open_weights",
      "base_url": "http://127.0.0.1:11434",
      "timeout_seconds": 90,
      "max_output_tokens": 1200,
      "context_tokens": 8192
    },
    {
      "id": "closed-compatible",
      "adapter": "chat_completions",
      "model": "configure-model-name",
      "model_class": "closed",
      "base_url": "https://api.example.invalid/v1",
      "api_key_env": "SSLP_CLOSED_API_KEY",
      "enabled": false
    }
  ]
}
